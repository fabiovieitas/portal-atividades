<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_robot_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/robot_logo"
        android:contentDescription="Lab Kids Robot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lab Kids 🤖"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Ofensiva: 3 dias seguidos!"
            android:textColor="#f59e0b"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 450 pts | Continue aprendendo"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_widget_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎮 JOGAR"
        android:textColor="#ffffff"
        android:background="#10b981"
        android:textSize="12sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

</LinearLayout>

  <script>
    // Gabarito Oficial 4º Ano Novembro/2026
    const correctAnswers = {
      1: 'B',
      2: 'C',
      3: 'PESSOAL', // Q3 Narrativa
      4: 'B',
      5: 'C',
      6: 'D',
      7: 'C',
      8: 'C',
      9: 'C',
      10: 'C'
    };

    const userAnswers = {};

    // Auto-detect turno via URL ?shift=manha ou ?shift=tarde
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const shiftParam = urlParams.get('shift');
      if (shiftParam) {
        const shiftEl = document.getElementById('shiftName');
        if (shiftEl) {
          if (shiftParam.toLowerCase().includes('tarde')) shiftEl.value = 'Tarde';
          else if (shiftParam.toLowerCase().includes('manha') || shiftParam.toLowerCase().includes('manhã')) shiftEl.value = 'Manhã';
          else if (shiftParam.toLowerCase().includes('integral')) shiftEl.value = 'Integral';
        }
      }

      // Restore local draft if exists
      const savedDraft = localStorage.getItem('simulado_4ano_novembro_draft');
      if (savedDraft) {
        try {
          const draft = JSON.parse(savedDraft);
          if (draft.studentName) document.getElementById('studentName').value = draft.studentName;
          if (draft.className) document.getElementById('className').value = draft.className;
          if (draft.shiftName && !shiftParam) document.getElementById('shiftName').value = draft.shiftName;
          if (draft.answers) {
            for (const [q, val] of Object.entries(draft.answers)) {
              if (q == '3') {
                if (typeof val === 'object') {
                  document.getElementById('q3-titulo').value = val.titulo || '';
                  document.getElementById('q3-redacao').value = val.texto || '';
                }
                userAnswers[3] = val;
              } else {
                selectOption(parseInt(q), val, false);
              }
            }
          }
        } catch(e) {}
      }
    });

    function saveDraft() {
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        className: document.getElementById('className')?.value || '',
        answers: userAnswers
      };
      localStorage.setItem('simulado_4ano_novembro_draft', JSON.stringify(draft));
    }

    function selectOption(qNum, letter, save = true) {
      userAnswers[qNum] = letter;
      const letters = ['A', 'B', 'C', 'D'];
      letters.forEach(l => {
        const el = document.getElementById(`opt-${qNum}-${l}`);
        if (el && el.parentElement) {
          if (l === letter) {
            el.parentElement.classList.add('selected');
          } else {
            el.parentElement.classList.remove('selected');
          }
        }
      });
      if (save) saveDraft();
    }

    function syncRedacao4Ano() {
      const titulo = document.getElementById('q3-titulo').value.trim();
      const texto = document.getElementById('q3-redacao').value.trim();
      userAnswers[3] = { titulo, texto };
      saveDraft();
    }

    // TTS Web Speech API
    function speakText() {}

    async function submitSimulado() {
      const studentName = document.getElementById('studentName').value.trim();
      const schoolName = document.getElementById('schoolName').value.trim();
      const shift = document.getElementById('shiftName').value || 'Manhã';
      const className = document.getElementById('className').value.trim() || '4º Ano';

      if (!studentName) {
        alert('Por favor, preencha o Nome do Aluno(a) antes de finalizar!');
        document.getElementById('studentName').focus();
        return;
      }

      // Verifica preenchimento
      const missing = [];
      for (let i = 1; i <= 10; i++) {
        if (!userAnswers[i]) missing.push(i);
      }
      if (missing.length > 0) {
        const confirmSend = confirm(`Você ainda não respondeu as seguintes questões: ${missing.join(', ')}.\n\nDeseja enviar mesmo assim?`);
        if (!confirmSend) return;
      }

      // Calcula pontuação (Q3 conta como pontuada se a narrativa tiver sido produzida)
      let score = 0;
      for (let i = 1; i <= 10; i++) {
        if (i === 3) {
          const red = userAnswers[3];
          if (red && (red.texto?.length > 10 || typeof red === 'string')) score++;
        } else {
          if (userAnswers[i] && userAnswers[i].toUpperCase() === correctAnswers[i]) {
            score++;
          }
        }
      }

      const narrativeText = typeof userAnswers[3] === 'string' ? userAnswers[3] : (userAnswers[3]?.texto || '');

      const payload = {
        simulado_id: 'campos-4ano-novembro-2026',
        simuladoId: 'campos-4ano-novembro-2026',
        student_name: studentName,
        studentName: studentName,
        school_name: schoolName,
        schoolName: schoolName,
        shift: shift,
        class_name: className,
        className: className,
        grade: '4º Ano',
        answers_json: userAnswers,
        answers: userAnswers,
        score: score,
        max_score: 10,
        totalQuestions: 10,
        essay_text: narrativeText,
        submittedAt: new Date().toISOString()
      };

      if (window.SimuladoVault) {
        await window.SimuladoVault.submit(payload);
      } else {
        try {
          const res = await fetch('/api/simulado/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await res.json();
          console.log('Submission result:', result);
        } catch (err) {
          console.warn('Fallback offline save:', err);
        }
      }

      // Limpa rascunho local
      localStorage.removeItem('simulado_4ano_novembro_draft');

      // Exibe Modal de Confirmação (Sem nota ou pontuação para o aluno)
      document.getElementById('modalDetails').innerHTML = `
        <div><strong>👤 Estudante:</strong> ${studentName}</div>
        <div><strong>🏫 Escola:</strong> ${schoolName}</div>
        <div><strong>🎒 Turma:</strong> ${className} • <strong>Turno:</strong> ${shift}</div>
        <div style="margin-top: 0.35rem; font-size: 0.85rem; color: #64748b;">🕒 Concluído em ${new Date().toLocaleDateString('pt-BR')} às ${new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})}</div>
      `;
      document.getElementById('resultModal').classList.add('active');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 150,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
    }
  </script>

        </div>
      </div>

      <div id="modalDetails" style="text-align: left; background: #f8fafc; border: 1px solid #e2e8f0; padding: 1rem; border-radius: 12px; font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6;">
      </div>

      <button type="button" class="btn-submit" style="padding: 0.85rem 2rem; font-size: 1.1rem; width: 100%; border-radius: 12px;" onclick="window.location.href='/'">

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Acessando: <%= activity.title %> | Lab Kids</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
  <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
    <meta name="google-adsense-account" content="<%= adsensePubId %>">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
  <% } %>
  <style>
    body {
      background: radial-gradient(circle at center, #1e1b4b 0%, #0f172a 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
      text-align: center;
      font-family: 'Outfit', sans-serif;
      box-sizing: border-box;
    }
    .redirect-container {
      background: rgba(30, 41, 59, 0.95);
      padding: 40px 30px;
      border-radius: 28px;
      border: 2px solid #38bdf8;
      max-width: 650px;
      width: 100%;
      box-shadow: 0 25px 60px rgba(0,0,0,0.6);
      backdrop-filter: blur(12px);
    }
    .icon { font-size: 4.5rem; margin-bottom: 10px; }
    h1 {
      font-family: 'Fredoka', sans-serif;
      color: #fbbf24;
      margin: 0 0 15px 0;
      font-size: clamp(1.8rem, 4vw, 2.4rem);
    }
    p {
      color: #cbd5e1;
      font-size: 1.1rem;
      line-height: 1.5;
      margin-bottom: 25px;
    }
    .btn-access {
      display: inline-block;
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      text-decoration: none;
      padding: 18px 36px;
      border-radius: 50px;
      font-weight: 900;
      font-size: 1.3rem;
      border: none;
      cursor: pointer;
      width: 100%;
      box-sizing: border-box;
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .btn-access:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 35px rgba(16, 185, 129, 0.6);
      background: linear-gradient(135deg, #34d399, #10b981);
    }
    .countdown {
      font-size: 1.05rem;
      color: #94a3b8;
      margin-top: 20px;
      font-weight: 700;
    }
    #timer {
      color: #38bdf8;
      font-weight: 900;
      font-size: 1.3rem;
    }
    .ad-box {
      margin: 25px 0;
      background: rgba(15, 23, 42, 0.7);
      border: 1.5px dashed #475569;
      border-radius: 16px;
      padding: 12px;
    }
    .ad-label {
      font-size: 0.72rem;
      color: #64748b;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      display: block;
    }
  </style>
</head>
<body>
  <div class="redirect-container">
    <div class="icon">🚀</div>
    <h1><%= activity.title %></h1>
    <p><%= activity.description || 'Prepare-se para o desafio! A atividade está sendo carregada para sua turma.' %></p>

    <!-- Google AdSense Oficial Rotulado -->
    <div class="ad-box">
      <span class="ad-label">Publicidade / Apoio Educacional</span>
      <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="<%= adsensePubId %>"
             data-ad-slot="default"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      <% } else { %>
        <div style="color: #64748b; font-size: 0.85rem; padding: 10px;">Portal Lab Kids - Educação & Cultura Digital</div>
      <% } %>
    </div>

    <a href="<%= activity.activity_url %>" class="btn-access" id="access-btn">🎮 INICIAR ATIVIDADE AGORA 🚀</a>
    <div class="countdown" id="timer-text">Abrindo automaticamente em <span id="timer">5</span> segundos...</div>
  </div>

  <script>
    let timeLeft = 5;
    const timerElement = document.getElementById('timer');
    const accessBtn = document.getElementById('access-btn');
    
    const interval = setInterval(() => {
      timeLeft--;
      if (timerElement) timerElement.innerText = timeLeft;
      
      if (timeLeft <= 0) {
        clearInterval(interval);
        const timerText = document.getElementById('timer-text');
        if (timerText) timerText.innerText = 'Carregando o jogo...';
        window.location.href = accessBtn.href;
      }
    }, 1000);
  </script>
</body>
</html>
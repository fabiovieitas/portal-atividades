<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>MeLi Alerta de Preços</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🟡</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/pesquisa/css/style.css?v=20260921_v10" />
</head>
<body>

  <div class="app-container">
    <!-- NAVBAR COM USUÁRIOS ONLINE (MÍNIMO 5) E ACESSO AO PAINEL -->
    <header class="top-navbar">
      <div onclick="voltarDashboard()" class="brand-meli">
        <div class="brand-icon-meli">▶</div>
        <span class="brand-title-meli">MeLi Alerta de Preços</span>
      </div>

      <div class="user-badge-pill">
        <!-- ITEM 6: Usuários Online (Mínimo 5) -->
        <div class="online-users-badge">
          <span class="online-pulsing-dot"></span>
          <span id="txtOnlineUsers">5 usuários online</span>
        </div>

        <span class="user-tag">fabio.marques</span>
        <a href="/pesquisa/admin" class="btn-admin-link" title="Acessar Painel do Dono">Painel do Dono</a>
      </div>
    </header>

    <!-- =======================================================================
         TELA 1: DASHBOARD ("Alertas Monitorados" - Imagem 1 com Feed Todos vs Meus)
         ======================================================================= -->
    <main id="viewDashboard">
      <div class="dashboard-header">
        <div class="dashboard-title-box">
          <h1 id="dashboardMainTitle">Alertas Monitorados</h1>
          <p id="statAtivosCount" class="dashboard-stats-subtitle">Carregando alertas...</p>
        </div>
        <button class="btn-new-alert" onclick="abrirModalNovoAlerta()">
          <span>+ Novo alerta</span>
        </button>
      </div>

      <!-- ITEM 5: FILTRO DE FEED (Todos os Alertas dos Usuários vs Meus Alertas) -->
      <div class="alerts-feed-filter">
        <button type="button" id="tabFeedTodos" class="feed-filter-btn active" onclick="filtrarFeed('todos')">
          <span>🌐 Todos os Alertas</span>
          <span id="badgeCountTodos" class="feed-count-pill">0</span>
        </button>
        <button type="button" id="tabFeedMeus" class="feed-filter-btn" onclick="filtrarFeed('meus')">
          <span>👤 Meus Alertas</span>
          <span id="badgeCountMeus" class="feed-count-pill">0</span>
        </button>
      </div>

      <!-- STATUS ROW: MONITORANDO + ITEM 4: CONTADOR DE QUANTO TEMPO FALTA PRA REPESQUISAR -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
        <div class="status-section-title" style="margin-bottom: 0;">
          <span class="status-dot"></span>
          <span>MONITORANDO</span>
        </div>

        <!-- ITEM 4: Contador Regressivo de Repesquisa -->
        <div class="recheck-timer-pill">
          <span>⏱️ Próxima varredura em: <strong id="recheckTimerDisplay">03:59:59</strong></span>
        </div>
      </div>

      <!-- Grid de Cards Idêntico à Imagem 1 -->
      <div id="alertsGrid" class="alerts-grid">
        <!-- Renderizado dinamicamente via app.js -->
      </div>
    </main>

    <!-- =======================================================================
         TELA 2: DETALHES DO ALERTA (Imagem 2 - SEM AS INFOS DE AFILIADO/COPIAR LINK)
         ======================================================================= -->
    <section id="viewDetalhes" style="display: none;">
      <!-- Barra Superior da Tela 2 -->
      <div class="detail-top-nav">
        <button class="btn-back-dash" onclick="voltarDashboard()">
          <span>← Voltar para o Dashboard</span>
        </button>
        <!-- ITEM 1: Excluir Alerta 100% Funcional -->
        <button class="btn-delete-alert" onclick="excluirAlertaAtual()">
          Excluir Alerta
        </button>
      </div>

      <div class="detail-layout-grid">
        <!-- COLUNA ESQUERDA: Card do Produto (ITEM 3: Sem o box de afiliado e sem botão de copiar link) -->
        <div class="detail-left-card">
          <div class="detail-img-box">
            <img id="detailImg" src="" alt="Capa do Produto" />
          </div>
          <h2 id="detailTitle" class="detail-product-title">--</h2>
          
          <div class="detail-tags-row">
            <span class="badge-active-pill">ATIVO</span>
            <span id="detailCreatedDate" class="detail-created-date">Criado em --</span>
          </div>

          <!-- BOTÃO OFICIAL DE COMPRA (Link de Afiliado funciona silenciosamente) -->
          <a id="btnMeliBuy" href="#" target="_blank" rel="noopener noreferrer" class="btn-buy-meli">
            <span>Ver no Mercado Livre ↗</span>
          </a>
        </div>

        <!-- COLUNA DIREITA: 4 KPIs + Gráfico de Histórico + Timeline -->
        <div class="detail-right-content">
          <div class="detail-kpis-row">
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO INICIAL</div>
              <div id="kpiPrecoInicial" class="detail-kpi-value" style="color: #ffffff;">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">MENOR PREÇO</div>
              <div id="kpiMenorPreco" class="detail-kpi-value" style="color: var(--accent-green);">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO ALVO</div>
              <div id="kpiPrecoAlvo" class="detail-kpi-value" style="color: var(--accent-yellow);">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO ATUAL</div>
              <div id="kpiPrecoAtual" class="detail-kpi-value" style="color: #ffffff;">R$ --,--</div>
            </div>
          </div>

          <!-- Box do Gráfico -->
          <div class="detail-chart-box">
            <h3 class="detail-chart-header">Histórico de Preços</h3>
            <div class="chart-canvas-container">
              <canvas id="priceHistoryChart"></canvas>
            </div>
          </div>

          <!-- Tabela de Coletas Cronológicas -->
          <div class="timeline-box">
            <h4 class="timeline-title">📋 Registro de Coletas do Monitor</h4>
            <table class="timeline-table">
              <thead>
                <tr>
                  <th>Data & Hora</th>
                  <th>Plataforma</th>
                  <th>Preço Coletado</th>
                  <th>Ação</th>
                </tr>
              </thead>
              <tbody id="tbodyDetailTimeline">
                <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">Nenhum histórico gravado ainda.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- MODAL: + Novo alerta (Inserir Dados Completos de Cada Pesquisa) -->
  
  <!-- MODAL DE CONFIRMAÇÃO DE EXCLUSÃO (100% livre de bloqueios de popup do navegador) -->
  <div id="modalConfirmExclusao" class="modal-overlay" style="display: none; align-items: center; justify-content: center; z-index: 99999;">
    <div class="modal-box" style="max-width: 440px; text-align: center; padding: 28px; border: 1px solid rgba(239, 68, 68, 0.4); box-shadow: 0 20px 50px rgba(0,0,0,0.8);">
      <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🗑️</div>
      <h3 style="color: #fff; font-size: 1.3rem; font-weight: 700; margin-bottom: 10px;">Excluir este Alerta?</h3>
      <p id="modalConfirmExclusaoText" style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 24px; line-height: 1.5;">
        Você tem certeza que deseja remover este monitoramento de preço?
      </p>
      <div style="display: flex; gap: 14px; justify-content: center;">
        <button type="button" class="btn-admin-link" onclick="fecharModalConfirmExclusao()" style="padding: 10px 22px; font-size: 0.95rem;">
          Cancelar
        </button>
        <button type="button" id="btnConfirmarExclusaoAcao" onclick="confirmarExclusaoDefinitiva()" style="padding: 10px 22px; background: #ef4444; color: #fff; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 0.95rem; transition: background 0.2s;">
          Sim, Excluir Alerta
        </button>
      </div>
    </div>
  </div>


  <div id="modalNovoAlerta" class="modal-overlay">
    <div class="modal-box modal-large">
      <div class="modal-header">
        <h3 class="modal-title">+ Configurar Novo Alerta de Pesquisa</h3>
        <button class="close-btn" onclick="fecharModalNovoAlerta()">&times;</button>
      </div>

      <!-- Abas do Modal: Por Link/URL vs Por Termo de Busca -->
      <div class="modal-tabs-header">
        <button type="button" id="btnTabModalLink" class="modal-tab-btn active" onclick="alternarAbaModal('link')">
          🔗 Por Link / URL do Produto
        </button>
        <button type="button" id="btnTabModalTermo" class="modal-tab-btn" onclick="alternarAbaModal('termo')">
          🔍 Pesquisar por Termo & Filtros
        </button>
      </div>

      <!-- PAINEL 1: Link Direto ou URL de Busca Copiada -->
      <div id="painelModalLink">
        <div class="form-group">
          <label class="form-label">Nome / Identificador do Alerta (Opcional):</label>
          <input type="text" id="inputNomeLink" class="form-input" placeholder="ex: Filamento PETG 1kg Preto (se vazio, usa o título do site)" />
        </div>

        <div class="form-group">
          <label class="form-label">URL do Produto ou da Busca (Mercado Livre ou Shopee):</label>
          <textarea id="inputNovoUrl" class="form-textarea" placeholder="Cole aqui o link do anúncio ou a URL da pesquisa filtrada..."></textarea>
          <small style="color: var(--text-muted); font-size: 11px; margin-top: 4px; display: block;">
            💡 Dica: Você pode copiar o link de qualquer busca já filtrada no Mercado Livre ou Shopee.
          </small>
        </div>
      </div>

      <!-- PAINEL 2: Criar Pesquisa por Termo com Filtros Automáticos -->
      <div id="painelModalTermo" style="display: none;">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Termo da Pesquisa:</label>
            <input type="text" id="inputTermoBusca" class="form-input" placeholder="ex: Filamento PETG 1kg" />
          </div>
          <div class="form-group">
            <label class="form-label">Plataforma:</label>
            <select id="selectPlataformaBusca" class="form-input">
              <option value="Mercado Livre">🟡 Mercado Livre</option>
              <option value="Shopee">🟠 Shopee</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Filtros da Pesquisa a Aplicar:</label>
          <div class="filters-checkbox-grid">
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalFull" checked />
              <span>⚡ Envio FULL</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalNacional" checked />
              <span>🇧🇷 Nacional</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalFreteGratis" checked />
              <span>📦 Frete Grátis</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalMenorPreco" checked />
              <span>💰 Menor Preço</span>
            </label>
          </div>
        </div>
      </div>

      <!-- DADOS COMUNS: Preço Alvo, Frequência e Data Limite -->
      <div class="form-row" style="margin-top: 14px;">
        <div class="form-group">
          <label class="form-label">Preço Alvo Desejado (R$):</label>
          <input type="number" id="inputNovoAlvo" class="form-input" placeholder="ex: 67.50 (ou -10% padrão)" step="0.01" />
        </div>
        <div class="form-group">
          <label class="form-label">Frequência de Monitoramento:</label>
          <select id="inputNovoFrequencia" class="form-input">
            <option value="1">A cada 1 hora</option>
            <option value="2">A cada 2 horas</option>
            <option value="4" selected>A cada 4 horas (Recomendado)</option>
            <option value="8">A cada 8 horas</option>
            <option value="24">1 vez ao dia (24h)</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Data Limite do Monitoramento:</label>
          <input type="date" id="inputNovoDataLimite" class="form-input" value="2026-12-31" />
        </div>
        <div class="form-group">
          <label class="form-label">Status Inicial:</label>
          <div class="switch-wrapper" style="margin-top: 10px;">
            <label class="switch">
              <input type="checkbox" id="checkNovoAtivo" checked />
              <span class="slider"></span>
            </label>
            <span style="font-size: 13px; font-weight: 500;">Monitoramento Ativo</span>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.06);">
        <button type="button" class="btn-admin-link" onclick="fecharModalNovoAlerta()" style="padding: 10px 18px;">Cancelar</button>
        <button type="button" id="btnSubmitNovoAlerta" class="btn-new-alert" onclick="salvarNovoAlertaCompleto()">
          <span>Criar e Rastrear Alerta</span>
        </button>
      </div>
    </div>
  </div>

  <div id="toastContainer" class="toast-container"></div>

  <!-- Scripts -->
  <script src="/pesquisa/js/affiliate.js?v=20260921_v10"></script>
  <script src="/pesquisa/js/app.js?v=20260921_v15"></script>
</body>
</html>

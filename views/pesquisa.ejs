<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MeLi Alerta de Preços — Monitor Inteligente do Mercado Livre</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🟡</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/pesquisa/css/style.css?v=20260925_V101" />
  <link rel="stylesheet" href="css/style.css?v=20260925_V101" />
</head>
<body>

  <!-- Pular para o Conteúdo Principal (#9 Acessibilidade) -->
  <a href="#viewDashboard" class="skip-to-content">Pular para o conteúdo principal</a>

  <div class="app-container">
    <!-- NAVBAR COM PERFIS (#12), NOVIDADES (#20), USUÁRIOS ONLINE E ACESSO AO PAINEL -->
    <header class="top-navbar" role="banner">
      <div onclick="voltarDashboard()" class="brand-meli" role="button" tabindex="0" aria-label="Voltar para a página inicial do MeLi Alerta de Preços" onkeydown="if(event.key==='Enter'||event.key===' ') voltarDashboard()">
        <div class="brand-icon-meli" aria-hidden="true">▶</div>
        <span class="brand-title-meli">MeLi Alerta de Preços</span>
      </div>

      <div class="user-badge-pill" style="display: flex; align-items: center; gap: 10px;">
        <!-- ITEM 20: Botão O que há de novo / Changelog -->
        <button type="button" class="btn-changelog-nav" onclick="abrirModalChangelog()" aria-label="Ver o que há de novo e atualizações do sistema">
          <span aria-hidden="true">✨</span>
          <span>Novidades</span>
          <span id="badgeChangelogDot" class="changelog-badge-dot" title="Novidades disponíveis!"></span>
        </button>

        <!-- ITEM 6: Usuários Online (Mínimo 5) -->
        <div class="online-users-badge" aria-label="Usuários ativos">
          <span class="online-pulsing-dot" aria-hidden="true"></span>
          <span id="txtOnlineUsers">5 online</span>
        </div>

        <!-- REQUISITO 3: PERFIL VISITANTE COM BOTÃO DE LOGIN / CADASTRO AO LADO -->
        <div id="boxPerfilVisitante" class="perfil-status-group" style="display: flex; align-items: center; gap: 8px;">
          <span class="badge-visitante-pill">👀 Visitante</span>
          <button type="button" class="btn-auth-nav" onclick="abrirModalAuth('login')" aria-label="Fazer login ou cadastrar">
            <span>Entrar / Cadastrar</span>
          </button>
        </div>

        <!-- PERFIL USUÁRIO LOGADO -->
        <div id="boxPerfilLogado" class="perfil-status-group" style="display: none; align-items: center; gap: 8px;">
          <span id="txtNomeUsuarioLogado" class="badge-usuario-pill">👤 Usuário</span>
          <button type="button" class="btn-sessoes-nav" onclick="abrirModalSessoes()" title="Ver sessões ativas" aria-label="Ver sessões ativas">
            🛡️ Sessões
          </button>
          <button type="button" class="btn-logout-nav" onclick="fazerLogout()" title="Sair da conta" aria-label="Sair da conta">
            Sair
          </button>
        </div>
      </div>
    </header>

    <!-- =======================================================================
         TELA 1: DASHBOARD ("Alertas Monitorados" com Feed Todos vs Meus)
         ======================================================================= -->
    <main id="viewDashboard" tabindex="-1">
      
      <!-- ITEM 8: BANNER DE TRATAMENTO AMIGÁVEL DE ERROS -->
      <div id="friendlyErrorState" class="friendly-error-card" style="display: none;" role="alert">
        <div class="friendly-error-content">
          <span class="friendly-error-icon" aria-hidden="true">📡</span>
          <div>
            <h4 class="friendly-error-title">Não foi possível carregar as ofertas agora</h4>
            <p class="friendly-error-desc">Houve uma instabilidade na conexão ou com o servidor. Seus dados e alertas salvos continuam seguros.</p>
          </div>
        </div>
        <button type="button" class="btn-retry-action" onclick="carregarTodosOsDados()">
          <span>🔄 Tentar Novamente</span>
        </button>
      </div>

      <!-- ITEM 2: ONBOARDING CONTEXTUAL / TOUR RÁPIDO -->
      <div id="onboardingBanner" class="onboarding-banner" style="display: none;" role="region" aria-label="Guia Rápido do Sistema">
        <div class="onboarding-banner-header">
          <h3 class="onboarding-banner-title">
            <span>🧭 Como funciona o MeLi Alerta de Preços:</span>
          </h3>
          <button type="button" class="onboarding-close-btn" onclick="fecharOnboarding()" aria-label="Fechar introdução">&times;</button>
        </div>
        <div class="onboarding-steps-grid">
          <div class="onboarding-step-card">
            <div class="onboarding-step-num">1</div>
            <div class="onboarding-step-text">
              <strong>Busque ou Cole o Link</strong>
              <p>Pesquise qualquer produto ou cole o link do anúncio do Mercado Livre.</p>
            </div>
          </div>
          <div class="onboarding-step-card">
            <div class="onboarding-step-num">2</div>
            <div class="onboarding-step-text">
              <strong>Defina o Preço Desejado</strong>
              <p>Veja o histórico de preços e configure quanto você quer pagar.</p>
            </div>
          </div>
          <div class="onboarding-step-card">
            <div class="onboarding-step-num">3</div>
            <div class="onboarding-step-text">
              <strong>Aviso Automático Gratuito</strong>
              <p>O robô monitora 24 horas e te avisa assim que o preço atingir sua meta!</p>
            </div>
          </div>
        </div>
      </div>

      <div class="dashboard-header">
        <div class="dashboard-title-box">
          <h1 id="dashboardMainTitle">Alertas Monitorados</h1>
          <p id="statAtivosCount" class="dashboard-stats-subtitle" aria-live="polite">Carregando alertas...</p>
        </div>
        <button class="btn-new-alert" onclick="abrirModalNovoAlerta()" aria-label="Criar um novo alerta de preço">
          <span>+ Novo alerta</span>
        </button>
      </div>

      <!-- BARRA DE BUSCA RÁPIDA ESTILO ZOOM / BUSCAPÉ -->
      <div class="home-search-section">
        <div class="home-search-bar">
          <span class="home-search-icon" aria-hidden="true">🔍</span>
          <input type="text" id="inputBuscaRapidaHome" class="home-search-input" placeholder="Pesquisar produto ou menor preço (ex: Filamento PETG 1kg, SSD NVMe)..." onkeydown="if(event.key==='Enter') executarBuscaRapidaHome()" aria-label="Buscar produto ou menor preço" />
          <button type="button" class="btn-home-search" onclick="executarBuscaRapidaHome()" aria-label="Executar busca de menor preço">
            <span>Buscar Menor Preço ⚡</span>
          </button>
        </div>
        <div class="home-search-tags" role="toolbar" aria-label="Termos mais buscados">
          <span class="search-tag-label">Mais buscados:</span>
          <button type="button" class="search-tag-chip" onclick="preencherBuscaRapida('Filamento PETG 1kg')">Filamento PETG</button>
          <button type="button" class="search-tag-chip" onclick="preencherBuscaRapida('Filamento PLA 1kg')">Filamento PLA</button>
          <button type="button" class="search-tag-chip" onclick="preencherBuscaRapida('SSD NVMe 1TB')">SSD 1TB</button>
          <button type="button" class="search-tag-chip" onclick="preencherBuscaRapida('Mouse sem fio')">Mouse sem fio</button>
        </div>
      </div>

      <!-- ITEM 5: FILTRO DE FEED (Todos os Alertas dos Usuários vs Meus Alertas) -->
      <div class="alerts-feed-filter" role="tablist" aria-label="Filtro de visualização de alertas">
        <button type="button" id="tabFeedTodos" class="feed-filter-btn active" onclick="filtrarFeed('todos')" role="tab" aria-selected="true">
          <span>🌐 Todos os Alertas</span>
          <span id="badgeCountTodos" class="feed-count-pill">0</span>
        </button>
        <button type="button" id="tabFeedMeus" class="feed-filter-btn" onclick="filtrarFeed('meus')" role="tab" aria-selected="false">
          <span>👤 Meus Alertas</span>
          <span id="badgeCountMeus" class="feed-count-pill">0</span>
        </button>
      </div>

      <!-- STATUS ROW: MONITORANDO + ITEM 4: CONTADOR DE QUANTO TEMPO FALTA PRA REPESQUISAR -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
        <div class="status-section-title" style="margin-bottom: 0;">
          <span class="status-dot" aria-hidden="true"></span>
          <span>MONITORANDO</span>
        </div>

        <div class="recheck-timer-pill" aria-live="polite">
          <span>⏱️ Próxima varredura em: <strong id="recheckTimerDisplay">03:59:59</strong></span>
        </div>
      </div>

      <!-- ITEM 5: SKELETON SCREENS DURANTE O CARREGAMENTO -->
      <div id="alertsGridSkeleton" class="alerts-grid" style="display: none;" aria-hidden="true">
        <div class="skeleton-card">
          <div class="skeleton-shimmer skeleton-img"></div>
          <div class="skeleton-shimmer skeleton-line-title"></div>
          <div class="skeleton-shimmer skeleton-line-subtitle"></div>
          <div class="skeleton-shimmer skeleton-line-price"></div>
          <div class="skeleton-shimmer skeleton-line-btn"></div>
        </div>
        <div class="skeleton-card">
          <div class="skeleton-shimmer skeleton-img"></div>
          <div class="skeleton-shimmer skeleton-line-title"></div>
          <div class="skeleton-shimmer skeleton-line-subtitle"></div>
          <div class="skeleton-shimmer skeleton-line-price"></div>
          <div class="skeleton-shimmer skeleton-line-btn"></div>
        </div>
        <div class="skeleton-card">
          <div class="skeleton-shimmer skeleton-img"></div>
          <div class="skeleton-shimmer skeleton-line-title"></div>
          <div class="skeleton-shimmer skeleton-line-subtitle"></div>
          <div class="skeleton-shimmer skeleton-line-price"></div>
          <div class="skeleton-shimmer skeleton-line-btn"></div>
        </div>
        <div class="skeleton-card">
          <div class="skeleton-shimmer skeleton-img"></div>
          <div class="skeleton-shimmer skeleton-line-title"></div>
          <div class="skeleton-shimmer skeleton-line-subtitle"></div>
          <div class="skeleton-shimmer skeleton-line-price"></div>
          <div class="skeleton-shimmer skeleton-line-btn"></div>
        </div>
      </div>

      <!-- Grid de Cards de Alertas -->
      <div id="alertsGrid" class="alerts-grid" role="region" aria-label="Lista de produtos monitorados">
        <!-- Renderizado dinamicamente via app.js -->
      </div>
    </main>

    <!-- =======================================================================
         TELA 2: DETALHES DO ALERTA
         ======================================================================= -->
    <section id="viewDetalhes" style="display: none;" tabindex="-1">
      <div class="detail-top-nav">
        <button class="btn-back-dash" onclick="voltarDashboard()" aria-label="Voltar para a lista de alertas">
          <span>← Voltar para o Dashboard</span>
        </button>
        <button class="btn-delete-alert" onclick="excluirAlertaAtual()" aria-label="Excluir este alerta do sistema">
          Excluir Alerta
        </button>
      </div>

      <div class="detail-layout-grid">
        <!-- COLUNA ESQUERDA: Card do Produto -->
        <div class="detail-left-card">
          <div class="detail-img-box">
            <img id="detailImg" src="" alt="Capa do Produto no Mercado Livre" />
          </div>
          <h2 id="detailTitle" class="detail-product-title">--</h2>
          
          <div class="detail-tags-row">
            <span class="badge-active-pill">ATIVO</span>
            <span id="detailCreatedDate" class="detail-created-date">Criado em --</span>
          </div>

          <a id="btnMeliBuy" href="#" target="_blank" rel="noopener noreferrer" class="btn-buy-meli" aria-label="Ver anúncio com desconto no Mercado Livre (abre em nova aba)">
            <span>Ver no Mercado Livre ↗</span>
          </a>

          <!-- BLOCO VIRAL: COMPARTILHAR OFERTA -->
          <div class="detail-share-box">
            <div class="detail-share-header">
              <span class="detail-share-icon" aria-hidden="true">📢</span>
              <div>
                <strong style="color: #fff; font-size: 13px;">Compartilhar Economia</strong>
                <p style="font-size: 11px; color: var(--text-muted); margin: 0;">Envie para amigos com link de desconto e do site</p>
              </div>
            </div>
            <div class="detail-share-btns">
              <button type="button" class="btn-share-action btn-share-wpp" onclick="compartilharOfertaAtiva('whatsapp')">
                <span>🟢 WhatsApp</span>
              </button>
              <button type="button" class="btn-share-action btn-share-tg" onclick="compartilharOfertaAtiva('telegram')">
                <span>🔵 Telegram</span>
              </button>
              <button type="button" class="btn-share-action btn-share-copy" onclick="compartilharOfertaAtiva('copiar')">
                <span>📋 Copiar Texto</span>
              </button>
            </div>
          </div>
        </div>

        <!-- COLUNA DIREITA: KPIs + Gráfico de Histórico + Timeline -->
        <div class="detail-right-content">
          <div class="detail-kpis-row">
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO INICIAL</div>
              <div id="kpiPrecoInicial" class="detail-kpi-value" style="color: #ffffff;">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">MENOR PREÇO</div>
              <div id="kpiMenorPreco" class="detail-kpi-value" style="color: var(--accent-green);">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO ALVO</div>
              <div id="kpiPrecoAlvo" class="detail-kpi-value" style="color: var(--accent-yellow);">R$ --,--</div>
            </div>
            <div class="detail-kpi-card">
              <div class="detail-kpi-label">PREÇO ATUAL</div>
              <div id="kpiPrecoAtual" class="detail-kpi-value" style="color: #ffffff;">R$ --,--</div>
            </div>
          </div>

          <!-- Box do Gráfico -->
          <div class="detail-chart-box">
            <h3 class="detail-chart-header">Histórico de Preços</h3>
            <div class="chart-canvas-container">
              <canvas id="priceHistoryChart" aria-label="Gráfico de evolução histórica de preços" role="img"></canvas>
            </div>
          </div>

          <!-- Tabela de Coletas Cronológicas -->
          <div class="timeline-box">
            <h4 class="timeline-title">📋 Registro de Coletas do Monitor</h4>
            <table class="timeline-table">
              <thead>
                <tr>
                  <th>Data & Hora</th>
                  <th>Plataforma</th>
                  <th>Preço Coletado</th>
                  <th>Ação</th>
                </tr>
              </thead>
              <tbody id="tbodyDetailTimeline">
                <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">Nenhum histórico gravado ainda.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- =======================================================================
       MODAIS DO SISTEMA (#9 Navegação por Teclado e #11 ARIA)
       ======================================================================= -->

  <!-- MODAL: + Novo Alerta com Auto-save (#6) -->
  <div id="modalNovoAlerta" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="novoAlertaTitle">
    <div class="modal-box modal-large">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <h3 id="novoAlertaTitle" class="modal-title">+ Configurar Novo Alerta de Pesquisa</h3>
          <span id="badgeDraftRestored" class="draft-restored-pill" style="display: none;">📝 Rascunho restaurado</span>
        </div>
        <button class="close-btn" onclick="fecharModalNovoAlerta()" aria-label="Fechar modal de novo alerta">&times;</button>
      </div>

      <!-- Abas do Modal: Por Link/URL vs Por Termo de Busca -->
      <div class="modal-tabs-header" role="tablist">
        <button type="button" id="btnTabModalLink" class="modal-tab-btn active" onclick="alternarAbaModal('link')" role="tab" aria-selected="true">
          🔗 Por Link / URL do Produto
        </button>
        <button type="button" id="btnTabModalTermo" class="modal-tab-btn" onclick="alternarAbaModal('termo')" role="tab" aria-selected="false">
          🔍 Pesquisar por Termo & Filtros
        </button>
      </div>

      <!-- PAINEL 1: Link Direto ou URL de Busca Copiada -->
      <div id="painelModalLink">
        <div class="form-group">
          <label class="form-label" for="inputNomeLink">Nome / Identificador do Alerta (Opcional):</label>
          <input type="text" id="inputNomeLink" class="form-input" placeholder="ex: Filamento PETG 1kg Preto (se vazio, usa o título do site)" oninput="salvarRascunhoAlerta()" />
        </div>

        <div class="form-group">
          <label class="form-label" for="inputNovoUrl">URL do Produto ou da Busca (Mercado Livre ou Shopee):</label>
          <textarea id="inputNovoUrl" class="form-textarea" placeholder="Cole aqui o link do anúncio ou a URL da pesquisa filtrada..." oninput="salvarRascunhoAlerta()"></textarea>
          <small style="color: var(--text-muted); font-size: 11px; margin-top: 4px; display: block;">
            💡 Dica: Você pode copiar o link de qualquer busca já filtrada no Mercado Livre ou Shopee.
          </small>
        </div>
      </div>

      <!-- PAINEL 2: Criar Pesquisa por Termo com Filtros Automáticos -->
      <div id="painelModalTermo" style="display: none;">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="inputTermoBusca">Termo da Pesquisa:</label>
            <input type="text" id="inputTermoBusca" class="form-input" placeholder="ex: Filamento PETG 1kg" oninput="salvarRascunhoAlerta()" />
          </div>
          <div class="form-group">
            <label class="form-label" for="selectPlataformaBusca">Plataforma:</label>
            <select id="selectPlataformaBusca" class="form-input">
              <option value="Mercado Livre">🟡 Mercado Livre</option>
              <option value="Shopee">🟠 Shopee</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Filtros da Pesquisa a Aplicar:</label>
          <div class="filters-checkbox-grid">
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalFull" checked />
              <span>⚡ Envio FULL</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalNacional" checked />
              <span>🇧🇷 Nacional</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalFreteGratis" checked />
              <span>📦 Frete Grátis</span>
            </label>
            <label class="filter-checkbox-item">
              <input type="checkbox" id="checkModalMenorPreco" checked />
              <span>💰 Menor Preço</span>
            </label>
          </div>
        </div>

        <div class="form-group" style="margin-top: 14px;">
          <label class="form-label">🔢 Quantos produtos monitorar?</label>
          <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0 10px;">
            O sistema vai criar <strong>um alerta individual</strong> para cada produto encontrado.
          </p>
          <div class="qty-selector-pills" id="qtySelectorPills">
            <button type="button" class="qty-pill" data-qty="1" onclick="selecionarQtdAlertas(1)">1 produto</button>
            <button type="button" class="qty-pill active" data-qty="3" onclick="selecionarQtdAlertas(3)">3 produtos ⭐</button>
            <button type="button" class="qty-pill" data-qty="5" onclick="selecionarQtdAlertas(5)">5 produtos</button>
            <button type="button" class="qty-pill" data-qty="10" onclick="selecionarQtdAlertas(10)">10 produtos</button>
          </div>
          <input type="hidden" id="inputQtdAlertas" value="3" />
        </div>
      </div>

      <!-- DADOS COMUNS: Preço Alvo, Frequência e Data Limite -->
      <div class="form-row" style="margin-top: 14px;">
        <div class="form-group">
          <label class="form-label" for="inputNovoAlvo">Preço Alvo Desejado (R$):</label>
          <input type="number" id="inputNovoAlvo" class="form-input" placeholder="ex: 67.50 (ou use os atalhos)" step="0.01" oninput="salvarRascunhoAlerta()" />
          <div class="target-discount-shortcuts">
            <span class="discount-shortcuts-label">Atalhos:</span>
            <button type="button" class="discount-chip" onclick="aplicarDescontoRapido(5)">-5%</button>
            <button type="button" class="discount-chip active" id="chipDesc10" onclick="aplicarDescontoRapido(10)">-10% ⭐</button>
            <button type="button" class="discount-chip" onclick="aplicarDescontoRapido(15)">-15%</button>
            <button type="button" class="discount-chip" onclick="aplicarDescontoRapido(20)">-20%</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="inputNovoFrequencia">Frequência de Monitoramento:</label>
          <select id="inputNovoFrequencia" class="form-input">
            <option value="1">A cada 1 hora</option>
            <option value="2">A cada 2 horas</option>
            <option value="4" selected>A cada 4 horas (Recomendado)</option>
            <option value="8">A cada 8 horas</option>
            <option value="24">1 vez ao dia (24h)</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="inputNovoDataLimite">Data Limite do Monitoramento:</label>
          <input type="date" id="inputNovoDataLimite" class="form-input" value="2026-12-31" />
        </div>
        <div class="form-group">
          <label class="form-label">Status Inicial:</label>
          <div class="switch-wrapper" style="margin-top: 10px;">
            <label class="switch">
              <input type="checkbox" id="checkNovoAtivo" checked />
              <span class="slider"></span>
            </label>
            <span style="font-size: 13px; font-weight: 500;">Monitoramento Ativo</span>
          </div>
        </div>
      </div>

      <!-- CAPTURA OPCIONAL DE E-MAIL -->
      <div class="form-group email-capture-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label class="form-label" for="inputNovoEmail" style="margin-bottom: 0; color: #93c5fd; display: flex; align-items: center; gap: 6px;">
            <span>📧 Receber Alerta por E-mail (Opcional):</span>
          </label>
          <span class="badge-free-pill">100% Gratuito</span>
        </div>
        <p style="font-size: 11.5px; color: var(--text-muted); margin-bottom: 8px;">
          Sem senha e sem cadastro. Se preenchido, você recebe um e-mail avisando na hora que o produto baixar de preço!
        </p>
        <input type="email" id="inputNovoEmail" class="form-input" placeholder="seu-email@exemplo.com (deixe em branco se não quiser)" oninput="salvarRascunhoAlerta()" />
        
        <div class="email-trigger-row">
          <label class="email-trigger-label">

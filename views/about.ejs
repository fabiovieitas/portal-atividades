            color: var(--text-dark);
            line-height: 1.7;
            margin: 0;
            padding: 0;
        }

        .about-hero {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            color: white;
            padding: 5rem 1.5rem 6rem 1.5rem;
            text-align: center;
            position: relative;
        }

        .about-hero h1 {
            font-family: 'Fredoka', sans-serif;
            font-size: clamp(2.2rem, 5vw, 3.4rem);
            font-weight: 700;
            margin-bottom: 1rem;
            color: #ffffff;
            text-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .about-hero p {
            font-size: clamp(1.1rem, 2.5vw, 1.35rem);
            color: #cbd5e1;
            max-width: 760px;
            margin: 0 auto;
        }

        .about-container {
            max-width: 960px;
            margin: -3rem auto 4rem auto;
            padding: 0 1.5rem;
            position: relative;
            z-index: 10;
        }

        .about-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 3rem 2.5rem;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
            margin-bottom: 2rem;
        }

        @media (max-width: 640px) {
            .about-card { padding: 2rem 1.5rem; }
        }

        .about-card h2 {
            font-family: 'Fredoka', sans-serif;
            color: #1e1b4b;
            font-size: 1.8rem;
            font-weight: 700;
            margin-top: 0;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 0.8rem;
        }

        .founder-box {
            display: flex;
            gap: 2rem;
            align-items: center;
            background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
            border: 1px solid #c7d2fe;
            border-radius: 20px;
            padding: 2rem;
            margin: 2rem 0;
        }

        @media (max-width: 680px) {
            .founder-box { flex-direction: column; text-align: center; }
        }

        .founder-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #4f46e5;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
            flex-shrink: 0;
        }

        .pillars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
            margin: 2rem 0;
        }

        .pillar-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.5rem;
            transition: transform 0.2s;
        }

        .pillar-item:hover {
            transform: translateY(-4px);
            border-color: #818cf8;
        }

        .pillar-icon {
            font-size: 2.2rem;
            margin-bottom: 0.8rem;
            display: block;
        }

        .pillar-item h3 {

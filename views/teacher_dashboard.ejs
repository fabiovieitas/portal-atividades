                                <button onclick="removeItemFromCollection('${col.id}', '${item.activity_id}')" style="background: none; border: none; color: #ff6b6b; cursor: pointer; font-size: 1.1rem;" title="Remover da coleção">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                itemsContainer.innerHTML = html;

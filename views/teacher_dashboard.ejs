<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Professor - Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin_fixes.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="/js/app-enhancements.js" defer></script>
    <style>
        :root {
            --sidebar-bg: #f8fafc;
            --content-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --accent: #2563eb;
            --border: #e2e8f0;
            --teacher-level-color: <%= teacher.level.color %>;
        }
        body { 
            background: #f1f5f9; 
            color: var(--text-main); 
            font-family: 'Outfit', sans-serif; 
            margin: 0;
        }
        .dashboard-container { display: flex; min-height: 100vh; }
        .admin-sidebar { 
            background: var(--sidebar-bg); 
            width: 280px; 
            border-right: 1px solid var(--border); 
            display: flex; 
            flex-direction: column;
            padding: 20px 0;
        }
        .admin-content { flex: 1; padding: 40px; background: var(--content-bg); }
        
        .nav-item { 
            padding: 12px 25px; 
            color: var(--text-muted); 
            text-decoration: none; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            font-weight: 600;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: 0.2s;
        }
        .nav-item:hover { background: #f1f5f9; color: var(--accent); }
        .nav-item.active { background: #eff6ff; color: var(--accent); border-right: 4px solid var(--accent); }
        
        .glass-panel { 
            background: white !important; 
            border: 1px solid var(--border) !important; 
            border-radius: 16px !important; 
            padding: 24px !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
            color: var(--text-main) !important;
        }
        
        .workspace-header h1 { font-size: 2rem; color: var(--text-main); margin-bottom: 8px; }
        .workspace-header p { color: var(--text-muted); }
        
        .stat-card-new { border: 1px solid var(--border); background: white; border-radius: 16px; padding: 24px; display: flex; align-items: center; gap: 20px; }
        .stat-data .label { font-size: 0.875rem; color: var(--text-muted); text-transform: uppercase; }
        .stat-data .value { font-size: 1.5rem; font-weight: 700; color: var(--text-main); }
        
        .input-group label { display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-main); }
        .input-group input, .input-group select, .input-group textarea { 
            width: 100%; 
            padding: 10px 14px; 
            border: 1px solid var(--border); 
            border-radius: 8px; 
            font-size: 1rem;
            color: var(--text-main);
        }
        .btn-submit { background: var(--accent); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; }
        .btn-submit:hover { opacity: 0.9; transform: translateY(-1px); }
        
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: none; align-items: center; justify-content: center; }
        .modal-content { background: white; padding: 30px; border-radius: 20px; width: 90%; max-width: 500px; text-align: center; }
        .close { float: right; font-size: 1.5rem; cursor: pointer; }
    </style>
</head>

<body class="admin-dashboard-new">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-top" style="padding: 20px;">
            <img src="/img/logo-prof.png" alt="Logo" class="sidebar-logo">
            <div style="margin-top: 10px;">
                <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-main);"><%= teacher.name %></h3>
                <span style="background: var(--teacher-level-color); color: white; padding: 3px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 800; display: inline-block; margin-top: 5px;">
                    <%= teacher.level.title %>
                </span>
            </div>
        </div>
        <nav class="sidebar-nav">
            <button class="nav-item active" onclick="switchTab('acervo', this)">
                <span class="nav-icon">❤️</span> <span class="nav-text">Favoritos</span>
            </button>
            <button class="nav-item" onclick="switchTab('colecoes', this)">
                <span class="nav-icon">📂</span> <span class="nav-text">Coleções</span>
            </button>
            <button class="nav-item" onclick="switchTab('calendario', this)">
                <span class="nav-icon">📅</span> <span class="nav-text">Agenda</span>
            </button>
            <button class="nav-item" onclick="switchTab('minhas-aulas', this)">
                <span class="nav-icon">💡</span> <span class="nav-text">Minhas Atividades</span>
            </button>
            <button class="nav-item" onclick="switchTab('turmas', this)">
                <span class="nav-icon">🏫</span> <span class="nav-text">Turmas</span>
            </button>
            <button class="nav-item" onclick="switchTab('provas', this)">
                <span class="nav-icon">📝</span> <span class="nav-text">Provas</span>
            </button>
            <button class="nav-item" onclick="switchTab('analytics', this)">
                <span class="nav-icon">📊</span> <span class="nav-text">Monitor & Controle</span>
            </button>
            <button class="nav-item" onclick="switchTab('livros-parceiros', this)">
                <span class="nav-icon">📚</span> <span class="nav-text">Livros & Materiais</span>
            </button>
            <button class="nav-item" onclick="switchTab('config', this)">
                <span class="nav-icon">⚙️</span> <span class="nav-text">Ajustes</span>
            </button>
        </nav>
        <div class="sidebar-bottom">
            <a href="/professor/logout" class="btn-logout" style="background: rgba(255,0,0,0.2); color: #ff6b6b;">Sair do Painel</a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-content">
        
        <!-- MEU ACERVO -->
        <div id="acervo" class="tab-pane active">
            <header class="workspace-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1>⭐ Atividades Favoritas & Sala de Aula</h1>
                    <p>Projete na lousa digital, compartilhe no WhatsApp ou organize suas aulas.</p>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" onclick="switchTab('analytics', document.querySelector('[onclick*=\'analytics\']'))" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; padding: 12px 22px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(37,99,235,0.35);">
                        📊 MONITOR DE ALUNOS & TABLETS
                    </button>
                    <a href="/professor/certificado" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 12px 22px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 15px rgba(245,158,11,0.3); border: 2px solid rgba(255,255,255,0.3);">
                        🏆 GERAR CERTIFICADO DE ALUNO
                    </a>
                    <a href="/imprimir-qrcodes" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #0284c7, #2563eb); color: white; padding: 12px 22px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 15px rgba(2,132,199,0.3); border: 2px solid rgba(255,255,255,0.3);">
                        🏷️ IMPRIMIR MINI CARTÕES (A4)
                    </a>
                    <a href="https://api.whatsapp.com/send?text=Recomendo%20este%20portal%20gratuito%20de%20jogos%20pedag%C3%B3gicos%20e%20atividades%20para%20Datashow%20(BNCC):%20https://labkids.online/" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: #25d366; color: white; padding: 12px 22px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 15px rgba(37,211,102,0.3); border: 2px solid rgba(255,255,255,0.3);">
                        📲 RECOMENDAR NO WHATSAPP
                    </a>
                    <a href="/download/labkids.apk" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 12px 22px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 15px rgba(16,185,129,0.3); border: 2px solid rgba(255,255,255,0.3);">
                        📱 BAIXAR APK TABLETS
                    </a>
                </div>
            </header>
            <div class="projects-admin-grid">
                <% 
                   const favActivities = activities.filter(a => favorites.includes(a.id));
                   if(favActivities.length === 0) { 
                %>
                    <p style="color: var(--text-muted); font-size: 1.1rem; text-align: center; margin-top: 30px;">Você ainda não favoritou nenhuma atividade. Volte ao portal e clique no coração ❤️!</p>
                <% } else {
                   favActivities.forEach(activity => { 
                %>
                    <div class="project-admin-card glass-panel" style="padding: 20px; border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <!-- Capa da Atividade -->
                            <div style="position: relative; width: 100%; height: 140px; border-radius: 12px; overflow: hidden; background: linear-gradient(135deg, #f8fafc, #e2e8f0); margin-bottom: 14px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center;">
                                <img src="<%= activity.icon_url || '/img/robot-icon-192.png' %>" alt="<%= activity.title %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/img/robot-icon-192.png'; this.style.objectFit='contain'; this.style.padding='20px';">
                                <span style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); color: #fbbf24; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800;">
                                    ❤️ Favorito
                                </span>
                            </div>

                            <h3 style="color: var(--accent); margin: 0 0 6px 0; font-size: 1.15rem; line-height: 1.3;">
                                <a href="/qr/<%= activity.id %>" target="_blank" style="text-decoration: none; color: inherit;"><%= activity.title %> 🔗</a>
                            </h3>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px;">
                                <span style="background: rgba(37,99,235,0.1); color: #2563eb; padding: 3px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 700;">
                                    📚 <%= activity.subject %>
                                </span>
                                <% if (activity.bncc_code) { %>
                                    <span style="background: rgba(16,185,129,0.1); color: #059669; padding: 3px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 700;">
                                        🎯 BNCC: <%= activity.bncc_code %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div>
                            <!-- Botões de Ação Rápida: Projetar / QR Code + WhatsApp -->
                            <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 8px; margin-bottom: 8px;">
                                <button class="btn-submit" onclick="openDatashow('<%= activity.id %>', '<%= activity.title.replace(/'/g, "\\'") %>', '<%= activity.subject %>', '<%= activity.bncc_code || '' %>', '/qr/<%= activity.id %>')" style="background: linear-gradient(135deg, #6366f1, #4f46e5); font-size: 0.85rem; padding: 10px 8px; font-weight: 700;" title="Abrir modo de projeção na lousa com QR Code gigante para alunos">
                                    🖥️ Projetar / QR Code
                                </button>
                                <button class="btn-submit" onclick="openWhatsAppModal('<%= activity.title.replace(/'/g, "\\'") %>', '<%= activity.bncc_code || '' %>', '<%= activity.id %>')" style="background: #25d366; font-size: 0.85rem; padding: 10px 8px; font-weight: 700;" title="Enviar bilhete com link no WhatsApp da turma">
                                    💬 WhatsApp
                                </button>
                            </div>

                            <div style="display: flex; gap: 8px;">
                                <button class="btn-submit" onclick="addToCollectionPrompt('<%= activity.id %>')" style="flex: 1; background: #f8fafc; color: var(--text-main); border: 1px solid var(--border); font-size: 0.82rem; padding: 8px 10px; font-weight: 600;" title="Salvar em Coleção / Pasta">
                                    📂 Salvar Coleção
                                </button>
                                <button class="btn-submit" onclick="scheduleActivityPrompt('<%= activity.id %>')" style="flex: 1; background: #f8fafc; color: var(--text-main); border: 1px solid var(--border); font-size: 0.82rem; padding: 8px 10px; font-weight: 600;" title="Agendar aula no Calendário">
                                    📅 Agendar
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); } %>
            </div>
        </div>

        <!-- COLEÇÕES -->
        <div id="colecoes" class="tab-pane">
            <header class="workspace-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1>📂 Minhas Coleções Temáticas</h1>
                    <p>Organize suas atividades em playlists por bimestre, matéria ou projeto escolar.</p>
                </div>
                <button class="btn-add-main" onclick="createNewCollection()">+ Nova Coleção</button>
            </header>
            <div class="projects-admin-grid">
                <% if(collections.length === 0) { %>
                    <p style="color: var(--text-muted); text-align: center; width: 100%; padding: 40px;">Crie coleções para organizar suas atividades favoritas por tema ou bimestre.</p>
                <% } else { collections.forEach(col => { 
                    const itemCount = (col.items && col.items.length) || 0;
                %>
                    <div class="project-admin-card glass-panel" style="padding: 24px; border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                                <h3 style="color: var(--accent); margin: 0; font-size: 1.3rem;"><%= col.name %></h3>
                                <span style="background: #e0f2fe; color: #0284c7; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 800;">
                                    ⭐ <%= itemCount %> <%= itemCount === 1 ? 'missão' : 'missões' %>
                                </span>
                            </div>
                            <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 6px;">Playlist pedagógica para compartilhar com a turma ou projetar em sequência.</p>
                        </div>
                        <div style="margin-top: 20px; display: flex; gap: 8px;">
                            <button class="btn-submit" onclick="openCollectionModal('<%= col.id %>')" style="flex: 2;">
                                📂 Ver Atividades
                            </button>
                            <a href="/colecao/<%= col.id %>" target="_blank" class="btn-submit" style="background: #10b981; text-decoration: none; display: flex; align-items: center; justify-content: center; padding: 0 14px;" title="Abrir Playlist Pública">
                                🔗 Playlist
                            </a>
                            <button onclick="deleteCollection('<%= col.id %>')" style="background: rgba(255,107,107,0.1); color: #ff6b6b; border: none; padding: 10px 14px; border-radius: 8px; cursor: pointer;" title="Excluir Coleção">
                                🗑️
                            </button>
                        </div>
                    </div>
                <% }); } %>
            </div>
        </div>

        <!-- CALENDÁRIO / PLANEJAMENTO -->
        <div id="calendario" class="tab-pane">
            <header class="workspace-header">
                <h1>📅 Planejamento de Aulas</h1>
                <p>Veja as missões agendadas para suas turmas.</p>
            </header>
            
            <div class="calendar-grid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; margin-top: 20px;">
                <% 
                   const weekDays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
                   weekDays.forEach(day => { 
                %>
                    <div style="text-align: center; font-weight: bold; padding: 10px; background: var(--sidebar-bg); border-radius: 8px; color: var(--text-muted);"><%= day %></div>
                <% }); %>
                <% 
                   // Calendário simplificado para o mês atual
                   const now = new Date();
                   const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
                   for(let i=0; i<daysInMonth; i++) { 
                     const d = (i+1).toString().padStart(2, '0');
                     const m = (now.getMonth()+1).toString().padStart(2, '0');
                     const dateStr = `${now.getFullYear()}-${m}-${d}`;
                     const items = planning.filter(p => p.planned_date === dateStr);
                %>
                    <div class="calendar-day" style="min-height: 105px; border: 1px solid var(--border); border-radius: 12px; padding: 10px; background: white; display: flex; flex-direction: column;">
                        <span style="font-size: 0.9rem; font-weight: 700; color: <%= items.length > 0 ? 'var(--accent)' : 'var(--text-muted)' %>;"><%= i+1 %></span>
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 4px; margin-top: 5px;">
                            <% items.forEach(item => { %>
                                <div style="font-size: 0.72rem; background: var(--accent); color: white; padding: 4px 6px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 4px;" title="<%= item.activity_title %>">
                                    <a href="/qr/<%= item.activity_id %>" target="_blank" style="color: white; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; font-weight: 600;">
                                        🚀 <%= item.activity_title %>
                                    </a>
                                    <button onclick="deletePlanningItem('<%= item.id %>')" style="background: none; border: none; color: #fca5a5; cursor: pointer; padding: 0; font-size: 0.75rem; font-weight: bold; line-height: 1;" title="Remover da agenda">✕</button>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- MINHAS ATIVIDADES -->
        <div id="minhas-aulas" class="tab-pane">
            <header class="workspace-header">
                <h1>💡 Minhas Atividades Criadas</h1>
                <p>Cadastre suas próprias atividades, use na sala de aula e compartilhe no portal.</p>
                <button class="btn-add-main" onclick="toggleForm('add-lesson-form')">+ Nova Atividade</button>
            </header>

            <div id="add-lesson-form" class="admin-card-new glass-panel" style="display:none; margin-bottom: 30px;">
                <h2>Cadastrar Nova Atividade Pedagógica</h2>
                <form onsubmit="addTeacherActivity(event)" class="form-grid">
                    <div class="input-group">
                        <label>Título da Atividade</label>
                        <input type="text" name="title" required placeholder="Ex: Jogo da Memória de Frações">
                    </div>
                    <div class="input-group">
                        <label>URL / Link da Atividade (Jogo, Simulação ou Formulário)</label>
                        <input type="url" name="activity_url" required placeholder="https://exemplo.com/jogo">
                    </div>
                    <div class="input-group">
                        <label>Disciplina</label>
                        <input type="text" name="subject" placeholder="Ex: Matemática, Robótica, Português...">
                    </div>
                    <div class="input-group">
                        <label>Habilidade BNCC (Opcional)</label>
                        <input type="text" name="bncc_code" placeholder="Ex: EF04MA03">
                    </div>
                    <div class="input-group" style="grid-column: 1 / -1;">
                        <label>URL da Imagem de Capa (Opcional)</label>
                        <input type="url" name="icon_url" placeholder="https://exemplo.com/capa.png">
                    </div>

                    <!-- Pergunta sobre inclusão no catálogo do site com crédito de autoria -->
                    <div style="grid-column: 1 / -1; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px; padding: 18px; margin: 10px 0;">
                        <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; color: #166534; font-size: 0.95rem; font-weight: 600;">
                            <input type="checkbox" name="submit_public" value="true" style="width: 22px; height: 22px; margin-top: 2px; accent-color: #16a34a; flex-shrink: 0;">
                            <div>
                                <span style="font-size: 1rem; color: #14532d;">🚀 <strong>Autorizo adicionar esta atividade ao catálogo público do Lab Kids (após aprovação)</strong></span>
                                <p style="font-weight: 400; color: #15803d; margin: 6px 0 0; font-size: 0.88rem; line-height: 1.45;">
                                    Caso esta atividade seja autoral, seu nome receberá os devidos créditos de autoria como criador(a) em destaque no portal após ser revisada e aprovada pela nossa equipe pedagógica!
                                </p>
                            </div>
                        </label>
                    </div>

                    <button type="submit" class="btn-submit" style="grid-column: 1 / -1; padding: 14px; font-size: 1rem;">
                        Salvar Minha Atividade ✨
                    </button>
                </form>
            </div>

            <div class="projects-admin-grid">
                <% 
                   const myActivities = activities.filter(a => a.teacher_id === teacher.id);
                   if(myActivities.length === 0) { 
                %>
                    <p style="color: var(--text-muted); font-size: 1.05rem; padding: 25px 0; text-align: center; width: 100%;">
                        Você ainda não cadastrou nenhuma atividade própria. Clique em <strong>+ Nova Atividade</strong> acima para começar!
                    </p>
                <% } else {
                   myActivities.forEach(activity => { 
                %>
                    <div class="project-admin-card glass-panel" style="padding: 20px; border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <!-- Capa se existir -->
                            <% if (activity.icon_url) { %>
                                <div style="width: 100%; height: 130px; border-radius: 12px; overflow: hidden; margin-bottom: 12px; background: #f8fafc; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);">
                                    <img src="<%= activity.icon_url %>" alt="<%= activity.title %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/img/robot-icon-192.png'; this.style.objectFit='contain'; this.style.padding='16px';">
                                </div>
                            <% } %>

                            <h3 style="color: var(--accent); margin: 0 0 6px 0; font-size: 1.15rem; line-height: 1.3;"><%= activity.title %></h3>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px;">
                                <span class="badge" style="background: <%= activity.status === 'public' ? '#dcfce7' : (activity.status === 'pending' ? '#fef9c3' : '#f1f5f9') %>; color: #1e293b; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 700;">
                                    <%= activity.status === 'public' ? '✓ Pública no Catálogo' : (activity.status === 'pending' ? '⏳ Em Análise' : '🔒 Privada (Somente sua)') %>
                                </span>
                                <% if (activity.subject) { %>
                                    <span style="background: rgba(37,99,235,0.1); color: #2563eb; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 700;">
                                        📚 <%= activity.subject %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div>
                            <!-- Botões de Ação: Testar / Abrir + Projetar / QR -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                                <a href="<%= activity.activity_url %>" target="_blank" class="btn-submit" style="text-align: center; text-decoration: none; background: #0284c7; font-size: 0.85rem; padding: 10px 8px; font-weight: 700;" title="Abrir e testar o jogo agora">
                                    ▶️ Testar / Abrir
                                </a>
                                <button class="btn-submit" onclick="openDatashow('<%= activity.id %>', '<%= activity.title.replace(/'/g, "\\'") %>', '<%= activity.subject || '' %>', '<%= activity.bncc_code || '' %>', '/qr/<%= activity.id %>')" style="background: linear-gradient(135deg, #6366f1, #4f46e5); font-size: 0.85rem; padding: 10px 8px; font-weight: 700;" title="Projetar na lousa com QR Code gigante para alunos">
                                    🖥️ Projetar / QR
                                </button>
                            </div>

                            <div style="display: flex; gap: 8px;">
                                <% if (activity.status === 'private') { %>
                                    <button class="btn-submit" onclick="requestPublic('<%= activity.id %>')" style="flex: 1; background: #16a34a; font-size: 0.82rem; padding: 8px 10px; font-weight: 700;" title="Sugerir inclusão no site com seus créditos de autoria">
                                        🚀 Sugerir p/ Site
                                    </button>
                                <% } %>
                                <button class="btn-submit" onclick="scheduleActivityPrompt('<%= activity.id %>')" style="flex: 1; background: #f8fafc; color: var(--text-main); border: 1px solid var(--border); font-size: 0.82rem; padding: 8px 10px; font-weight: 600;" title="Agendar aula no Calendário">
                                    📅 Agendar
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); } %>
            </div>
        </div>

        <!-- MINHAS TURMAS -->
        <div id="turmas" class="tab-pane">
            <header class="workspace-header">
                <h1>🏫 Minhas Turmas</h1>
                <button class="btn-add-main" onclick="toggleForm('add-class-form')">+ Nova Turma</button>
            </header>

            <div id="add-class-form" class="admin-card-new glass-panel" style="display:none; margin-bottom: 20px;">
                <h2>Cadastrar Turma</h2>
                <form onsubmit="addClass(event)" class="form-grid">
                    <div class="input-group">
                        <label>Nome da Escola</label>
                        <input type="text" id="schoolName" required>
                    </div>
                    <div class="input-group">
                        <label>Turma (Ex: 9º Ano A)</label>
                        <input type="text" id="className" required>
                    </div>
                    <button type="submit" class="btn-submit">Salvar Turma</button>
                </form>
            </div>

            <div class="classes-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
                <% if(classes.length === 0) { %>
                    <div class="glass-panel" style="grid-column: 1 / -1; text-align: center; padding: 40px 20px; border-radius: 16px;">
                        <span style="font-size: 3rem;">🏫</span>
                        <h3 style="color: var(--text-main); margin: 10px 0;">Nenhuma turma cadastrada ainda</h3>
                        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 15px auto;">Clique no botão "+ Nova Turma" acima para cadastrar sua primeira turma e gerar o código de acesso dos seus alunos!</p>
                    </div>
                <% } else { classes.forEach(c => { 
                    const code = c.access_code || ('LK' + c.id);
                    const inviteUrl = 'https://labkids.online/aluno?turma=' + code;
                %>
                    <div class="class-card glass-panel" style="padding: 22px; border: 1.5px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; box-shadow: 0 6px 20px rgba(0,0,0,0.04);">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div>
                                    <h3 style="color: var(--text-main); margin: 0 0 4px 0; font-size: 1.25rem;"><%= c.class_name %></h3>
                                    <p style="color: var(--text-muted); margin: 0; font-size: 0.92rem;">🏫 <%= c.school_name %></p>
                                </div>
                                <button onclick="deleteClass('<%= c.id %>')" class="btn-delete-small" style="background: rgba(255,107,107,0.1); color: #ff6b6b; border: none; padding: 6px 12px; border-radius: 8px; cursor: pointer; font-size: 0.85rem;" title="Remover Turma">🗑️</button>
                            </div>

                            <!-- Badge Destaque Código de Acesso -->
                            <div style="background: #eff6ff; border: 2px dashed #3b82f6; border-radius: 14px; padding: 12px; margin: 15px 0 10px 0; text-align: center;">
                                <div style="font-size: 0.75rem; font-weight: 800; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">🔑 Código da Turma (Alunos)</div>
                                <div style="font-size: 2rem; font-weight: 900; color: #1d4ed8; letter-spacing: 3px; font-family: monospace;"><%= code %></div>
                                <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Alunos entram em: <strong style="color: #2563eb;">labkids.online/aluno</strong></div>
                            </div>
                        </div>

                        <!-- Botões de Ação para o Professor -->
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <button onclick="copyClassCode('<%= code %>')" class="btn-submit" style="background: #3b82f6; font-size: 0.82rem; padding: 9px 8px; margin: 0; font-weight: 700; border-radius: 10px;" title="Copiar código para enviar aos alunos ou pais">
                                    📋 Copiar Código
                                </button>
                                <button onclick="copyClassLink('<%= inviteUrl %>')" class="btn-submit" style="background: #10b981; font-size: 0.82rem; padding: 9px 8px; margin: 0; font-weight: 700; border-radius: 10px;" title="Copiar link direto para os alunos entrarem sem digitar código">
                                    🔗 Link Direto
                                </button>
                            </div>
                            <button onclick="openClassProjector('<%= code %>', '<%= c.class_name.replace(/'/g, "\\'") %>', '<%= c.school_name.replace(/'/g, "\\'") %>', '<%= inviteUrl %>')" class="btn-submit" style="background: linear-gradient(135deg, #6366f1, #4f46e5); font-size: 0.88rem; padding: 11px; margin: 0; font-weight: 800; border-radius: 10px;" title="Projetar na lousa digital / Datashow com QR Code gigante para toda a turma conectar">
                                📽️ Projetar para Alunos (Datashow / QR) 🚀
                            </button>
                        </div>
                    </div>
                <% }); } %>
            </div>
        </div>

        <!-- PROVAS E AVALIAÇÕES -->
        <div id="provas" class="tab-pane">
            <header class="workspace-header">
                <h1>📝 Banco de Provas e Avaliações</h1>
                <p>Acesse o banco de provas global da rede ou crie as suas.</p>
            </header>

            <h2 style="margin-bottom: 15px; color: var(--dark);">🌐 Provas da Rede (Global)</h2>
            <div class="projects-admin-grid">
                <% if(globalExams.length === 0) { %>
                    <p style="color: #888;">Nenhuma prova global disponível no momento.</p>
                <% } else { globalExams.forEach(exam => { %>
                    <div class="project-admin-card glass-panel" style="padding: 20px; border-left: 4px solid var(--accent);">
                        <h3 style="color: var(--accent);"><%= exam.title %></h3>
                        <p style="color: #aaa; margin: 5px 0;"><%= exam.subject %></p>
                        <a href="<%= exam.pdf_url %>" target="_blank" class="btn-submit" style="display: block; text-align: center; margin-top: 15px; background: transparent; border: 1px solid var(--accent); color: var(--accent);">📄 Ver PDF</a>
                    </div>
                <% }); } %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin: 40px 0 15px 0;">
                <h2 style="margin: 0; color: var(--dark);">Minhas Provas Personalizadas</h2>
                <button class="btn-add-main" onclick="toggleForm('add-exam-form')" style="margin: 0;">+ Criar Prova</button>
            </div>

            <div id="add-exam-form" class="admin-card-new glass-panel" style="display:none; margin-bottom: 30px;">
                <h2>Criar Nova Prova</h2>
                <form onsubmit="addTeacherExam(event)" class="form-grid" style="grid-template-columns: 1fr;">
                    <div class="input-group">
                        <label>Título da Prova</label>
                        <input type="text" name="title" placeholder="Ex: Prova Mensal de História" required>
                    </div>
                    <div class="input-group">
                        <label>Quantidade de Questões</label>
                        <select name="num_questions" required>
                            <option value="5">5 Questões</option>
                            <option value="10" selected>10 Questões</option>
                            <option value="15">15 Questões</option>
                            <option value="20">20 Questões</option>
                            <option value="30">30 Questões</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Como deseja fornecer o PDF?</label>
                        <div style="display: flex; gap: 20px; margin-bottom: 10px;">
                            <label style="font-weight: normal; cursor: pointer;"><input type="radio" name="pdf_source" value="upload" checked onclick="togglePdfSource('upload')"> Enviar arquivo PDF</label>
                            <label style="font-weight: normal; cursor: pointer;"><input type="radio" name="pdf_source" value="url" onclick="togglePdfSource('url')"> Inserir link/URL do PDF</label>
                        </div>
                    </div>
                    <div class="input-group" id="pdf-file-group">
                        <label>Arquivo PDF (max. 10MB)</label>
                        <input type="file" id="pdf_file" accept="application/pdf">
                    </div>
                    <div class="input-group" id="pdf-url-group" style="display: none;">
                        <label>URL/Link do PDF</label>
                        <input type="url" name="pdf_url" placeholder="https://exemplo.com/prova.pdf">
                    </div>
                    <button type="submit" class="btn-submit" style="margin-top: 15px;">Criar Prova 🚀</button>
                </form>
            </div>

            <div class="projects-admin-grid">
                 <% if (exams.length === 0) { %>
                    <p style="color: var(--text-muted); width: 100%; text-align: center; padding: 20px;">Você ainda não criou nenhuma prova. Clique em "+ Criar Prova" acima!</p>
                 <% } %>
                 <% exams.forEach(exam => { %>
                    <div class="project-admin-card glass-panel" style="padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <h3 style="color: var(--accent); margin-top: 0;"><%= exam.title %></h3>
                            <p style="color: var(--text-muted); margin: 5px 0;">Qtd. Questões: <strong><%= exam.num_questions || 10 %></strong></p>
                            <p style="color: var(--text-muted); margin: 5px 0;">Cód. Acesso: <strong style="font-size: 1.2rem; color: var(--accent);"><%= exam.access_code %></strong></p>
                        </div>
                        <div style="margin-top: 15px; display: flex; flex-direction: column; gap: 8px;">
                            <a href="<%= exam.pdf_url %>" target="_blank" class="btn-submit" style="text-align: center; background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 8px 12px; font-size: 0.9rem; text-decoration: none;">📄 Ver PDF</a>
                            <button class="btn-submit" onclick="viewSubmissions('<%= exam.id %>', '<%= exam.title %>')" style="padding: 8px 12px; font-size: 0.9rem;">👁️ Ver Respostas</button>
                            <button class="btn-submit" onclick="deleteExam('<%= exam.id %>')" style="background: #ff6b6b; padding: 8px 12px; font-size: 0.9rem;">🗑️ Excluir Prova</button>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- ANALYTICS -->
        <div id="analytics" class="tab-pane">
            <header class="workspace-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1>📊 Painel de Desempenho & Relatórios</h1>
                    <p>Acompanhe o engajamento das suas turmas e o retorno das avaliações digitais.</p>
                </div>
                <a href="/api/teacher/export" class="btn-submit" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: #0284c7;">
                    📥 Exportar Acervo Completo (CSV)
                </a>
            </header>

            <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <div class="stat-card-new glass-panel">
                    <div class="stat-icon" style="background: rgba(37, 99, 235, 0.1); color: #2563eb; font-size: 2rem;">❤️</div>
                    <div class="stat-data">
                        <span class="label">Atividades Salvas</span>
                        <span class="value"><%= favActivities.length %></span>
                    </div>
                </div>
                <div class="stat-card-new glass-panel">
                    <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981; font-size: 2rem;">🏫</div>
                    <div class="stat-data">
                        <span class="label">Turmas Atendidas</span>
                        <span class="value"><%= classes.length %></span>
                    </div>
                </div>
                <div class="stat-card-new glass-panel">
                    <div class="stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; font-size: 2rem;">📝</div>
                    <div class="stat-data">
                        <span class="label">Provas no Banco</span>
                        <span class="value"><%= exams.length %></span>
                    </div>
                </div>
                <div class="stat-card-new glass-panel">
                    <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; font-size: 2rem;">👩‍🎓</div>
                    <div class="stat-data">
                        <span class="label">Respostas Recebidas</span>
                        <span class="value"><%= examSubmissions.length %></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================================
                 CONTROLE INTERNO: GESTÃO DE TABLETS DA SALA (ENCERRAR AULA)
                 ============================================================================ -->
            <div class="glass-panel" style="margin-bottom: 25px; padding: 20px 24px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 2px solid #3b82f6;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h3 style="margin: 0 0 4px 0; color: #1e3a8a; font-size: 1.25rem; font-weight: 900; display: flex; align-items: center; gap: 8px;">
                            <span>🚪</span> Gestão de Tablets da Sala (Fim da Aula)
                        </h3>
                        <p style="margin: 0; color: #475569; font-size: 0.95rem; font-weight: 600;">Ao soar o sinal do recreio ou fim da aula, encerre a sessão para deslogar todos os tablets da sala em 1 clique.</p>
                    </div>
                    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <select id="select-class-end-session" style="padding: 10px 14px; border-radius: 12px; border: 1.5px solid #3b82f6; font-weight: 700; background: #ffffff; color: #1e3a8a;">
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.name %> (<%= c.access_code %>)</option>
                            <% }); %>
                        </select>
                        <button onclick="endClassSession()" class="btn-submit" style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none; font-weight: 900; padding: 12px 22px; border-radius: 50px; color: white; cursor: pointer; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);">
                            🚪 Deslogar Todos os Tablets
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============================================================================
                 CONTROLE INTERNO: ALUNOS LOGADOS, PONTOS E TEMPO DE ESTUDO
                 ============================================================================ -->
            <div class="glass-panel" style="margin-bottom: 30px; padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <h2 style="margin: 0 0 4px 0; color: var(--accent); display: flex; align-items: center; gap: 10px; font-size: 1.35rem;">
                            👥 Alunos Conectados, Pontuação & Tempo de Estudo
                        </h2>
                        <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">Relatório em tempo real de presença, foco nos estudos e pontuação acumulada.</p>
                    </div>
                    <span style="font-size: 0.85rem; background: #e0f2fe; color: #0284c7; padding: 6px 14px; border-radius: 50px; font-weight: 800;">
                        <%= (typeof studentsActivity !== 'undefined' ? studentsActivity.length : 0) %> Alunos Monitorados
                    </span>
                </div>

                <% if (typeof studentsActivity === 'undefined' || studentsActivity.length === 0) { %>
                    <p style="color: var(--text-muted); padding: 20px 0; text-align: center;">Nenhum aluno registrou acesso recente nesta turma ainda. Os dados aparecerão assim que os alunos entrarem com o código.</p>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border); text-align: left; color: var(--text-muted);">
                                    <th style="padding: 12px;">Aluno</th>
                                    <th style="padding: 12px;">Turma</th>
                                    <th style="padding: 12px; text-align: center;">Status</th>
                                    <th style="padding: 12px; text-align: center;">Pontos (XP)</th>
                                    <th style="padding: 12px; text-align: center;">Tempo Ativo</th>
                                    <th style="padding: 12px;">Última Atividade</th>
                                    <th style="padding: 12px; text-align: center;">PIN / Segurança</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% studentsActivity.forEach(st => { 
                                    const mins = Number(st.active_minutes || 0);
                                    let tempoFormatado = mins < 60 ? (mins + ' min') : (Math.floor(mins/60) + 'h ' + (mins%60) + 'min');
                                    if (mins === 0) tempoFormatado = 'Iniciando';

                                    // Determina se esteve ativo nas últimas 2 horas
                                    let isRecent = false;
                                    if (st.last_active_at) {
                                        const diffMs = Date.now() - new Date(st.last_active_at).getTime();
                                        isRecent = diffMs < (2 * 60 * 60 * 1000);
                                    }
                                %>
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 12px; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                                            <span style="font-size: 1.4rem;">👤</span>
                                            <span><%= st.name %></span>
                                        </td>
                                        <td style="padding: 12px; color: var(--text-muted);">
                                            <%= st.turma_nome || st.class || 'Livre' %>
                                        </td>
                                        <td style="padding: 12px; text-align: center;">
                                            <% if (isRecent) { %>
                                                <span style="background: #dcfce7; color: #15803d; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 4px;">
                                                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #16a34a; display: inline-block;"></span> Ativo Hoje
                                                </span>
                                            <% } else { %>
                                                <span style="background: #f1f5f9; color: #64748b; padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.75rem;">
                                                    Offline
                                                </span>
                                            <% } %>
                                        </td>
                                        <td style="padding: 12px; text-align: center; font-weight: 900; color: #2563eb;">
                                            ⭐ <%= st.points || 0 %> XP
                                        </td>
                                        <td style="padding: 12px; text-align: center; font-weight: 800; color: #059669;">
                                            ⏱️ <%= tempoFormatado %>
                                        </td>
                                        <td style="padding: 12px; color: var(--text-muted); font-size: 0.85rem;">
                                            <%= st.last_active_at ? new Date(st.last_active_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : (st.last_login_date || '—') %>
                                        </td>
                                        <td style="padding: 12px; text-align: center;">
                                            <% if (st.student_pin) { %>
                                                <button onclick="resetStudentPin('<%= st.id %>', '<%= st.name.replace(/'/g, "\\'") %>')" 
                                                        style="background: #fef2f2; border: 1.5px solid #fecaca; color: #dc2626; padding: 4px 10px; border-radius: 12px; font-weight: 800; font-size: 0.75rem; cursor: pointer;">
                                                    🔑 Resetar PIN
                                                </button>
                                            <% } else { %>
                                                <span style="color: #94a3b8; font-size: 0.8rem;">Sem PIN</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <!-- ============================================================================
                 CONTROLE INTERNO: TOP 10 ATIVIDADES MAIS UTILIZADAS
                 ============================================================================ -->
            <div class="glass-panel" style="margin-bottom: 30px; padding: 24px;">
                <h2 style="margin-top: 0; color: var(--accent); display: flex; align-items: center; gap: 10px; font-size: 1.35rem;">
                    🔥 Atividades & Jogos Mais Utilizados de Modo Geral
                </h2>
                <p style="margin: 0 0 16px 0; color: var(--text-muted); font-size: 0.9rem;">Ranking dos desafios pedagógicos com maior engajamento dos estudantes na plataforma.</p>

                <% if (typeof topActivities !== 'undefined' && topActivities.length > 0) { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border); text-align: left; color: var(--text-muted);">
                                    <th style="padding: 12px; width: 50px;">#</th>
                                    <th style="padding: 12px;">Atividade / Jogo</th>
                                    <th style="padding: 12px;">Disciplina / BNCC</th>
                                    <th style="padding: 12px; text-align: center;">Ano Escolar</th>
                                    <th style="padding: 12px; text-align: center;">Acessos / Visitas</th>
                                    <th style="padding: 12px; text-align: center;">Projeção</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topActivities.forEach((act, idx) => { %>
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 12px; font-weight: 900; color: #b45309;">
                                            <% if (idx === 0) { %>🥇 1º<% } else if (idx === 1) { %>🥈 2º<% } else if (idx === 2) { %>🥉 3º<% } else { %><%= idx + 1 %>º<% } %>
                                        </td>
                                        <td style="padding: 12px; font-weight: 800; color: var(--text-main);">
                                            🎮 <%= act.title %>
                                        </td>
                                        <td style="padding: 12px; color: var(--text-muted);">
                                            <%= act.subject || 'Geral' %> • <span style="font-family: monospace; font-size: 0.8rem; background: #f1f5f9; padding: 2px 6px; border-radius: 4px;"><%= act.bncc_code || 'Cultura Digital' %></span>
                                        </td>
                                        <td style="padding: 12px; text-align: center; color: var(--text-muted);">
                                            <%= act.level || '1º ao 5º' %>
                                        </td>
                                        <td style="padding: 12px; text-align: center; font-weight: 900; color: #0284c7;">
                                            👁️ <%= act.visits || 0 %>
                                        </td>
                                        <td style="padding: 12px; text-align: center;">
                                            <a href="<%= act.activity_url %>" target="_blank" class="btn-submit" style="font-size: 0.8rem; padding: 6px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                                                🚀 Abrir / Projetar
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p style="color: var(--text-muted);">Nenhum registro de atividades no ranking ainda.</p>
                <% } %>
            </div>

            <!-- Diagnóstico de Provas Digitais -->
            <div class="glass-panel" style="margin-bottom: 30px; padding: 24px;">
                <h2 style="margin-top: 0; color: var(--accent); display: flex; align-items: center; gap: 10px;">
                    📝 Diagnóstico de Avaliações Digitais
                </h2>
                <% if (exams.length === 0) { %>
                    <p style="color: var(--text-muted); padding: 20px 0;">Você ainda não criou nenhuma avaliação digital. Acesse a aba <strong>Provas</strong> para cadastrar a primeira com código de acesso.</p>
                <% } else { %>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 15px;">
                        <% exams.forEach(exam => { 
                            const subsCount = examSubmissions.filter(s => s.exam_id === exam.id).length;
                        %>
                            <div style="border: 1px solid var(--border); border-radius: 12px; padding: 18px; background: #fafafa;">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                                    <h4 style="margin: 0; color: var(--text-main); font-size: 1.1rem;"><%= exam.title %></h4>
                                    <span style="background: #e0e7ff; color: #4338ca; padding: 3px 10px; border-radius: 20px; font-weight: 800; font-size: 0.8rem; font-family: monospace;">
                                        <%= exam.access_code %>
                                    </span>
                                </div>
                                <p style="color: var(--text-muted); font-size: 0.9rem; margin: 6px 0;">
                                    Total de Questões: <strong><%= exam.num_questions || 10 %></strong>
                                </p>
                                <div style="margin: 12px 0;">
                                    <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 5px;">
                                        <span>Participação da Turma</span>
                                        <strong><%= subsCount %> <%= subsCount === 1 ? 'resposta' : 'respostas' %></strong>
                                    </div>
                                    <div style="width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden;">
                                        <div style="width: <%= Math.min(subsCount * 10, 100) %>%; height: 100%; background: #10b981; border-radius: 4px;"></div>
                                    </div>
                                </div>
                                <button class="btn-submit" onclick="viewSubmissions('<%= exam.id %>', '<%= exam.title.replace(/'/g, "\\'") %>')" style="width: 100%; font-size: 0.85rem; padding: 8px 12px; margin-top: 8px;">
                                    👁️ Ver Respostas Detalhadas
                                </button>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Últimas Respostas de Alunos -->
            <div class="glass-panel" style="padding: 24px;">
                <h2 style="margin-top: 0; color: var(--accent); display: flex; align-items: center; gap: 10px;">
                    ⚡ Últimas Submissões de Alunos (Tempo Real)
                </h2>
                <% if (examSubmissions.length === 0) { %>
                    <p style="color: var(--text-muted); padding: 20px 0;">Nenhuma resposta enviada ainda pelos alunos. Quando os alunos responderem pelo código de acesso, o feed aparecerá aqui automaticamente.</p>
                <% } else { %>
                    <div style="overflow-x: auto; margin-top: 15px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border); text-align: left; color: var(--text-muted);">
                                    <th style="padding: 12px;">Aluno</th>
                                    <th style="padding: 12px;">Avaliação</th>
                                    <th style="padding: 12px;">Código</th>
                                    <th style="padding: 12px;">Data & Hora</th>
                                    <th style="padding: 12px; text-align: center;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% examSubmissions.slice(0, 10).forEach(sub => { %>
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 12px; font-weight: 700; color: var(--text-main);">
                                            👩‍🎓 <%= sub.student_name %>
                                        </td>
                                        <td style="padding: 12px; color: var(--text-main);">
                                            <%= sub.title %>
                                        </td>
                                        <td style="padding: 12px; font-family: monospace; font-weight: 800; color: var(--accent);">
                                            <%= sub.access_code %>
                                        </td>
                                        <td style="padding: 12px; color: var(--text-muted); font-size: 0.85rem;">
                                            <% 
                                                const subRaw = String(sub.created_at || '').trim();
                                                const subUtc = (subRaw.includes('T') || subRaw.includes('Z')) 
                                                    ? (subRaw.endsWith('Z') ? subRaw : subRaw + 'Z') 
                                                    : subRaw.replace(' ', 'T') + 'Z';
                                            %>
                                            <%= sub.created_at ? new Date(subUtc).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '-' %>
                                        </td>
                                        <td style="padding: 12px; text-align: center;">
                                            <button class="btn-submit" onclick="viewSubmissions('<%= sub.exam_id %>', '<%= sub.title.replace(/'/g, "\\'") %>')" style="padding: 6px 12px; font-size: 0.8rem;">
                                                Ver
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <!-- SIMULADOS DA REDE MUNICIPAL (PROJETO CAMPOS DE TODOS NÓS) -->
            <div class="glass-panel" style="margin-top: 30px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
                    <div>
                        <h2 style="margin: 0; color: #1e3a8a; display: flex; align-items: center; gap: 10px; font-size: 1.25rem;">
                            📝 Avaliações & Simulados da Rede (Campos de Todos Nós)
                        </h2>
                        <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 0.88rem;">Resultados e submissões registradas com segurança para os alunos da sua escola/turma.</p>
                    </div>
                    <a href="/atividades/simulado-campos-3ano-outubro" target="_blank" class="btn-submit" style="text-decoration: none; padding: 8px 16px; font-size: 0.85rem; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                        ⭐ Abrir Novo Simulado 3º Ano (Outubro)
                    </a>
                </div>

                <% if (typeof simuladoSubmissions === 'undefined' || !simuladoSubmissions || simuladoSubmissions.length === 0) { %>
                    <p style="color: var(--text-muted); padding: 15px 0;">Nenhuma resposta de simulado registrada ainda para a sua escola. Conforme os alunos realizarem os simulados digitais, eles aparecerão aqui com nota automática.</p>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border); text-align: left; color: var(--text-muted);">
                                    <th style="padding: 10px;">Estudante</th>
                                    <th style="padding: 10px;">Turma / Turno</th>
                                    <th style="padding: 10px;">Simulado</th>
                                    <th style="padding: 10px; text-align: center;">Acertos</th>
                                    <th style="padding: 10px; text-align: center;">Nota (0 a 10)</th>
                                    <th style="padding: 10px;">Data & Hora</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% simuladoSubmissions.slice(0, 15).forEach(sub => { 
                                    const maxScore = Number(sub.max_score) || 10;
                                    const nota10 = ((Number(sub.score || 0) / maxScore) * 10).toFixed(1);
                                %>
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 10px; font-weight: 700; color: var(--text-main);">
                                            👧👦 <%= sub.student_name %>
                                        </td>
                                        <td style="padding: 10px; color: var(--text-main); font-size: 0.88rem;">
                                            <strong><%= sub.class_name %></strong> (<%= sub.shift || 'Manhã' %>)
                                        </td>
                                        <td style="padding: 10px; font-size: 0.85rem; color: #0369a1; font-weight: 700;">
                                            <%= sub.simulado_id %>
                                        </td>
                                        <td style="padding: 10px; text-align: center; font-weight: 800; color: #10b981;">
                                            <%= sub.score %> / <%= sub.max_score %>
                                        </td>
                                        <td style="padding: 10px; text-align: center;">
                                            <span style="background: <%= Number(nota10) >= 6 ? '#dcfce7' : '#fee2e2' %>; color: <%= Number(nota10) >= 6 ? '#15803d' : '#b91c1c' %>; padding: 3px 8px; border-radius: 6px; font-weight: 800; font-size: 0.85rem;">
                                                <%= nota10 %>
                                            </span>
                                        </td>
                                        <td style="padding: 10px; color: var(--text-muted); font-size: 0.82rem;">
                                            <%= sub.created_at ? new Date(sub.created_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '-' %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- LIVROS E MATERIAIS PARCEIROS (ITEM 13 - EXCLUSIVO PARA O PROFESSOR) -->
        <div id="livros-parceiros" class="tab-pane">

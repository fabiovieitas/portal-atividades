        }

        async function removeItemFromCollection(colId, activityId) {
            if (!confirm('Deseja remover esta atividade da coleção?')) return;
            const res = await fetch('/api/teacher/collections/remove-item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ collection_id: colId, activity_id: activityId })
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Erro ao remover: ' + (data.error || 'Erro desconhecido'));
            }
        }

        async function deleteCollection(colId) {
            if (!confirm('Deseja realmente excluir esta coleção? As atividades não serão apagadas, apenas a pasta.')) return;
            const res = await fetch('/api/teacher/collections/delete/' + colId, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Erro ao excluir: ' + (data.error || 'Erro desconhecido'));
            }
        }

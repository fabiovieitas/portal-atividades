            <div style="margin-bottom: 15px;">
                <label style="font-weight: 700; color: var(--text-main); font-size: 0.9rem; display: block; margin-bottom: 6px;">Modelo do Recado:</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                    <label style="border: 1px solid var(--border); border-radius: 8px; padding: 10px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                        <input type="radio" name="wa_template" value="1" checked onchange="updateWhatsAppPreview()"> 🎮 Tarefa / Prática da Semana
                    </label>
                    <label style="border: 1px solid var(--border); border-radius: 8px; padding: 10px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                        <input type="radio" name="wa_template" value="2" onchange="updateWhatsAppPreview()"> 🌟 Parceria Família & Escola
                    </label>
                </div>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="font-weight: 700; color: var(--text-main); font-size: 0.9rem; display: block; margin-bottom: 6px;">Prévia da Mensagem (Editável):</label>
                <textarea id="wa-preview" rows="8" style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 12px; font-family: sans-serif; font-size: 0.95rem; line-height: 1.5; background: #f8fafc; color: #1e293b;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
                <button onclick="closeWhatsAppModal()" class="btn-submit" style="background: transparent; color: var(--text-muted); border: 1px solid var(--border);">Cancelar</button>
                <button onclick="copyWhatsAppMessage()" class="btn-submit" style="background: #0284c7;">📋 Copiar Recado</button>
                <button onclick="sendWhatsAppDirect()" class="btn-submit" style="background: #25d366; display: inline-flex; align-items: center; gap: 6px;">
                    <span>🟢</span> Abrir no WhatsApp
                </button>
            </div>
        </div>
    </div>

    <!-- COLEÇÃO DETALHES MODAL -->
    <div id="collection-modal" class="modal" style="display:none;">
        <div class="modal-content glass-panel" style="background: white; padding: 30px; border-radius: 24px; text-align: left; max-width: 650px; width: 92%; max-height: 85vh; overflow-y: auto;">
            <span class="close" onclick="closeCollectionModal()" style="font-size: 1.8rem; cursor: pointer;">&times;</span>
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                <div>
                    <span class="badge" style="background: #e0f2fe; color: #0284c7; margin-bottom: 6px; display: inline-block;">📂 Coleção Temática</span>
                    <h2 id="modal-col-title" style="margin: 0; color: var(--accent); font-size: 1.5rem;">Nome da Coleção</h2>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button id="modal-col-share" class="btn-submit" style="background: #10b981; padding: 8px 14px; font-size: 0.85rem;" title="Copiar link da playlist">🔗 Copiar Link</button>
                    <button id="modal-col-delete" class="btn-delete-small" style="background: rgba(255,107,107,0.1); color: #ff6b6b; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer;" title="Excluir Coleção">🗑️</button>
                </div>
            </div>

            <div id="modal-col-items" style="margin-top: 20px;">
                <!-- Preenchido dinamicamente por JS -->
            </div>

            <div style="text-align: right; margin-top: 25px;">
                <button onclick="closeCollectionModal()" class="btn-submit">Fechar</button>
            </div>
        </div>
    </div>

    <!-- MODAL DE PROJEÇÃO DA TURMA (DATASHOW / SALA DE AULA) -->
    <div id="class-projector-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(14px); z-index: 999999; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: #1e293b; border: 3px solid #38bdf8; border-radius: 28px; max-width: 820px; width: 100%; padding: 35px 30px; box-shadow: 0 25px 60px rgba(0,0,0,0.8); color: white; text-align: center; position: relative;">
            <button onclick="closeClassProjector()" style="position: absolute; right: 20px; top: 20px; background: rgba(255,255,255,0.1); border: none; color: white; font-size: 1.5rem; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;">✕</button>
            
            <div style="display: inline-block; background: #2563eb; color: white; padding: 6px 18px; border-radius: 50px; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;">
                📽️ PROJEÇÃO NA LOUSA / SALA DE AULA
            </div>
            <h1 id="proj-class-name" style="font-family: 'Fredoka', cursive; font-size: 2.2rem; color: #fbbf24; margin: 0 0 6px 0;">Turma</h1>
            <p id="proj-school-name" style="color: #cbd5e1; font-size: 1.1rem; margin: 0 0 25px 0;">Escola</p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; align-items: center; margin-bottom: 25px;">
                <!-- QR Code Box -->
                <div style="background: white; padding: 22px; border-radius: 20px; display: inline-block; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
                    <div id="class-projector-qr" style="display: inline-block;"></div>
                    <p style="color: #1e293b; font-weight: 800; margin: 12px 0 0 0; font-size: 1.05rem;">
                        📱 Aponte a Câmera para Entrar!
                    </p>
                </div>

                <!-- Giant Code Box -->
                <div style="background: rgba(15, 23, 42, 0.7); border: 2px dashed #38bdf8; border-radius: 20px; padding: 25px; text-align: center;">
                    <div style="font-size: 0.95rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 8px;">Ou no tablet/computador acesse:</div>
                    <div style="font-size: 1.5rem; font-weight: 900; color: #38bdf8; margin-bottom: 12px;">labkids.online/aluno</div>
                    <div style="font-size: 0.85rem; color: #cbd5e1; margin-bottom: 6px;">E digite este Código da Turma:</div>
                    <div id="proj-code-display" style="font-size: 3.2rem; font-weight: 900; color: #fbbf24; font-family: monospace; letter-spacing: 4px; background: rgba(0,0,0,0.4); padding: 10px 20px; border-radius: 14px; border: 2px solid #fbbf24; display: inline-block;">LK0000</div>
                </div>
            </div>

            <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                <button onclick="copyProjectorLink()" class="btn-submit" style="background: #10b981; padding: 12px 24px; font-weight: 800;">📋 Copiar Link da Turma</button>
                <button onclick="toggleProjectorFullscreen()" class="btn-submit" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 12px 24px; font-weight: 800;">⛶ Tela Cheia</button>
                <button onclick="closeClassProjector()" class="btn-submit" style="background: transparent; border: 1px solid rgba(255,255,255,0.3); color: #cbd5e1; padding: 12px 24px;">Fechar Projeção</button>
            </div>
        </div>
    </div>

</body>
</html>

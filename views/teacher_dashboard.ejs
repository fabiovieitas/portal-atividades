        // --- COLEÇÕES INTERATIVAS ---
        let activeCollectionId = null;
        function openCollectionModal(colId) {
            activeCollectionId = colId;
            const col = teacherCollections.find(c => c.id === parseInt(colId));
            if (!col) return;
            
            document.getElementById('modal-col-title').innerText = col.name;
            const itemsContainer = document.getElementById('modal-col-items');
            itemsContainer.innerHTML = '';
            
            const items = col.items || [];
            if (items.length === 0) {
                itemsContainer.innerHTML = `

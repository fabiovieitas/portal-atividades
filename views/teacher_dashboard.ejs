        async function addClass(e) {
            e.preventDefault();
            const school = document.getElementById('schoolName').value;
            const cls = document.getElementById('className').value;
            
            const res = await fetch('/api/teacher/classes/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ school_name: school, class_name: cls })
            });
            const data = await res.json();
            if (data.success) location.reload();
        }

        async function deleteClass(id) {
            if (!confirm('Deseja realmente remover esta turma?')) return;
            const res = await fetch('/api/teacher/classes/delete/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) location.reload();
        }

        // Exam Submissions data and handling
        const examSubmissions = <%- JSON.stringify(examSubmissions) %>;

        function togglePdfSource(source) {
            if (source === 'upload') {
                document.getElementById('pdf-file-group').style.display = 'block';
                document.getElementById('pdf-url-group').style.display = 'none';
                document.getElementById('pdf_file').required = true;
                const pdfUrlInput = document.querySelector('input[name="pdf_url"]');
                if (pdfUrlInput) pdfUrlInput.required = false;
            } else {
                document.getElementById('pdf-file-group').style.display = 'none';
                document.getElementById('pdf-url-group').style.display = 'block';
                document.getElementById('pdf_file').required = false;
                const pdfUrlInput = document.querySelector('input[name="pdf_url"]');
                if (pdfUrlInput) pdfUrlInput.required = true;
            }
        }

        async function addTeacherExam(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            if (data.pdf_source === 'upload') {
                const fileInput = document.getElementById('pdf_file');
                const file = fileInput.files[0];
                if (!file) return alert('Por favor, selecione o arquivo PDF.');
                
                const reader = new FileReader();
                reader.onloadend = async () => {
                    const base64String = reader.result.replace('data:', '').replace(/^.+,/, '');
                    const body = {
                        title: data.title,
                        num_questions: data.num_questions,
                        pdf_base64: base64String,
                        pdf_name: file.name,
                        pdf_source: 'upload'
                    };
                    
                    const submitBtn = form.querySelector('button[type="submit"]');
                    submitBtn.innerText = 'Criando Prova... ⏳';
                    submitBtn.disabled = true;
                    
                    try {
                        const res = await fetch('/api/teacher/exams/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(body)
                        });
                        const resData = await res.json();
                        if (resData.success) {
                            location.reload();
                        } else {
                            alert('Erro ao criar prova: ' + resData.error);
                        }
                    } catch (err) {
                        alert('Erro na requisição: ' + err.message);
                    } finally {
                        submitBtn.innerText = 'Criar Prova 🚀';
                        submitBtn.disabled = false;
                    }
                };
                reader.readAsDataURL(file);
            } else {
                const body = {
                    title: data.title,
                    num_questions: data.num_questions,
                    pdf_url: data.pdf_url,
                    pdf_source: 'url'
                };
                
                const submitBtn = form.querySelector('button[type="submit"]');
                submitBtn.innerText = 'Criando Prova... ⏳';
                submitBtn.disabled = true;
                
                try {
                    const res = await fetch('/api/teacher/exams/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    const resData = await res.json();
                    if (resData.success) {
                        location.reload();
                    } else {
                        alert('Erro ao criar prova: ' + resData.error);
                    }
                } catch (err) {
                    alert('Erro na requisição: ' + err.message);
                } finally {
                    submitBtn.innerText = 'Criar Prova 🚀';
                    submitBtn.disabled = false;
                }
            }
        }

        function viewSubmissions(examId, examTitle) {
            document.getElementById('modal-exam-title').innerText = `Respostas: ${examTitle}`;
            const listDiv = document.getElementById('submissions-list');
            listDiv.innerHTML = '';

            const subs = examSubmissions.filter(s => s.exam_id === parseInt(examId));
            if (subs.length === 0) {
                listDiv.innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 20px;">Nenhuma resposta registrada ainda para esta prova.</p>';
            } else {
                let tableHtml = `
                    <div style="overflow-x:auto;">
                        <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                                    <th style="padding: 10px; color: var(--text-main);">Aluno</th>
                                    <th style="padding: 10px; color: var(--text-main);">Data de Envio</th>
                                    <th style="padding: 10px; color: var(--text-main);">Gabarito Respondido</th>
                                    <th style="padding: 10px; color: var(--text-main); text-align: center;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                subs.forEach(s => {
                    const answers = s.answers_json || {};
                    const numQuestions = s.exams?.num_questions || 10;
                    let gabaritoText = [];
                    for (let i = 1; i <= numQuestions; i++) {
                        gabaritoText.push(`${i}:${answers[i] || '-'}`);
                    }
                    
                    const sRaw = String(s.created_at || '').trim();
                    const sUtc = (sRaw.includes('T') || sRaw.includes('Z')) 
                        ? (sRaw.endsWith('Z') ? sRaw : sRaw + 'Z') 
                        : sRaw.replace(' ', 'T') + 'Z';
                    const dateStr = s.created_at ? new Date(sUtc).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '-';
                    
                    tableHtml += `
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 10px; font-weight: bold; color: var(--text-main);">${s.student_name}</td>
                            <td style="padding: 10px; font-size: 0.9rem; color: var(--text-muted);">${dateStr}</td>
                            <td style="padding: 10px; font-size: 0.85rem; font-family: monospace; color: var(--text-main); max-width: 250px; overflow-wrap: break-word;">
                                ${gabaritoText.join(' | ')}
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <button onclick="deleteSubmission('${s.id}')" style="background: none; border: none; color: #ff6b6b; cursor: pointer; font-size: 1.1rem;" title="Remover resposta">🗑️</button>
                            </td>
                        </tr>
                    `;
                });
                
                tableHtml += `
                            </tbody>
                        </table>
                    </div>
                `;
                listDiv.innerHTML = tableHtml;
            }
            
            document.getElementById('submissions-modal').style.display = 'flex';
        }

        function closeSubmissionsModal() {
            document.getElementById('submissions-modal').style.display = 'none';
        }

        async function deleteExam(id) {
            if (!confirm('Deseja realmente excluir esta prova? Todos os gabaritos dos alunos associados serão apagados permanentemente!')) return;
            const res = await fetch(`/api/teacher/exams/delete/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Erro ao excluir: ' + data.error);
            }
        }

        async function deleteSubmission(id) {
            if (!confirm('Deseja realmente apagar esta resposta de aluno?')) return;

        <!-- CONFIGURAÇÕES -->
        <div id="config" class="tab-pane">
            <header class="workspace-header">
                <h1>⚙️ Configurações da Conta</h1>
            </header>

            <div class="admin-card-new glass-panel config-form">
                <h2 style="margin-bottom: 20px;">Alterar Senha</h2>
                <form onsubmit="updatePassword(event)" class="form-grid" style="grid-template-columns: 1fr;">
                    <div class="input-group">
                        <label>Senha Atual</label>
                        <input type="password" id="currentPassword" required>
                    </div>
                    <div class="input-group">
                        <label>Nova Senha</label>
                        <input type="password" id="newPassword" required>
                    </div>
                    <button type="submit" class="btn-submit">Salvar Nova Senha</button>
                    <p id="pwd-msg" style="margin-top: 10px;"></p>
                </form>
            </div>
        </div>
    </main>

    <!-- QR Modal -->
    <div id="qr-modal" class="modal" style="display:none">
        <div class="modal-content glass-panel" style="background: white; padding: 30px; border-radius: 20px; text-align: center; max-width: 400px; border: 1px solid var(--border);">
            <span class="close" onclick="closeQRModal()">&times;</span>
            <h2 id="qr-title" style="color: var(--accent); margin-bottom: 20px;">QR Code</h2>
            <div id="qrcode" style="background: white; padding: 20px; border-radius: 10px; display: inline-block; border: 1px solid #eee;"></div>
            <p style="color: var(--text-muted); margin: 15px 0;">Alunos escaneiam para acessar!</p>
            <button onclick="closeQRModal()" class="btn-submit">Fechar</button>
        </div>
    </div>

    <script>
        function switchTab(id, btn) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            if(btn) btn.classList.add('active');
            localStorage.setItem('teacher_active_tab', id);
        }

        window.onload = () => {
            const activeTab = localStorage.getItem('teacher_active_tab') || 'acervo';
            const btn = Array.from(document.querySelectorAll('.nav-item')).find(b => b.getAttribute('onclick').includes(`'${activeTab}'`));
            switchTab(activeTab, btn);
        }

        function toggleForm(formId) {
            const form = document.getElementById(formId);
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        async function addTeacherActivity(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            data.submit_public = !!e.target.querySelector('[name="submit_public"]:checked');
            
            const res = await fetch('/api/teacher/activities/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok && result.success) {
                if (data.submit_public) {
                    alert('🎉 Atividade cadastrada com sucesso! Ela foi enviada para moderação pedagógica e será publicada no site com seus devidos créditos de autoria assim que aprovada.');
                } else {
                    alert('✨ Atividade criada com sucesso! Ela está salva no seu acervo pessoal para você testar, projetar e agendar com suas turmas.');
                }
                location.reload();
            } else {
                alert('Erro ao salvar atividade: ' + (result.error || 'Erro desconhecido'));
            }
        }

        async function requestPublic(id) {
            if (!confirm('Deseja solicitar que esta atividade seja adicionada ao catálogo público do Lab Kids? Ela passará por moderação pedagógica e você receberá créditos de autoria como criador(a).')) return;
            const res = await fetch(`/api/teacher/activities/request-public/${id}`, { method: 'POST' });
            if (res.ok) {
                alert('🎉 Solicitação enviada com sucesso! Nossa equipe analisará e publicará no portal com seu nome.');
                location.reload();
            } else {
                alert('Erro ao enviar solicitação.');
            }
        }

        async function createNewCollection() {
            const name = prompt('Nome da nova coleção:');
            if(!name) return;
            const res = await fetch('/api/teacher/collections/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            if(res.ok) location.reload();
        }

        async function addToCollectionPrompt(activityId) {
            const res = await fetch('/api/teacher/collections');
            const collections = await res.json();
            if(collections.length === 0) return alert('Crie uma coleção primeiro!');
            
            const colId = prompt('Escolha o ID da coleção:\n' + collections.map(c => `${c.id}: ${c.name}`).join('\n'));
            if(!colId) return;
            
            await fetch('/api/teacher/collections/add-item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ collection_id: colId, activity_id: activityId })
            });
            alert('Adicionado!');
        }

        async function scheduleActivityPrompt(activityId) {
            const date = prompt('Data para a aula (AAAA-MM-DD):', new Date().toISOString().split('T')[0]);
            if(!date) return;
            const res = await fetch('/api/teacher/planning/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ activity_id: activityId, planned_date: date })
            });
            if (res.ok) {
                alert('📅 Atividade agendada com sucesso no calendário da sua turma!');
                location.reload();
            }
        }

        async function deletePlanningItem(id) {
            if(!confirm('Deseja desmarcar esta atividade da sua agenda?')) return;
            const res = await fetch(`/api/teacher/planning/delete/${id}`, { method: 'POST' });
            if(res.ok) location.reload();
        }

        function generateQR(id, title, teacherId) {
            const modal = document.getElementById('qr-modal');
            const qrDiv = document.getElementById('qrcode');
            qrDiv.innerHTML = '';
            document.getElementById('qr-title').innerText = title;
            const redirectUrl = window.location.origin + '/qr/' + id + '?t=' + teacherId;
            new QRCode(qrDiv, { text: redirectUrl, width: 256, height: 256 });
            modal.style.display = 'flex';
        }

        function closeQRModal() { document.getElementById('qr-modal').style.display = 'none'; }

        async function updatePassword(e) {
            e.preventDefault();
            const cp = document.getElementById('currentPassword').value;
            const np = document.getElementById('newPassword').value;
            const msg = document.getElementById('pwd-msg');
            
            const res = await fetch('/api/teacher/password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ currentPassword: cp, newPassword: np })
            });
            const data = await res.json();
            
            if (data.success) {
                msg.style.color = 'var(--success)';
                msg.innerText = 'Senha atualizada com sucesso!';
                e.target.reset();
            } else {
                msg.style.color = '#ff6b6b';
                msg.innerText = data.message || 'Erro ao atualizar senha.';
            }
        }

        
        let currentProjectorUrl = '';
        function copyClassCode(code) {

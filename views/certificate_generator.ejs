<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Certificado de Aluno Destaque | Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        body { background: #0f172a; color: white; font-family: 'Outfit', sans-serif; min-height: 100vh; padding: 20px 10px; margin: 0; }
        .cert-container { max-width: 900px; margin: 0 auto; }
        .cert-card { background: white; color: #1e293b; border-radius: 24px; padding: 40px; border: 12px solid #3b82f6; box-shadow: 0 20px 50px rgba(0,0,0,0.5); position: relative; overflow: hidden; text-align: center; }
        .cert-header { font-family: 'Fredoka', sans-serif; font-size: 2.2rem; color: #1e3a8a; margin-top: 10px; text-transform: uppercase; letter-spacing: 1px; }
        .cert-subtitle { font-size: 1.2rem; color: #475569; margin-bottom: 25px; }
        .student-name-display { font-family: 'Fredoka', sans-serif; font-size: 2.5rem; color: #2563eb; border-bottom: 3px dashed #93c5fd; display: inline-block; padding: 0 30px 5px 30px; margin: 15px 0; }
        .cert-text { font-size: 1.15rem; color: #334155; line-height: 1.7; max-width: 700px; margin: 0 auto 25px auto; }
        .cert-footer-grid { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 30px; padding-top: 20px; border-top: 2px solid #e2e8f0; }
        .btn-print { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 15px 35px; border-radius: 50px; font-weight: 800; font-size: 1.2rem; cursor: pointer; box-shadow: 0 6px 20px rgba(16,185,129,0.4); text-decoration: none; display: inline-flex; align-items: center; gap: 10px; }
        
        @media print {
            body { background: white; padding: 0; }
            .no-print { display: none !important; }
            .cert-card { border-width: 8px; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="cert-container">
        <div class="no-print" style="margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <a href="/" style="color: white; text-decoration: none; font-weight: 700;">⬅️ Voltar ao Portal</a>
            <h2 style="margin: 0; color: #fbbf24; font-family: 'Fredoka', sans-serif;">🏆 Gerador de Certificado Escolar</h2>
            <button onclick="window.print()" class="btn-print">🖨️ IMPRIMIR OU SALVAR EM PDF</button>
        </div>

        <div class="no-print" style="background: rgba(30, 41, 59, 0.9); border: 2px solid #3b82f6; border-radius: 20px; padding: 20px; margin-bottom: 30px;">
            <h4 style="margin-top: 0; color: #60a5fa;">✏️ Preencha os Dados para Gerar o Certificado:</h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <div>
                    <label style="font-size: 0.85rem; color: #94a3b8; display: block;">Nome do Aluno:</label>
                    <input type="text" id="in-name" value="Lucas Gabriel Santos" oninput="updateCert()" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: white;">
                </div>
                <div>
                    <label style="font-size: 0.85rem; color: #94a3b8; display: block;">Nome da Escola:</label>
                    <input type="text" id="in-school" value="E.M. José Giró Faísca" oninput="updateCert()" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: white;">
                </div>
                <div>
                    <label style="font-size: 0.85rem; color: #94a3b8; display: block;">Turma:</label>
                    <input type="text" id="in-class" value="3º Ano A" oninput="updateCert()" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: white;">
                </div>
                <div>
                    <label style="font-size: 0.85rem; color: #94a3b8; display: block;">Conquista / Categoria:</label>
                    <input type="text" id="in-reason" value="Leitor Destaque & Campeão de Matemática" oninput="updateCert()" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: white;">
                </div>
            </div>
        </div>

        <!-- CERTIFICADO IMPRIMÍVEL -->
        <div class="cert-card" id="printable-cert">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <img src="/img/robot-icon-512.png" style="width: 70px; height: 70px; border-radius: 14px;" alt="Lab Kids Robot">
                <span style="font-family: 'Fredoka', sans-serif; font-size: 1.4rem; color: #2563eb; font-weight: 700;">PORTAL LAB KIDS</span>
            </div>

            <h1 class="cert-header">🏆 CERTIFICADO DE DESTAQUE ESCOLAR 🏆</h1>
            <p class="cert-subtitle">Reconhecimento de Mérito, Dedicação e Aprendizagem Tecnológica</p>

            <p style="font-size: 1.1rem; color: #64748b; margin: 0;">Certificamos com orgulho que o(a) estudante</p>
            <div class="student-name-display" id="out-name">Lucas Gabriel Santos</div>

            <p class="cert-text" id="out-text">
                Demonstrou excelente desempenho, participação ativa e dedicação nos jogos pedagógicos interativos e atividades de alfabetização e raciocínio lógico no <strong id="out-school">E.M. José Giró Faísca</strong> (<span id="out-class">3º Ano A</span>), conquistando o título de <strong id="out-reason" style="color: #d97706;">Leitor Destaque & Campeão de Matemática</strong>.
            </p>

            <div class="cert-footer-grid">
                <div style="text-align: left;">
                    <p style="margin: 0; font-weight: 700; color: #1e293b;">Prof. Fábio Vieitas</p>
                    <small style="color: #64748b;">Coordenação Pedagógica Lab Kids</small>
                </div>
                <div style="text-align: center;">
                    <span style="font-size: 0.8rem; color: #94a3b8;">Verificado via Lab Kids</span><br>
                    <strong style="font-size: 0.85rem; color: #2563eb;">portal-atividades.onrender.com</strong>
                </div>
                <div style="text-align: right;">
                    <p style="margin: 0; font-weight: 700; color: #1e293b;" id="out-date">Data: 17/08/2026</p>
                    <small style="color: #64748b;">Ano Letivo 2026</small>
                </div>
            </div>
        </div>

        <div class="no-print" style="text-align: center; margin-top: 25px;">
            <a href="https://api.whatsapp.com/send?text=Gerei%20este%20Certificado%20de%20Aluno%20Destaque%20no%20Portal%20Lab%20Kids!%20Experimente%20gerar%20para%20seus%20alunos%20tamb%C3%A9m:%20https://portal-atividades.onrender.com/professor/certificado" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: #25d366; color: white; padding: 12px 28px; border-radius: 50px; font-weight: 800; text-decoration: none; box-shadow: 0 4px 15px rgba(37,211,102,0.4);">
                📲 COMPARTILHAR GERADOR DE CERTIFICADOS NO WHATSAPP COM PROFESSORES
            </a>
        </div>
    </div>

    <script>
        function updateCert() {
            document.getElementById('out-name').innerText = document.getElementById('in-name').value || 'Nome do Aluno';
            document.getElementById('out-school').innerText = document.getElementById('in-school').value || 'Nome da Escola';
            document.getElementById('out-class').innerText = document.getElementById('in-class').value || 'Turma';
            document.getElementById('out-reason').innerText = document.getElementById('in-reason').value || 'Destaque Escolar';
        }
        document.getElementById('out-date').innerText = 'Data: ' + new Date().toLocaleDateString('pt-BR');
    </script>
</body>
</html>

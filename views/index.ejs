        📰 Blog de Notícias
    </a>

    <!-- Vitrine de Jogos Educativos (Sidebar Canto Direito) -->
    <div class="games-showcase-sidebar">
        <div class="showcase-header">
            <span>🎮 Vitrine de Jogos</span>
            <span class="showcase-badge">DESTAQUES 🔥</span>
        </div>
        <div class="showcase-ticker">
            <div class="showcase-content">
                <% const showcaseList = (typeof showcaseActivities !== 'undefined' && showcaseActivities && showcaseActivities.length > 0) ? showcaseActivities : (activities || []); %>
                <% if (showcaseList && showcaseList.length > 0) { %>
                    <% showcaseList.forEach(act => { %>
                        <a href="/atividade/<%= act.id %>" class="showcase-item">
                            <div class="showcase-icon-box">
                                <img src="<%= act.icon_url || '/img/default-icon.png' %>" alt="<%= act.title %>" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3662/3662817.png'">
                            </div>
                            <div class="showcase-info">
                                <strong class="showcase-title"><%= act.title %></strong>
                                <span class="showcase-tag"><%= act.category || 'Jogo Educativo' %> • <%= act.level || '1º ao 5º' %></span>
                                <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                            </div>
                        </a>
                    <% }); %>
                    <!-- Repetição para Loop Infinito Contínuo -->
                    <% showcaseList.forEach(act => { %>
                        <a href="/atividade/<%= act.id %>" class="showcase-item">
                            <div class="showcase-icon-box">
                                <img src="<%= act.icon_url || '/img/default-icon.png' %>" alt="<%= act.title %>" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3662/3662817.png'">
                            </div>
                            <div class="showcase-info">
                                <strong class="showcase-title"><%= act.title %></strong>
                                <span class="showcase-tag"><%= act.category || 'Jogo Educativo' %> • <%= act.level || '1º ao 5º' %></span>
                                <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                            </div>
                        </a>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback se não houver lista pronta -->
                    <a href="/atividades/leitura-datashow" class="showcase-item">
                        <div class="showcase-icon-box"><img src="https://cdn-icons-png.flaticon.com/512/3426/3426653.png"></div>
                        <div class="showcase-info">
                            <strong class="showcase-title">⭐ Leitura no Datashow</strong>
                            <span class="showcase-tag">Alfabetização & Datashow</span>
                            <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                        </div>
                    </a>
                <% } %>
            </div>
        </div>
    </div>


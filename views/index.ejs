    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://labkids.online/">
    <meta property="og:title" content="Lab Kids - Jogos Educativos, Robótica e BNCC">

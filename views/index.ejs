    <link rel="stylesheet" href="/css/style.css?v=3">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <script>
        // PWA Early Registration & Prompt Interception
        window.pwaDeferredPrompt = null;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            window.pwaDeferredPrompt = e;
            console.log('⚡ PWA prompt captured in head!');
            const btn = document.getElementById('btn-pwa-install');
            if (btn) btn.style.boxShadow = '0 0 25px rgba(16,185,129,0.9)';
            if (typeof window.onPwaPromptCaptured === 'function') {
                window.onPwaPromptCaptured(e);
            }
        });
        window.addEventListener('appinstalled', () => {
            console.log('⚡ PWA installed!');
            window.pwaDeferredPrompt = null;
            if (typeof closePwaModal === 'function') closePwaModal();
        });
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').then(reg => {
                console.log('SW registered early!', reg);
            }).catch(e => console.warn('SW register error:', e));
        }
    </script>
    <meta name="theme-color" content="#4f46e5">

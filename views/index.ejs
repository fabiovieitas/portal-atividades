    <script>
        function switchSimuladoTab(month, btn) {
            document.querySelectorAll('.simulado-folder-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const panelSetembro = document.getElementById('panel-simulados-setembro');
            const panelAgosto = document.getElementById('panel-simulados-agosto');

            if (month === 'setembro') {
                if (panelSetembro) panelSetembro.style.display = 'block';
                if (panelAgosto) panelAgosto.style.display = 'none';
            } else if (month === 'agosto') {
                if (panelSetembro) panelSetembro.style.display = 'none';
                if (panelAgosto) panelAgosto.style.display = 'block';
            } else { // 'todos'
                if (panelSetembro) panelSetembro.style.display = 'block';
                if (panelAgosto) panelAgosto.style.display = 'block';
            }

            try {
                const url = new URL(window.location);
                url.searchParams.set('simulado_mes', month);
                window.history.replaceState({}, '', url);
            } catch(e){}
        }

        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const simMonth = urlParams.get('simulado_mes') || 'setembro';
            const targetSimBtn = simMonth === 'agosto' 
                ? document.getElementById('tab-simulado-agosto') 
                : (simMonth === 'todos' ? document.getElementById('tab-simulado-todos') : document.getElementById('tab-simulado-setembro'));
            if (targetSimBtn) {
                switchSimuladoTab(simMonth, targetSimBtn);
            }
        });
    </script>

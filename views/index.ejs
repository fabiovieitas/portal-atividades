                                                        <label><input type="radio" name="avatar" value="👾"><span>👾</span></label>
                                                        <label><input type="radio" name="avatar" value="⚡"><span>⚡</span></label>
                                                        <label><input type="radio" name="avatar" value="💻"><span>💻</span></label>
                                                        <label><input type="radio" name="avatar" value="🌟"><span>🌟</span></label>
                                                    </div>

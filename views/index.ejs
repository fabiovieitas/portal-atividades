<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Atividades Lab - Jogos Educativos, Robótica e BNCC</title>
    <meta name="description" content="Portal de Atividades Interativas para Educação Infantil e Ensino Fundamental (BNCC). Jogos de Leitura, Alfabetização, Matemática, Datashow, Tecnologia e Robótica Educativa.">
    <meta name="keywords" content="portal de atividades, jogos educativos, BNCC, alfabetização, leitura datashow, robótica educativa, atividades 1 ano, atividades 2 ano, ensino fundamental, educação infantil, prof fabio vieitas">
    <meta name="author" content="Professor Fábio Vieitas Marques">
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://portal-atividades.onrender.com/">
    <meta property="og:title" content="Portal de Atividades Lab - Jogos Educativos & BNCC">
    <meta property="og:description" content="Acesse dezenas de jogos interativos, leituras no datashow e desafios alinhados à BNCC para seus alunos.">
    <meta property="og:image" content="https://cdn-icons-png.flaticon.com/512/616/616430.png">

    <!-- Schema.org JSON-LD for Google Search Engine Optimization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalWebSite",
      "name": "Portal de Atividades Lab Kids",
      "url": "https://portal-atividades.onrender.com/",
      "description": "Portal de jogos e atividades pedagógicas interativas alinhadas com a BNCC para Ensino Fundamental e Educação Infantil.",
      "author": {
        "@type": "Person",
        "name": "Fábio Vieitas Marques"
      },
      "educationalCredentialAwarded": "Medalhas e Pontos de Aprendizagem"
    }
    </script>

    <link rel="stylesheet" href="/css/style.css?v=3">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Lab Kids">
    <meta name="application-name" content="Lab Kids">
    <link rel="icon" type="image/png" sizes="512x512" href="https://portal-atividades.onrender.com/img/robot-icon-512.png">
    <link rel="icon" type="image/png" sizes="192x192" href="https://portal-atividades.onrender.com/img/robot-icon-512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://portal-atividades.onrender.com/img/robot-icon-512.png">
    <link rel="shortcut icon" href="https://portal-atividades.onrender.com/favicon.ico">
    <script src="/js/avatar_system.js"></script>
</head>

<body class="<%= selectedLevel ? 'view-list' : 'view-selection' %>">

    <!-- Active Student Bar -->
    <div id="active-student-bar" style="position: fixed; top: 15px; left: 20px; z-index: 1000; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(10px); border: 2px solid #3b82f6; padding: 6px 14px; border-radius: 50px; display: flex; align-items: center; gap: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
        <a href="/aluno" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: white; font-family: 'Fredoka', sans-serif;">
            <div id="nav-student-avatar" style="font-size: 1.5rem;">📱</div>
            <div>
                <div id="nav-student-name" style="font-weight: 700; font-size: 0.95rem; color: #fbbf24;">Área do Aluno 🎮</div>
                <div id="nav-student-sub" style="font-size: 0.75rem; color: #94a3b8;">Criar Avatar & Ver Medalhas</div>
            </div>
        </a>
    </div>

    <!-- Botões Fixos -->
    <a href="/professor/login" class="fixed-teacher-btn">
        🧑‍🏫 Área do Professor
    </a>
    <a href="/noticias" class="fixed-blog-btn" style="position: fixed; bottom: 80px; right: 20px; z-index: 1000; background: var(--secondary); color: white; padding: 12px 25px; border-radius: 50px; text-decoration: none; font-weight: 700; box-shadow: 0 10px 20px rgba(0,0,0,0.2); transition: 0.3s; display: flex; align-items: center; gap: 8px;">
        📰 Blog de Notícias
    </a>

    <!-- Vitrine de Jogos Educativos (Sidebar Canto Direito) -->

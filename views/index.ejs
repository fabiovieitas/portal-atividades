                        <strong>⭐ Leitura no Datashow</strong>
                        <span class="showcase-tag">Alfabetização & Datashow</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/1" class="showcase-item">
                    <div class="showcase-icon">🔤</div>
                    <div class="showcase-info">
                        <strong>Fábrica de Sílabas</strong>
                        <span class="showcase-tag">Português • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/2" class="showcase-item">
                    <div class="showcase-icon">🔍</div>
                    <div class="showcase-info">
                        <strong>Caça-Palavras Interativo</strong>
                        <span class="showcase-tag">Vocabulário • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/3" class="showcase-item">
                    <div class="showcase-icon">🔢</div>
                    <div class="showcase-info">
                        <strong>Desafio dos Números</strong>
                        <span class="showcase-tag">Matemática • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/5" class="showcase-item">
                    <div class="showcase-icon">🐊</div>
                    <div class="showcase-info">
                        <strong>O Lenda do Ururau de Campos</strong>
                        <span class="showcase-tag">História & Cultura • 4º e 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/4" class="showcase-item">
                    <div class="showcase-icon">🦁</div>
                    <div class="showcase-info">
                        <strong>Akinator dos Animais</strong>
                        <span class="showcase-tag">Ciências & Lógica • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/6" class="showcase-item">
                    <div class="showcase-icon">🐒</div>
                    <div class="showcase-info">
                        <strong>Brincando com Ariê 1</strong>
                        <span class="showcase-tag">Alfabetização & Jogos</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <!-- Repetição para Loop Infinito Contínuo -->
                <a href="/atividades/leitura-datashow" class="showcase-item">
                    <div class="showcase-icon">📺</div>
                    <div class="showcase-info">
                        <strong>⭐ Leitura no Datashow</strong>
                        <span class="showcase-tag">Alfabetização & Datashow</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/1" class="showcase-item">
                    <div class="showcase-icon">🔤</div>
                    <div class="showcase-info">
                        <strong>Fábrica de Sílabas</strong>
                        <span class="showcase-tag">Português • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/2" class="showcase-item">
                    <div class="showcase-icon">🔍</div>
                    <div class="showcase-info">
                        <strong>Caça-Palavras Interativo</strong>
                        <span class="showcase-tag">Vocabulário • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
                <a href="/atividade/3" class="showcase-item">
                    <div class="showcase-icon">🔢</div>
                    <div class="showcase-info">
                        <strong>Desafio dos Números</strong>
                        <span class="showcase-tag">Matemática • 1º ao 5º Ano</span>
                        <span class="showcase-play-btn">JOGAR AGORA 🎮</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <header>
        <div class="container" style="position: relative;">
            <div class="logo animate-scale">
                <span class="icon" style="animation: rotate 10s infinite linear; display: inline-block;">🤖</span>
                <h1>
                    <%= selectedLevel==='6-9' ? 'Tech Masters' : 'Lab Kids' %>
                </h1>
            </div>
            <% if (!selectedLevel) { %>
                <p class="subtitle animate-up delay-1">Bem-vindo, explorador! Escolha sua jornada tecnológica:</p>
                <% } else { %>
                    <p class="subtitle animate-up delay-1">Missões preparadas para o seu nível!</p>
                    <% } %>
        </div>
    </header>

    <!-- Anúncios Laterais AdSense (Esquerda e Direita em Telas Largas) -->
    <div class="adsense-sidebar-left" style="position: fixed; left: 10px; top: 120px; width: 160px; height: 600px; z-index: 100; display: none;">
        <div style="background: rgba(255,255,255,0.95); border: 2px dashed #cbd5e1; border-radius: 14px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 0.7rem; color: #64748b; font-weight: 700; text-transform: uppercase;">📢 ADSENSE</div>
            <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 4px;">Anúncios Seguros</div>
            <% if (process.env.ADSENSE_PUB_ID) { %>
                <ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px" data-ad-client="<%= process.env.ADSENSE_PUB_ID %>" data-ad-slot="1234567891"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            <% } %>
        </div>
    </div>

    <div class="adsense-sidebar-right" style="position: fixed; right: 10px; top: 120px; width: 160px; height: 600px; z-index: 100; display: none;">
        <div style="background: rgba(255,255,255,0.95); border: 2px dashed #cbd5e1; border-radius: 14px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            <div style="font-size: 0.7rem; color: #64748b; font-weight: 700; text-transform: uppercase;">📢 ADSENSE</div>
            <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 4px;">Anúncios Seguros</div>
            <% if (process.env.ADSENSE_PUB_ID) { %>
                <ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px" data-ad-client="<%= process.env.ADSENSE_PUB_ID %>" data-ad-slot="1234567892"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            <% } %>
        </div>
    </div>

    <style>
        @media (min-width: 1450px) {
            .adsense-sidebar-left, .adsense-sidebar-right { display: block !important; }
        }
    </style>

    <main class="container">
        <% if (!selectedLevel) { %>
            <section class="selection-screen">
                <div class="selection-grid">
                    <a href="/?level=1-5" class="selection-card kids animate-up delay-2">
                        <div class="card-glow"></div>
                        <div class="card-icon">🚀</div>
                        <div class="card-info">
                            <h2>1º ao 5º Ano</h2>
                            <p>Exploradores Mirins</p>
                            <span class="btn-select">ENTRAR 🎮</span>
                        </div>
                    </a>
                    <a href="/?level=6-9" class="selection-card tech animate-up delay-3">
                        <div class="card-glow"></div>
                        <div class="card-icon">💻</div>
                        <div class="card-info">
                            <h2>6º ao 9º Ano</h2>
                            <p>Mestres da Tecnologia</p>
                            <span class="btn-select">LEVEL UP ⚡</span>
                        </div>
                    </a>
                </div>
            </section>

            <!-- AdSense Top Banner Banner -->
            <div class="adsense-banner-container" style="margin: 20px auto; max-width: 900px; background: rgba(241, 245, 249, 0.8); border: 2px dashed #cbd5e1; border-radius: 18px; padding: 15px; text-align: center;">
                <div style="font-size: 0.75rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">📢 Espaço Publicitário AdSense (Lab Kids)</div>
                <div style="font-size: 0.7rem; color: #94a3b8;">Anúncios seguros para crianças</div>
                <% if (process.env.ADSENSE_PUB_ID) { %>
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="<%= process.env.ADSENSE_PUB_ID %>"
                         data-ad-slot="1234567890"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                <% } %>
            </div>
            <% } else { %>

            <!-- Central de Simulados Municipais (Exibido apenas na aba de 1º ao 5º Ano) -->
            <% if (selectedLevel === '1-5') { %>
            <section class="simulados-portal-section" style="margin: 1rem 0 2.5rem 0; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 2rem; border-radius: 24px; color: white; box-shadow: 0 20px 40px rgba(0,0,0,0.25); border: 2px solid #0284c7;">
                <div style="text-align: center; margin-bottom: 1.5rem;">
                    <span style="background: rgba(2, 132, 199, 0.25); color: #38bdf8; font-weight: 800; font-family: 'Fredoka', sans-serif; padding: 0.4rem 1.2rem; border-radius: 50px; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; border: 1px solid #0284c7;">
                        🏛️ PROJETO CAMPOS DE TODOS NÓS
                    </span>
                    <h2 style="font-family: 'Fredoka', sans-serif; font-size: 2rem; margin-top: 0.8rem; color: #ffffff;">
                        📝 Central de Simulados Municipais (1º ao 5º Ano)
                    </h2>
                    <p style="color: #94a3b8; font-family: 'Outfit', sans-serif; font-size: 1rem; max-width: 650px; margin: 0.4rem auto 0 auto;">
                        Selecione o ano escolar do aluno para realizar o simulado digital oficial da Secretaria Municipal de Educação:
                    </p>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1.2rem;">
                    <!-- 1º Ano (ATIVO 🔥) -->
                    <a href="/atividades/simulado-campos-1ano" style="text-decoration: none; display: block; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: 2px solid #38bdf8; border-radius: 18px; padding: 1.5rem 1rem; text-align: center; box-shadow: 0 10px 25px rgba(2, 132, 199, 0.3); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🥇</div>
                        <h3 style="font-family: 'Fredoka'; font-size: 1.3rem; color: #ffffff; margin-bottom: 0.3rem;">1º Ano</h3>
                        <span style="font-size: 0.8rem; background: #10b981; color: #ffffff; font-weight: 800; padding: 0.25rem 0.7rem; border-radius: 50px;">DISPONÍVEL 🔥</span>
                    </a>

                    <!-- 2º Ano (ATIVO 🔥) -->
                    <a href="/atividades/simulado-campos-2ano" style="text-decoration: none; display: block; background: linear-gradient(135deg, #059669 0%, #047857 100%); border: 2px solid #34d399; border-radius: 18px; padding: 1.5rem 1rem; text-align: center; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🥈</div>
                        <h3 style="font-family: 'Fredoka'; font-size: 1.3rem; color: #ffffff; margin-bottom: 0.3rem;">2º Ano</h3>
                        <span style="font-size: 0.8rem; background: #10b981; color: #ffffff; font-weight: 800; padding: 0.25rem 0.7rem; border-radius: 50px;">DISPONÍVEL 🔥</span>
                    </a>

                    <!-- 3º Ano (ATIVO 🔥) -->
                    <a href="/atividades/simulado-campos-3ano" style="text-decoration: none; display: block; background: linear-gradient(135deg, #d97706 0%, #b45309 100%); border: 2px solid #fbbf24; border-radius: 18px; padding: 1.5rem 1rem; text-align: center; box-shadow: 0 10px 25px rgba(245, 158, 11, 0.3); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🥉</div>
                        <h3 style="font-family: 'Fredoka'; font-size: 1.3rem; color: #ffffff; margin-bottom: 0.3rem;">3º Ano</h3>
                        <span style="font-size: 0.8rem; background: #10b981; color: #ffffff; font-weight: 800; padding: 0.25rem 0.7rem; border-radius: 50px;">DISPONÍVEL 🔥</span>
                    </a>

                    <!-- 4º Ano (ATIVO 🔥) -->
                    <a href="/atividades/simulado-campos-4ano" style="text-decoration: none; display: block; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: 2px solid #38bdf8; border-radius: 18px; padding: 1.5rem 1rem; text-align: center; box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🎯</div>
                        <h3 style="font-family: 'Fredoka'; font-size: 1.3rem; color: #ffffff; margin-bottom: 0.3rem;">4º Ano</h3>
                        <span style="font-size: 0.8rem; background: #f59e0b; color: #000; font-weight: 800; padding: 0.25rem 0.7rem; border-radius: 50px;">DISPONÍVEL 🔥</span>
                    </a>

                    <!-- 5º Ano (ATIVO 🔥) -->
                    <a href="/atividades/simulado-campos-5ano" style="text-decoration: none; display: block; background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border: 2px solid #a78bfa; border-radius: 18px; padding: 1.5rem 1rem; text-align: center; box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🚀</div>
                        <h3 style="font-family: 'Fredoka'; font-size: 1.3rem; color: #ffffff; margin-bottom: 0.3rem;">5º Ano</h3>
                        <span style="font-size: 0.8rem; background: #10b981; color: #ffffff; font-weight: 800; padding: 0.25rem 0.7rem; border-radius: 50px;">DISPONÍVEL 🔥</span>
                    </a>
                </div>
            </section>
            <% } %>

            <section class="challenges">
                <div class="section-header">
                    <div class="header-content">
                        <h2>
                            <%= selectedLevel==='1-5' ? '🚀 Missões Kids (1º ao 5º Ano)' : '🔥 Desafios Tech (6º ao 9º Ano)' %>
                        </h2>
                        <a href="/" class="btn-back">⬅ Voltar</a>
                    </div>
                        
                        <!-- Search and Filter Bar -->
                        <div class="filter-bar glass-panel animate-up">
                            <form action="/" method="GET" class="filter-form">
                                <input type="hidden" name="level" value="<%= selectedLevel %>">
                                <div class="search-box">
                                    <input type="text" name="search" placeholder="Pesquisar missão..." value="<%= search || '' %>">
                                    <button type="submit">🔍</button>
                                </div>
                                <div class="category-box">
                                    <input type="text" name="bncc" placeholder="Código BNCC..." value="<%= bncc || '' %>" style="padding: 12px; border-radius: 50px; border: 1px solid #e1e8ef; margin-right: 10px;">
                                    <select name="subject" onchange="this.form.submit()" style="margin-right: 10px;">
                                        <option value="Todas">Todas Disciplinas</option>
                                        <% subjects.forEach(sub => { %>
                                            <option value="<%= sub %>" <%= selectedSubject === sub ? 'selected' : '' %>><%= sub %></option>
                                        <% }); %>
                                    </select>
                                    <select name="category" onchange="this.form.submit()">
                                        <option value="Todas">Todas Categorias</option>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="activity-grid">
                        <% if (activities.length===0) { %>
                            <div class="no-activities">
                                <p>Nenhuma missão disponível nesta modalidade ainda. O professor está preparando
                                    novidades!</p>
                            </div>
                            <% } %>
                                <% activities.forEach((activity, index) => { %>
                                    <div class="activity-card <%= selectedLevel === '6-9' ? 'tech-theme' : '' %> animate-up"
                                        style="animation-delay: <%= 0.1 * (index + 1) %>s; opacity: 0;"
                                        data-id="<%= activity.id %>">
                                        
                                        <!-- Badges -->
                                        <div class="card-badges">
                                            <% const isNew = (Date.now() - new Date(activity.created_at).getTime()) < (7 * 24 * 60 * 60 * 1000); %>
                                            <% if (isNew) { %><span class="badge-new">NOVO 🔥</span><% } %>
                                            <% if (activity.visits > 50) { %><span class="badge-popular">POPULAR ⭐</span><% } %>
                                        </div>

                                        <a href="/atividade/<%= activity.id %>" class="card-link"
                                            onclick="trackVisit(<%= activity.id %>)">
                                            <div class="card-icon">
                                                <img src="<%= activity.icon_url || '/img/default-icon.png' %>"
                                                    alt="<%= activity.title %>"
                                                    onerror="this.src='https://cdn-icons-png.flaticon.com/512/3662/3662817.png'">
                                            </div>
                                            <div class="card-content">
                                                <h3>
                                                    <%= activity.title %>
                                                </h3>
                                                <p>
                                                    <%= activity.description %>
                                                </p>
                                            </div>
                                        </a>
                                        <div class="card-rating">
                                            <div class="stars" data-id="<%= activity.id %>">
                                                <% const avg=activity.rating_count> 0 ? Math.round(activity.rating_sum /
                                                    activity.rating_count) : 0; %>
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <span class="star <%= i <= avg ? 'filled' : '' %>"
                                                            data-value="<%= i %>">★</span>

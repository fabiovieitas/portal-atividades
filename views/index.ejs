    <style>
        /* Pastas dos Simulados por Mês */
        .simulados-portal-section {
            margin: 1rem 0 2.5rem 0;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            padding: 2.2rem 1.8rem;
            border-radius: 24px;
            color: white;
            box-shadow: 0 20px 45px rgba(0,0,0,0.3);
            border: 2px solid #0284c7;
            position: relative;
            overflow: hidden;
        }
        .simulados-portal-section::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.15), transparent 70%);
            pointer-events: none;
        }
        .simulado-folders-nav {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 1.8rem 0 1.5rem 0;
        }
        .simulado-folder-tab-btn {
            background: rgba(15, 23, 42, 0.85);
            border: 2px solid #334155;
            border-radius: 16px;
            padding: 12px 22px;
            color: #cbd5e1;
            font-family: 'Fredoka', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        .simulado-folder-tab-btn:hover {
            transform: translateY(-2px);
            border-color: #38bdf8;
            color: #ffffff;
            box-shadow: 0 8px 25px rgba(56, 189, 248, 0.25);
        }
        .simulado-folder-tab-btn.active {
            border-color: #38bdf8;
            background: linear-gradient(135deg, rgba(2, 132, 199, 0.35), rgba(15, 23, 42, 0.95));
            color: #ffffff;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.35), 0 10px 25px rgba(2, 132, 199, 0.3);
        }
        .tab-badge-new {
            background: #f59e0b;
            color: #000;
            font-size: 0.72rem;
            font-weight: 900;
            padding: 2px 8px;
            border-radius: 50px;
            animation: pulse-glow 2s infinite;
        }
        .tab-badge-prev {
            background: #38bdf8;
            color: #082f49;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 50px;
        }
        .simulado-folder-panel {
            transition: opacity 0.3s ease;
        }
        .simulado-folder-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
            padding: 10px 16px;
            background: rgba(30, 41, 59, 0.6);
            border-radius: 14px;
            border-left: 4px solid #38bdf8;
        }
        .simulado-folder-header.header-agosto {
            border-left-color: #60a5fa;
        }
        .simulado-folder-title {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.15rem;
            color: #f1f5f9;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .simulado-folder-count {
            font-size: 0.85rem;
            color: #94a3b8;
            font-family: 'Outfit', sans-serif;
        }
        .simulado-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.2rem;
        }
        .simulado-card-item {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-radius: 18px;
            padding: 1.4rem 1.1rem;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s;
            position: relative;
            overflow: hidden;
        }
        .simulado-card-item:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 15px 35px rgba(56, 189, 248, 0.35);
        }
        .simulado-card-emoji {
            font-size: 2.2rem;
            margin-bottom: 0.4rem;
        }
        .simulado-card-title {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.3rem;
            color: #ffffff;
            margin-bottom: 0.3rem;
        }
        .simulado-card-desc {
            font-size: 0.8rem;
            color: #e2e8f0;
            margin-bottom: 0.8rem;
            line-height: 1.35;
            font-family: 'Outfit', sans-serif;
        }
        .simulado-card-btn {
            font-size: 0.8rem;
            font-weight: 900;
            padding: 0.35rem 0.8rem;
            border-radius: 50px;
            display: inline-block;
            margin-top: auto;
            font-family: 'Outfit', sans-serif;
        }
        @keyframes pulse-glow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.03); }
        }
    </style>
</head>


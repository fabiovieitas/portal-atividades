<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog de Notícias Educativas | Portal Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
    <!-- Google AdSense Official Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-light: #818cf8;
            --secondary: #ec4899;
            --dark: #0f172a;
            --glass: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.3);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: #f1f5f9;
            color: var(--dark);
            overflow-x: hidden;
        }

        /* Hero Section Premium */
        .blog-hero {
            position: relative;
            background: linear-gradient(135deg, #4338ca 0%, #db2777 100%);
            padding: 8rem 2rem 10rem;
            color: white;
            text-align: center;
            clip-path: ellipse(150% 100% at 50% 0%);
        }

        .blog-hero h1 {
            font-family: 'Fredoka', sans-serif;
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .blog-hero p {
            font-size: 1.25rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        /* News Container */
        .container-blog {
            max-width: 1200px;
            margin: -5rem auto 4rem;
            padding: 0 1.5rem;
            position: relative;
            z-index: 10;
        }

        /* Glassmorphism Card */
        .news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 2.5rem;
        }

        .premium-card {
            background: var(--glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
        }

        .premium-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0,0,0,0.12);
            background: rgba(255, 255, 255, 0.9);
        }

        .card-img-wrapper {
            position: relative;
            height: 240px;
            overflow: hidden;
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .premium-card:hover .card-img {
            transform: scale(1.1);
        }

        .card-category {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            color: white;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .card-body {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 800;
            line-height: 1.3;
            margin-bottom: 1rem;
            color: var(--dark);
        }

        .card-summary {
            color: #475569;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-btn {
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: white;
            padding: 12px 24px;
            border-radius: 15px;
            text-decoration: none;
            font-weight: 700;
            transition: 0.3s;
            align-self: flex-start;
        }

        .card-btn:hover {
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3);
            filter: brightness(1.1);
        }

        .card-footer-info {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: #94a3b8;
        }

        /* Animations */
        .animate-fade {
            animation: fadeInUp 0.8s ease backwards;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 768px) {
            .blog-hero h1 { font-size: 2.5rem; }
            .news-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <nav class="main-nav" style="background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 10px 0;">
        <div class="nav-container" style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <a href="/" class="logo" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 2rem; animation: rotate 10s infinite linear; display: inline-block;">🤖</span>
                <h1 style="font-family: 'Fredoka', sans-serif; color: white; margin: 0; font-size: 1.8rem;">Lab Kids</h1>
            </a>
            <div class="nav-links" style="display: flex; align-items: center; gap: 20px;">
                <a href="/" style="color: white; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: 0.3s;">
                    <i class="fas fa-home"></i> Início
                </a>
                <a href="/professor/login" style="background: linear-gradient(135deg, #4f46e5, #818cf8); color: white; padding: 10px 20px; border-radius: 50px; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);">
                    <i class="fas fa-chalkboard-teacher"></i> Área do Professor
                </a>
            </div>
        </div>
    </nav>

    <header class="blog-hero">
        <h1 class="animate-fade">Blog do Lab Kids</h1>
        <p class="animate-fade" style="animation-delay: 0.2s;">Dicas, novidades e o melhor da tecnologia educacional diretamente para você.</p>
    </header>

    <main class="container-blog">
        <div class="news-grid">
            <% if (news.length === 0) { %>
                <div class="premium-card animate-fade" style="grid-column: 1/-1; padding: 4rem; text-align: center;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">📝</div>
                    <h2>Prepare o café!</h2>
                    <p>O professor Fábio está preparando novidades incríveis. Volte logo!</p>
                </div>
            <% } %>

            <% news.forEach((article, index) => { %>
                <article class="premium-card animate-fade" style="animation-delay: <%= 0.1 * (index + 1) %>s">
                    <div class="card-img-wrapper">
                        <img src="<%= article.image_url || 'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&q=80&w=800' %>" alt="<%= article.title %>" class="card-img">
                        <span class="card-category"><%= article.category %></span>
                    </div>
                    <div class="card-body">
                        <h2 class="card-title"><%= article.title %></h2>
                        <p class="card-summary"><%= article.summary %></p>
                        <a href="/noticia/<%= article.id %>" class="card-btn">
                            Ler Notícia <i class="fas fa-chevron-right" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="card-footer-info">
                            <span><i class="far fa-calendar-alt"></i> <%= new Date(article.created_at).toLocaleDateString('pt-BR') %></span>
                            <span><i class="far fa-user"></i> <%= article.author %></span>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>

        <!-- AdSense Bottom Banner (Ultra-Fino Horizontal) -->
        <div class="adsense-tablet-wrapper tablet-ad-banner" style="margin: 20px auto 10px auto; max-width: 970px; background: rgba(255, 255, 255, 0.7); border: 1px dashed #cbd5e1; border-radius: 12px; padding: 4px 8px; text-align: center;">
            <div class="adsense-micro-label">📢 Publicidade Educativa</div>
            <ins class="adsbygoogle" style="display:block; max-height:90px; width:100%;" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567890" data-ad-format="horizontal" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>
    </main>

    <footer class="footer" style="background: var(--dark); color: white; padding: 4rem 2rem;">
        <div class="container" style="text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 1rem;">🤖</div>
            <p>&copy; 2026 Lab Kids - Transformando a educação através da tecnologia.</p>
            <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 2rem;">
                <a href="/" style="color: #94a3b8; text-decoration: none;">Início</a>
                <a href="/privacidade" style="color: #94a3b8; text-decoration: none;">Privacidade</a>
                <a href="/contato" style="color: #94a3b8; text-decoration: none;">Contato</a>
            </div>
        </div>
    </footer>

</body>
</html>

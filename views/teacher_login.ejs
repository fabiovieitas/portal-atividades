<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Lab Kids - Área do Professor</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4f46e5">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Lab Kids">
  <link rel="icon" type="image/png" sizes="512x512" href="/img/robot-icon-512.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/robot-icon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/robot-icon-512.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css?v=3">
  <link rel="stylesheet" href="/css/admin_fixes.css?v=2">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, var(--bg-color) 0%, #d4e4f7 100%);
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
    }
    .auth-wrapper {
      display: flex;
      flex-wrap: wrap;
      background: var(--glass-bg);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 15px 35px rgba(0,0,0,0.1);
      max-width: 900px;
      width: 100%;
      overflow: hidden;
    }
    .auth-benefits {
      flex: 1;
      min-width: 300px;
      background: linear-gradient(135deg, var(--accent), var(--primary));
      padding: 40px;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .auth-benefits h2 {
      font-family: 'Fredoka', sans-serif;
      font-size: 2em;
      margin-top: 0;
      margin-bottom: 20px;
    }
    .auth-benefits ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .auth-benefits li {
      margin-bottom: 15px;
      font-size: 1.1em;
      display: flex;
      align-items: center;
    }
    .auth-benefits li span {
      font-size: 1.5em;
      margin-right: 15px;
    }
    .login-container {
      flex: 1;
      min-width: 300px;
      padding: 40px;
      text-align: center;
      color: var(--text-dark);
      background: white;
    }
    .login-container h1 { 
      margin-top: 0;
      margin-bottom: 20px; 
      font-family: 'Fredoka', sans-serif; 
      color: var(--accent-blue);
    }
    .login-form input { 
      width: 100%; 
      padding: 15px; 
      margin-bottom: 15px; 
      border-radius: 10px; 
      border: 2px solid #ccc; 
      background: #ffffff !important; 
      color: #000000 !important; 
      font-weight: 600;
      font-size: 1em;
      font-family: 'Outfit', sans-serif;
      box-sizing: border-box;
      transition: 0.3s;
    }
    .login-form input:focus {
      border-color: var(--accent-blue);
      outline: none;
      box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.2);
    }
    .login-form button { 
      width: 100%; 
      padding: 15px; 
      background: var(--accent-blue); 
      color: white; 
      border: none; 
      border-radius: 10px; 
      font-size: 1.1em;
      font-weight: bold; 
      cursor: pointer; 
      transition: 0.3s; 
      font-family: 'Outfit', sans-serif;
    }
    .login-form button:hover { 
      background: var(--btn-hover); 
      transform: translateY(-2px); 
      box-shadow: 0 5px 15px rgba(74, 144, 226, 0.4);
    }
    .error { 
      background: #ffe5e5;
      color: #d63031; 
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px; 
      font-weight: bold;
    }
    .success {
      background: #e5ffe5;
      color: #27ae60;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-weight: bold;
    }
    .toggle-form { 
      margin-top: 20px; 
      font-size: 1em; 
      cursor: pointer; 
      color: var(--accent-blue); 
      text-decoration: none; 
      display: inline-block;
      font-weight: bold;
    }
    .toggle-form:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  
  <div class="auth-wrapper">
    <div class="auth-benefits">
      <h2>Transforme sua Sala de Aula 🚀</h2>
      <div style="background: rgba(255,255,255,0.2); display: inline-block; padding: 6px 16px; border-radius: 50px; font-weight: bold; margin-bottom: 15px; border: 1px solid rgba(255,255,255,0.5);">
        ✨ 100% Gratuito para Educadores de Todas as Redes
      </div>
      <p>Junte-se ao Portal Lab Kids! Seja de escola municipal, estadual, federal ou particular, tenha acesso gratuito a ferramentas pedagógicas interativas.</p>
      <ul>
        <li><span>📂</span> Crie seu acervo de atividades favoritas</li>
        <li><span>📱</span> Gere QR Codes para acesso rápido dos alunos</li>
        <li><span>📊</span> Aplique provas digitais com salvamento em tempo real</li>
        <li><span>💬</span> Receba e gerencie feedbacks dos estudantes</li>
      </ul>
    </div>
    
    <div class="login-container">
      <h1 id="form-title">Login do Professor</h1>
      
      <% if (error) { %>
        <% if (error.includes('sucesso') || error.includes('Verifique seu e-mail') || error.includes('Parabéns')) { %>
          <div class="success"><%= error %></div>
        <% } else { %>
          <div class="error"><%= error %></div>
        <% } %>
      <% } %>
      
      <!-- Student redirect notice -->
      <div style="background: #f1f5f9; border-radius: 10px; padding: 10px 14px; margin-bottom: 20px; font-size: 0.88rem; color: #475569; text-align: center;">
        🎒 <strong>É estudante?</strong> Você não precisa de cadastro! <br>
        <a href="/#activities" style="color: #4f46e5; font-weight: 700; text-decoration: underline;">Clique aqui para ir aos Jogos e Desafios 🚀</a>
      </div>
      
      <form id="login-form" class="login-form" action="/professor/login" method="POST">
        <input type="email" name="email" placeholder="Seu E-mail (ex: professor@escola.com ou gmail)" required>
        <input type="password" name="password" placeholder="Sua Senha" required>
        <div style="text-align: right; margin-top: -6px; margin-bottom: 14px;">
          <a href="/professor/esqueci-senha" style="color: #64748b; font-size: 0.86rem; text-decoration: none; font-weight: 600; transition: color 0.2s;" onmouseover="this.style.color='#0284c7'" onmouseout="this.style.color='#64748b'">Esqueceu sua senha?</a>
        </div>
        <button type="submit">Entrar na Plataforma</button>
        <div class="toggle-form" onclick="toggleForm()">Novo por aqui? Cadastre-se gratuitamente</div>
        <div style="margin-top: 20px;">
          <a href="/" style="color: #64748b; text-decoration: none; font-size: 0.9em; font-weight: 600;">⬅ Voltar para a Página Inicial</a>
        </div>
      </form>
  
      <form id="register-form" class="login-form" action="/professor/register" method="POST" style="display: none;">
        <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 12px; margin-bottom: 15px; font-size: 0.85rem; color: #1e40af; text-align: left; line-height: 1.4;">
          ✨ <strong>Acesso Aberto a Educadores de Qualquer Rede:</strong><br>
          Após o cadastro, você receberá um <strong>código de 6 dígitos no seu e-mail</strong> para ativar seu acesso pedagógico com total segurança (LGPD).
        </div>
        <input type="text" name="name" placeholder="Seu Nome Completo (ex: Prof. Carlos Silva)" required>
        <input type="email" name="email" placeholder="Seu E-mail (ex: nome@edu.campos.rj.gov.br ou seu Gmail)" required>
        <input type="text" name="school" placeholder="Sua Escola / Cidade (ex: E.M. 29 de Maio - Campos)" required>
        <input type="password" name="password" placeholder="Crie uma Senha (mín. 6 caracteres)" minlength="6" required>
        <label style="display: flex; align-items: flex-start; text-align: left; font-size: 0.82rem; color: #475569; margin: 12px 0 16px 0; cursor: pointer; line-height: 1.35;">
          <input type="checkbox" name="teacher_declaration" required style="width: 18px; height: 18px; margin-right: 8px; margin-top: 2px; flex-shrink: 0; cursor: pointer;">
          Declaro que atuo como educador(a) / professor(a) e utilizarei esta conta exclusivamente para fins pedagógicos (LGPD).
        </label>
        <button type="submit">Cadastrar e Receber Código 🚀</button>
        <div class="toggle-form" onclick="toggleForm()">Já tem uma conta? Fazer Login</div>
        <div style="margin-top: 20px;">
          <a href="/" style="color: #64748b; text-decoration: none; font-size: 0.9em; font-weight: 600;">⬅ Voltar para a Página Inicial</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    let isLogin = true;
    function toggleForm() {
      isLogin = !isLogin;
      document.getElementById('login-form').style.display = isLogin ? 'block' : 'none';
      document.getElementById('register-form').style.display = isLogin ? 'none' : 'block';
      document.getElementById('form-title').innerText = isLogin ? 'Login do Professor' : 'Cadastro de Professor';
    }

    // Auto-open register tab if requested
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('cadastro') === '1' || urlParams.get('cadastrar') === '1' || urlParams.get('register') === '1') {
      toggleForm();
    }
  </script>
</body>
</html>

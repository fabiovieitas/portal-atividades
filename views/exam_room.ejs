<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title><%= exam.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { margin: 0; overflow: hidden; background: #333; font-family: 'Inter', sans-serif; }
    .header { background: var(--bg-dark); color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--accent-cyan); position: fixed; top: 0; width: 100%; z-index: 10; height: 60px; box-sizing: border-box; }
    .pdf-container { position: absolute; top: 60px; bottom: 0; width: 100%; -webkit-overflow-scrolling: touch; overflow-y: auto; background: #ddd; }
    iframe { width: 100%; height: 100%; border: none; }
    
    /* Bottom Sheet / Floating Gabarito */
    .gabarito-btn { position: fixed; bottom: 20px; right: 20px; background: var(--accent-purple); color: white; padding: 15px 30px; border-radius: 30px; font-weight: bold; font-size: 1.2em; border: none; box-shadow: 0 5px 15px rgba(0,0,0,0.5); z-index: 100; cursor: pointer; transition: 0.3s; }
    .gabarito-sheet { position: fixed; bottom: -100%; left: 0; width: 100%; height: 70%; background: var(--bg-dark); border-top-left-radius: 20px; border-top-right-radius: 20px; box-shadow: 0 -5px 20px rgba(0,0,0,0.5); z-index: 101; transition: 0.3s ease-in-out; display: flex; flex-direction: column; color: white; }
    .gabarito-sheet.open { bottom: 0; }
    
    .sheet-header { padding: 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #444; }
    .close-btn { background: none; border: none; color: white; font-size: 1.5em; cursor: pointer; }
    
    .sheet-content { padding: 20px; overflow-y: auto; flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
    
    .question { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; border: 1px solid #444; }
    .question h4 { margin: 0 0 10px 0; color: var(--accent-cyan); }
    .options { display: flex; gap: 10px; }
    .option { flex: 1; padding: 10px; background: rgba(255,255,255,0.1); border: 1px solid transparent; border-radius: 5px; text-align: center; cursor: pointer; transition: 0.2s; font-weight: bold; }
    .option.selected { background: var(--accent-blue); border-color: white; }
    
    #save-status { font-size: 0.8em; color: #aaa; margin-left: 10px; }
  </style>
</head>
<body>
  <div class="header">
    <div><strong>📝 <%= exam.title %></strong> - <%= submission.student_name %></div>
    <div><span id="save-status">Salvo ✔️</span></div>
  </div>

  <div class="pdf-container">
    <iframe src="<%= exam.pdf_url %>" title="Prova PDF"></iframe>
  </div>

  <button class="gabarito-btn" onclick="toggleGabarito()">Ver Gabarito 📝</button>

  <div class="gabarito-sheet" id="gabarito">
    <div class="sheet-header">
      <h3 style="margin: 0; color: var(--accent-cyan);">Gabarito Digital</h3>
      <button class="close-btn" onclick="toggleGabarito()">✖</button>
    </div>
    <div class="sheet-content" id="questions-container">
      <!-- Generated by JS -->
    </div>
    <div style="padding: 15px; text-align: center; border-top: 1px solid #444;">
      <button style="padding: 12px 30px; background: #28a745; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 1.1em; cursor: pointer;" onclick="finishExam()">Finalizar Prova</button>
    </div>
  </div>

  <script>
    let answers = <%- submission.answers_json || '{}' %>;
    const numQuestions = <%= exam.num_questions || 10 %>;
    
    function renderGabarito() {
      const container = document.getElementById('questions-container');
      container.innerHTML = '';
      
      for(let i = 1; i <= numQuestions; i++) {
        const qDiv = document.createElement('div');
        qDiv.className = 'question';
        
        let optionsHtml = '';
        ['A', 'B', 'C', 'D'].forEach(opt => {
          const isSelected = answers[i] === opt;
          optionsHtml += `<div class="option ${isSelected ? 'selected' : ''}" onclick="selectOption(${i}, '${opt}')">${opt}</div>`;
        });
        
        qDiv.innerHTML = `
          <h4>Questão ${i}</h4>
          <div class="options">${optionsHtml}</div>
        `;
        container.appendChild(qDiv);
      }
    }

    function toggleGabarito() {
      document.getElementById('gabarito').classList.toggle('open');
    }

    async function selectOption(qNumber, opt) {
      answers[qNumber] = opt;
      renderGabarito();
      
      // Auto-save
      const statusSpan = document.getElementById('save-status');
      statusSpan.innerText = 'Salvando... ⏳';
      statusSpan.style.color = '#ffeb3b';
      
      try {
        const res = await fetch('/api/exam/submit-answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ answers })
        });
        
        if (res.ok) {
          statusSpan.innerText = 'Salvo ✔️';
          statusSpan.style.color = '#4CAF50';
        }
      } catch (err) {
        statusSpan.innerText = 'Erro ao salvar! ❌';
        statusSpan.style.color = '#ff6b6b';
      }
    }

    function finishExam() {
      if(confirm('Tem certeza que deseja finalizar a prova? Suas respostas foram salvas.')) {
        window.location.href = '/';
      }
    }

    // Inicializa o gabarito
    renderGabarito();
  </script>
</body>
</html>

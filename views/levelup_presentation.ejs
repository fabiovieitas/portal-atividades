        .badge-theme { background: linear-gradient(135deg, #ef4444, #b91c1c); color: white; padding: 8px 20px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; margin: 5px; display: inline-block; border: 1px solid rgba(255,255,255,0.3); }

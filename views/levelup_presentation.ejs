    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <style>
        body { background: #0b0f19; color: #f8fafc; font-family: 'Outfit', sans-serif; min-height: 100vh; margin: 0; padding: 25px 15px 60px 15px; }
        .container-presentation { max-width: 960px; margin: 0 auto; }
        .top-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 12px; }
        .btn-return-portal { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #ef4444, #dc2626); color: white; padding: 12px 24px; border-radius: 50px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4); border: 2px solid rgba(255, 255, 255, 0.3); font-family: 'Fredoka', sans-serif; }
        .hero-banner { background: rgba(15, 23, 42, 0.95); border: 2px solid #8b5cf6; border-radius: 28px; padding: 40px 30px; text-align: center; margin-bottom: 30px; box-shadow: 0 25px 50px rgba(139, 92, 246, 0.25); }
        .badge-autoral { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #f59e0b; padding: 10px 25px; border-radius: 50px; font-weight: 800; font-size: 1rem; border: 2px solid #f59e0b; display: inline-block; margin-bottom: 15px; }
        .badge-theme { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid #ef4444; padding: 6px 16px; border-radius: 50px; font-weight: 700; font-size: 0.85rem; margin: 4px; display: inline-block; }
        .game-title { font-size: clamp(2rem, 4.5vw, 2.8rem); font-weight: 800; color: #f59e0b; margin: 15px 0 10px 0; font-family: 'Fredoka', sans-serif; }
        .game-subtitle { font-size: 1.15rem; color: #cbd5e1; max-width: 800px; margin: 0 auto 25px auto; line-height: 1.6; }
        .btn-launch-large { display: inline-flex; align-items: center; justify-content: center; gap: 12px; background: linear-gradient(135deg, #10b981, #047857); color: white; padding: 20px 45px; border-radius: 50px; font-weight: 800; font-size: 1.35rem; text-decoration: none; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4); border: 2px solid rgba(255,255,255,0.4); transition: transform 0.2s, box-shadow 0.2s; max-width: 500px; width: 100%; margin: 10px auto; }
        .btn-launch-large:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(16, 185, 129, 0.6); }
        .pedagogical-card { background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 30px; margin-bottom: 25px; }
        .pedagogical-card h2 { color: #8b5cf6; font-size: 1.5rem; margin-top: 0; display: flex; align-items: center; gap: 10px; font-family: 'Fredoka', sans-serif; }
        .bncc-badge { background: #4f46e5; color: white; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: inline-block; margin: 4px; }
        .step-box { background: rgba(30, 41, 59, 0.6); border-left: 4px solid #8b5cf6; padding: 15px 20px; border-radius: 0 16px 16px 0; margin-bottom: 15px; }
        .step-box h4 { margin: 0 0 6px 0; color: #c4b5fd; font-size: 1.1rem; }
        .step-box p { margin: 0; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; }
        .institutional-footer { text-align: center; margin-top: 50px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); color: #94a3b8; font-size: 0.9rem; }
        .institutional-footer a { color: #60a5fa; text-decoration: none; margin: 0 8px; }
        .institutional-footer a:hover { text-decoration: underline; }
    </style>

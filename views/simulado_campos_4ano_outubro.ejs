  <!-- Modal de Confirmação & Vitória -->
  <div class="modal-overlay" id="resultModal">
    <div class="modal-card">
      <div style="font-size: 4rem; margin-bottom: 0.75rem;">🏆</div>
      <h2 style="font-size: 2.2rem; color: #166534; font-family: 'Fredoka', cursive; margin-bottom: 0.5rem;">Parabéns!</h2>

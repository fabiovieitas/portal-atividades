  <script>
    const SIMULADO_ID = 'campos-4ano-outubro-2026';
    
    // Gabarito Oficial SEDUCT Outubro 2026 (Página 8 do PDF)
    const answerKey = {
      1: 'C',
      2: 'B',
      4: 'B',
      5: 'B',
      6: 'C',
      7: 'B',
      8: 'C',
      9: 'C',
      10: 'C'
    };

    const questionKeys = ['1', '2', '4', '5', '6', '7', '8', '9', '10'];
    const studentAnswers = {};
    let isSubmitting = false;

    // Sintetizador de voz
    function speakText(elementId) {
      if (!('speechSynthesis' in window)) {
        alert('Seu navegador não suporta leitura em áudio.');
        return;
      }
      window.speechSynthesis.cancel();
      const el = document.getElementById(elementId);
      if (!el) return;
      
      const textToSpeak = el.innerText || el.textContent;
      const utterance = new SpeechSynthesisUtterance(textToSpeak);
      utterance.lang = 'pt-BR';
      utterance.rate = 1.0;

      const btn = event?.currentTarget;
      if (btn) btn.classList.add('speaking');

      utterance.onend = () => {
        if (btn) btn.classList.remove('speaking');
      };
      utterance.onerror = () => {
        if (btn) btn.classList.remove('speaking');
      };

      window.speechSynthesis.speak(utterance);
    }

    // Inicialização do espelho
    function initCRGrid() {
      const grid = document.getElementById('crGrid');
      grid.innerHTML = '';
      
      const allDisplayKeys = ['1', '2', '3 (Redação)', '4', '5', '6', '7', '8', '9', '10'];
      allDisplayKeys.forEach(k => {
        const item = document.createElement('div');
        item.className = 'cr-item';
        item.id = 'cr-badge-' + k.replace(/\s+/g, '_');
        item.innerText = 'Q' + k + ': -';
        grid.appendChild(item);
      });
    }

    // Selecionar Opção
    function selectOption(qKey, opt) {
      studentAnswers[qKey] = opt;

      ['A', 'B', 'C', 'D'].forEach(letter => {
        const optEl = document.getElementById('opt-' + qKey + '-' + letter);
        if (optEl && optEl.parentElement) {
          optEl.parentElement.classList.remove('selected');
        }
      });

      const activeEl = document.getElementById('opt-' + qKey + '-' + opt);
      if (activeEl && activeEl.parentElement) {
        activeEl.parentElement.classList.add('selected');
      }

      const badge = document.getElementById('cr-badge-' + qKey);
      if (badge) {
        badge.innerText = 'Q' + qKey + ': ' + opt;
        badge.classList.add('done');
      }

      updateProgress();
      saveVaultDraft();
    }

    // Sincronizar Produção Textual (Questão 3)
    function syncEssayText() {
      const title = document.getElementById('q3Title')?.value.trim() || '';
      const text = document.getElementById('q3Essay')?.value.trim() || '';
      
      const fullEssay = (title ? '[TÍTULO: ' + title + ']\n\n' : '') + text;
      
      if (text.length > 5) {
        studentAnswers['3'] = fullEssay;
        const badge = document.getElementById('cr-badge-3_(Redação)');
        if (badge) {
          badge.innerText = 'Q3: ✓';
          badge.classList.add('done');
        }
      } else {
        delete studentAnswers['3'];
        const badge = document.getElementById('cr-badge-3_(Redação)');
        if (badge) {
          badge.innerText = 'Q3: -';
          badge.classList.remove('done');
        }
      }

      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      document.getElementById('essayWordsCounter').innerText = words + ' palavras';

      updateProgress();
      saveVaultDraft();
    }

    // Atualizar Barra de Progresso
    function updateProgress() {
      const answeredCount = Object.keys(studentAnswers).length;
      const totalRequired = 10; // 9 objetivas + 1 redação
      const pct = Math.min(100, Math.round((answeredCount / totalRequired) * 100));

      document.getElementById('progressFill').style.width = pct + '%';
      document.getElementById('progressText').innerText = answeredCount + ' de ' + totalRequired + ' respondidas';
    }

    // Salvar rascunho
    function saveVaultDraft() {
      if (typeof window.SimuladoVault !== 'undefined') {
        const studentData = {
          name: document.getElementById('studentName')?.value.trim() || '',
          school: document.getElementById('schoolName')?.value.trim() || '',
          class: document.getElementById('className')?.value || '4º Ano',
          shift: document.getElementById('shiftName')?.value || 'Manhã'
        };
        window.SimuladoVault.saveDraft(SIMULADO_ID, studentData, studentAnswers);
      }
    }

    // Restaurar rascunho
    function restoreDraft() {
      if (typeof window.SimuladoVault === 'undefined') return;
      const draft = window.SimuladoVault.loadDraft(SIMULADO_ID);
      if (!draft) return;

      if (draft.studentData) {
        if (draft.studentData.name) document.getElementById('studentName').value = draft.studentData.name;
        if (draft.studentData.school) document.getElementById('schoolName').value = draft.studentData.school;
        if (draft.studentData.class) document.getElementById('className').value = draft.studentData.class;
        if (draft.studentData.shift) document.getElementById('shiftName').value = draft.studentData.shift;
      }

      if (draft.answers) {
        Object.keys(draft.answers).forEach(k => {
          if (k === '3') {
            const val = draft.answers[k];
            if (val.includes('[TÍTULO:')) {
              const parts = val.split(']\n\n');
              document.getElementById('q3Title').value = parts[0].replace('[TÍTULO: ', '');
              document.getElementById('q3Essay').value = parts[1] || '';
            } else {
              document.getElementById('q3Essay').value = val;
            }
            syncEssayText();
          } else {
            selectOption(k, draft.answers[k]);
          }
        });
      }
    }

    // Envio Ultra-Resiliente com SimuladoVault
    async function submitExamWithVault() {
      if (isSubmitting) return;

      const studentName = document.getElementById('studentName').value.trim();
      if (!studentName) {
        alert('⚠️ Por favor, informe seu Nome Completo antes de finalizar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      questionKeys.forEach(k => {
        if (!studentAnswers[k]) missing.push('Questão ' + k);
      });
      if (!studentAnswers['3']) missing.push('Questão 03 (Produção Textual)');

      if (missing.length > 0) {
        const confirmSend = confirm('⚠️ Atenção: você ainda não respondeu:\n' + missing.join('\n') + '\n\nDeseja enviar mesmo assim?');
        if (!confirmSend) return;
      }

      let score = 0;
      questionKeys.forEach(k => {
        if (studentAnswers[k] === answerKey[k]) score++;
      });

      const payload = {
        simulado_id: SIMULADO_ID,
        student_name: studentName,
        school_name: document.getElementById('schoolName').value.trim(),
        class_name: document.getElementById('className').value || '4º Ano',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 10,
        essay_text: studentAnswers['3'] || ''
      };

      const btn = document.querySelector('.btn-submit-exam');
      btn.innerHTML = '<span>⏳</span> <span>GRAVANDO NA NUVEM...</span>';
      btn.style.opacity = '0.7';
      isSubmitting = true;

      const result = await window.SimuladoVault.submit(payload, (attempt, max) => {
        btn.innerHTML = '<span>⏳</span> <span>ENVIANDO (TENTATIVA ' + attempt + '/' + max + ')...</span>';
      });

      isSubmitting = false;
      btn.innerHTML = '<span>🚀</span> <span>FINALIZAR E ENVIAR</span>';
      btn.style.opacity = '1';

      if (result.success) {
        document.getElementById('resultModal').classList.add('active');
        if (typeof confetti === 'function') {
          confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
        }
      } else {
        alert('⚠️ ATENÇÃO: Falha temporária na internet da escola!\n\nSuas respostas foram SALVAS COM TOTAL SEGURANÇA na memória deste aparelho e NÃO FORAM APAGADAS.\n\nAssim que o sinal de internet voltar, você pode clicar em Enviar novamente ou o sistema sincronizará automaticamente.');
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      initCRGrid();
      restoreDraft();
      updateProgress();
    });
  </script>

<!-- OVERLAY 1: AGUARDANDO LIBERAÇÃO DO PROFESSOR -->
  <div id="waitingForTeacherOverlay" style="display:none !important;" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(14px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: white; border-radius: 24px; max-width: 540px; width: 100%; padding: 40px 25px; text-align: center; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
      <div style="font-size: 4.5rem; margin-bottom: 15px;">⏳</div>
      <h2 style="color: #1e3a8a; font-family: 'Fredoka', sans-serif; font-size: 1.9rem; margin: 0 0 10px 0;">Aguardando o Professor Liberar</h2>
      <p style="color: #475569; font-size: 1.05rem; line-height: 1.5; margin-bottom: 20px;">
        Olá, <strong id="waitStudentName" style="color: #0284c7;">Estudante</strong>!<br>
        Você está conectado na turma <strong id="waitClassName">4º Ano</strong>.<br>
        O professor ainda não autorizou o início desta avaliação oficial. Aguarde as instruções em sala de aula!
      </p>
      <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 14px; padding: 14px; margin-bottom: 25px; font-size: 0.88rem; color: #1e40af; display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>🔄</span> <span>O sistema verifica automaticamente a cada 4 segundos...</span>
      </div>
      <button onclick="checkTeacherReleaseNow()" class="btn-submit-exam" style="width: 100%; padding: 14px; font-size: 1.1rem; font-weight: 800; border-radius: 12px; justify-content: center; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);">
        🔄 Verificar se o Professor Liberou
      </button>
    </div>
  </div>

  <!-- OVERLAY 2: LOGIN OU IDENTIFICAÇÃO DO ALUNO OBRIGATÓRIA -->
  <div id="loginRequiredOverlay" style="display:none !important;" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(14px); z-index: 99998; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: white; border-radius: 24px; max-width: 520px; width: 100%; padding: 35px 25px; text-align: center; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
      <div style="font-size: 3.5rem; margin-bottom: 12px;">🔒</div>
      <h2 style="color: #1e3a8a; font-family: 'Fredoka', sans-serif; font-size: 1.8rem; margin: 0 0 8px 0;">Avaliação Oficial da Turma</h2>
      <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 20px;">
        Para realizar este simulado, você precisa estar conectado à sua turma para que seu cabeçalho e nota sejam registrados com segurança.
      </p>
      
      <div style="background: #f8fafc; border: 2px dashed #93c5fd; border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: left;">
        <label style="display: block; font-weight: 800; color: #1e3a8a; font-size: 0.9rem; margin-bottom: 6px;">🔑 Digite o Código da sua Turma (ex: LK1234):</label>
        <div style="display: flex; gap: 8px;">
          <input type="text" id="quickClassCodeInput" placeholder="Ex: LK4829" maxlength="8" style="flex: 1; padding: 12px; font-size: 1.25rem; font-family: monospace; font-weight: 900; text-transform: uppercase; border: 2px solid #cbd5e1; border-radius: 10px; text-align: center;">
          <button onclick="lookupQuickClassCode()" style="background: #0284c7; color: white; border: none; padding: 0 20px; border-radius: 10px; font-weight: 800; cursor: pointer;">Buscar</button>
        </div>
        <div id="quickClassStatus" style="font-size: 0.85rem; margin-top: 8px;"></div>
      </div>

      <div id="quickStudentSelector" style="display: none; text-align: left; margin-bottom: 18px;">
        <label style="display: block; font-weight: 800; color: #1e3a8a; font-size: 0.9rem; margin-bottom: 6px;">👧👦 Quem é você na lista da turma?</label>
        <select id="quickStudentSelect" style="width: 100%; padding: 12px; border-radius: 10px; border: 2px solid #0284c7; font-size: 1rem; font-weight: 700; background: white;" onchange="confirmQuickStudent(this.value)">
          <option value="">-- Selecione seu Nome --</option>
        </select>
      </div>

      <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; margin-top: 15px;">
        <a href="/aluno" class="btn-submit-exam" style="text-decoration: none; background: #10b981; padding: 12px; border-radius: 10px; font-weight: 800; font-size: 0.95rem; justify-content: center;">
          👤 Entrar pelo Portal do Aluno Completo
        </a>
      </div>
    </div>
  </div>

  <script>
    // ============================================================================
    // CONTROLE DE ACESSO DO PROFESSOR E PREENCHIMENTO AUTOMÁTICO DO CABEÇALHO
    // ============================================================================
    let activePollTimer = null;
    let cachedFoundStudents = [];
    let currentStudentProfile = null;

    async function checkAndEnforceStudentAuth() {
      // Modo Livre / Teste: libera acesso direto para qualquer aluno sem travas
      let profileRaw = localStorage.getItem('lab_student_profile');

      try {
        currentStudentProfile = JSON.parse(profileRaw);
      } catch(e) {
        localStorage.removeItem('lab_student_profile');
        document.getElementById('loginRequiredOverlay').style.display = 'flex';
        return;
      }

      if (!currentStudentProfile || !currentStudentProfile.name) {
        document.getElementById('loginRequiredOverlay').style.display = 'flex';
        return;
      }

      // 2. Aluno autenticado: PREENCHE AUTOMATICAMENTE O CABEÇALHO
      document.getElementById('loginRequiredOverlay').style.display = 'none';

      const sName = currentStudentProfile.name;
      const sSchool = currentStudentProfile.school_name || currentStudentProfile.school || 'E.M. José Giró Faísca';
      const sClass = currentStudentProfile.class_name || currentStudentProfile.class || '4º Ano B';
      const sShift = currentStudentProfile.shift || 'Manhã';

      const stNameEl = document.getElementById('studentName');
      const scNameEl = document.getElementById('schoolName');
      const clNameEl = document.getElementById('className');
      const shNameEl = document.getElementById('shiftName');

      stNameEl.value = sName;
      stNameEl.readOnly = true;
      stNameEl.style.backgroundColor = '#f1f5f9';
      stNameEl.style.cursor = 'not-allowed';

      scNameEl.value = sSchool;
      scNameEl.readOnly = true;
      scNameEl.style.backgroundColor = '#f1f5f9';
      scNameEl.style.cursor = 'not-allowed';

      // Set class dropdown if options exist, or set value
      let optFound = Array.from(clNameEl.options).some(o => o.value === sClass);
      if (!optFound) {
        const newOpt = document.createElement('option');
        newOpt.value = sClass;
        newOpt.innerText = sClass;
        clNameEl.appendChild(newOpt);
      }
      clNameEl.value = sClass;
      clNameEl.disabled = true;
      clNameEl.style.backgroundColor = '#f1f5f9';

      shNameEl.value = sShift;
      shNameEl.disabled = true;
      shNameEl.style.backgroundColor = '#f1f5f9';

      // Mostra o banner de estudante identificado
      document.getElementById('verifiedStudentBanner').style.display = 'block';
      document.getElementById('bannerStudentName').innerText = sName;
      document.getElementById('bannerStudentInfo').innerText = sClass + ' • ' + sSchool;

      // 3. Checa se o simulado está LIBERADO pelo professor para a turma
      await verifySimuladoRelease(currentStudentProfile);
    }

    async function verifySimuladoRelease(st) {
      const waitOverlay = document.getElementById('waitingForTeacherOverlay');
      try {
        const query = new URLSearchParams({
          simulado_id: SIMULADO_ID,
          class_id: st.class_id || '',
          class_name: st.class_name || st.class || '',
          school_name: st.school_name || st.school || '',
          student_id: st.id || ''
        });

        const res = await fetch('/api/simulado/check-access?' + query.toString());
        const data = await res.json();

        if (data.allowed) {
          // PROVA LIBERADA!
          waitOverlay.style.display = 'none';
          if (activePollTimer) {
            clearInterval(activePollTimer);
            activePollTimer = null;
          }
        } else {
          // PROVA BLOQUEADA / AGUARDANDO PROFESSOR
          document.getElementById('waitStudentName').innerText = st.name;
          document.getElementById('waitClassName').innerText = st.class_name || '4º Ano';
          waitOverlay.style.display = 'none';

          // Inicia verificação periódica a cada 4 segundos
          if (!activePollTimer) {
            activePollTimer = setInterval(() => {
              if (currentStudentProfile) verifySimuladoRelease(currentStudentProfile);
            }, 4000);
          }
        }
      } catch (err) {
        console.warn('Erro ao verificar liberação:', err);
      }
    }

    async function checkTeacherReleaseNow() {
      if (currentStudentProfile) {
        await verifySimuladoRelease(currentStudentProfile);
      } else {
        await checkAndEnforceStudentAuth();
      }
    }

    // Busca rápida da turma pelo código de 6 dígitos
    async function lookupQuickClassCode() {
      const codeInput = document.getElementById('quickClassCodeInput');
      const statusEl = document.getElementById('quickClassStatus');
      const rawCode = codeInput.value.trim().toUpperCase();
      if (!rawCode || rawCode.length < 3) {
        statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">Digite o código da turma!</span>';
        return;
      }

      statusEl.innerHTML = '<span style="color:#0284c7; font-weight:700;">⏳ Localizando turma...</span>';

      try {
        const res = await fetch('/api/classes/by-code/' + rawCode);
        const data = await res.json();
        if (!data.success || !data.class) {
          statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">❌ ' + (data.error || 'Código não encontrado!') + '</span>';
          return;
        }

        const cls = data.class;
        statusEl.innerHTML = '<span style="color:#15803d; font-weight:800;">✓ Turma encontrada: ' + cls.class_name + ' (' + cls.school_name + ')</span>';

        // Busca alunos da turma
        const stRes = await fetch('/api/classes/' + (cls.teacher_class_id || cls.id) + '/students');
        const stData = await stRes.json();
        const students = Array.isArray(stData) ? stData : (stData.students || []);
        cachedFoundStudents = students;

        const selectEl = document.getElementById('quickStudentSelect');
        selectEl.innerHTML = '<option value="">-- Clique e selecione seu Nome --</option>';

        students.forEach(s => {
          const opt = document.createElement('option');
          opt.value = s.id;
          opt.innerText = s.name;
          selectEl.appendChild(opt);
        });

        document.getElementById('quickStudentSelector').style.display = 'block';
      } catch(e) {
        statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">Erro ao buscar turma: ' + e.message + '</span>';
      }
    }

    function confirmQuickStudent(studentId) {
      if (!studentId) return;
      const found = cachedFoundStudents.find(s => String(s.id) === String(studentId));
      if (!found) return;

      localStorage.setItem('lab_student_profile', JSON.stringify(found));
      checkAndEnforceStudentAuth();
    }

    function logoutStudentAndSwitch() {
      if (!confirm('Deseja trocar de aluno neste aparelho?')) return;
      localStorage.removeItem('lab_student_profile');
      location.reload();
    }

    // Inicialização ao carregar a página
    window.addEventListener('DOMContentLoaded', () => {
      checkAndEnforceStudentAuth();
    });
  </script>
</body>
</html>


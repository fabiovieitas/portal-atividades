  <script>
    const answerKey = {
      1: 'D',
      2: 'C',
      3: 'A',
      4: 'B',
      5: 'B',
      6: 'D',
      7: 'A',
      8: 'C',
      9: 'D',
      10: 'C'
    };

    let studentAnswers = {};
    let isSubmitted = false;
    const SIMULADO_KEY = 'lab_simulado_4ano_setembro_draft';

    function saveDraft() {
      if (isSubmitted) return;
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        className: document.getElementById('className')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        answers: studentAnswers
      };
      try { localStorage.setItem(SIMULADO_KEY, JSON.stringify(draft)); } catch(e){}
    }

    function restoreDraft() {
      try {
        const raw = localStorage.getItem(SIMULADO_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft.studentName) document.getElementById('studentName').value = draft.studentName;
        if (draft.schoolName) document.getElementById('schoolName').value = draft.schoolName;
        if (draft.className) document.getElementById('className').value = draft.className;
        if (draft.shiftName) document.getElementById('shiftName').value = draft.shiftName;

        if (draft.answers) {
          for (let q in draft.answers) {
            const opt = draft.answers[q];
            const radio = document.querySelector(`input[name="q${q}"][value="${opt}"]`);
            if (radio) {
              radio.checked = true;
              updateCartao(q, opt, false);
            }
          }
        }
      } catch(e){}
    }

    window.addEventListener('DOMContentLoaded', () => {
      restoreDraft();
      document.getElementById('studentName')?.addEventListener('input', saveDraft);
      document.getElementById('schoolName')?.addEventListener('change', saveDraft);
      document.getElementById('className')?.addEventListener('change', saveDraft);
      document.getElementById('shiftName')?.addEventListener('change', saveDraft);
    });

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if (radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt, shouldSave = true) {
      studentAnswers[qNum] = opt;
      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if (dot) dot.classList.remove('selected');
      });
      const dot = document.getElementById(`b-${qNum}-${opt}`);
      if (dot) dot.classList.add('selected');
      updateProgress();
      if (shouldSave) saveDraft();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const progressPercent = Math.round((totalAnswered / 10) * 100);
      const fill = document.getElementById('progressFill');
      const text = document.getElementById('progressText');
      if (fill) fill.style.width = `${progressPercent}%`;
      if (text) text.innerText = `${totalAnswered} de 10 respondidas`;
    }

    function toggleGabaritoModal() {
      const modal = document.getElementById('gabaritoModal');
      if (modal) modal.classList.toggle('active');
    }

    function closeMissingModal() {
      document.getElementById('missingModal').classList.remove('active');
    }

    async function submitSimulado() {
      const name = document.getElementById('studentName').value.trim();
      if (!name) {
        alert('Por favor, informe seu Nome Completo antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      for (let i = 1; i <= 10; i++) {
        if (!studentAnswers[i]) {
          missing.push(`Questão ${i < 10 ? '0' + i : i}`);
        }
      }

      if (missing.length > 0) {
        document.getElementById('missingQuestionsList').innerHTML = missing.map(m => `<div>• ${m}</div>`).join('');
        document.getElementById('missingModal').classList.add('active');
        return;
      }

      let score = 0;
      for (let i = 1; i <= 10; i++) {
        if (studentAnswers[i] === answerKey[i]) score++;
      }

      const payload = {
        simulado_id: 'campos-4ano-setembro-2026',
        student_name: name,
        school_name: document.getElementById('schoolName').value.trim(),
        class_name: document.getElementById('className').value || '4º Ano',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 10,
        essay_text: ''
      };

      try {
        await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch(err) {
        console.error('Submit error:', err);
      }

      isSubmitted = true;
      try { localStorage.removeItem(SIMULADO_KEY); } catch(e){}

      document.getElementById('finalScoreDisplay').innerText = `${score} / 10`;
      document.getElementById('resultModal').classList.add('active');
      if (typeof confetti === 'function') confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
    }
  </script>

</body>
</html>

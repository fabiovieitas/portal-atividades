<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bloco de Notas Online — Tipo Dontpad</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --card-border: #334155;
      --primary: #38bdf8;
      --primary-hover: #0284c7;
      --text: #f8fafc;
      --subtext: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .container {
      max-width: 520px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 36px 28px;
      box-shadow: 0 25px 60px rgba(0,0,0,0.4);
      text-align: center;
    }

    .icon-box {
      font-size: 3.5rem;
      margin-bottom: 12px;
      display: inline-block;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    h1 {
      font-size: 1.9rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    p {
      color: var(--subtext);
      font-size: 0.98rem;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .input-box {
      display: flex;
      align-items: center;
      background: #0f172a;
      border: 2px solid var(--card-border);
      border-radius: 14px;
      padding: 4px 6px 4px 14px;
      margin-bottom: 16px;
      transition: border-color 0.2s ease;
    }

    .input-box:focus-within {
      border-color: var(--primary);
    }

    .url-prefix {
      color: var(--subtext);
      font-family: 'Fira Code', monospace;
      font-size: 1rem;
      font-weight: 600;
      user-select: none;
    }

    input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #ffffff;
      font-family: 'Fira Code', monospace;
      font-size: 1.15rem;
      font-weight: 700;
      padding: 10px 8px;
    }

    input::placeholder {
      color: #475569;
    }

    .btn-open {
      background: var(--primary);
      color: #0f172a;
      border: none;
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 10px 18px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .btn-open:hover {
      background: #7dd3fc;
      transform: translateY(-1px);
    }

    .quick-examples {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
      border-top: 1px solid var(--card-border);
      padding-top: 20px;
    }

    .chip {
      background: #0f172a;
      color: var(--primary);
      text-decoration: none;
      font-family: 'Fira Code', monospace;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid #334155;
      transition: all 0.15s ease;
    }

    .chip:hover {
      background: #334155;
      color: #ffffff;
    }

    .footer-note {
      margin-top: 24px;
      font-size: 0.82rem;
      color: #64748b;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="icon-box">📝</div>
    <h1>Bloco de Notas Online</h1>
    <p>
      Digite qualquer caminho para abrir um bloco de notas em tempo real. O que você digita no PC aparece instantaneamente no celular!
    </p>

    <form onsubmit="openPad(event)">
      <div class="input-box">
        <span class="url-prefix">labkids.online/</span>
        <input type="text" id="padNameInput" placeholder="ex: 123" autofocus autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
        <button type="submit" class="btn-open">Abrir 🚀</button>
      </div>
    </form>

    <div class="quick-examples">
      <span style="width: 100%; font-size: 0.82rem; color: #64748b; margin-bottom: 4px;">Atalhos rápidos:</span>
      <a href="/123" class="chip">/123</a>
      <a href="/celular" class="chip">/celular</a>
      <a href="/notas" class="chip">/notas</a>
      <a href="/clip" class="chip">/clip</a>
      <a href="javascript:void(0)" onclick="openRandomPad()" class="chip" style="color: #4ade80;">🎲 Gerar Aleatório</a>
    </div>

    <div class="footer-note">
      ⚡ Inspirado no Dontpad • Sincronização ultra-rápida entre dispositivos
    </div>
  </div>

  <script>
    function openPad(e) {
      if (e) e.preventDefault();
      const input = document.getElementById('padNameInput');
      const val = (input.value || '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '');
      if (val) {
        window.location.href = '/' + val;
      } else {
        openRandomPad();
      }
    }

    function openRandomPad() {
      const chars = 'abcdefghjkmnpqrstuvwxyz23456789';
      let rand = '';
      for (let i = 0; i < 4; i++) {
        rand += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      window.location.href = '/' + rand;
    }
  </script>
</body>
</html>

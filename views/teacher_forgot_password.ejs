<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Recuperar Senha — Portal Lab Kids</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" sizes="512x512" href="/img/robot-icon-512.png">
  <link rel="stylesheet" href="/css/style.css?v=3">
  <link rel="stylesheet" href="/css/admin_fixes.css?v=2">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0b1120 0%, #1e1b4b 50%, #0f172a 100%);
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
      color: #1e293b;
    }
    .auth-card {
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(56, 189, 248, 0.2);
      max-width: 480px;
      width: 100%;
      padding: 40px 35px;
      text-align: center;
      overflow: hidden;
      position: relative;
    }
    .card-logo {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      border: 3px solid #38bdf8;
      box-shadow: 0 8px 24px rgba(56, 189, 248, 0.35);
      margin-bottom: 16px;
      display: inline-block;
    }
    .card-title {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.85rem;
      color: #0f172a;
      margin: 0 0 8px 0;
    }
    .card-desc {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.55;
      margin-bottom: 25px;
    }
    .form-group {
      margin-bottom: 20px;
      text-align: left;
    }
    .form-group label {
      display: block;
      font-weight: 700;
      font-size: 0.88rem;
      color: #334155;
      margin-bottom: 6px;
    }
    .form-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      font-size: 1rem;
      font-family: 'Outfit', sans-serif;
      color: #0f172a;
      transition: all 0.2s;
      box-sizing: border-box;
    }
    .form-input:focus {
      border-color: #0284c7;
      outline: none;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }
    .btn-submit {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      font-family: 'Fredoka', 'Outfit', sans-serif;
      transition: all 0.2s;
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.45);
    }
    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border-left: 4px solid #ef4444;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 0.9rem;
      margin-bottom: 20px;
      text-align: left;
    }
    .alert-success {
      background: #f0fdf4;
      color: #15803d;
      border-left: 4px solid #22c55e;
      padding: 14px 16px;
      border-radius: 8px;
      font-size: 0.92rem;
      line-height: 1.5;
      margin-bottom: 25px;
      text-align: left;
    }
    .back-link {
      display: inline-block;
      margin-top: 22px;
      color: #64748b;
      font-weight: 600;
      text-decoration: none;
      font-size: 0.92rem;
      transition: color 0.15s;
    }
    .back-link:hover {
      color: #0284c7;
    }
  </style>
</head>
<body>

  <div class="auth-card">
    <img src="/img/robot-icon-512.png" alt="Robô Lab Kids" class="card-logo">
    <h1 class="card-title">Esqueci Minha Senha</h1>
    <p class="card-desc">Digite o e-mail cadastrado na sua conta de educador para receber as instruções de redefinição.</p>

    <% if (error) { %>
      <div class="alert-error">⚠️ <%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert-success">
        ✅ <strong>Link Enviado!</strong><br>
        <%= success %>
      </div>
      <div>
        <a href="/professor/login" class="btn-submit" style="display: block; text-decoration: none; text-align: center; box-sizing: border-box;">
          Voltar para o Login
        </a>
      </div>
    <% } else { %>
      <form action="/professor/esqueci-senha" method="POST">
        <div class="form-group">
          <label for="email">E-mail Cadastrado</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="ex: professor@escola.com ou seu Gmail" required autofocus>
        </div>
        <button type="submit" class="btn-submit">Enviar Link de Recuperação 🚀</button>
      </form>
    <% } %>

    <div>
      <a href="/professor/login" class="back-link">⬅ Voltar para o Login</a>
    </div>
  </div>

</body>
</html>

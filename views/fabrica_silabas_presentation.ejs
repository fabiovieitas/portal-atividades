        .pedagogical-card h2 { color: #34d399; font-size: 1.5rem; margin-top: 0; display: flex; align-items: center; gap: 10px; }
        .bncc-badge { background: #059669; color: white; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: inline-block; margin: 4px; }
        .step-box { background: rgba(15, 23, 42, 0.6); border-left: 4px solid #10b981; padding: 15px 20px; border-radius: 0 16px 16px 0; margin-bottom: 15px; }

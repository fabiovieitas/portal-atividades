<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fábrica de Sílabas - Guia BNCC | Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
    <!-- Google AdSense Official Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Fredoka', sans-serif; min-height: 100vh; padding: 20px 10px; margin: 0; }
        .presentation-box { max-width: 850px; margin: 0 auto; background: #1e293b; border-radius: 28px; padding: 35px; border: 2px solid #10b981; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
        .bncc-chip { background: #6366f1; color: white; padding: 6px 16px; border-radius: 50px; font-weight: 800; font-size: 0.9rem; margin: 4px; display: inline-block; }
        .btn-launch-game { display: inline-flex; align-items: center; gap: 10px; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 16px 40px; border-radius: 50px; font-weight: 800; font-size: 1.3rem; text-decoration: none; box-shadow: 0 8px 25px rgba(16,185,129,0.4); border: 2px solid rgba(255,255,255,0.3); margin-top: 20px; }
    </style>
</head>
<body>
    <div class="presentation-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <a href="/" style="color: white; text-decoration: none; font-weight: 700;">⬅️ Voltar ao Portal</a>
            <span style="color: #10b981; font-weight: 700;">🔤 Alfabetização</span>
        </div>

        <h1 style="color: #fbbf24; font-size: 2.5rem; margin: 10px 0;">Fábrica de Sílabas & Palavras</h1>
        <p style="color: #cbd5e1; font-size: 1.15rem;">Junte sílabas simples para formar palavras e acelerar o processo de hipótese silábica e leitura.</p>

        <div>
            <span class="bncc-chip">EF01LP08</span>
            <span class="bncc-chip">EF01LP10</span>
        </div>

        <div style="margin: 25px 0;">
            <a href="/games/fabrica-de-silabas/index.html" class="btn-launch-game">🎮 ABRIR FÁBRICA DE SÍLABAS AGORA 🚀</a>
        </div>

        <!-- AdSense Banner Container (Ultra-Fino Horizontal) -->
        <div class="adsense-box" style="background: rgba(15, 23, 42, 0.6); border: 1px dashed rgba(255,255,255,0.2); border-radius: 12px; padding: 4px 8px; text-align: center; margin-top: 14px;">
            <div class="adsense-micro-label">📢 Publicidade Educativa</div>
            <ins class="adsbygoogle" style="display:block; max-height:90px; width:100%;" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567890" data-ad-format="horizontal" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>
    </div>
</body>
</html>

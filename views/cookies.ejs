    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #f1f5f9;
            color: #0f172a;
            line-height: 1.75;
            margin: 0;
            padding: 0;
        }

        .header-box {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
            color: white;
            padding: 4rem 1.5rem 5rem 1.5rem;
            text-align: center;
        }

        .header-box h1 {
            font-family: 'Fredoka', sans-serif;
            font-size: clamp(2rem, 4.5vw, 3rem);

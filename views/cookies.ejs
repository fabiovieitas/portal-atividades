<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Política de Cookies — Portal Lab Kids</title>
    <meta name="description" content="Saiba como o Portal Lab Kids utiliza cookies essenciais e de publicidade em conformidade com as diretrizes do Google AdSense e a LGPD.">
    
    <link rel="stylesheet" href="/css/style.css?v=4">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

                colorHeading.innerHTML = '🎨 Escolha a Cor do Traje:';
                container.appendChild(colorHeading);

                P.clothesColors.forEach(cc => {
                    const isSel = (avatarConfig.clothesColor || '5199e4').replace('#', '') === cc.hex.replace('#', '');
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; padding:8px 4px; border-radius:14px; min-height:75px; cursor:pointer; background:#ffffff;';
                    tile.onclick = () => {
                        ensureAvataaarsStyle();
                        avatarConfig.clothesColor = cc.hex;
                        renderTabContent();

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área do Aluno - Portal de Atividades Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
    <script src="/js/avatar_system.js"></script>
    <style>
        :root {
            --duo-green: #58cc02;
            --duo-green-dark: #46a302;
            --duo-blue: #1cb0f6;
            --duo-blue-dark: #1899d6;
            --duo-card-bg: #ffffff;
            --duo-border: #e5e5e5;
            --duo-text-dark: #3c3c3c;
            --app-bg: #f7f7f7;
        }

        body.student-theme {
            background: var(--app-bg);
            color: var(--duo-text-dark);
            font-family: 'Nunito', 'Fredoka', sans-serif;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
        }

        .portal-header {
            text-align: center;
            margin-bottom: 20px;
            position: relative;
        }

        .portal-header h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin: 0;
            color: #3c3c3c;
        }

        .portal-header p {
            color: #777777;
            font-size: 1.05rem;
            margin-top: 4px;
            font-weight: 700;
        }

        .btn-top-logout {
            position: absolute;
            right: 10px;
            top: 0;
            background: #ff4b4b;
            border: none;
            border-bottom: 4px solid #ea2b2b;
            color: white;
            padding: 8px 18px;
            border-radius: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-top-logout:hover {
            transform: translateY(-2px);
            background: #ff3333;
        }

        /* Step Bar */
        .step-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .step-pill {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 800;
            color: #afafaf;
            transition: 0.2s;
        }

        .step-pill.active {
            background: var(--duo-blue);
            color: #ffffff;
            border-color: var(--duo-blue-dark);
            box-shadow: 0 4px 0 var(--duo-blue-dark);
        }

        /* Selection Grid */
        .grid-selection {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            max-width: 950px;
            margin: 0 auto;
        }

        .card-item {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .card-item:hover {
            transform: translateY(-4px);
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
        }

        .card-item.in-use {
            border-color: var(--duo-green);
            border-bottom-color: var(--duo-green-dark);
            background: #f1fbe8;
        }

        .card-item .icon-box {
            font-size: 3rem;
            margin-bottom: 8px;
        }

        .card-item h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0 0 4px 0;
            color: var(--duo-text-dark);
        }

        /* DUOLINGO OFFICIAL AVATAR EDITOR LAYOUT */
        .duo-editor-window {
            display: flex;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-radius: 24px;
            overflow: hidden;
            max-width: 1050px;
            margin: 0 auto;
            min-height: 520px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

        /* Left Canvas Preview Area */
        .duo-canvas-side {
            flex: 1.1;
            min-width: 320px;
            background: #e55b5b;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            position: relative;
            transition: background 0.3s ease;
        }

        .duo-canvas-avatar-wrapper {
            transform: scale(1.35);
            margin-bottom: 20px;
        }

        .duo-name-input {
            width: 85%;
            padding: 12px;
            border-radius: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            background: rgba(0, 0, 0, 0.25);
            color: #ffffff;
            font-weight: 800;
            font-size: 1.1rem;
            text-align: center;
            outline: none;
            backdrop-filter: blur(5px);
        }

        .duo-name-input::placeholder {
            color: rgba(255,255,255,0.7);
        }

        .btn-duo-save {
            background: var(--duo-green);
            border: none;
            border-bottom: 4px solid var(--duo-green-dark);
            color: #ffffff;
            font-weight: 900;
            font-size: 1.2rem;
            padding: 14px 32px;
            border-radius: 18px;
            cursor: pointer;
            width: 85%;
            margin-top: 15px;
            transition: 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-duo-save:hover {
            transform: translateY(-2px);
            background: #61e002;
        }

        .btn-duo-save:active {
            transform: translateY(2px);
            border-bottom-width: 0;
        }

        /* Right Panel Customizer Side */
        .duo-panel-side {
            flex: 1.4;
            min-width: 340px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            border-left: 2px solid var(--duo-border);
        }

        /* Top Horizontal Icon Tabs Bar */
        .duo-tabs-nav {
            display: flex;
            overflow-x: auto;
            border-bottom: 2px solid var(--duo-border);
            padding: 10px 10px 0 10px;
            gap: 4px;
            background: #ffffff;
            scrollbar-width: none;
        }

        .duo-tabs-nav::-webkit-scrollbar { display: none; }

        .duo-tab-icon {
            flex: 0 0 auto;
            padding: 10px 14px;
            border-radius: 12px 12px 0 0;
            font-size: 1.4rem;
            cursor: pointer;
            color: #afafaf;
            border-bottom: 3px solid transparent;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .duo-tab-icon:hover {
            color: var(--duo-blue);
            background: #f7f7f7;
        }

        .duo-tab-icon.active {
            color: var(--duo-blue);
            border-bottom-color: var(--duo-blue);
            background: #ffffff;
        }

        /* Content Panel Inside Tab */
        .duo-tab-content {
            padding: 20px;
            overflow-y: auto;
            max-height: 480px;
            flex: 1;
        }

        .duo-category-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--duo-text-dark);
            margin: 0 0 15px 0;
        }

        /* 3-Column Grid Tiles */
        .duo-tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .duo-tile-card {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 16px;
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.15s;
            position: relative;
            padding: 6px;
        }

        .duo-tile-card:hover {
            border-color: var(--duo-blue);
            transform: translateY(-2px);
        }

        .duo-tile-card.selected {
            background: #ddf4ff;
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
            box-shadow: 0 0 0 2px var(--duo-blue);
        }

        .duo-color-swatch {
            width: 100%;
            height: 100%;
            border-radius: 12px;
        }

        .btn-back {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            color: var(--duo-text-dark);
            padding: 8px 18px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 800;
            margin-bottom: 15px;
        }

        /* PIN Modal */
        .pin-container {
            max-width: 380px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 5px solid var(--duo-border);
            border-radius: 24px;
            padding: 25px;
            text-align: center;
        }

        .pin-input {
            font-size: 2.2rem;
            letter-spacing: 10px;
            text-align: center;
            width: 80%;
            padding: 10px;
            border-radius: 16px;
            border: 2px solid var(--duo-blue);
            background: #f7f7f7;
            color: var(--duo-text-dark);
            font-weight: 800;
            margin: 15px 0;
            outline: none;
        }
    </style>
</head>
<body class="student-theme">

    <div class="container" style="max-width: 1080px; margin: 0 auto;">
        <div class="portal-header">
            <button id="btn-header-logout" class="btn-top-logout" onclick="logoutStudent()" style="display:none;">
                🚪 SAIR
            </button>
            <h1>Edite o seu Avatar</h1>
            <p>Monte seu perfil exatamente no estilo oficial do Duolingo!</p>
        </div>

        <!-- Step Indicator -->
        <div class="step-bar">
            <div class="step-pill" id="step-pill-1">1. Escola 🏫</div>
            <div class="step-pill" id="step-pill-2">2. Turma & PIN 🔑</div>
            <div class="step-pill" id="step-pill-3">3. Escolha seu Nome 👤</div>
            <div class="step-pill" id="step-pill-4">4. Criador de Avatar 🎨</div>
            <div class="step-pill" id="step-pill-5">5. Perfil & Jogos 🏆</div>
        </div>

        <button id="btn-global-back" class="btn-back" onclick="goBackStep()" style="display:none;">⬅️ Voltar</button>

        <!-- VIEW 1: SELECT SCHOOL -->
        <div id="view-school" class="step-view">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 20px;">Selecione a sua Escola:</h2>
            <div class="grid-selection" id="schools-container">
                <p style="text-align: center; width: 100%;">Carregando escolas...</p>
            </div>
        </div>

        <!-- VIEW 2: SELECT CLASS & PIN -->
        <div id="view-class" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 15px;" id="school-title">Turmas da Escola</h2>
            <div class="grid-selection" id="classes-container" style="margin-bottom: 25px;">
                <!-- Classes loaded here -->
            </div>

            <div id="pin-box" class="pin-container" style="display:none;">
                <h3 style="margin: 0; color: var(--duo-blue);">🔑 Digite o PIN da Turma:</h3>
                <input type="password" id="pin-input" class="pin-input" maxlength="6" placeholder="****">
                <button class="btn-duo-save" style="width: 100%;" onclick="submitPin()">LIBERAR TURMA 🚀</button>
                <p id="pin-error" style="color: #ff4b4b; font-weight: 800; margin-top: 10px; display:none;"></p>
            </div>
        </div>

        <!-- VIEW 3: SELECT STUDENT OR CREATE NEW -->
        <div id="view-students" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 8px;">Quem é você?</h2>
            <p style="text-align: center; color: #777; margin-bottom: 20px;">Clique no seu perfil ou crie um novo avatar!</p>
            
            <div style="text-align: center; margin-bottom: 20px;">
                <button class="btn-duo-save" style="max-width: 340px;" onclick="openAvatarBuilderForNew()">
                    ✨ CRIAR NOVO AVATAR DUOLINGO
                </button>
            </div>

            <div class="grid-selection" id="students-container">
                <!-- Students loaded here -->
            </div>
        </div>

        <!-- VIEW 4: OFFICIAL DUOLINGO AVATAR EDITOR -->
        <div id="view-avatar-builder" class="step-view" style="display:none;">
            <div class="duo-editor-window">
                <!-- Left Side: Canvas Preview & Name Input -->
                <div class="duo-canvas-side" id="duo-canvas-bg">
                    <div class="duo-canvas-avatar-wrapper" id="duo-avatar-preview"></div>
                    <input type="text" id="student-name-input" class="duo-name-input" placeholder="Digite seu nome...">
                    <button class="btn-duo-save" onclick="saveAvatarProfile()">PRONTO</button>
                </div>

                <!-- Right Side: Duolingo Horizontal Tab Bar & Grid Customizer -->
                <div class="duo-panel-side">
                    <!-- Top Icon Tabs -->
                    <div class="duo-tabs-nav">
                        <div class="duo-tab-icon active" onclick="switchDuoTab('styles')" title="Estilo de Avatar">🎨</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('skin')" title="Tom da pele">👤</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('hair')" title="Cabelo">💇</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('beards')" title="Barba / Fade">🧔</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('glasses')" title="Óculos">👓</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('clothes')" title="Roupas">👕</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('eyes')" title="Olhos / Expressão">👀</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('bg')" title="Cor de Fundo">🖼️</div>
                    </div>

                    <!-- Active Tab Content Area -->
                    <div class="duo-tab-content">
                        <div class="duo-category-title" id="duo-tab-title">Tom da pele</div>
                        <div class="duo-tiles-grid" id="duo-tiles-container">
                            <!-- 3-Column Grid Tiles loaded dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW 5: ACTIVE PROFILE -->
        <div id="view-profile" class="step-view" style="display:none;">
            <div style="max-width: 550px; margin: 0 auto; background: #ffffff; border: 2px solid var(--duo-border); border-bottom: 5px solid var(--duo-border); border-radius: 24px; padding: 30px; text-align: center;">
                <div id="active-avatar-display" style="margin-bottom: 15px;"></div>
                <h2 id="active-student-name" style="margin: 0; font-size: 2rem; color: var(--duo-text-dark);">Nome do Aluno</h2>
                <p id="active-student-school" style="color: #777; font-size: 1rem; margin-top: 4px; font-weight: 700;"></p>

                <div style="display: flex; justify-content: center; gap: 15px; margin: 20px 0;">
                    <div style="background: #f7f7f7; border: 2px solid var(--duo-border); padding: 10px 18px; border-radius: 16px;">
                        <span style="font-size: 1.6rem; font-weight: 900; color: var(--duo-blue);" id="active-points">0</span>
                        <div style="font-size: 0.85rem; color: #777; font-weight: 800;">Pontos</div>
                    </div>
                    <div style="background: #f7f7f7; border: 2px solid var(--duo-border); padding: 10px 18px; border-radius: 16px;">
                        <span style="font-size: 1.6rem; font-weight: 900; color: var(--duo-green);" id="active-medals-count">0</span>
                        <div style="font-size: 0.85rem; color: #777; font-weight: 800;">Medalhas</div>
                    </div>
                </div>

                <div style="margin-top: 25px; display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/?level=1-5" class="btn-duo-save" style="flex:1; text-decoration: none; text-align: center; margin: 0;">🚀 JOGAR AGORA</a>
                    <button onclick="editCurrentAvatar()" class="btn-back" style="margin: 0; padding: 12px 18px;">✏️ Editar Avatar</button>
                    <button onclick="logoutStudent()" class="btn-back" style="margin: 0; background: #fff0f0; border-color: #ff4b4b; color: #ff4b4b; padding: 12px 18px;">🚪 Sair</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentStep = 1;
        let activeTab = 'skin';
        let selectedSchool = null;
        let selectedClass = null;
        let selectedStudent = null;

        // Customizer state (DiceBear Studio Engine)
        let avatarConfig = {
            style: 'avataaars',
            seed: 'Student' + Math.floor(Math.random() * 1000),
            skinColor: 'ffdbb4',
            hairStyle: 'shortHairShortFlat',
            hairColor: 'black',
            beard: 'blank',
            glasses: 'blank',
            outfit: 'overall',
            outfitColor: '1cb0f6',
            eyes: 'default',
            bg: 'e55b5b'
        };

        window.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('lab_student_profile');
            if (saved) {
                try {
                    selectedStudent = JSON.parse(saved);
                    showStep(5);
                    renderProfileView();
                    return;
                } catch(e){}
            }
            loadSchools();
            renderTabContent();
            updateDuoPreview();
        });

        function showStep(step) {
            currentStep = step;
            document.querySelectorAll('.step-view').forEach(v => v.style.display = 'none');
            document.querySelectorAll('.step-pill').forEach((p, idx) => {
                if (idx + 1 === step) p.classList.add('active');
                else p.classList.remove('active');
            });

            document.getElementById('btn-global-back').style.display = (step > 1 && step !== 5) ? 'inline-block' : 'none';
            document.getElementById('btn-header-logout').style.display = (step === 5 || localStorage.getItem('lab_student_profile')) ? 'block' : 'none';

            if (step === 1) document.getElementById('view-school').style.display = 'block';
            if (step === 2) document.getElementById('view-class').style.display = 'block';
            if (step === 3) document.getElementById('view-students').style.display = 'block';
            if (step === 4) document.getElementById('view-avatar-builder').style.display = 'block';
            if (step === 5) document.getElementById('view-profile').style.display = 'block';
        }

        function goBackStep() {
            if (currentStep > 1) showStep(currentStep - 1);
        }

        async function loadSchools() {
            showStep(1);
            const res = await fetch('/api/schools');
            const schools = await res.json();
            const container = document.getElementById('schools-container');
            container.innerHTML = '';
            schools.forEach(s => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => selectSchool(s);
                card.innerHTML = `
                    <div class="icon-box">🏫</div>
                    <h3>${s.name}</h3>
                    <p style="color:#777; margin:0;">${s.city}</p>
                `;
                container.appendChild(card);
            });
        }

        async function selectSchool(school) {
            selectedSchool = school;
            document.getElementById('school-title').innerText = school.name;
            showStep(2);
            document.getElementById('pin-box').style.display = 'none';

            const res = await fetch(`/api/schools/${school.id}/classes`);
            const classes = await res.json();
            const container = document.getElementById('classes-container');
            container.innerHTML = '';

            classes.forEach(c => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => openPinBox(c);
                card.innerHTML = `
                    <div class="icon-box">👥</div>
                    <h3>${c.name}</h3>
                    <p style="color:#777; margin:0;">${c.grade_level || 'Turma Escolar'}</p>
                `;
                container.appendChild(card);
            });
        }

        function openPinBox(cls) {
            selectedClass = cls;
            document.getElementById('pin-box').style.display = 'block';
            document.getElementById('pin-input').value = '';
            document.getElementById('pin-error').style.display = 'none';
            document.getElementById('pin-input').focus();
        }

        async function submitPin() {
            const pin = document.getElementById('pin-input').value;
            if (!pin) return;
            const res = await fetch('/api/classes/verify-pin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ class_id: selectedClass.id, pin })
            });
            const data = await res.json();
            if (data.success) {
                loadStudentsByClass();
            } else {
                const err = document.getElementById('pin-error');
                err.innerText = 'PIN incorreto!';
                err.style.display = 'block';
            }
        }

        async function loadStudentsByClass() {
            showStep(3);
            const res = await fetch(`/api/classes/${selectedClass.id}/students`);
            const students = await res.json();
            const container = document.getElementById('students-container');
            container.innerHTML = '';

            const currentActive = localStorage.getItem('lab_student_profile');
            let activeId = null;
            if (currentActive) {
                try { activeId = JSON.parse(currentActive).id; } catch(e){}
            }

            if (students.length === 0) {
                container.innerHTML = '<p style="color:#888; width:100%; text-align:center;">Nenhum aluno nesta turma. Crie o seu!</p>';
                return;
            }

            students.forEach(st => {
                const svg = generateAvatarSVG(st.avatar_config || {}, 90);
                const isCurrentLocal = (st.id === activeId);
                const card = document.createElement('div');
                card.className = `card-item ${isCurrentLocal ? 'in-use' : ''}`;
                card.onclick = () => activateStudent(st);
                card.innerHTML = `
                    <div style="margin-bottom: 8px;">${svg}</div>
                    <h3>${st.name} ${isCurrentLocal ? '🟢' : ''}</h3>
                    <p style="color: ${isCurrentLocal ? '#58cc02' : '#777'}; font-weight:800;">
                        ${isCurrentLocal ? 'Seu Perfil Conectado' : (st.points || 0) + ' Pontos'}
                    </p>
                `;
                container.appendChild(card);
            });
        }

        function openAvatarBuilderForNew() {
            selectedStudent = null;
            document.getElementById('student-name-input').value = '';
            showStep(4);
            switchDuoTab('skin');
            updateDuoPreview();
        }

        function switchDuoTab(tabKey) {
            activeTab = tabKey;
            document.querySelectorAll('.duo-tab-icon').forEach(icon => icon.classList.remove('active'));
            const activeIcon = Array.from(document.querySelectorAll('.duo-tab-icon')).find(el => el.getAttribute('onclick').includes(tabKey));
            if (activeIcon) activeIcon.classList.add('active');

            renderTabContent();
        }

        function renderTabContent() {
            const P = DUOLINGO_AVATAR_PRESETS;
            const container = document.getElementById('duo-tiles-container');
            const titleEl = document.getElementById('duo-tab-title');
            container.innerHTML = '';

            if (activeTab === 'styles') {
                titleEl.innerText = 'Estilo do Ilustrador';
                P.styles.forEach(s => {
                    const isSel = avatarConfig.style === s.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.style = s.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('styles', s.id);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'skin') {
                titleEl.innerText = 'Tom da pele';
                P.skinColors.forEach(item => {
                    const colorHex = '#' + item.id;
                    const isSel = avatarConfig.skinColor === item.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.skinColor = item.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = `<div class="duo-color-swatch" style="background:${colorHex}; border-radius:12px;" title="${item.label}"></div>`;
                    container.appendChild(tile);
                });
            } else if (activeTab === 'hair') {
                titleEl.innerText = 'Cabelo & Cor';
                
                const colorRow = document.createElement('div');
                colorRow.style.cssText = 'grid-column: 1 / -1; display: flex; gap: 8px; margin-bottom: 12px; overflow-x: auto; padding-bottom: 6px;';
                P.hairColors.forEach(hc => {
                    const sw = document.createElement('div');
                    sw.style.cssText = `width: 28px; height: 28px; border-radius: 50%; background: ${hc.id === 'black' ? '#1a1a1a' : hc.id === 'blonde' ? '#ffd700' : hc.id === 'auburn' ? '#c94a2b' : hc.id === 'pastelPink' ? '#ffb6c1' : '#784824'}; cursor: pointer; border: ${avatarConfig.hairColor === hc.id ? '3px solid #1cb0f6' : '2px solid #e5e5e5'}; flex-shrink: 0;`;
                    sw.onclick = () => { avatarConfig.hairColor = hc.id; renderTabContent(); updateDuoPreview(); };
                    colorRow.appendChild(sw);
                });
                container.appendChild(colorRow);

                P.hairStyles.forEach(h => {
                    const isSel = avatarConfig.hairStyle === h.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.hairStyle = h.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('hair', h.id, avatarConfig.hairColor);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'beards') {
                titleEl.innerText = 'Barba / Fade';
                P.beards.forEach(b => {
                    const isSel = avatarConfig.beard === b.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.beard = b.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('beards', b.id);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'glasses') {
                titleEl.innerText = 'Óculos & Acessórios';
                P.glasses.forEach(g => {
                    const isSel = avatarConfig.glasses === g.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.glasses = g.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('glasses', g.id);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'clothes') {
                titleEl.innerText = 'Roupas';
                P.outfits.forEach(o => {
                    const isSel = avatarConfig.outfit === o.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.outfit = o.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('clothes', o.id);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'eyes') {
                titleEl.innerText = 'Olhos & Expressão';
                P.eyes.forEach(ey => {
                    const isSel = avatarConfig.eyes === ey.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.eyes = ey.id; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = generateItemTileSVG('eyes', ey.id);
                    container.appendChild(tile);
                });
            } else if (activeTab === 'bg') {
                titleEl.innerText = 'Cor de Fundo';
                P.bgColors.forEach(bgHex => {
                    const colorHex = '#' + bgHex;
                    const isSel = avatarConfig.bg === bgHex;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => { avatarConfig.bg = bgHex; renderTabContent(); updateDuoPreview(); };
                    tile.innerHTML = `<div class="duo-color-swatch" style="background:${colorHex}; border-radius:12px;"></div>`;
                    container.appendChild(tile);
                });
            }
        }

        function updateDuoPreview() {
            const svg = generateAvatarSVG(avatarConfig, 220);
            document.getElementById('duo-avatar-preview').innerHTML = svg;
            document.getElementById('duo-canvas-bg').style.background = '#' + (avatarConfig.bg || 'e55b5b').replace('#','');
        }

        async function saveAvatarProfile() {
            const name = document.getElementById('student-name-input').value.trim();
            if (!name) return alert('Por favor, digite seu nome!');

            if (!selectedStudent) {
                const res = await fetch('/api/students', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        class_id: selectedClass.id,
                        name,
                        avatar_config: JSON.stringify(avatarConfig)
                    })
                });
                const data = await res.json();
                if (data.success) {
                    activateStudent(data.student);
                }
            } else {
                await fetch(`/api/students/${selectedStudent.id}/avatar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ avatar_config: JSON.stringify(avatarConfig) })
                });
                selectedStudent.avatar_config = avatarConfig;
                activateStudent(selectedStudent);
            }
        }

        function activateStudent(st) {
            selectedStudent = st;
            if (typeof st.avatar_config === 'string') {
                try { selectedStudent.avatar_config = JSON.parse(st.avatar_config); } catch(e){}
            }
            if (selectedSchool) selectedStudent.school_name = selectedSchool.name;
            if (selectedClass) selectedStudent.class_name = selectedClass.name;

            localStorage.setItem('lab_student_profile', JSON.stringify(selectedStudent));
            showStep(5);
            renderProfileView();
        }

        function renderProfileView() {
            if (!selectedStudent) return;
            document.getElementById('active-student-name').innerText = selectedStudent.name;
            document.getElementById('active-student-school').innerText = `${selectedStudent.school_name || ''} | ${selectedStudent.class_name || ''}`;
            document.getElementById('active-points').innerText = selectedStudent.points || 0;

            const svg = generateAvatarSVG(selectedStudent.avatar_config || {}, 160);
            document.getElementById('active-avatar-display').innerHTML = svg;
        }

        function editCurrentAvatar() {
            if (selectedStudent && selectedStudent.avatar_config) {
                avatarConfig = typeof selectedStudent.avatar_config === 'string' 
                    ? JSON.parse(selectedStudent.avatar_config) 
                    : selectedStudent.avatar_config;
                document.getElementById('student-name-input').value = selectedStudent.name;
            }
            showStep(4);
            switchDuoTab('skin');
            updateDuoPreview();
        }

        function logoutStudent() {
            if (!confirm('Deseja sair do perfil deste aluno no tablet?')) return;
            localStorage.removeItem('lab_student_profile');
            selectedStudent = null;
            document.getElementById('btn-header-logout').style.display = 'none';
            loadSchools();
        }
    </script>
</body>
</html>

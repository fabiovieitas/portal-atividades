        function updateDuoPreview() {
            const svg = generateAvatarSVG(avatarConfig, 220);
            const previewEl = document.getElementById('duo-avatar-preview');
            if (previewEl) previewEl.innerHTML = svg;
            
            const bgEl = document.getElementById('duo-canvas-bg');
            if (bgEl) {
                const hexColor = (avatarConfig.bg || '38bdf8').startsWith('#') ? avatarConfig.bg : '#' + avatarConfig.bg;
                bgEl.style.background = hexColor;
            }
        }

        async function saveAvatarProfile() {
            let name = document.getElementById('student-name-input') ? document.getElementById('student-name-input').value.trim() : '';
            if (!name) name = 'Aluno Lab Kids';
            const studentPin = document.getElementById('student-pin-input') ? document.getElementById('student-pin-input').value.trim() : '';

            const classId = (selectedClass && selectedClass.id) 
                ? selectedClass.id 
                : (selectedStudent && selectedStudent.class_id ? selectedStudent.class_id : 1);

            const schoolName = selectedSchool ? selectedSchool.name : (selectedStudent ? selectedStudent.school_name : 'Escola');
            const className = selectedClass ? selectedClass.name : (selectedStudent ? selectedStudent.class_name : 'Turma');

            if (!selectedStudent) {
                try {
                    const res = await fetch('/api/students', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            class_id: classId,
                            name,
                            avatar_config: JSON.stringify(avatarConfig),
                            school_name: schoolName,
                            class_name: className,
                            student_pin: studentPin
                        })
                    });
                    const data = await res.json();
                    if (data && data.success && data.student) {
                        data.student.school_name = schoolName;
                        data.student.class_name = className;
                        data.student.student_pin = studentPin;
                        activateStudent(data.student);
                        return;
                    }
                } catch(e) {
                    console.warn('saveAvatarProfile API error:', e);
                }
                
                // Fallback: Activate profile locally so user is never stuck
                activateStudent({
                    id: Date.now(),
                    class_id: classId,
                    name,
                    school_name: schoolName,
                    class_name: className,
                    avatar_config: avatarConfig,
                    student_pin: studentPin,
                    points: 0
                });
            } else {
                try {
                    const res = await fetch(`/api/students/${selectedStudent.id}/avatar`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            name,
                            avatar_config: JSON.stringify(avatarConfig),
                            student_pin: studentPin,
                            school_name: schoolName,
                            class_name: className
                        })
                    });
                    const data = await res.json();
                    if (data && data.success && data.student) {
                        data.student.school_name = schoolName;
                        data.student.class_name = className;
                        activateStudent(data.student);
                        return;
                    }
                } catch(e){
                    console.warn('saveAvatarProfile edit error:', e);
                }
                selectedStudent.name = name;
                selectedStudent.avatar_config = avatarConfig;
                selectedStudent.student_pin = studentPin;
                if (schoolName) selectedStudent.school_name = schoolName;
                if (className) selectedStudent.class_name = className;
                activateStudent(selectedStudent);
            }
        }

        function activateStudent(st) {
            if (!st) return;
            const prevSchool = selectedStudent ? selectedStudent.school_name : '';
            const prevClass = selectedStudent ? selectedStudent.class_name : '';

            selectedStudent = st;
            if (typeof st.avatar_config === 'string') {
                try { selectedStudent.avatar_config = JSON.parse(st.avatar_config); } catch(e){}
            }

            if (selectedSchool && selectedSchool.name) {
                selectedStudent.school_name = selectedSchool.name;
            } else if (prevSchool && !selectedStudent.school_name) {
                selectedStudent.school_name = prevSchool;
            } else if (!selectedStudent.school_name) {
                try {
                    const s = JSON.parse(sessionStorage.getItem('lab_selected_school'));
                    if (s && s.name) selectedStudent.school_name = s.name;
                } catch(e){}
            }

            if (selectedClass && selectedClass.name) {
                selectedStudent.class_name = selectedClass.name;
            } else if (prevClass && !selectedStudent.class_name) {
                selectedStudent.class_name = prevClass;
            } else if (!selectedStudent.class_name) {
                try {
                    const c = JSON.parse(sessionStorage.getItem('lab_selected_class'));
                    if (c && c.name) selectedStudent.class_name = c.name;
                } catch(e){}
            }

            localStorage.setItem('lab_student_profile', JSON.stringify(selectedStudent));
            showStep(5);
            renderProfileView();
        }

        function updateBackpackStamps(st) {
            if (!st) return;
            const completed = JSON.parse(localStorage.getItem('lab_completed_activities') || '[]');
            const activeMins = Number(st.active_minutes || 0);
            const streak = Number(st.daily_streak || 1);
            let unlocked = 0;

            // 1. Português (3 missões)
            const portCount = completed.filter(c => c.subject === 'Português' || (c.title && c.title.toLowerCase().includes('leitura'))).length;
            const portEl = document.getElementById('stamp-leitor');
            const portProg = document.getElementById('stamp-leitor-progress');
            const portBar = document.getElementById('stamp-leitor-bar');
            const portIcon = document.getElementById('stamp-icon-leitor');
            if (portProg) {
                const p = Math.min(portCount, 3);
                portProg.textContent = p >= 3 ? '✅ Conquistado! (+100 XP)' : (p + '/3 Missões');
                if (portBar) portBar.style.width = Math.round((p / 3) * 100) + '%';
                if (p >= 3) {
                    unlocked++;
                    if (portEl) { portEl.style.background = '#eff6ff'; portEl.style.borderColor = '#3b82f6'; }
                    if (portIcon) { portIcon.style.filter = 'none'; portIcon.style.opacity = '1'; }
                }
            }

            // 2. Matemática (3 missões)
            const mathCount = completed.filter(c => c.subject === 'Matemática' || (c.title && c.title.toLowerCase().includes('tabuada'))).length;
            const mathEl = document.getElementById('stamp-math');
            const mathProg = document.getElementById('stamp-math-progress');
            const mathBar = document.getElementById('stamp-math-bar');
            const mathIcon = document.getElementById('stamp-icon-math');
            if (mathProg) {
                const m = Math.min(mathCount, 3);
                mathProg.textContent = m >= 3 ? '✅ Conquistado! (+100 XP)' : (m + '/3 Missões');
                if (mathBar) mathBar.style.width = Math.round((m / 3) * 100) + '%';
                if (m >= 3) {
                    unlocked++;
                    if (mathEl) { mathEl.style.background = '#f0fdf4'; mathEl.style.borderColor = '#10b981'; }
                    if (mathIcon) { mathIcon.style.filter = 'none'; mathIcon.style.opacity = '1'; }
                }
            }

            // 3. Foco (30 min)
            const focoEl = document.getElementById('stamp-foco');
            const focoProg = document.getElementById('stamp-foco-progress');
            const focoBar = document.getElementById('stamp-foco-bar');
            const focoIcon = document.getElementById('stamp-icon-foco');
            if (focoProg) {
                const f = Math.min(activeMins, 30);
                focoProg.textContent = f >= 30 ? '✅ Conquistado! (+150 XP)' : (f + '/30 min');
                if (focoBar) focoBar.style.width = Math.round((f / 30) * 100) + '%';
                if (f >= 30) {
                    unlocked++;
                    if (focoEl) { focoEl.style.background = '#fffbeb'; focoEl.style.borderColor = '#f59e0b'; }
                    if (focoIcon) { focoIcon.style.filter = 'none'; focoIcon.style.opacity = '1'; }
                }
            }

            // 4. Streak (5 dias)
            const strEl = document.getElementById('stamp-streak');
            const strProg = document.getElementById('stamp-streak-progress');
            const strBar = document.getElementById('stamp-streak-bar');
            const strIcon = document.getElementById('stamp-icon-streak');
            if (strProg) {
                const s = Math.min(streak, 5);
                strProg.textContent = s >= 5 ? '✅ Conquistado! (+200 XP)' : (s + '/5 dias');
                if (strBar) strBar.style.width = Math.round((s / 5) * 100) + '%';
                if (s >= 5) {
                    unlocked++;
                    if (strEl) { strEl.style.background = '#fef2f2'; strEl.style.borderColor = '#ef4444'; }
                    if (strIcon) { strIcon.style.filter = 'none'; strIcon.style.opacity = '1'; }
                }
            }

            // 5. Criativo (1 missão)
            const criatCount = completed.filter(c => c.subject === 'Artes' || c.subject === 'Ciências').length;
            const criatEl = document.getElementById('stamp-criativo');
            const criatProg = document.getElementById('stamp-criativo-progress');
            const criatBar = document.getElementById('stamp-criativo-bar');
            const criatIcon = document.getElementById('stamp-icon-criativo');
            if (criatProg) {
                const cr = Math.min(criatCount, 1);
                criatProg.textContent = cr >= 1 ? '✅ Conquistado! (+80 XP)' : (cr + '/1 Missão');
                if (criatBar) criatBar.style.width = cr >= 1 ? '100%' : '0%';
                if (cr >= 1) {
                    unlocked++;
                    if (criatEl) { criatEl.style.background = '#faf5ff'; criatEl.style.borderColor = '#8b5cf6'; }
                    if (criatIcon) { criatIcon.style.filter = 'none'; criatIcon.style.opacity = '1'; }
                }
            }

            const badge = document.getElementById('stamps-unlocked-badge');
            if (badge) badge.textContent = unlocked + '/5 Carimbos';
        }

        function renderProfileView() {
            if (!selectedStudent) return;
            updateBackpackStamps(selectedStudent);
            document.getElementById('active-student-name').innerText = selectedStudent.name;
            const scText = (selectedStudent.school_name || selectedStudent.class_name) 
                ? `${selectedStudent.school_name || 'Escola'} | ${selectedStudent.class_name || 'Turma'}`
                : 'Lab Kids Digital';
            document.getElementById('active-student-school').innerText = scText;
            const pts = Number(selectedStudent.points || 0);
            document.getElementById('active-points').innerText = pts;
            const streak = Number(selectedStudent.daily_streak || 1);
            const strEl = document.getElementById('active-streak-display');
            if (strEl) strEl.innerText = '🔥 ' + streak + 'd';
            const lvlObj = (window.LabGamification && window.LabGamification.calculateLevel)
                ? window.LabGamification.calculateLevel(pts)
                : { level: 1, title: 'Recruta' };
            const lvlEl = document.getElementById('active-level-display');
            if (lvlEl) lvlEl.innerText = 'Nvl ' + lvlObj.level;

            const svg = generateAvatarSVG(selectedStudent.avatar_config || {}, 160);
            document.getElementById('active-avatar-display').innerHTML = svg;
        }

        
        function goToAvatarStudioDirect() {
            showStep(4);
            switchDuoTab('heroes');
            renderTabContent();
            updateDuoPreview();
        }

        function editCurrentAvatar() {
            if (selectedStudent && selectedStudent.avatar_config) {
                avatarConfig = typeof selectedStudent.avatar_config === 'string' 
                    ? JSON.parse(selectedStudent.avatar_config) 
                    : selectedStudent.avatar_config;
                if (document.getElementById('student-name-input')) {
                    document.getElementById('student-name-input').value = selectedStudent.name || '';
                }
                if (document.getElementById('student-pin-input')) {
                    document.getElementById('student-pin-input').value = selectedStudent.student_pin || '';
                }
            }
            showStep(4);
            switchDuoTab('heroes');
            updateDuoPreview();
        }

        function logoutStudent() {
            if (!confirm('Deseja sair do perfil deste aluno no tablet?')) return;
            localStorage.removeItem('lab_student_profile');
            sessionStorage.removeItem('lab_wizard_step');
            sessionStorage.removeItem('lab_selected_school');
            sessionStorage.removeItem('lab_selected_class');
            selectedStudent = null;
            selectedSchool = null;
            selectedClass = null;
            loadSchools();
            showStep(1);
        }
    </script>

    <!-- MODAL DE AVISO DE INATIVIDADE (TABLET COLETIVO - 10 MINUTOS) -->

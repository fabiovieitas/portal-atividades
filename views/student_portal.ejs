<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área do Aluno - Lab Kids</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Lab Kids">
    <link rel="icon" type="image/png" sizes="512x512" href="/img/robot-icon-512.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/img/robot-icon-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/img/robot-icon-512.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
    <!-- Google AdSense Oficial -->
    <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
      <meta name="google-adsense-account" content="<%= adsensePubId %>">
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <% } %>
    <meta name="robots" content="noindex, follow">
    <script src="/js/avatar_system.js"></script>
    <script src="/js/app-enhancements.js" defer></script>
    <style>
        :root {
            --duo-green: #58cc02;
            --duo-green-dark: #46a302;
            --duo-blue: #1cb0f6;
            --duo-blue-dark: #1899d6;
            --duo-card-bg: #ffffff;
            --duo-border: #e5e5e5;
            --duo-text-dark: #3c3c3c;
            --app-bg: #f7f7f7;
        }

        body.student-theme {
            background: var(--app-bg);
            color: var(--duo-text-dark);
            font-family: 'Nunito', 'Fredoka', sans-serif;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
        }

        .portal-header {
            text-align: center;
            margin-bottom: 20px;
            position: relative;
        }

        .portal-header h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin: 0;
            color: #3c3c3c;
        }

        .portal-header p {
            color: #777777;
            font-size: 1.05rem;
            margin-top: 4px;
            font-weight: 700;
        }

        .btn-top-logout {
            position: absolute;
            right: 10px;
            top: 0;
            background: #ff4b4b;
            border: none;
            border-bottom: 4px solid #ea2b2b;
            color: white;
            padding: 8px 18px;
            border-radius: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-top-logout:hover {
            transform: translateY(-2px);
            background: #ff3333;
        }

        /* Step Bar */
        .step-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .step-pill {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 800;
            color: #afafaf;
            transition: 0.2s;
        }

        .step-pill.active {
            background: var(--duo-blue);
            color: #ffffff;
            border-color: var(--duo-blue-dark);
            box-shadow: 0 4px 0 var(--duo-blue-dark);
        }

        /* Selection Grid */
        .grid-selection {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            max-width: 950px;
            margin: 0 auto;
        }

        .card-item {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .card-item:hover {
            transform: translateY(-4px);
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
        }

        .card-item.in-use {
            border-color: var(--duo-green);
            border-bottom-color: var(--duo-green-dark);
            background: #f1fbe8;
        }

        .card-item .icon-box {
            font-size: 3rem;
            margin-bottom: 8px;
        }

        .card-item h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0 0 4px 0;
            color: var(--duo-text-dark);
        }

        /* DUOLINGO OFFICIAL AVATAR EDITOR LAYOUT */
        .duo-editor-window {
            display: flex;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-radius: 24px;
            overflow: hidden;
            max-width: 1050px;
            margin: 0 auto;
            min-height: 520px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

        /* Left Canvas Preview Area */
        .duo-canvas-side {
            flex: 1.1;
            min-width: 320px;
            background: #e55b5b;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            position: relative;
            transition: background 0.3s ease;
        }

        .duo-canvas-avatar-wrapper {
            transform: scale(1.35);
            margin-bottom: 20px;
        }

        .duo-name-input {
            width: 85%;
            padding: 12px;
            border-radius: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            background: rgba(0, 0, 0, 0.25);
            color: #ffffff;
            font-weight: 800;
            font-size: 1.1rem;
            text-align: center;
            outline: none;
            backdrop-filter: blur(5px);
        }

        .duo-name-input::placeholder {
            color: rgba(255,255,255,0.7);
        }

        .btn-duo-save {
            background: var(--duo-green);
            border: none;
            border-bottom: 4px solid var(--duo-green-dark);
            color: #ffffff;
            font-weight: 900;
            font-size: 1.2rem;
            padding: 14px 32px;
            border-radius: 18px;
            cursor: pointer;
            width: 85%;
            margin-top: 15px;
            transition: 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-duo-save:hover {
            transform: translateY(-2px);
            background: #61e002;
        }

        .btn-duo-save:active {
            transform: translateY(2px);
            border-bottom-width: 0;
        }

        /* Right Panel Customizer Side */
        .duo-panel-side {
            flex: 1.4;
            min-width: 340px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            border-left: 2px solid var(--duo-border);
        }

        /* Top Horizontal Icon Tabs Bar */
        .duo-tabs-nav {
            display: flex;
            overflow-x: auto;
            border-bottom: 2px solid var(--duo-border);
            padding: 10px 10px 0 10px;
            gap: 4px;
            background: #ffffff;
            scrollbar-width: none;
        }

        .duo-tabs-nav::-webkit-scrollbar { display: none; }

        .duo-tab-icon {
            flex: 0 0 auto;
            padding: 10px 14px;
            border-radius: 12px 12px 0 0;
            font-size: 1.4rem;
            cursor: pointer;
            color: #afafaf;
            border-bottom: 3px solid transparent;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .duo-tab-icon:hover {
            color: var(--duo-blue);
            background: #f7f7f7;
        }

        .duo-tab-icon.active {
            color: var(--duo-blue);
            border-bottom-color: var(--duo-blue);
            background: #ffffff;
        }

        /* Content Panel Inside Tab */
        .duo-tab-content {
            padding: 20px;
            overflow-y: auto;
            max-height: 480px;
            flex: 1;
        }

        .duo-category-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--duo-text-dark);
            margin: 0 0 15px 0;
        }

        /* 3-Column Grid Tiles */
        .duo-tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .duo-tile-card {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 16px;
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.15s;
            position: relative;
            padding: 6px;
        }

        .duo-tile-card:hover {
            border-color: var(--duo-blue);
            transform: translateY(-2px);
        }

        .duo-tile-card.selected {
            background: #ddf4ff;
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
            box-shadow: 0 0 0 2px var(--duo-blue);
        }

        .duo-color-swatch {
            width: 100%;
            height: 100%;
            border-radius: 12px;
        }

        .btn-back {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            color: var(--duo-text-dark);
            padding: 8px 18px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 800;
            margin-bottom: 15px;
        }

        /* PIN Modal */
        .pin-container {
            max-width: 380px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 5px solid var(--duo-border);
            border-radius: 24px;
            padding: 25px;
            text-align: center;
        }

        .pin-input {
            font-size: 2.2rem;
            letter-spacing: 10px;
            text-align: center;
            width: 80%;
            padding: 10px;
            border-radius: 16px;
            border: 2px solid var(--duo-blue);
            background: #f7f7f7;
            color: var(--duo-text-dark);
            font-weight: 800;
            margin: 15px 0;
            outline: none;
        }
    </style>
</head>
<body class="student-theme">
    <%- include('partials/portal_header') %>

    <div class="container" style="max-width: 1080px; margin: 20px auto 0 auto; padding-bottom: 50px;">

        <div class="portal-header" style="position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                <a href="/" class="btn-back" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; font-size: 1rem; padding: 10px 18px;">
                    🏠 Início do Portal
                </a>
                <button onclick="logoutStudent()" style="background: #ef4444; border: none; border-bottom: 4px solid #b91c1c; color: white; padding: 10px 20px; border-radius: 16px; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem; transition: 0.15s;" title="Desconecta este aluno para que o próximo colega possa usar o tablet">
                    🚪 Trocar Aluno / Finalizar Aula
                </button>
            </div>
            <h1>Área do Aluno - Avatar & Desafios</h1>
            <p>Monte seu perfil interativo no estilo oficial do Duolingo!</p>
        </div>

        <!-- Step Indicator -->
        <div class="step-bar">
            <div class="step-pill" id="step-pill-1">1. Escola 🏫</div>
            <div class="step-pill" id="step-pill-2">2. Turma & PIN 🔑</div>
            <div class="step-pill" id="step-pill-3">3. Escolha seu Nome 👤</div>
            <div class="step-pill" id="step-pill-4">4. Criador de Avatar 🎨</div>
            <div class="step-pill" id="step-pill-5">5. Perfil & Jogos 🏆</div>
        </div>

        <button id="btn-global-back" class="btn-back" onclick="goBackStep()" style="display:inline-block; font-size: 1.1rem; padding: 12px 24px; margin-bottom: 15px;">⬅️ Voltar</button>


        <!-- BANNER PUBLICIDADE / APOIO EDUCACIONAL (TOPO) -->
        <div class="adsense-portal-slot" style="margin: 0 auto 25px auto; max-width: 728px; text-align: center; background: #ffffff; padding: 10px; border-radius: 16px; border: 1.5px solid var(--duo-border);">
            <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Publicidade / Apoio Educacional</span>
            <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
              <ins class="adsbygoogle"
                   style="display:block"
                   data-ad-client="<%= adsensePubId %>"
                   data-ad-slot="default"
                   data-ad-format="auto"
                   data-full-width-responsive="true"></ins>
              <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            <% } else { %>
              <div style="color: #64748b; font-size: 0.85rem; padding: 6px;">Portal Lab Kids - Atividades Educativas & Cultura Digital</div>
            <% } %>
        </div>

        <!-- VIEW 1: SELECT SCHOOL / CODE / FREE EXPLORER -->
        <div id="view-school" class="step-view">

            <!-- 1. CÓDIGO DA TURMA (ENTRADA ULTRA-RÁPIDA) -->
            <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 2.5px solid #3b82f6; border-radius: 24px; padding: 25px 20px; margin-bottom: 25px; box-shadow: 0 8px 30px rgba(59, 130, 246, 0.15); text-align: center;">
                <div style="font-size: 2.4rem; margin-bottom: 4px;">🔑</div>
                <h2 style="margin: 0 0 6px 0; color: #1e40af; font-size: 1.5rem; font-weight: 900;">Tem o Código da sua Turma?</h2>
                <p style="color: #475569; margin: 0 0 16px 0; font-size: 1.05rem; font-weight: 700;">Se o seu professor passou o código da sala (ex: <strong>LK4078</strong>), digite abaixo para entrar direto:</p>
                
                <div style="display: flex; gap: 10px; justify-content: center; max-width: 480px; margin: 0 auto; flex-wrap: wrap;">
                    <input type="text" id="class-code-input" placeholder="Ex: LK4078" maxlength="10" 
                           style="flex: 1; min-width: 170px; padding: 14px 18px; border-radius: 16px; border: 2.5px solid #3b82f6; font-size: 1.35rem; font-weight: 900; text-align: center; text-transform: uppercase; letter-spacing: 2px; outline: none; background: #ffffff; color: #1e3a8a;"
                           onkeydown="if(event.key==='Enter') lookupClassCode()">
                    <button onclick="lookupClassCode()" class="btn-duo-save" style="margin: 0; width: auto; padding: 14px 28px; font-size: 1.1rem; background: #2563eb; border-color: #1d4ed8;">
                        ENTRAR NA TURMA 🚀
                    </button>
                </div>
                <div id="code-lookup-status" style="margin-top: 12px; font-weight: 800; font-size: 1rem; display: none;"></div>
            </div>

            <!-- 2. MODO EXPLORADOR LIVRE (ESTUDANTE EM CASA / QUALQUER ESCOLA) -->
            <div style="background: linear-gradient(135deg, #fefce8 0%, #fef08a 100%); border: 2.5px solid #eab308; border-radius: 24px; padding: 22px 20px; margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; box-shadow: 0 8px 30px rgba(234, 179, 8, 0.15);">
                <div style="display: flex; align-items: center; gap: 15px; text-align: left; flex: 1; min-width: 260px;">
                    <span style="font-size: 2.6rem;">🎒</span>
                    <div>
                        <h3 style="margin: 0 0 4px 0; color: #854d0e; font-size: 1.3rem; font-weight: 900;">Jogando de Casa ou Outra Escola?</h3>
                        <p style="margin: 0; color: #713f12; font-size: 0.95rem; font-weight: 700;">Você não precisa de código de turma! Jogue como <strong>Explorador Livre</strong>, crie seu avatar 3D e colecione medalhas.</p>
                    </div>
                </div>
                <button onclick="startFreeExplorerMode()" class="btn-duo-save" style="margin: 0; width: auto; padding: 14px 28px; background: #eab308; border-color: #ca8a04; color: #422006; font-size: 1.1rem; box-shadow: 0 4px 0 #ca8a04;">
                    ⭐ JOGAR NO MODO LIVRE
                </button>
            </div>

            <!-- 3. LISTA TRADICIONAL DE ESCOLAS COM CAMPO DE BUSCA -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                <h3 style="color: var(--duo-text-dark); margin: 0; font-size: 1.3rem; font-weight: 800;">Ou selecione sua Escola na Rede:</h3>
                <input type="text" id="school-search-filter" placeholder="🔍 Buscar escola por nome..." oninput="filterSchools(this.value)" 
                       style="padding: 10px 16px; border-radius: 14px; border: 2px solid var(--duo-border); outline: none; font-weight: 700; width: 100%; max-width: 320px;">
            </div>

            <div class="grid-selection" id="schools-container">
                <p style="text-align: center; width: 100%;">Carregando escolas...</p>
            </div>
        </div>

        <!-- VIEW 2: SELECT CLASS & PIN -->
        <div id="view-class" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 15px;" id="school-title">Turmas da Escola</h2>
            <div class="grid-selection" id="classes-container" style="margin-bottom: 25px;">
                <!-- Classes loaded here -->
            </div>

            <div id="pin-box" class="pin-container" style="display:none;">
                <h3 style="margin: 0; color: var(--duo-blue);">🔑 Digite o PIN da Turma:</h3>
                <input type="password" id="pin-input" class="pin-input" maxlength="6" placeholder="****">
                <button class="btn-duo-save" style="width: 100%;" onclick="submitPin()">LIBERAR TURMA 🚀</button>
                <p id="pin-error" style="color: #ff4b4b; font-weight: 800; margin-top: 10px; display:none;"></p>
            </div>
        </div>

        <!-- VIEW 3: SELECT STUDENT OR CREATE NEW -->
        <div id="view-students" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 8px;">Quem é você?</h2>
            <p style="text-align: center; color: #777; margin-bottom: 20px;">Clique no seu perfil ou crie um novo avatar!</p>
            
            <div style="text-align: center; margin-bottom: 20px;">
                <button class="btn-duo-save" style="max-width: 340px;" onclick="openAvatarBuilderForNew()">
                    ✨ CRIAR NOVO AVATAR DUOLINGO
                </button>
            </div>

            <div class="grid-selection" id="students-container">
                <!-- Students loaded here -->
            </div>
        </div>

        <!-- VIEW 4: STUDIO DE AVATARES ÉPICO LAB KIDS -->
        <div id="view-avatar-builder" class="step-view" style="display:none;">
            <div style="text-align: center; margin-bottom: 20px;">
                <h2 style="font-family: 'Fredoka', cursive; font-size: 2.2rem; color: #1e3a8a; margin: 0 0 6px 0;">🎨 Studio de Avatares Lab Kids</h2>
                <p style="color: #64748b; font-weight: 700; margin: 0; font-size: 1.05rem;">Monte o personagem que vai representar suas conquistas e medalhas na plataforma!</p>
            </div>

            <div class="duo-editor-window" style="box-shadow: 0 20px 50px rgba(0,0,0,0.12); border-radius: 28px; border: 2.5px solid var(--duo-border);">
                <!-- Left Side: Canvas Preview & Inputs -->
                <div class="duo-canvas-side" id="duo-canvas-bg" style="background: #38bdf8; padding: 30px 20px; transition: background 0.4s ease; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    
                    <!-- Crachá do Jogador -->
                    <div style="background: rgba(0,0,0,0.3); backdrop-filter: blur(8px); padding: 5px 16px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.3); color: #ffffff; font-size: 0.85rem; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.5px;">
                        ⭐ Nível 1 • Recruta Digital
                    </div>

                    <!-- Preview do Avatar em Tamanho Gigante -->
                    <div class="duo-canvas-avatar-wrapper" id="duo-avatar-preview" style="filter: drop-shadow(0 15px 25px rgba(0,0,0,0.3)); transform: scale(1.15); margin-bottom: 15px;"></div>

                    <button onclick="randomizeAvatar()" class="btn-back" style="margin-bottom: 15px; background: rgba(255,255,255,0.95); border: none; font-weight: 900; box-shadow: 0 4px 0 rgba(0,0,0,0.15); color: #0284c7; padding: 10px 22px; border-radius: 50px; font-size: 1rem; cursor: pointer; transition: transform 0.15s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        🎲 Sorteio Surpresa 🚀
                    </button>

                    <div style="width: 88%; max-width: 320px; display: flex; flex-direction: column; gap: 8px;">
                        <input type="text" id="student-name-input" class="duo-name-input" placeholder="Digite seu Nome de Aluno..." style="width: 100%; box-sizing: border-box; font-size: 1.15rem; background: rgba(255,255,255,0.95) !important; color: #0f172a !important; border: 2px solid #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                        <input type="password" id="student-pin-input" class="duo-name-input" maxlength="4" placeholder="🔑 Senha de 4 dígitos (Opcional)" style="width: 100%; box-sizing: border-box; font-size: 0.95rem; padding: 10px 14px; background: rgba(255,255,255,0.9) !important; color: #0f172a !important; border: 2px solid #ffffff;">
                        <button class="btn-duo-save" onclick="saveAvatarProfile()" style="width: 100%; margin-top: 8px; font-size: 1.2rem; padding: 16px; background: #10b981; border-color: #059669; box-shadow: 0 6px 0 #059669;">
                            ✨ SALVAR MEU AVATAR 🚀
                        </button>
                    </div>
                </div>

                <!-- Right Side: Style Tabs & Customization Grid -->
                <div class="duo-panel-side">
                    <!-- Top Icon Tabs -->
                    <div class="duo-tabs-nav" style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <div class="duo-tab-icon active" onclick="switchDuoTab('heroes')" title="Heróis Prontos" style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 0.92rem;">🦸‍♂️ Heróis</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('style')" title="Estilo da Coleção" style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 0.92rem;">🎨 Tribo</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('seed')" title="Personagens & Rosto" style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 0.92rem;">👤 Personagem</div>
                        <div class="duo-tab-icon" onclick="switchDuoTab('bg')" title="Cenários de Fundo" style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 0.92rem;">🌈 Fundo</div>
                    </div>

                    <!-- Active Tab Content Area -->
                    <div class="duo-tab-content" style="padding: 22px;">
                        <div class="duo-category-title" id="duo-tab-title" style="font-size: 1.2rem; font-weight: 900; color: #1e3a8a; margin-bottom: 16px;">Escolha o Herói do Lab</div>
                        <div class="duo-tiles-grid" id="duo-tiles-container" style="gap: 14px;">
                            <!-- Dynamically loaded -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW 5: ACTIVE PROFILE -->
        <div id="view-profile" class="step-view" style="display:none;">
            <div style="max-width: 550px; margin: 0 auto; background: #ffffff; border: 2px solid var(--duo-border); border-bottom: 5px solid var(--duo-border); border-radius: 24px; padding: 30px; text-align: center;">
                <div id="active-avatar-display" style="margin-bottom: 15px;"></div>
                <h2 id="active-student-name" style="margin: 0; font-size: 2rem; color: var(--duo-text-dark);">Nome do Aluno</h2>
                <p id="active-student-school" style="color: #777; font-size: 1rem; margin-top: 4px; font-weight: 700;"></p>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0;">
                    <div style="background: #eff6ff; border: 2px solid #bfdbfe; padding: 10px 6px; border-radius: 18px; text-align: center;">
                        <span style="font-size: 1.5rem; font-weight: 900; color: #2563eb;" id="active-points">0</span>
                        <div style="font-size: 0.75rem; color: #1e40af; font-weight: 800; text-transform: uppercase;">XP Total</div>
                    </div>
                    <div style="background: #fef2f2; border: 2px solid #fecaca; padding: 10px 6px; border-radius: 18px; text-align: center;">
                        <span style="font-size: 1.5rem; font-weight: 900; color: #dc2626;" id="active-streak-display">🔥 1d</span>
                        <div style="font-size: 0.75rem; color: #991b1b; font-weight: 800; text-transform: uppercase;">Sequência</div>
                    </div>
                    <div style="background: #f0fdf4; border: 2px solid #bbf7d0; padding: 10px 6px; border-radius: 18px; text-align: center;">
                        <span style="font-size: 1.4rem; font-weight: 900; color: #16a34a;" id="active-level-display">Nvl 1</span>
                        <div style="font-size: 0.75rem; color: #166534; font-weight: 800; text-transform: uppercase;">Patente</div>
                    </div>
                </div>

                <!-- Publicidade Educativa no Dashboard do Aluno -->
                <div class="adsense-portal-slot" style="margin: 15px auto; max-width: 440px; text-align: center; background: #f8fafc; padding: 8px; border-radius: 14px; border: 1px dashed #cbd5e1;">
                    <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px;">Publicidade / Apoio</span>
                    <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
                      <ins class="adsbygoogle"
                           style="display:block"
                           data-ad-client="<%= adsensePubId %>"
                           data-ad-slot="default"
                           data-ad-format="auto"
                           data-full-width-responsive="true"></ins>
                      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                    <% } %>
                </div>

                <div style="margin-top: 25px; display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/" class="btn-duo-save" style="flex:1; text-decoration: none; text-align: center; margin: 0;">🚀 JOGAR AGORA</a>
                    <button onclick="editCurrentAvatar()" class="btn-back" style="margin: 0; padding: 12px 18px;">✏️ Editar Avatar</button>
                    <button onclick="logoutStudent()" class="btn-back" style="margin: 0; background: #fff0f0; border-color: #ff4b4b; color: #ff4b4b; padding: 12px 18px;">🚪 Sair</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        
        // ============================================================================
        // BUSCA DE TURMA POR CÓDIGO (EX: LK4078)
        // ============================================================================
        async function lookupClassCode(codeToSearch) {
            const input = document.getElementById('class-code-input');
            const code = (codeToSearch || (input ? input.value : '')).trim().toUpperCase();
            const statusDiv = document.getElementById('code-lookup-status');

            if (!code) {
                if (statusDiv) {
                    statusDiv.style.color = '#ef4444';
                    statusDiv.innerText = 'Por favor, digite o código da turma (ex: LK4078).';
                    statusDiv.style.display = 'block';
                }
                return;
            }

            if (statusDiv) {
                statusDiv.style.color = '#2563eb';
                statusDiv.innerText = '🔍 Localizando sua turma...';
                statusDiv.style.display = 'block';
            }

            try {
                const res = await fetch('/api/classes/lookup/' + encodeURIComponent(code));
                const data = await res.json();
                if (data.success && data.class) {
                    selectedSchool = { id: data.class.id, name: data.class.school_name };
                    selectedClass = { id: data.class.id, name: data.class.name, grade_level: data.class.name };
                    
                    try {
                        sessionStorage.setItem('lab_selected_school', JSON.stringify(selectedSchool));
                        sessionStorage.setItem('lab_selected_class', JSON.stringify(selectedClass));
                    } catch(e){}

                    if (statusDiv) {
                        statusDiv.style.color = '#10b981';
                        statusDiv.innerText = '🎉 Turma encontrada: ' + data.class.name + ' - ' + data.class.school_name + ' (' + data.class.teacher_name + ')';
                    }

                    document.getElementById('school-title').innerText = data.class.name + ' - ' + data.class.school_name;
                    setTimeout(() => {
                        loadStudentsByClass();
                    }, 500);
                } else {
                    if (statusDiv) {
                        statusDiv.style.color = '#ef4444';
                        statusDiv.innerText = data.error || 'Código não encontrado. Peça o código correto ao seu professor!';
                    }
                }
            } catch(err) {
                if (statusDiv) {
                    statusDiv.style.color = '#ef4444';
                    statusDiv.innerText = 'Erro ao conectar. Verifique sua internet.';
                }
            }
        }

        // ============================================================================
        // MODO EXPLORADOR LIVRE (ESTUDANTE EM CASA / SEM ESCOLA)
        // ============================================================================
        function startFreeExplorerMode() {
            selectedSchool = { id: 0, name: 'Lab Kids Brasil' };
            selectedClass = { id: 0, name: 'Exploradores Livres' };
            try {
                sessionStorage.setItem('lab_selected_school', JSON.stringify(selectedSchool));
                sessionStorage.setItem('lab_selected_class', JSON.stringify(selectedClass));
            } catch(e){}

            openAvatarBuilderForNew();
        }

        // ============================================================================
        // FILTRO DE BUSCA DE ESCOLAS
        // ============================================================================
        let allSchoolsList = [];
        function filterSchools(query) {
            const q = (query || '').toLowerCase().trim();
            if (!allSchoolsList || allSchoolsList.length === 0) return;
            const filtered = allSchoolsList.filter(s => (s.name || '').toLowerCase().includes(q) || (s.city || '').toLowerCase().includes(q));
            renderSchools(filtered);
        }

        // ============================================================================
        // CONTROLE DE INATIVIDADE (10 MINUTOS COM AVISO AOS 9 MINUTOS - TABLET COLETIVO)
        // ============================================================================
        const IDLE_WARN_MS = 4 * 60 * 1000;    // 9 minutos
        const IDLE_LOGOUT_MS = 5 * 60 * 1000; // 10 minutos
        let lastUserActionTime = Date.now();
        let idleIntervalCountdown = null;

        function recordUserActivity() {
            lastUserActionTime = Date.now();
            const modal = document.getElementById('idle-warning-modal');
            if (modal && modal.style.display === 'flex') {
                dismissIdleWarning();
            }
        }

        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach(evt => {
            window.addEventListener(evt, recordUserActivity, { passive: true });
        });

        setInterval(() => {
            const hasProfile = !!localStorage.getItem('lab_student_profile');
            if (!hasProfile) return;

            const elapsed = Date.now() - lastUserActionTime;
            const modal = document.getElementById('idle-warning-modal');

            if (elapsed >= IDLE_LOGOUT_MS) {
                dismissIdleWarning();
                forceIdleLogout();
            } else if (elapsed >= IDLE_WARN_MS) {
                if (modal && modal.style.display !== 'flex') {
                    modal.style.display = 'flex';
                    let remaining = Math.max(1, Math.round((IDLE_LOGOUT_MS - elapsed) / 1000));
                    const cd = document.getElementById('idle-countdown');
                    if (cd) cd.innerText = remaining;

                    clearInterval(idleIntervalCountdown);
                    idleIntervalCountdown = setInterval(() => {
                        remaining--;
                        if (cd) cd.innerText = remaining;
                        if (remaining <= 0) {
                            clearInterval(idleIntervalCountdown);
                            dismissIdleWarning();
                            forceIdleLogout();
                        }
                    }, 1000);
                }
            }
        }, 4000);

        function dismissIdleWarning() {
            clearInterval(idleIntervalCountdown);
            const modal = document.getElementById('idle-warning-modal');
            if (modal) modal.style.display = 'none';
            lastUserActionTime = Date.now();
        }

        function forceIdleLogout() {
            localStorage.removeItem('lab_student_profile');
            sessionStorage.removeItem('lab_wizard_step');
            sessionStorage.removeItem('lab_selected_school');
            sessionStorage.removeItem('lab_selected_class');
            selectedStudent = null;
            selectedSchool = null;
            selectedClass = null;
            alert('⏳ Sessão finalizada por 5 minutos de inatividade!\n\nO tablet foi liberado para o próximo colega.');
            loadSchools();
            showStep(1);
        }

        let currentStep = 1;
        let activeTab = 'voxelSeeds';
        let selectedSchool = null;
        let selectedClass = null;
        let selectedStudent = null;

        // Customizer state (100% Editable Animated Voxel Art 3D Engine)
        let avatarConfig = {
            style: 'voxel-art',
            seed: 'Voxel' + Math.floor(Math.random() * 10000),
            animationSpeed: 'fastest',
            hairStyle: 'spiky',
            hairColor: '2c1b18',
            skinColor: 'ffdbb4',
            outfit: 'hoodie',
            glasses: 'none',
            beard: 'none',
            eyes: 'open',
            bg: 'e55b5b',
            bgPattern: '',
            customBg: ''
        };

        window.addEventListener('DOMContentLoaded', () => {
            // Restore school & class selection from sessionStorage if available
            try {
                const savedSchool = sessionStorage.getItem('lab_selected_school');
                if (savedSchool) selectedSchool = JSON.parse(savedSchool);
                const savedClass = sessionStorage.getItem('lab_selected_class');
                if (savedClass) selectedClass = JSON.parse(savedClass);
            } catch(e){}

            const savedProfile = localStorage.getItem('lab_student_profile');
            if (savedProfile) {
                try {
                    selectedStudent = JSON.parse(savedProfile);
                    if (selectedStudent && selectedStudent.avatar_config) {
                        avatarConfig = typeof selectedStudent.avatar_config === 'string'
                            ? JSON.parse(selectedStudent.avatar_config)
                            : selectedStudent.avatar_config;
                    }
                    showStep(5);
                    renderProfileView();
                    return;
                } catch(e){
                    console.error('Error parsing saved student profile:', e);
                }
            }

            // If user was in the middle of wizard steps before F5
            const savedStep = parseInt(sessionStorage.getItem('lab_wizard_step') || '1');
            if (savedStep > 1 && selectedSchool) {
                if (savedStep === 2) {
                    selectSchool(selectedSchool);
                } else if (savedStep === 3 && selectedClass) {
                    document.getElementById('school-title').innerText = selectedSchool.name;
                    loadStudentsByClass();
                } else if (savedStep === 4 && selectedClass) {
                    showStep(4);
                    renderTabContent();
                    updateDuoPreview();
                } else {
                    loadSchools();
                }
            } else {
                loadSchools();
                renderTabContent();
                updateDuoPreview();
            }
        });

        function showStep(step) {
            currentStep = step;
            try { sessionStorage.setItem('lab_wizard_step', String(step)); } catch(e){}

            document.querySelectorAll('.step-view').forEach(v => v.style.display = 'none');
            document.querySelectorAll('.step-pill').forEach((p, idx) => {
                if (idx + 1 === step) p.classList.add('active');
                else p.classList.remove('active');
            });

            const backBtn = document.getElementById('btn-global-back');
            if (backBtn) {
                backBtn.style.display = 'inline-block';
                if (step === 1) {
                    backBtn.innerText = '⬅️ Voltar para o Início do Site';
                } else if (step === 5) {
                    backBtn.innerText = '⬅️ Trocar Aluno / Escolher Escola';
                } else {
                    backBtn.innerText = '⬅️ Voltar Passo Anterior';
                }
            }

            if (step === 1) document.getElementById('view-school').style.display = 'block';
            if (step === 2) document.getElementById('view-class').style.display = 'block';
            if (step === 3) document.getElementById('view-students').style.display = 'block';
            if (step === 4) document.getElementById('view-avatar-builder').style.display = 'block';
            if (step === 5) document.getElementById('view-profile').style.display = 'block';

            // Navegação de etapa limpa
        }

        function goBackStep() {
            if (currentStep === 1) {
                window.location.href = '/';
            } else if (currentStep === 5) {
                loadSchools();
                showStep(1);
            } else {
                showStep(currentStep - 1);
            }
        }


        async function loadSchools() {
            showStep(1);
            try {
                const res = await fetch('/api/schools');
                const schools = await res.json();
                allSchoolsList = schools;
                renderSchools(schools);
            } catch(e) {
                allSchoolsList = [
                    { id: 1, name: 'E.M. José Giró Faísca', city: 'Angra dos Reis' },
                    { id: 2, name: 'C.E. Cornélis Verolme', city: 'Angra dos Reis' }
                ];
                renderSchools(allSchoolsList);
            }

            // Auto-check URL query params (?turma=LK4078 or ?codigo=LK4078)
            const urlParams = new URLSearchParams(window.location.search);
            const tCode = urlParams.get('turma') || urlParams.get('codigo') || urlParams.get('code');
            if (tCode) {
                const inp = document.getElementById('class-code-input');
                if (inp) inp.value = tCode.toUpperCase();
                lookupClassCode(tCode);
            }
        }

        function renderSchools(schools) {
            const container = document.getElementById('schools-container');
            container.innerHTML = '';
            schools.forEach(s => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => selectSchool(s);
                card.innerHTML = `
                    <div class="icon-box">🏫</div>
                    <h3>${s.name}</h3>
                    <p style="color:#777; margin:0;">${s.city}</p>
                `;
                container.appendChild(card);
            });
        }

        async function selectSchool(school) {
            selectedSchool = school;
            try { sessionStorage.setItem('lab_selected_school', JSON.stringify(school)); } catch(e){}
            document.getElementById('school-title').innerText = school.name;
            showStep(2);
            document.getElementById('pin-box').style.display = 'none';

            const res = await fetch(`/api/schools/${school.id}/classes`);
            const classes = await res.json();
            const container = document.getElementById('classes-container');
            container.innerHTML = '';

            classes.forEach(c => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => openPinBox(c);
                card.innerHTML = `
                    <div class="icon-box">👥</div>
                    <h3>${c.name}</h3>
                    <p style="color:#777; margin:0;">${c.grade_level || 'Turma Escolar'}</p>
                `;
                container.appendChild(card);
            });
        }

        function openPinBox(cls) {
            selectedClass = cls;
            try { sessionStorage.setItem('lab_selected_class', JSON.stringify(cls)); } catch(e){}
            document.getElementById('pin-box').style.display = 'block';
            document.getElementById('pin-input').value = '';
            document.getElementById('pin-error').style.display = 'none';
            document.getElementById('pin-input').focus();
        }

        async function submitPin() {
            const pin = document.getElementById('pin-input').value;
            if (!pin) return;
            const res = await fetch('/api/classes/verify-pin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ class_id: selectedClass.id, pin })
            });
            const data = await res.json();
            if (data.success) {
                loadStudentsByClass();
            } else {
                const err = document.getElementById('pin-error');
                err.innerText = 'PIN incorreto!';
                err.style.display = 'block';
            }
        }

        async function loadStudentsByClass() {
            showStep(3);
            const res = await fetch(`/api/classes/${selectedClass.id}/students`);
            const students = await res.json();
            const container = document.getElementById('students-container');
            container.innerHTML = '';

            const currentActive = localStorage.getItem('lab_student_profile');
            let activeId = null;
            if (currentActive) {
                try { activeId = JSON.parse(currentActive).id; } catch(e){}
            }

            if (students.length === 0) {
                container.innerHTML = '<p style="color:#888; width:100%; text-align:center;">Nenhum aluno nesta turma. Crie o seu!</p>';
                return;
            }

            students.forEach(st => {
                const svg = generateAvatarSVG(st.avatar_config || {}, 90);
                const isCurrentLocal = (st.id === activeId);
                const hasPin = st.student_pin && String(st.student_pin).trim() !== '';
                const card = document.createElement('div');
                card.className = `card-item ${isCurrentLocal ? 'in-use' : ''}`;
                card.onclick = () => selectStudentCard(st);
                card.innerHTML = `
                    <div style="margin-bottom: 8px;">${svg}</div>
                    <h3>${st.name} ${isCurrentLocal ? '🟢' : ''} ${hasPin ? '🔒' : ''}</h3>
                    <p style="color: ${isCurrentLocal ? '#58cc02' : '#777'}; font-weight:800;">
                        ${isCurrentLocal ? 'Seu Perfil Conectado' : (st.points || 0) + ' Pontos'}
                    </p>
                `;
                container.appendChild(card);
            });
        }

        async function selectStudentCard(st) {
            const currentActive = localStorage.getItem('lab_student_profile');
            let activeId = null;
            if (currentActive) {
                try { activeId = JSON.parse(currentActive).id; } catch(e){}
            }
            if (st.id === activeId) {
                activateStudent(st);
                return;
            }

            const hasPin = st.student_pin && String(st.student_pin).trim() !== '';
            if (hasPin) {
                const pinInput = prompt(`🔑 Digite a sua SENHA INDIVIDUAL (4 dígitos) para acessar o perfil de ${st.name}:`);
                if (pinInput === null) return;
                const res = await fetch('/api/students/verify-pin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: st.id, pin: pinInput })
                });
                const data = await res.json();
                if (data.success) {
                    activateStudent(st);
                } else {
                    alert('❌ Senha incorreta do aluno!');
                }
            } else {
                activateStudent(st);
            }
        }

        function openAvatarBuilderForNew() {
            selectedStudent = null;
            if (document.getElementById('student-name-input')) {
                document.getElementById('student-name-input').value = '';
            }
            if (document.getElementById('student-pin-input')) {
                document.getElementById('student-pin-input').value = '';
            }
            avatarConfig = {
                style: 'bottts',
                seed: 'Spark',
                bg: 'b6e3f4'
            };
            showStep(4);
            switchDuoTab('heroes');
            updateDuoPreview();
        }

        function switchDuoTab(tabKey) {
            activeTab = tabKey;
            document.querySelectorAll('.duo-tab-icon').forEach(icon => icon.classList.remove('active'));
            const activeIcon = Array.from(document.querySelectorAll('.duo-tab-icon')).find(el => {
                const attr = el.getAttribute('onclick') || '';
                return attr.includes(`'${tabKey}'`);
            });
            if (activeIcon) activeIcon.classList.add('active');

            renderTabContent();
        }

        function randomizeAvatar() {
            const P = DUOLINGO_AVATAR_PRESETS;
            const styleObj = P.styles[Math.floor(Math.random() * P.styles.length)];
            avatarConfig.style = styleObj.id;
            
            const seedsList = P.styleSeeds[styleObj.id] || P.styleSeeds['bottts'];
            const seedObj = seedsList[Math.floor(Math.random() * seedsList.length)];
            avatarConfig.seed = seedObj.id + Math.floor(Math.random() * 100);

            const bgObj = P.bgColors[Math.floor(Math.random() * P.bgColors.length)];
            avatarConfig.bg = bgObj.hex;

            updateDuoPreview();
            renderTabContent();
        }

        function renderTabContent() {
            const P = DUOLINGO_AVATAR_PRESETS;
            const container = document.getElementById('duo-tiles-container');
            const titleEl = document.getElementById('duo-tab-title');
            if (!container || !titleEl) return;
            container.innerHTML = '';

            if (activeTab === 'heroes') {
                titleEl.innerText = '🦸‍♂️ Escolha um Herói Pronto ou Mascote:';
                const heroes = DUOLINGO_AVATAR_PRESETS.heroes || [];
                heroes.forEach(h => {
                    const isSel = (avatarConfig.style === h.style && avatarConfig.seed === h.seed);
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; padding:12px; font-weight:800; border-radius:18px; min-height:115px; cursor:pointer; background: #ffffff; border: 2px solid #e2e8f0; border-bottom: 4px solid #cbd5e1; transition: 0.2s;';
                    tile.onmouseover = () => tile.style.transform = 'translateY(-3px)';
                    tile.onmouseout = () => tile.style.transform = 'translateY(0)';
                    tile.onclick = () => {
                        avatarConfig.style = h.style;
                        avatarConfig.seed = h.seed;
                        avatarConfig.bg = h.bg;
                        const nameInp = document.getElementById('student-name-input');
                        if (nameInp && (!nameInp.value || nameInp.value === 'Aluno Lab Kids')) {
                            nameInp.value = h.name;
                        }
                        renderTabContent();
                        updateDuoPreview();
                    };
                    const sampleUrl = buildDiceBearUrl({ style: h.style, seed: h.seed, bg: h.bg });
                    tile.innerHTML = `
                        <img src="${sampleUrl}" width="65" height="65" style="border-radius:14px; margin-bottom:6px; box-shadow:0 4px 10px rgba(0,0,0,0.1);" alt="${h.name}" />
                        <div style="font-size:0.88rem; font-weight:900; color:#1e293b;">${h.name}</div>
                        <div style="font-size:0.7rem; color:#64748b; font-weight:700;">${h.title}</div>
                    `;
                    container.appendChild(tile);
                });
            } else if (activeTab === 'style') {
                titleEl.innerText = 'Escolha a Coleção do Avatar 🎨';
                P.styles.forEach(s => {
                    const isSel = avatarConfig.style === s.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; padding:12px; font-weight:800; font-size:0.9rem; text-align:center; border-radius:16px; min-height:95px; cursor:pointer; background: #ffffff;';
                    tile.onclick = () => {
                        avatarConfig.style = s.id;
                        const defaultSeeds = P.styleSeeds[s.id] || P.styleSeeds['bottts'];
                        if (defaultSeeds && defaultSeeds.length > 0) {
                            avatarConfig.seed = defaultSeeds[0].id;
                        }
                        renderTabContent();
                        updateDuoPreview();
                    };
                    const sampleUrl = buildDiceBearUrl({ style: s.id, seed: 'Sample', bg: 'b6e3f4' });
                    tile.innerHTML = `
                        <img src="${sampleUrl}" width="55" height="55" style="border-radius:10px; margin-bottom:6px;" alt="${s.label}" />
                        <div>${s.label}</div>
                    `;
                    container.appendChild(tile);
                });
            } else if (activeTab === 'seed') {
                const currentStyleName = (P.styles.find(st => st.id === avatarConfig.style) || {}).label || 'ESTILO';
                titleEl.innerText = `Personagens de ${currentStyleName} 👤`;
                
                // Random seed button
                const randBtn = document.createElement('div');
                randBtn.style.cssText = 'grid-column: 1 / -1; margin-bottom: 10px;';
                randBtn.innerHTML = `
                    <button onclick="randomizeAvatar()" class="btn-back" style="width:100%; background: #58cc02; color: white; border: none; font-weight: 900; box-shadow: 0 4px 0 #46a302; padding: 12px; font-size: 1rem;">
                        🎲 Sorteio Surpresa 🚀
                    </button>
                `;
                container.appendChild(randBtn);

                const seedList = P.styleSeeds[avatarConfig.style] || P.styleSeeds['bottts'];
                seedList.forEach(sd => {
                    const isSel = avatarConfig.seed === sd.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => {
                        avatarConfig.seed = sd.id;
                        renderTabContent();
                        updateDuoPreview();
                    };
                    const tileUrl = buildDiceBearUrl({ style: avatarConfig.style, seed: sd.id, bg: avatarConfig.bg || 'b6e3f4' });
                    tile.innerHTML = `
                        <img src="${tileUrl}" width="65" height="65" style="display:block; margin:0 auto; border-radius:10px;" alt="${sd.label}" />
                        <div style="font-size:0.75rem; font-weight:800; text-align:center; margin-top:4px; color:#4b5563;">${sd.label}</div>
                    `;
                    container.appendChild(tile);
                });
            } else if (activeTab === 'bg') {
                titleEl.innerText = 'Cor de Fundo 🌈';
                P.bgColors.forEach(theme => {
                    const isSel = (avatarConfig.bg || '').replace('#','') === theme.hex.replace('#','');
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => {
                        avatarConfig.bg = theme.hex;
                        renderTabContent();
                        updateDuoPreview();
                    };
                    tile.innerHTML = `
                        <div class="duo-color-swatch" style="background:${theme.hex}; border-radius:12px; width:100%; height:55px;" title="${theme.label}"></div>
                        <div style="font-size:0.75rem; font-weight:800; text-align:center; margin-top:4px; color:#4b5563;">${theme.label}</div>
                    `;
                    container.appendChild(tile);
                });
            }
        }

        function updateDuoPreview() {
            const svg = generateAvatarSVG(avatarConfig, 220);
            const previewEl = document.getElementById('duo-avatar-preview');
            if (previewEl) previewEl.innerHTML = svg;
            
            const bgEl = document.getElementById('duo-canvas-bg');
            if (bgEl) {
                const hexColor = (avatarConfig.bg || 'b6e3f4').startsWith('#') ? avatarConfig.bg : '#' + avatarConfig.bg;
                bgEl.style.background = hexColor;
            }
        }

        async function saveAvatarProfile() {
            let name = document.getElementById('student-name-input') ? document.getElementById('student-name-input').value.trim() : '';
            if (!name) name = 'Aluno Lab Kids';
            const studentPin = document.getElementById('student-pin-input') ? document.getElementById('student-pin-input').value.trim() : '';

            const classId = (selectedClass && selectedClass.id) 
                ? selectedClass.id 
                : (selectedStudent && selectedStudent.class_id ? selectedStudent.class_id : 1);

            const schoolName = selectedSchool ? selectedSchool.name : (selectedStudent ? selectedStudent.school_name : 'Escola');
            const className = selectedClass ? selectedClass.name : (selectedStudent ? selectedStudent.class_name : 'Turma');

            if (!selectedStudent) {
                try {
                    const res = await fetch('/api/students', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            class_id: classId,
                            name,
                            avatar_config: JSON.stringify(avatarConfig),
                            school_name: schoolName,
                            class_name: className,
                            student_pin: studentPin
                        })
                    });
                    const data = await res.json();
                    if (data && data.success && data.student) {
                        data.student.school_name = schoolName;
                        data.student.class_name = className;
                        data.student.student_pin = studentPin;
                        activateStudent(data.student);
                        return;
                    }
                } catch(e) {
                    console.warn('saveAvatarProfile API error:', e);
                }
                
                // Fallback: Activate profile locally so user is never stuck
                activateStudent({
                    id: Date.now(),
                    class_id: classId,
                    name,
                    school_name: schoolName,
                    class_name: className,
                    avatar_config: avatarConfig,
                    student_pin: studentPin,
                    points: 0
                });
            } else {
                try {
                    const res = await fetch(`/api/students/${selectedStudent.id}/avatar`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            name,
                            avatar_config: JSON.stringify(avatarConfig),
                            student_pin: studentPin,
                            school_name: schoolName,
                            class_name: className
                        })
                    });
                    const data = await res.json();
                    if (data && data.success && data.student) {
                        data.student.school_name = schoolName;
                        data.student.class_name = className;
                        activateStudent(data.student);
                        return;
                    }
                } catch(e){
                    console.warn('saveAvatarProfile edit error:', e);
                }
                selectedStudent.name = name;
                selectedStudent.avatar_config = avatarConfig;
                selectedStudent.student_pin = studentPin;
                if (schoolName) selectedStudent.school_name = schoolName;
                if (className) selectedStudent.class_name = className;
                activateStudent(selectedStudent);
            }
        }

        function activateStudent(st) {
            if (!st) return;
            const prevSchool = selectedStudent ? selectedStudent.school_name : '';
            const prevClass = selectedStudent ? selectedStudent.class_name : '';

            selectedStudent = st;
            if (typeof st.avatar_config === 'string') {
                try { selectedStudent.avatar_config = JSON.parse(st.avatar_config); } catch(e){}
            }

            if (selectedSchool && selectedSchool.name) {
                selectedStudent.school_name = selectedSchool.name;
            } else if (prevSchool && !selectedStudent.school_name) {
                selectedStudent.school_name = prevSchool;
            } else if (!selectedStudent.school_name) {
                try {
                    const s = JSON.parse(sessionStorage.getItem('lab_selected_school'));
                    if (s && s.name) selectedStudent.school_name = s.name;
                } catch(e){}
            }

            if (selectedClass && selectedClass.name) {
                selectedStudent.class_name = selectedClass.name;
            } else if (prevClass && !selectedStudent.class_name) {
                selectedStudent.class_name = prevClass;
            } else if (!selectedStudent.class_name) {
                try {
                    const c = JSON.parse(sessionStorage.getItem('lab_selected_class'));
                    if (c && c.name) selectedStudent.class_name = c.name;
                } catch(e){}
            }

            localStorage.setItem('lab_student_profile', JSON.stringify(selectedStudent));
            showStep(5);
            renderProfileView();
        }

        function renderProfileView() {
            if (!selectedStudent) return;
            document.getElementById('active-student-name').innerText = selectedStudent.name;
            const scText = (selectedStudent.school_name || selectedStudent.class_name) 
                ? `${selectedStudent.school_name || 'Escola'} | ${selectedStudent.class_name || 'Turma'}`
                : 'Lab Kids Digital';
            document.getElementById('active-student-school').innerText = scText;
            const pts = Number(selectedStudent.points || 0);
            document.getElementById('active-points').innerText = pts;
            const streak = Number(selectedStudent.daily_streak || 1);
            const strEl = document.getElementById('active-streak-display');
            if (strEl) strEl.innerText = '🔥 ' + streak + 'd';
            const lvlObj = (window.LabGamification && window.LabGamification.calculateLevel)
                ? window.LabGamification.calculateLevel(pts)
                : { level: 1, title: 'Recruta' };
            const lvlEl = document.getElementById('active-level-display');
            if (lvlEl) lvlEl.innerText = 'Nvl ' + lvlObj.level;

            const svg = generateAvatarSVG(selectedStudent.avatar_config || {}, 160);
            document.getElementById('active-avatar-display').innerHTML = svg;
        }

        function editCurrentAvatar() {
            if (selectedStudent && selectedStudent.avatar_config) {
                avatarConfig = typeof selectedStudent.avatar_config === 'string' 
                    ? JSON.parse(selectedStudent.avatar_config) 
                    : selectedStudent.avatar_config;
                if (document.getElementById('student-name-input')) {
                    document.getElementById('student-name-input').value = selectedStudent.name || '';
                }
                if (document.getElementById('student-pin-input')) {
                    document.getElementById('student-pin-input').value = selectedStudent.student_pin || '';
                }
            }
            showStep(4);
            switchDuoTab('skin');
            updateDuoPreview();
        }

        function logoutStudent() {
            if (!confirm('Deseja sair do perfil deste aluno no tablet?')) return;
            localStorage.removeItem('lab_student_profile');
            sessionStorage.removeItem('lab_wizard_step');
            sessionStorage.removeItem('lab_selected_school');
            sessionStorage.removeItem('lab_selected_class');
            selectedStudent = null;
            selectedSchool = null;
            selectedClass = null;
            loadSchools();
            showStep(1);
        }
    </script>

    <!-- MODAL DE AVISO DE INATIVIDADE (TABLET COLETIVO - 10 MINUTOS) -->
    <div id="idle-warning-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(8px); z-index: 999999; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: #ffffff; border: 4px solid #f59e0b; border-radius: 28px; max-width: 450px; width: 100%; padding: 35px 25px; text-align: center; box-shadow: 0 25px 60px rgba(0,0,0,0.5);">
            <div style="font-size: 3.5rem; margin-bottom: 6px;">⏳</div>
            <h2 style="color: #d97706; margin: 0 0 10px 0; font-size: 1.8rem; font-weight: 900;">Você ainda está aí?</h2>
            <p style="color: #4b5563; font-weight: 700; font-size: 1.05rem; line-height: 1.5; margin: 0 0 15px 0;">
                Por segurança neste tablet compartilhado, seu perfil será <strong>desconectado</strong> para liberar o aparelho para o próximo colega em:
            </p>
            <div style="font-size: 3.8rem; font-weight: 900; color: #ef4444; font-family: monospace; letter-spacing: 2px; margin-bottom: 20px;">
                <span id="idle-countdown">60</span>s
            </div>
            <button onclick="dismissIdleWarning()" class="btn-duo-save" style="width: 100%; background: #10b981; border-color: #059669; font-size: 1.2rem; margin: 0;">
                🟢 CONTINUAR JOGANDO
            </button>
        </div>
    </div>

</body>
</html>

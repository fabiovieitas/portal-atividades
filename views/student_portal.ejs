<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área do Aluno - Lab Kids</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Lab Kids">
    <link rel="icon" type="image/png" sizes="512x512" href="/img/robot-icon-512.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/img/robot-icon-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/img/robot-icon-512.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
    <!-- Google AdSense Oficial -->
    <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
      <meta name="google-adsense-account" content="<%= adsensePubId %>">
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <% } %>
    <meta name="robots" content="noindex, follow">
    <script src="/js/avatar_system.js"></script>
    <script src="/js/labkids-gamification.js"></script>
    <script src="/js/app-enhancements.js" defer></script>
    <style>
        :root {
            --duo-green: #58cc02;
            --duo-green-dark: #46a302;
            --duo-blue: #1cb0f6;
            --duo-blue-dark: #1899d6;
            --duo-card-bg: #ffffff;
            --duo-border: #e5e5e5;
            --duo-text-dark: #3c3c3c;
            --app-bg: #f7f7f7;
        }

        body.student-theme {
            background: var(--app-bg);
            color: var(--duo-text-dark);
            font-family: 'Nunito', 'Fredoka', sans-serif;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
        }

        .portal-header {
            text-align: center;
            margin-bottom: 20px;
            position: relative;
        }

        .portal-header h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin: 0;
            color: #3c3c3c;
        }

        .portal-header p {
            color: #777777;
            font-size: 1.05rem;
            margin-top: 4px;
            font-weight: 700;
        }

        .btn-top-logout {
            position: absolute;
            right: 10px;
            top: 0;
            background: #ff4b4b;
            border: none;
            border-bottom: 4px solid #ea2b2b;
            color: white;
            padding: 8px 18px;
            border-radius: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-top-logout:hover {
            transform: translateY(-2px);
            background: #ff3333;
        }

        /* Step Bar */
        .step-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .step-pill {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 800;
            color: #afafaf;
            transition: 0.2s;
        }

        .step-pill.active {
            background: var(--duo-blue);
            color: #ffffff;
            border-color: var(--duo-blue-dark);
            box-shadow: 0 4px 0 var(--duo-blue-dark);
        }

        /* Selection Grid */
        .grid-selection {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            max-width: 950px;
            margin: 0 auto;
        }

        .card-item {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .card-item:hover {
            transform: translateY(-4px);
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
        }

        .card-item.in-use {
            border-color: var(--duo-green);
            border-bottom-color: var(--duo-green-dark);
            background: #f1fbe8;
        }

        .card-item .icon-box {
            font-size: 3rem;
            margin-bottom: 8px;
        }

        .card-item h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0 0 4px 0;
            color: var(--duo-text-dark);
        }

        /* DUOLINGO OFFICIAL AVATAR EDITOR LAYOUT */
        .duo-editor-window {
            display: flex;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-radius: 24px;
            overflow: hidden;
            max-width: 1050px;
            margin: 0 auto;
            min-height: 520px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

        /* Left Canvas Preview Area */
        .duo-canvas-side {
            flex: 1.1;
            min-width: 320px;
            background: #e55b5b;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            position: relative;
            transition: background 0.3s ease;
        }

        .duo-canvas-avatar-wrapper {
            transform: scale(1.35);
            margin-bottom: 20px;
        }

        .duo-name-input {
            width: 85%;
            padding: 12px;
            border-radius: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            background: rgba(0, 0, 0, 0.25);
            color: #ffffff;
            font-weight: 800;
            font-size: 1.1rem;
            text-align: center;
            outline: none;
            backdrop-filter: blur(5px);
        }

        .duo-name-input::placeholder {
            color: rgba(255,255,255,0.7);
        }

        .btn-duo-save {
            background: var(--duo-green);
            border: none;
            border-bottom: 4px solid var(--duo-green-dark);
            color: #ffffff;
            font-weight: 900;
            font-size: 1.2rem;
            padding: 14px 32px;
            border-radius: 18px;
            cursor: pointer;
            width: 85%;
            margin-top: 15px;
            transition: 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-duo-save:hover {
            transform: translateY(-2px);
            background: #61e002;
        }

        .btn-duo-save:active {
            transform: translateY(2px);
            border-bottom-width: 0;
        }

        /* Right Panel Customizer Side */
        .duo-panel-side {
            flex: 1.4;
            min-width: 340px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            border-left: 2px solid var(--duo-border);
        }

        /* Top Horizontal Icon Tabs Bar */
        .duo-tabs-nav {
            display: flex;
            overflow-x: auto;
            border-bottom: 2px solid var(--duo-border);
            padding: 10px 10px 0 10px;
            gap: 4px;
            background: #ffffff;
            scrollbar-width: none;
        }

        .duo-tabs-nav::-webkit-scrollbar { display: none; }

        .duo-tab-icon {
            flex: 0 0 auto;
            padding: 10px 14px;
            border-radius: 12px 12px 0 0;
            font-size: 1.4rem;
            cursor: pointer;
            color: #afafaf;
            border-bottom: 3px solid transparent;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .duo-tab-icon:hover {
            color: var(--duo-blue);
            background: #f7f7f7;
        }

        .duo-tab-icon.active {
            color: var(--duo-blue);
            border-bottom-color: var(--duo-blue);
            background: #ffffff;
        }

        /* Content Panel Inside Tab */
        .duo-tab-content {
            padding: 20px;
            overflow-y: auto;
            max-height: 480px;
            flex: 1;
        }

        .duo-category-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--duo-text-dark);
            margin: 0 0 15px 0;
        }

        /* 3-Column Grid Tiles */
        .duo-tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .duo-tile-card {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 4px solid var(--duo-border);
            border-radius: 16px;
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.15s;
            position: relative;
            padding: 6px;
        }

        .duo-tile-card:hover {
            border-color: var(--duo-blue);
            transform: translateY(-2px);
        }

        .duo-tile-card.selected {
            background: #ddf4ff;
            border-color: var(--duo-blue);
            border-bottom-color: var(--duo-blue-dark);
            box-shadow: 0 0 0 2px var(--duo-blue);
        }

        .duo-color-swatch {
            width: 100%;
            height: 100%;
            border-radius: 12px;
        }

        .btn-back {
            background: #ffffff;
            border: 2px solid var(--duo-border);
            color: var(--duo-text-dark);
            padding: 8px 18px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 800;
            margin-bottom: 15px;
        }

        /* PIN Modal */
        .pin-container {
            max-width: 380px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid var(--duo-border);
            border-bottom: 5px solid var(--duo-border);
            border-radius: 24px;
            padding: 25px;
            text-align: center;
        }

        .pin-input {
            font-size: 2.2rem;
            letter-spacing: 10px;
            text-align: center;
            width: 80%;
            padding: 10px;
            border-radius: 16px;
            border: 2px solid var(--duo-blue);
            background: #f7f7f7;
            color: var(--duo-text-dark);
            font-weight: 800;
            margin: 15px 0;
            outline: none;
        }
    
        @keyframes labFloatAvatar {
            0% { transform: scale(1.15) translateY(0); }
            50% { transform: scale(1.15) translateY(-8px); }
            100% { transform: scale(1.15) translateY(0); }
        }

    </style>
</head>
<body class="student-theme">
    <%- include('partials/portal_header') %>

    <div class="container" style="max-width: 1080px; margin: 20px auto 0 auto; padding-bottom: 50px;">

        <div class="portal-header" style="position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                <a href="/" class="btn-back" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; font-size: 1rem; padding: 10px 18px;">
                    🏠 Início do Portal
                </a>
                <button onclick="logoutStudent()" style="background: #ef4444; border: none; border-bottom: 4px solid #b91c1c; color: white; padding: 10px 20px; border-radius: 16px; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem; transition: 0.15s;" title="Desconecta este aluno para que o próximo colega possa usar o tablet">
                    🚪 Trocar Aluno / Finalizar Aula
                </button>
            </div>
            <h1>Área do Aluno - Avatar & Desafios</h1>
            <p>Monte seu perfil interativo no estilo oficial do Duolingo!</p>
        </div>

        <!-- Step Indicator -->
        <div class="step-bar">
            <div class="step-pill" id="step-pill-1">1. Escola 🏫</div>
            <div class="step-pill" id="step-pill-2">2. Turma & PIN 🔑</div>
            <div class="step-pill" id="step-pill-3">3. Escolha seu Nome 👤</div>
            <div class="step-pill" id="step-pill-4">4. Criador de Avatar 🎨</div>
            <div class="step-pill" id="step-pill-5">5. Perfil & Jogos 🏆</div>
        </div>

        <button id="btn-global-back" class="btn-back" onclick="goBackStep()" style="display:inline-block; font-size: 1.1rem; padding: 12px 24px; margin-bottom: 15px;">⬅️ Voltar</button>


        <!-- BANNER PUBLICIDADE / APOIO EDUCACIONAL (TOPO) -->
        <div class="adsense-portal-slot" style="margin: 0 auto 25px auto; max-width: 728px; text-align: center; background: #ffffff; padding: 10px; border-radius: 16px; border: 1.5px solid var(--duo-border);">
            <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Publicidade / Apoio Educacional</span>
            <% if (typeof adsensePubId !== 'undefined' && adsensePubId) { %>
              <ins class="adsbygoogle"
                   style="display:block"
                   data-ad-client="<%= adsensePubId %>"
                   data-ad-slot="default"
                   data-ad-format="auto"
                   data-full-width-responsive="true"></ins>
              <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            <% } else { %>
              <div style="color: #64748b; font-size: 0.85rem; padding: 6px;">Portal Lab Kids - Atividades Educativas & Cultura Digital</div>
            <% } %>
        </div>

        <!-- VIEW 1: SELECT SCHOOL / CODE / FREE EXPLORER -->
        <div id="view-school" class="step-view">

            <!-- 0. ACESSO DIRETO AO STUDIO DE AVATARES 3D (DESTAQUE MÁXIMO) -->
            <div style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: 3px solid #fbbf24; border-radius: 24px; padding: 22px 20px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; box-shadow: 0 10px 35px rgba(124, 58, 237, 0.35); color: #ffffff;">
                <div style="display: flex; align-items: center; gap: 15px; text-align: left; flex: 1; min-width: 250px;">
                    <div style="font-size: 3rem; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));">🎨</div>
                    <div>
                        <div style="font-size: 0.78rem; font-weight: 800; background: #fbbf24; color: #1e1b4b; padding: 2px 10px; border-radius: 50px; display: inline-block; text-transform: uppercase; margin-bottom: 4px;">Studio de Personagens</div>
                        <h3 style="margin: 0 0 4px 0; color: #ffffff; font-size: 1.35rem; font-weight: 900;">Criar ou Mudar Meu Avatar 3D!</h3>
                        <p style="margin: 0; color: #e0e7ff; font-size: 0.95rem; font-weight: 700;">Monte seu herói personalizado, desbloqueie personagens lendários e colecione conquistas!</p>
                    </div>
                </div>
                <button onclick="goToAvatarStudioDirect()" class="btn-duo-save" style="margin: 0; width: auto; padding: 14px 28px; background: #fbbf24; border-color: #f59e0b; color: #1e1b4b; font-size: 1.15rem; font-weight: 900; box-shadow: 0 5px 0 #d97706;">
                    ✨ ABRIR STUDIO DE AVATARES 🚀
                </button>
            </div>


            <!-- 1. CÓDIGO DA TURMA (ENTRADA ULTRA-RÁPIDA) -->
            <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 2.5px solid #3b82f6; border-radius: 24px; padding: 25px 20px; margin-bottom: 25px; box-shadow: 0 8px 30px rgba(59, 130, 246, 0.15); text-align: center;">
                <div style="font-size: 2.4rem; margin-bottom: 4px;">🔑</div>
                <h2 style="margin: 0 0 6px 0; color: #1e40af; font-size: 1.5rem; font-weight: 900;">Tem o Código da sua Turma?</h2>
                <p style="color: #475569; margin: 0 0 16px 0; font-size: 1.05rem; font-weight: 700;">Se o seu professor passou o código da sala (ex: <strong>LK4078</strong>), digite abaixo para entrar direto:</p>
                
                <div style="display: flex; gap: 10px; justify-content: center; max-width: 480px; margin: 0 auto; flex-wrap: wrap;">
                    <input type="text" id="class-code-input" placeholder="Ex: LK4078" maxlength="10" 
                           style="flex: 1; min-width: 170px; padding: 14px 18px; border-radius: 16px; border: 2.5px solid #3b82f6; font-size: 1.35rem; font-weight: 900; text-align: center; text-transform: uppercase; letter-spacing: 2px; outline: none; background: #ffffff; color: #1e3a8a;"
                           onkeydown="if(event.key==='Enter') lookupClassCode()">
                    <button onclick="lookupClassCode()" class="btn-duo-save" style="margin: 0; width: auto; padding: 14px 28px; font-size: 1.1rem; background: #2563eb; border-color: #1d4ed8;">
                        ENTRAR NA TURMA 🚀
                    </button>
                </div>
                <div id="code-lookup-status" style="margin-top: 12px; font-weight: 800; font-size: 1rem; display: none;"></div>
            </div>

            <!-- 2. MODO EXPLORADOR LIVRE (ESTUDANTE EM CASA / QUALQUER ESCOLA) -->
            <div style="background: linear-gradient(135deg, #fefce8 0%, #fef08a 100%); border: 2.5px solid #eab308; border-radius: 24px; padding: 22px 20px; margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; box-shadow: 0 8px 30px rgba(234, 179, 8, 0.15);">
                <div style="display: flex; align-items: center; gap: 15px; text-align: left; flex: 1; min-width: 260px;">
                    <span style="font-size: 2.6rem;">🎒</span>
                    <div>
                        <h3 style="margin: 0 0 4px 0; color: #854d0e; font-size: 1.3rem; font-weight: 900;">Jogando de Casa ou Outra Escola?</h3>
                        <p style="margin: 0; color: #713f12; font-size: 0.95rem; font-weight: 700;">Você não precisa de código de turma! Jogue como <strong>Explorador Livre</strong>, crie seu avatar 3D e colecione medalhas.</p>
                    </div>
                </div>
                <button onclick="startFreeExplorerMode()" class="btn-duo-save" style="margin: 0; width: auto; padding: 14px 28px; background: #eab308; border-color: #ca8a04; color: #422006; font-size: 1.1rem; box-shadow: 0 4px 0 #ca8a04;">
                    ⭐ JOGAR NO MODO LIVRE
                </button>
            </div>

            <!-- 3. LISTA TRADICIONAL DE ESCOLAS COM CAMPO DE BUSCA -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                <h3 style="color: var(--duo-text-dark); margin: 0; font-size: 1.3rem; font-weight: 800;">Ou selecione sua Escola na Rede:</h3>
                <input type="text" id="school-search-filter" placeholder="🔍 Buscar escola por nome..." oninput="filterSchools(this.value)" 
                       style="padding: 10px 16px; border-radius: 14px; border: 2px solid var(--duo-border); outline: none; font-weight: 700; width: 100%; max-width: 320px;">
            </div>

            <div class="grid-selection" id="schools-container">
                <p style="text-align: center; width: 100%;">Carregando escolas...</p>
            </div>
        </div>

        <!-- VIEW 2: SELECT CLASS & PIN -->
        <div id="view-class" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 15px;" id="school-title">Turmas da Escola</h2>
            <div class="grid-selection" id="classes-container" style="margin-bottom: 25px;">
                <!-- Classes loaded here -->
            </div>

            <div id="pin-box" class="pin-container" style="display:none;">
                <h3 style="margin: 0; color: var(--duo-blue);">🔑 Digite o PIN da Turma:</h3>
                <input type="password" id="pin-input" class="pin-input" maxlength="6" placeholder="****">
                <button class="btn-duo-save" style="width: 100%;" onclick="submitPin()">LIBERAR TURMA 🚀</button>
                <p id="pin-error" style="color: #ff4b4b; font-weight: 800; margin-top: 10px; display:none;"></p>
            </div>
        </div>

        <!-- VIEW 3: SELECT STUDENT OR CREATE NEW -->
        <div id="view-students" class="step-view" style="display:none;">
            <h2 style="text-align: center; color: var(--duo-text-dark); margin-bottom: 8px;">Quem é você?</h2>
            <p style="text-align: center; color: #777; margin-bottom: 20px;">Clique no seu perfil ou crie um novo avatar!</p>
            
            <div style="text-align: center; margin-bottom: 20px;">
                <button class="btn-duo-save" style="max-width: 340px;" onclick="openAvatarBuilderForNew()">
                    ✨ CRIAR NOVO AVATAR DUOLINGO
                </button>
            </div>

            <div class="grid-selection" id="students-container">
                <!-- Students loaded here -->
            </div>
        </div>

        <!-- VIEW 4: STUDIO DE AVATARES ÉPICO LAB KIDS -->
        <div id="view-avatar-builder" class="step-view" style="display:none;">
            <div style="text-align: center; margin-bottom: 20px;">
                <h2 style="font-family: 'Fredoka', cursive; font-size: 2.2rem; color: #1e3a8a; margin: 0 0 6px 0;">🎨 Studio de Avatares Lab Kids</h2>
                <p style="color: #64748b; font-weight: 700; margin: 0; font-size: 1.05rem;">Monte o personagem que vai representar suas conquistas e medalhas na plataforma!</p>
            </div>

            <div class="duo-editor-window" style="box-shadow: 0 20px 50px rgba(0,0,0,0.12); border-radius: 28px; border: 2.5px solid var(--duo-border);">
                <!-- Left Side: Canvas Preview & Inputs -->
                <div class="duo-canvas-side" id="duo-canvas-bg" style="background: #38bdf8; padding: 30px 20px; transition: background 0.4s ease; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    
                    <!-- Crachá Dinâmico do Jogador -->
                    <div id="builder-player-badge" style="background: rgba(0,0,0,0.45); backdrop-filter: blur(8px); padding: 6px 18px; border-radius: 50px; border: 1.5px solid rgba(255,255,255,0.4); color: #ffffff; font-size: 0.9rem; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px;">
                        <span>⭐</span> <span id="builder-xp-display" style="color: #fbbf24;">0 XP</span> • <span id="builder-rank-display">Recruta Digital</span>
                    </div>

                    <!-- Pedestal 3D com Preview do Avatar em Levitação -->
                    <div style="position: relative; width: 220px; height: 210px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
                        <div style="position: absolute; bottom: 8px; width: 160px; height: 30px; background: radial-gradient(ellipse at center, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 70%); border-radius: 50%;"></div>
                        <div class="duo-canvas-avatar-wrapper" id="duo-avatar-preview" style="filter: drop-shadow(0 15px 25px rgba(0,0,0,0.35)); animation: labFloatAvatar 3s ease-in-out infinite;"></div>
                    </div>


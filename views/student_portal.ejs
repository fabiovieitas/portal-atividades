                accessories: 'none'
            };
            showStep(4);
            switchDuoTab('heroes');
            updateDuoPreview();
        }

        function switchDuoTab(tabKey) {
            activeTab = tabKey;
            document.querySelectorAll('.duo-tab-icon').forEach(icon => icon.classList.remove('active'));
            const activeIcon = Array.from(document.querySelectorAll('.duo-tab-icon')).find(el => {
                const attr = el.getAttribute('onclick') || '';
                return attr.includes(`'${tabKey}'`);
            });
            if (activeIcon) activeIcon.classList.add('active');

            renderTabContent();
        }

        function randomizeAvatar() {
            const P = DUOLINGO_AVATAR_PRESETS;
            if (window.LabKidsGamification) {
                window.LabKidsGamification.playChime();
                window.LabKidsGamification.confetti();
            }

            if (Math.random() > 0.5 && P.heroes && P.heroes.length > 0) {
                const h = P.heroes[Math.floor(Math.random() * P.heroes.length)];
                avatarConfig.style = h.style;
                avatarConfig.seed = h.seed;
                avatarConfig.bg = h.bg;
                const nameInp = document.getElementById('student-name-input');
                if (nameInp && (!nameInp.value || nameInp.value === 'Aluno Lab Kids')) {
                    nameInp.value = h.name;
                }
            } else {
                avatarConfig.style = 'avataaars';
                avatarConfig.seed = 'Kid' + Math.floor(Math.random() * 1000);
                avatarConfig.top = P.hairStyles[Math.floor(Math.random() * P.hairStyles.length)].id;
                avatarConfig.hairColor = P.hairColors[Math.floor(Math.random() * P.hairColors.length)].hex;
                avatarConfig.skinColor = P.skinColors[Math.floor(Math.random() * P.skinColors.length)].hex;
                avatarConfig.clothing = P.clothing[Math.floor(Math.random() * P.clothing.length)].id;
                avatarConfig.clothesColor = P.clothesColors[Math.floor(Math.random() * P.clothesColors.length)].hex;
                avatarConfig.eyes = P.eyes[Math.floor(Math.random() * P.eyes.length)].id;
                avatarConfig.mouth = P.mouth[Math.floor(Math.random() * P.mouth.length)].id;
                avatarConfig.accessories = P.accessories[Math.floor(Math.random() * P.accessories.length)].id;
                avatarConfig.bg = P.bgColors[Math.floor(Math.random() * P.bgColors.length)].hex;
            }

            updateDuoPreview();
            renderTabContent();

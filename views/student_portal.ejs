    <script>
        
        // ============================================================================
        // BUSCA DE TURMA POR CÓDIGO (EX: LK4078)
        // ============================================================================
        async function lookupClassCode(codeToSearch) {
            const input = document.getElementById('class-code-input');
            const code = (codeToSearch || (input ? input.value : '')).trim().toUpperCase();
            const statusDiv = document.getElementById('code-lookup-status');

            if (!code) {
                if (statusDiv) {
                    statusDiv.style.color = '#ef4444';
                    statusDiv.innerText = 'Por favor, digite o código da turma (ex: LK4078).';
                    statusDiv.style.display = 'block';
                }
                return;
            }

            if (statusDiv) {
                statusDiv.style.color = '#2563eb';
                statusDiv.innerText = '🔍 Localizando sua turma...';
                statusDiv.style.display = 'block';
            }

            try {
                const res = await fetch('/api/classes/lookup/' + encodeURIComponent(code));
                const data = await res.json();
                if (data.success && data.class) {
                    selectedSchool = { id: data.class.id, name: data.class.school_name };
                    selectedClass = { id: data.class.id, name: data.class.name, grade_level: data.class.name };
                    
                    try {
                        sessionStorage.setItem('lab_selected_school', JSON.stringify(selectedSchool));
                        sessionStorage.setItem('lab_selected_class', JSON.stringify(selectedClass));
                    } catch(e){}

                    if (statusDiv) {
                        statusDiv.style.color = '#10b981';
                        statusDiv.innerText = '🎉 Turma encontrada: ' + data.class.name + ' - ' + data.class.school_name + ' (' + data.class.teacher_name + ')';
                    }

                    document.getElementById('school-title').innerText = data.class.name + ' - ' + data.class.school_name;
                    setTimeout(() => {
                        loadStudentsByClass();
                    }, 500);
                } else {
                    if (statusDiv) {
                        statusDiv.style.color = '#ef4444';
                        statusDiv.innerText = data.error || 'Código não encontrado. Peça o código correto ao seu professor!';
                    }
                }
            } catch(err) {
                if (statusDiv) {
                    statusDiv.style.color = '#ef4444';
                    statusDiv.innerText = 'Erro ao conectar. Verifique sua internet.';
                }
            }
        }

        // ============================================================================
        // MODO EXPLORADOR LIVRE (ESTUDANTE EM CASA / SEM ESCOLA)
        // ============================================================================
        function startFreeExplorerMode() {
            selectedSchool = { id: 0, name: 'Lab Kids Brasil' };
            selectedClass = { id: 0, name: 'Exploradores Livres' };
            try {
                sessionStorage.setItem('lab_selected_school', JSON.stringify(selectedSchool));
                sessionStorage.setItem('lab_selected_class', JSON.stringify(selectedClass));
            } catch(e){}

            openAvatarBuilderForNew();
        }

        // ============================================================================
        // FILTRO DE BUSCA DE ESCOLAS
        // ============================================================================
        let allSchoolsList = [];
        function filterSchools(query) {
            const q = (query || '').toLowerCase().trim();
            if (!allSchoolsList || allSchoolsList.length === 0) return;
            const filtered = allSchoolsList.filter(s => (s.name || '').toLowerCase().includes(q) || (s.city || '').toLowerCase().includes(q));
            renderSchools(filtered);
        }

        // ============================================================================
        // CONTROLE DE INATIVIDADE (10 MINUTOS COM AVISO AOS 9 MINUTOS - TABLET COLETIVO)
        // ============================================================================
        const IDLE_WARN_MS = 4 * 60 * 1000;    // 9 minutos
        const IDLE_LOGOUT_MS = 5 * 60 * 1000; // 10 minutos
        let lastUserActionTime = Date.now();
        let idleIntervalCountdown = null;

        function recordUserActivity() {
            lastUserActionTime = Date.now();
            const modal = document.getElementById('idle-warning-modal');
            if (modal && modal.style.display === 'flex') {
                dismissIdleWarning();
            }
        }

        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach(evt => {
            window.addEventListener(evt, recordUserActivity, { passive: true });
        });

        setInterval(() => {
            const hasProfile = !!localStorage.getItem('lab_student_profile');
            if (!hasProfile) return;

            const elapsed = Date.now() - lastUserActionTime;
            const modal = document.getElementById('idle-warning-modal');

            // Verificação periódica de encerramento coletivo da aula (Item 20)
            const sessionStartTime = sessionStorage.getItem('lab_session_start_time') || new Date().toISOString();
            if (!sessionStorage.getItem('lab_session_start_time')) {
                sessionStorage.setItem('lab_session_start_time', sessionStartTime);
            }
            if (selectedClass && selectedClass.id && Math.random() < 0.3) {
                fetch('/api/classes/' + selectedClass.id + '/check-session?since=' + encodeURIComponent(sessionStartTime))
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.shouldLogout) {
                            alert('🚪 ' + (data.message || 'A aula foi encerrada pelo seu professor. Até a próxima!'));
                            logoutStudent();
                        }
                    }).catch(function(){});
            }

            if (elapsed >= IDLE_LOGOUT_MS) {
                dismissIdleWarning();
                forceIdleLogout();
            } else if (elapsed >= IDLE_WARN_MS) {
                if (modal && modal.style.display !== 'flex') {
                    modal.style.display = 'flex';
                    let remaining = Math.max(1, Math.round((IDLE_LOGOUT_MS - elapsed) / 1000));
                    const cd = document.getElementById('idle-countdown');
                    if (cd) cd.innerText = remaining;

                    clearInterval(idleIntervalCountdown);
                    idleIntervalCountdown = setInterval(() => {
                        remaining--;
                        if (cd) cd.innerText = remaining;
                        if (remaining <= 0) {
                            clearInterval(idleIntervalCountdown);
                            dismissIdleWarning();
                            forceIdleLogout();
                        }
                    }, 1000);
                }
            }
        }, 4000);

        function dismissIdleWarning() {
            clearInterval(idleIntervalCountdown);
            const modal = document.getElementById('idle-warning-modal');
            if (modal) modal.style.display = 'none';
            lastUserActionTime = Date.now();
        }

        function forceIdleLogout() {
            localStorage.removeItem('lab_student_profile');
            sessionStorage.removeItem('lab_wizard_step');
            sessionStorage.removeItem('lab_selected_school');
            sessionStorage.removeItem('lab_selected_class');
            selectedStudent = null;
            selectedSchool = null;
            selectedClass = null;
            alert('⏳ Sessão finalizada por 5 minutos de inatividade!\n\nO tablet foi liberado para o próximo colega.');
            loadSchools();
            showStep(1);
        }

        let currentStep = 1;
        let activeTab = 'voxelSeeds';
        let selectedSchool = null;
        let selectedClass = null;
        let selectedStudent = null;

        // Customizer state (100% Editable Animated Voxel Art 3D Engine)
        let avatarConfig = {
            style: 'voxel-art',
            seed: 'Voxel' + Math.floor(Math.random() * 10000),
            animationSpeed: 'fastest',
            hairStyle: 'spiky',
            hairColor: '2c1b18',
            skinColor: 'ffdbb4',
            outfit: 'hoodie',
            glasses: 'none',
            beard: 'none',
            eyes: 'open',
            bg: 'e55b5b',
            bgPattern: '',
            customBg: ''
        };

        window.addEventListener('DOMContentLoaded', () => {
            // Se veio pelo atalho direto de avatares (?action=avatar)
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('action') === 'avatar') {
                const savedProfile = localStorage.getItem('lab_student_profile');
                if (savedProfile) {
                    try {
                        selectedStudent = JSON.parse(savedProfile);
                        if (selectedStudent && selectedStudent.avatar_config) {
                            avatarConfig = typeof selectedStudent.avatar_config === 'string'
                                ? JSON.parse(selectedStudent.avatar_config)
                                : selectedStudent.avatar_config;
                        }
                    } catch(e){}
                }
                showStep(4);
                switchDuoTab('heroes');
                renderTabContent();
                updateDuoPreview();
                return;
            }
            // Restore school & class selection from sessionStorage if available
            try {
                const savedSchool = sessionStorage.getItem('lab_selected_school');
                if (savedSchool) selectedSchool = JSON.parse(savedSchool);
                const savedClass = sessionStorage.getItem('lab_selected_class');
                if (savedClass) selectedClass = JSON.parse(savedClass);
            } catch(e){}

            const savedProfile = localStorage.getItem('lab_student_profile');
            if (savedProfile) {
                try {
                    selectedStudent = JSON.parse(savedProfile);
                    if (selectedStudent && selectedStudent.avatar_config) {
                        avatarConfig = typeof selectedStudent.avatar_config === 'string'
                            ? JSON.parse(selectedStudent.avatar_config)
                            : selectedStudent.avatar_config;
                    }
                    showStep(5);
                    renderProfileView();
                    return;
                } catch(e){
                    console.error('Error parsing saved student profile:', e);
                }
            }

            // If user was in the middle of wizard steps before F5
            const savedStep = parseInt(sessionStorage.getItem('lab_wizard_step') || '1');
            if (savedStep > 1 && selectedSchool) {
                if (savedStep === 2) {
                    selectSchool(selectedSchool);
                } else if (savedStep === 3 && selectedClass) {
                    document.getElementById('school-title').innerText = selectedSchool.name;
                    loadStudentsByClass();
                } else if (savedStep === 4 && selectedClass) {
                    showStep(4);
                    renderTabContent();
                    updateDuoPreview();
                } else {
                    loadSchools();
                }
            } else {
                loadSchools();
                renderTabContent();
                updateDuoPreview();
            }
        });

        function showStep(step) {
            currentStep = step;
            try { sessionStorage.setItem('lab_wizard_step', String(step)); } catch(e){}

            document.querySelectorAll('.step-view').forEach(v => v.style.display = 'none');
            document.querySelectorAll('.step-pill').forEach((p, idx) => {
                if (idx + 1 === step) p.classList.add('active');
                else p.classList.remove('active');
            });

            const backBtn = document.getElementById('btn-global-back');
            if (backBtn) {
                backBtn.style.display = 'inline-block';
                if (step === 1) {
                    backBtn.innerText = '⬅️ Voltar para o Início do Site';
                } else if (step === 5) {
                    backBtn.innerText = '⬅️ Trocar Aluno / Escolher Escola';
                } else {
                    backBtn.innerText = '⬅️ Voltar Passo Anterior';
                }
            }

            if (step === 1) document.getElementById('view-school').style.display = 'block';
            if (step === 2) document.getElementById('view-class').style.display = 'block';
            if (step === 3) document.getElementById('view-students').style.display = 'block';
            if (step === 4) document.getElementById('view-avatar-builder').style.display = 'block';
            if (step === 5) document.getElementById('view-profile').style.display = 'block';

            // Navegação de etapa limpa
        }

        function goBackStep() {
            if (currentStep === 1) {
                window.location.href = '/';
            } else if (currentStep === 5) {
                loadSchools();
                showStep(1);
            } else {
                showStep(currentStep - 1);
            }
        }


        async function loadSchools() {
            showStep(1);
            try {
                const res = await fetch('/api/schools');
                const schools = await res.json();
                allSchoolsList = schools;
                renderSchools(schools);
            } catch(e) {
                allSchoolsList = [
                    { id: 1, name: 'E.M. José Giró Faísca', city: 'Angra dos Reis' },
                    { id: 2, name: 'C.E. Cornélis Verolme', city: 'Angra dos Reis' }
                ];
                renderSchools(allSchoolsList);
            }

            // Auto-check URL query params (?turma=LK4078 or ?codigo=LK4078)
            const urlParams = new URLSearchParams(window.location.search);
            const tCode = urlParams.get('turma') || urlParams.get('codigo') || urlParams.get('code');
            if (tCode) {
                const inp = document.getElementById('class-code-input');
                if (inp) inp.value = tCode.toUpperCase();
                lookupClassCode(tCode);
            }
        }

        function renderSchools(schools) {
            const container = document.getElementById('schools-container');
            container.innerHTML = '';
            schools.forEach(s => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => selectSchool(s);
                card.innerHTML = `
                    <div class="icon-box">🏫</div>
                    <h3>${s.name}</h3>
                    <p style="color:#777; margin:0;">${s.city}</p>
                `;
                container.appendChild(card);
            });
        }

        async function selectSchool(school) {
            selectedSchool = school;
            try { sessionStorage.setItem('lab_selected_school', JSON.stringify(school)); } catch(e){}
            document.getElementById('school-title').innerText = school.name;
            showStep(2);
            document.getElementById('pin-box').style.display = 'none';

            const res = await fetch(`/api/schools/${school.id}/classes`);
            const classes = await res.json();
            const container = document.getElementById('classes-container');
            container.innerHTML = '';

            classes.forEach(c => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.onclick = () => openPinBox(c);
                card.innerHTML = `
                    <div class="icon-box">👥</div>
                    <h3>${c.name}</h3>
                    <p style="color:#777; margin:0;">${c.grade_level || 'Turma Escolar'}</p>
                `;
                container.appendChild(card);
            });
        }

        function openPinBox(cls) {
            selectedClass = cls;
            try { sessionStorage.setItem('lab_selected_class', JSON.stringify(cls)); } catch(e){}
            document.getElementById('pin-box').style.display = 'block';
            document.getElementById('pin-input').value = '';
            document.getElementById('pin-error').style.display = 'none';
            document.getElementById('pin-input').focus();
        }

        async function submitPin() {
            const pin = document.getElementById('pin-input').value;
            if (!pin) return;
            const res = await fetch('/api/classes/verify-pin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ class_id: selectedClass.id, pin })
            });
            const data = await res.json();
            if (data.success) {
                loadStudentsByClass();
            } else {
                const err = document.getElementById('pin-error');
                err.innerText = 'PIN incorreto!';
                err.style.display = 'block';
            }
        }

        async function loadStudentsByClass() {
            showStep(3);
            const res = await fetch(`/api/classes/${selectedClass.id}/students`);
            const students = await res.json();
            const container = document.getElementById('students-container');
            container.innerHTML = '';

            const currentActive = localStorage.getItem('lab_student_profile');
            let activeId = null;
            if (currentActive) {
                try { activeId = JSON.parse(currentActive).id; } catch(e){}
            }

            if (students.length === 0) {
                container.innerHTML = '<p style="color:#888; width:100%; text-align:center;">Nenhum aluno nesta turma. Crie o seu!</p>';
                return;
            }

            students.forEach(st => {
                const svg = generateAvatarSVG(st.avatar_config || {}, 90);
                const isCurrentLocal = (st.id === activeId);
                const hasPin = st.student_pin && String(st.student_pin).trim() !== '';
                const card = document.createElement('div');
                card.className = `card-item ${isCurrentLocal ? 'in-use' : ''}`;
                card.onclick = () => selectStudentCard(st);
                card.innerHTML = `
                    <div style="margin-bottom: 8px;">${svg}</div>
                    <h3>${st.name} ${isCurrentLocal ? '🟢' : ''} ${hasPin ? '🔒' : ''}</h3>
                    <p style="color: ${isCurrentLocal ? '#58cc02' : '#777'}; font-weight:800;">
                        ${isCurrentLocal ? 'Seu Perfil Conectado' : (st.points || 0) + ' Pontos'}
                    </p>
                `;
                container.appendChild(card);
            });
        }

        async function selectStudentCard(st) {
            const currentActive = localStorage.getItem('lab_student_profile');
            let activeId = null;
            if (currentActive) {
                try { activeId = JSON.parse(currentActive).id; } catch(e){}
            }
            if (st.id === activeId) {
                activateStudent(st);
                return;
            }

            const hasPin = st.student_pin && String(st.student_pin).trim() !== '';
            if (hasPin) {
                openKidPinModal(st);
            } else {
                activateStudent(st);
            }
        }


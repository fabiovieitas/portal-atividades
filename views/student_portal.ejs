                    };
                    tile.innerHTML = `
                        <div style="background:${cc.hex}; border-radius:50%; width:34px; height:34px; border:2px solid #ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.25); margin-bottom:4px;"></div>
                        <div style="font-size:0.72rem; font-weight:800; color:#475569; text-align:center;">${cc.label}</div>
                    `;
                    container.appendChild(tile);
                });

                const styleHeading = document.createElement('div');
                styleHeading.style.cssText = 'grid-column: 1 / -1; font-weight: 900; color: #1e3a8a; font-size: 1rem; margin: 16px 0 2px 0; border-top: 1px dashed #cbd5e1; padding-top: 14px;';
                styleHeading.innerHTML = '👔 Escolha o Modelo de Roupa:';
                container.appendChild(styleHeading);

                P.clothing.forEach(cl => {
                    const isSel = (avatarConfig.clothing || 'hoodie') === cl.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; padding:10px 6px; font-weight:800; border-radius:16px; min-height:85px; cursor:pointer; background:#ffffff;';
                    tile.onclick = () => {
                        ensureAvataaarsStyle();
                        avatarConfig.clothing = cl.id;
                        renderTabContent();
                        updateDuoPreview();
                    };
                    tile.innerHTML = `
                        <div style="font-size:1.8rem; margin-bottom:2px;">${cl.icon}</div>
                        <div style="font-size:0.75rem; font-weight:800; color:#334155; text-align:center;">${cl.label}</div>
                    `;
                    container.appendChild(tile);
                });

            } else if (activeTab === 'bg') {
                titleEl.innerText = 'Cor do Cenário de Fundo 🌈';
                P.bgColors.forEach(theme => {
                    const isSel = (avatarConfig.bg || '').replace('#','') === theme.hex.replace('#','');
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.onclick = () => {
                        avatarConfig.bg = theme.hex;
                        renderTabContent();
                        updateDuoPreview();
                    };
                    tile.innerHTML = `
                        <div class="duo-color-swatch" style="background:${theme.hex}; border-radius:12px; width:100%; height:55px;" title="${theme.label}"></div>
                        <div style="font-size:0.75rem; font-weight:800; text-align:center; margin-top:4px; color:#4b5563;">${theme.label}</div>
                    `;
                    container.appendChild(tile);
                });

            } else if (activeTab === 'style') {
                titleEl.innerText = 'Escolha a Coleção do Avatar 🎨';
                P.styles.forEach(s => {
                    const isSel = avatarConfig.style === s.id;
                    const tile = document.createElement('div');
                    tile.className = `duo-tile-card ${isSel ? 'selected' : ''}`;
                    tile.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; padding:12px; font-weight:800; font-size:0.9rem; text-align:center; border-radius:16px; min-height:95px; cursor:pointer; background: #ffffff;';
                    tile.onclick = () => {
                        avatarConfig.style = s.id;
                        const defaultSeeds = P.styleSeeds[s.id] || P.styleSeeds['bottts'];
                        if (defaultSeeds && defaultSeeds.length > 0) {
                            avatarConfig.seed = defaultSeeds[0].id;
                        }
                        renderTabContent();
                        updateDuoPreview();
                    };
                    const seedMap = { bottts: 'LeoRobot', adventurer: 'Ninja', 'pixel-art': 'RetroKnight', lorelei: 'Sofia', 'big-smile': 'SuperSmile', 'fun-emoji': 'DinoRex', avataaars: 'CapitaoLucas' };
                    const sampleUrl = buildDiceBearUrl({ style: s.id, seed: seedMap[s.id] || 'LeoRobot', bg: '38bdf8' });
                    tile.innerHTML = `
                        <img src="${sampleUrl}" width="55" height="55" style="border-radius:10px; margin-bottom:6px;" alt="${s.label}" />

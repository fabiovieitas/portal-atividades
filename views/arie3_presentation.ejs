        .hero-banner { background: rgba(30, 41, 59, 0.9); border: 2px solid rgba(168, 85, 247, 0.3); border-radius: 28px; padding: 35px; text-align: center; margin-bottom: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }

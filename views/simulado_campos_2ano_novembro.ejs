      const urlParams = new URLSearchParams(window.location.search);
      const shiftParam = urlParams.get('shift');
      if (shiftParam) {
        const shiftEl = document.getElementById('shiftName');
        if (shiftEl) {
          if (shiftParam.toLowerCase().includes('tarde')) shiftEl.value = 'Tarde';
          else if (shiftParam.toLowerCase().includes('manha') || shiftParam.toLowerCase().includes('manhã')) shiftEl.value = 'Manhã';
          else if (shiftParam.toLowerCase().includes('integral')) shiftEl.value = 'Integral';
        }
      }
      initCRGrid();
      restoreDraft();
    });

    function initCRGrid() {
      const grid = document.getElementById('cartaoGrid');
      grid.innerHTML = '';
      questionKeys.forEach(k => {
        const row = document.createElement('div');
        row.className = 'cr-row';
        row.id = `cr-row-${k}`;
        if (k === 4) {
          row.innerHTML = `
            <span class="cr-q-num">Questão 04 (Ditado):</span>
            <span id="cr-status-q4" style="font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 50px; background: #f1f5f9; color: #64748b;">
              Aguardando Ditado
            </span>
          `;
        } else {
          const qNumFormatted = k < 10 ? '0' + k : k;
          row.innerHTML = `
            <span class="cr-q-num">Questão ${qNumFormatted}:</span>
            <div class="cr-bubbles">
              <div class="cr-bubble" id="cr-bubble-${k}-A" onclick="selectOption(${k}, 'A')">A</div>
              <div class="cr-bubble" id="cr-bubble-${k}-B" onclick="selectOption(${k}, 'B')">B</div>
              <div class="cr-bubble" id="cr-bubble-${k}-C" onclick="selectOption(${k}, 'C')">C</div>
              <div class="cr-bubble" id="cr-bubble-${k}-D" onclick="selectOption(${k}, 'D')">D</div>
            </div>
          `;
        }
        grid.appendChild(row);
      });
    }

    function selectOption(qNum, letter) {
      if (qNum === 4) return;
      studentAnswers[qNum] = letter;

      ['A', 'B', 'C', 'D'].forEach(l => {
        const optEl = document.getElementById(`opt-${qNum}-${l}`);
        if (optEl && optEl.parentElement) {
          if (l === letter) optEl.parentElement.classList.add('selected');
          else optEl.parentElement.classList.remove('selected');
        }
      });

      ['A', 'B', 'C', 'D'].forEach(l => {
        const b = document.getElementById(`cr-bubble-${qNum}-${l}`);
        if (b) {
          if (l === letter) b.classList.add('selected');
          else b.classList.remove('selected');
        }
      });

      updateProgress();
      saveDraft();
    }

    function syncDitado2Ano(shouldSave = true) {
      const d1 = document.getElementById('ditado1')?.value.trim() || '';
      const d2 = document.getElementById('ditado2')?.value.trim() || '';
      const d3 = document.getElementById('ditado3')?.value.trim() || '';
      const badge = document.getElementById('cr-status-q4');

      if (d1 || d2 || d3) {
        studentAnswers[4] = `1: ${d1} | 2: ${d2} | 3: ${d3}`;
        if (badge) {
          badge.innerText = '✓ Ditado Preenchido';
          badge.style.background = '#dcfce7';
          badge.style.color = '#15803d';
        }
      } else {
        delete studentAnswers[4];
        if (badge) {
          badge.innerText = 'Aguardando Ditado';
          badge.style.background = '#f1f5f9';
          badge.style.color = '#64748b';
        }
      }
      updateProgress();
      if (shouldSave) saveDraft();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const progressPercent = Math.round((totalAnswered / 11) * 100);
      const fill = document.getElementById('progressFill');
      const text = document.getElementById('progressText');
      const crInd = document.getElementById('crProgressIndicator');

      if (fill) fill.style.width = `${progressPercent}%`;
      if (text) text.innerText = `${totalAnswered} de 11 respondidas`;
      if (crInd) crInd.innerText = `${totalAnswered} de 11 preenchidas`;
    }

    function saveDraft() {
      if (isSubmitting) return;
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        className: document.getElementById('className')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        ditado1: document.getElementById('ditado1')?.value || '',
        ditado2: document.getElementById('ditado2')?.value || '',
        ditado3: document.getElementById('ditado3')?.value || '',
        answers: studentAnswers
      };
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); } catch(e){}
    }

    function restoreDraft() {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft.studentName && !document.getElementById('studentName').value) document.getElementById('studentName').value = draft.studentName;
        if (draft.className) document.getElementById('className').value = draft.className;
        if (draft.shiftName && !new URLSearchParams(window.location.search).get('shift')) document.getElementById('shiftName').value = draft.shiftName;

        if (draft.ditado1) document.getElementById('ditado1').value = draft.ditado1;
        if (draft.ditado2) document.getElementById('ditado2').value = draft.ditado2;
        if (draft.ditado3) document.getElementById('ditado3').value = draft.ditado3;
        syncDitado2Ano(false);

        if (draft.answers) {
          for (let q in draft.answers) {
            if (q == '4') continue;
            selectOption(parseInt(q), draft.answers[q]);
          }
        }
      } catch(e){}
    }

    function speakText() {}

    function speakSingleSentence(sentence) {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(sentence);
      utterance.lang = 'pt-BR';
      utterance.rate = 0.88;
      window.speechSynthesis.speak(utterance);
    }

    function speakDitado2AnoCompleto() {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const text = "Atenção ao ditado da professora Sara. Primeira frase: Respeitar é muito importante. Segunda frase: Toda pessoa tem direito ao respeito. Terceira frase: Todas as pessoas devem ser respeitadas sem preconceito.";
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'pt-BR';
      utterance.rate = 0.88;
      window.speechSynthesis.speak(utterance);
    }

    async function submitExamWithVault() {
      if (isSubmitting) return;

      const studentName = document.getElementById('studentName').value.trim();
      if (!studentName) {
        alert('⚠️ Por favor, informe seu Nome Completo antes de finalizar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      questionKeys.forEach(k => {
        if (!studentAnswers[k]) {
          if (k === 4) missing.push('Questão 04 (Ditado de Frases)');
          else missing.push(`Questão ${k < 10 ? '0' + k : k}`);
        }
      });

      if (missing.length > 0) {
        const confirmSend = confirm(`⚠️ Atenção: você ainda não respondeu:

${missing.join('\n')}

Deseja enviar a avaliação mesmo assim?`);
        if (!confirmSend) return;
      }

      let score = 0;
      for (let k in answerKey) {
        if (studentAnswers[k] === answerKey[k]) score++;
      }

      const ditadoText = studentAnswers[4] || '';

      const payload = {
        simulado_id: SIMULADO_ID,
        student_name: studentName,
        school_name: document.getElementById('schoolName').value.trim() || 'E.M. José Giró Faísca',
        class_name: document.getElementById('className').value || '2º Ano B',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 10,
        essay_text: ditadoText
      };

      const btn = document.querySelector('.btn-submit-exam');
      btn.innerHTML = '<span>⏳</span> <span>GRAVANDO NA NUVEM...</span>';
      btn.style.opacity = '0.7';
      isSubmitting = true;

      let result = { success: true };
      if (window.SimuladoVault) {
        result = await window.SimuladoVault.submit(payload);
      } else {
        try {
          const res = await fetch('/api/simulado/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          result.success = res.ok;
        } catch(e) {
          result.success = false;
        }
      }

      isSubmitting = false;
      btn.innerHTML = '<span>🚀</span> <span>FINALIZAR E ENVIAR</span>';
      btn.style.opacity = '1';

      if (result.success) {
        try { localStorage.removeItem(DRAFT_KEY); } catch(e){}
        const modalScoreEl = document.getElementById('modalScore');
        if (modalScoreEl) modalScoreEl.innerText = score;
        document.getElementById('resultModal').classList.add('active');
        if (typeof confetti === 'function') confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
      } else {
        alert('⚠️ ATENÇÃO: Falha temporária na internet da escola! Suas respostas foram salvas com total segurança na memória deste aparelho.');
      }
    }
  </script>
</body>
</html>

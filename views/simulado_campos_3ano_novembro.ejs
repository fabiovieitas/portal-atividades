  <!-- Modal de Resultados -->
  <div class="modal-overlay" id="resultModal">
    <div class="modal-card">
      <div style="font-size: 3rem;">🎉</div>
      <h2 style="font-family: 'Fredoka', sans-serif; font-size: 1.8rem; color: var(--primary-dark); margin-top: 0.5rem;">
        Parabéns pelo Esforço!
      </h2>
      <p style="font-size: 1.05rem; color: #475569; margin-top: 0.5rem;">
        Suas respostas foram salvas e enviadas com sucesso para a rede municipal!
      </p>

      <div class="score-circle">
        <div class="score-num" id="modalScore">0</div>
        <div class="score-max">de 15 acertos</div>
      </div>

      <div id="modalDetails" style="text-align: left; background: #f8fafc; padding: 1rem; border-radius: 12px; font-size: 0.95rem; margin-bottom: 1.5rem;">
      </div>

      <button type="button" class="btn-submit" style="padding: 0.8rem 2rem; font-size: 1.1rem;" onclick="window.location.href='/'">
        Voltar ao Portal LabKids
      </button>
    </div>
  </div>

  <script>
    // Gabarito Oficial 3º Ano Novembro/2026
    const correctAnswers = {
      1: 'B',
      2: 'A',
      3: 'A',
      4: 'B',
      5: 'PESSOAL', // Q5 Produção cartaz/frase
      6: 'C',
      7: 'A',
      8: 'C',
      9: 'C',
      10: 'C',
      11: 'C',
      12: 'B',
      13: 'C',
      14: 'B',
      15: 'B'
    };

    const userAnswers = {};

    // Auto-detect turno via URL ?shift=manha ou ?shift=tarde
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const shiftParam = urlParams.get('shift');
      if (shiftParam) {
        const shiftEl = document.getElementById('shiftName');
        if (shiftEl) {
          if (shiftParam.toLowerCase().includes('tarde')) shiftEl.value = 'Tarde';
          else if (shiftParam.toLowerCase().includes('manha') || shiftParam.toLowerCase().includes('manhã')) shiftEl.value = 'Manhã';
          else if (shiftParam.toLowerCase().includes('integral')) shiftEl.value = 'Integral';
        }
      }

      // Restore local draft if exists
      const savedDraft = localStorage.getItem('simulado_3ano_novembro_draft');
      if (savedDraft) {
        try {
          const draft = JSON.parse(savedDraft);
          if (draft.studentName) document.getElementById('studentName').value = draft.studentName;
          if (draft.className) document.getElementById('className').value = draft.className;
          if (draft.shiftName && !shiftParam) document.getElementById('shiftName').value = draft.shiftName;
          if (draft.answers) {
            for (const [q, val] of Object.entries(draft.answers)) {
              if (q == '5') {
                document.getElementById('q5-frase').value = val;
                userAnswers[5] = val;
              } else {
                selectOption(parseInt(q), val, false);
              }
            }
          }
        } catch(e) {}
      }

      initCanvas();
    });

    function saveDraft() {
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        className: document.getElementById('className')?.value || '',
        answers: userAnswers
      };
      localStorage.setItem('simulado_3ano_novembro_draft', JSON.stringify(draft));
    }

    function selectOption(qNum, letter, save = true) {
      userAnswers[qNum] = letter;
      const letters = ['A', 'B', 'C', 'D'];
      letters.forEach(l => {
        const el = document.getElementById(`opt-${qNum}-${l}`);
        if (el && el.parentElement) {
          if (l === letter) {
            el.parentElement.classList.add('selected');
          } else {
            el.parentElement.classList.remove('selected');
          }
        }
      });
      if (save) saveDraft();
    }

    function syncQ5Response() {
      const val = document.getElementById('q5-frase').value.trim();
      userAnswers[5] = val || 'PRODUÇÃO REALIZADA';
      saveDraft();
    }

    // TTS Web Speech API
    function speakText(elementId) {
      if (!('speechSynthesis' in window)) {
        alert('Seu navegador não suporta leitura em voz alta.');
        return;
      }
      window.speechSynthesis.cancel();
      const el = document.getElementById(elementId);
      if (!el) return;
      const text = el.innerText;
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'pt-BR';
      utterance.rate = 0.95;
      window.speechSynthesis.speak(utterance);
    }

    // Canvas de Desenho da Q5
    let canvas, ctx, isDrawing = false, currentColor = '#0f172a';

    function initCanvas() {
      canvas = document.getElementById('drawingCanvas');
      if (!canvas) return;
      ctx = canvas.getContext('2d');
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.strokeStyle = currentColor;

      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return {
          x: (clientX - rect.left) * (canvas.width / rect.width),
          y: (clientY - rect.top) * (canvas.height / rect.height)
        };
      }

      canvas.addEventListener('mousedown', (e) => {
        isDrawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
      });
      canvas.addEventListener('mousemove', (e) => {
        if (!isDrawing) return;
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
      });
      window.addEventListener('mouseup', () => { isDrawing = false; });

      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        isDrawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
      }, { passive: false });
      canvas.addEventListener('touchmove', (e) => {
        if (!isDrawing) return;
        e.preventDefault();
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
      }, { passive: false });
      window.addEventListener('touchend', () => { isDrawing = false; });
    }

    function setDrawingColor(color, btn) {
      currentColor = color;
      if (ctx) ctx.strokeStyle = color;
      document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    function clearCanvas() {
      if (ctx && canvas) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    async function submitSimulado() {
      const studentName = document.getElementById('studentName').value.trim();
      const schoolName = document.getElementById('schoolName').value.trim();
      const shift = document.getElementById('shiftName').value || 'Manhã';
      const className = document.getElementById('className').value.trim() || '3º Ano';

      if (!studentName) {
        alert('Por favor, preencha o Nome do Aluno(a) antes de finalizar!');
        document.getElementById('studentName').focus();
        return;
      }

      // Verifica preenchimento
      const missing = [];
      for (let i = 1; i <= 15; i++) {
        if (!userAnswers[i]) missing.push(i);
      }
      if (missing.length > 0) {
        const confirmSend = confirm(`Você ainda não respondeu as seguintes questões: ${missing.join(', ')}.\n\nDeseja enviar mesmo assim?`);
        if (!confirmSend) return;
      }

      // Calcula pontuação (Q5 conta como pontuada se a frase ou desenho tiver sido produzido)
      let score = 0;
      for (let i = 1; i <= 15; i++) {
        if (i === 5) {
          if (userAnswers[5] && userAnswers[5].trim().length > 0) score++;
        } else {
          if (userAnswers[i] && userAnswers[i].toUpperCase() === correctAnswers[i]) {
            score++;
          }
        }
      }

      const payload = {
        studentName,
        schoolName,
        shift,
        className,
        grade: '3º Ano',
        simuladoId: 'simulado-campos-3ano-novembro-2026',
        simuladoTitle: 'Simulado Oficial 3º Ano — Novembro/2026',
        answers: userAnswers,
        score,
        totalQuestions: 15,
        submittedAt: new Date().toISOString()
      };

      try {
        const res = await fetch('/api/simulados/respostas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        console.log('Submission result:', result);
      } catch (err) {
        console.warn('Fallback offline save:', err);
      }

      // Limpa rascunho local
      localStorage.removeItem('simulado_3ano_novembro_draft');

      // Exibe Modal
      document.getElementById('modalScore').innerText = score;
      document.getElementById('modalDetails').innerHTML = `
        <strong>Aluno(a):</strong> ${studentName}<br>
        <strong>Escola:</strong> ${schoolName}<br>
        <strong>Turno:</strong> ${shift} • <strong>Turma:</strong> ${className}<br>
        <strong>Aproveitamento:</strong> ${Math.round((score / 15) * 100)}%
      `;
      document.getElementById('resultModal').classList.add('active');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 150,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
    }
  </script>

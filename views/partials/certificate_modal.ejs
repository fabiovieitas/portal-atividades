<!-- ============================================================================
     CERTIFICADO OFICIAL DE HONRA AO MÉRITO (COM CARIMBO & DOWNLOAD/PDF)
     ============================================================================ -->
<div id="certificate-modal" style="display: none; position: fixed; inset: 0; z-index: 9999999; background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(10px); align-items: center; justify-content: center; padding: 15px; font-family: 'Fredoka', 'Outfit', sans-serif;">
  <div style="background: #ffffff; border-radius: 24px; max-width: 820px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 25px; box-shadow: 0 25px 60px rgba(0,0,0,0.6); position: relative;">
    
    <!-- Botões de Ação Topo -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
      <div style="font-weight: 800; color: #1e3a8a; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;">
        <span>📜</span> Certificado de Conquista Oficial
      </div>
      <div style="display: flex; gap: 10px;">
        <button onclick="printCertificate()" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; border: none; padding: 10px 20px; border-radius: 50px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(37,99,235,0.3);">
          🖨️ Imprimir / Salvar em PDF
        </button>
        <button onclick="closeCertificateModal()" style="background: #f1f5f9; color: #475569; border: none; padding: 10px 18px; border-radius: 50px; font-weight: 800; cursor: pointer;">
          ✕ Fechar
        </button>
      </div>
    </div>

    <!-- ÁREA IMPRIMÍVEL DO DIPLOMA (A4 LANDSCAPE STYLE) -->
    <div id="certificate-print-area" style="background: #fffdf5; border: 10px double #d97706; border-radius: 18px; padding: 35px 30px; text-align: center; color: #1e293b; position: relative; box-shadow: inset 0 0 40px rgba(245, 158, 11, 0.08);">
      
      <!-- Brasão / Cabeçalho -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 15px; margin-bottom: 12px;">
        <span style="font-size: 2.8rem;">🎓</span>
        <div>
          <div style="font-size: 1.1rem; font-weight: 900; letter-spacing: 2px; color: #b45309; text-transform: uppercase;">Portal Educacional Lab Kids</div>
          <div style="font-size: 0.82rem; color: #78350f; font-weight: 700;">Inovação, Cultura Digital e Práticas Pedagógicas Formativas</div>
        </div>
        <span style="font-size: 2.8rem;">⭐</span>
      </div>

      <!-- Título Principal -->
      <h1 style="font-family: 'Outfit', serif; font-size: 2rem; font-weight: 900; color: #1e3a8a; margin: 15px 0 8px 0; text-transform: uppercase; letter-spacing: 1px;">
        Certificado de Honra ao Mérito
      </h1>

      <p style="font-size: 1.05rem; color: #64748b; margin: 0 0 20px 0; font-weight: 600;">
        Reconhecimento oficial por dedicação, foco e excelente desempenho pedagógico
      </p>

      <!-- Corpo do Certificado -->
      <div style="max-width: 660px; margin: 0 auto; line-height: 1.8; font-size: 1.15rem; color: #1e293b;">
        Certificamos que o(a) brilhante estudante
        <div id="cert-student-name" style="font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 900; color: #b45309; border-bottom: 2.5px solid #d97706; display: inline-block; padding: 2px 25px; margin: 10px 0;">
          Nome do Estudante
        </div>
        <br>
        participou ativamente da turma <strong id="cert-class-name">4º Ano</strong> da escola 
        <strong id="cert-school-name">E.M. Profª Eleonora da Silva Pinto</strong>, concluindo com êxito os desafios pedagógicos e simulados diagnósticos com foco nas habilidades essenciais da <strong>BNCC</strong>.
      </div>

      <!-- Carimbo & Assinaturas -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 35px; padding-top: 20px; border-top: 1.5px dashed #cbd5e1; flex-wrap: wrap; gap: 20px;">
        
        <!-- Carimbo Oficial -->
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 70px; height: 70px; border-radius: 50%; border: 3px solid #d97706; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #d97706; font-size: 0.62rem; font-weight: 900; transform: rotate(-10deg); box-shadow: 0 0 10px rgba(217, 119, 6, 0.2);">
            <span style="font-size: 1rem;">🛡️</span>
            <span>OFICIAL</span>
            <span>LAB KIDS</span>
          </div>
          <div style="text-align: left; font-size: 0.8rem; color: #64748b; font-weight: 700;">
            <div id="cert-issue-date">Emitido em 03/11/2026</div>
            <div>Campos dos Goytacazes - RJ</div>
          </div>
        </div>

        <!-- Assinatura Coordenação -->
        <div style="text-align: center; min-width: 200px;">
          <div style="font-family: 'Brush Script MT', cursive, sans-serif; font-size: 1.6rem; color: #1e3a8a; line-height: 1;">
            Fábio Vieitas Marques
          </div>
          <div style="border-top: 1.5px solid #64748b; width: 100%; margin: 4px auto;"></div>
          <div style="font-size: 0.82rem; font-weight: 800; color: #334155;">Prof. Fábio Vieitas Marques</div>
          <div style="font-size: 0.72rem; color: #64748b;">Coordenador Pedagógico • Lab Kids</div>
        </div>

      </div>

    </div>

  </div>
</div>

<style>
@media print {
  body * {
    visibility: hidden;
  }
  #certificate-print-area, #certificate-print-area * {
    visibility: visible;
  }
  #certificate-print-area {
    position: fixed;
    left: 0;
    top: 0;
    width: 100vw;
    height: 95vh;
    border: 12px double #d97706 !important;
    padding: 40px !important;
    background: #ffffff !important;
    box-sizing: border-box;
  }
}
</style>

<script>
function openCertificateModal(studentName, className, schoolName) {
  const modal = document.getElementById('certificate-modal');
  if (!modal) return;

  const nameEl = document.getElementById('cert-student-name');
  const classEl = document.getElementById('cert-class-name');
  const schoolEl = document.getElementById('cert-school-name');
  const dateEl = document.getElementById('cert-issue-date');

  if (nameEl) nameEl.innerText = studentName || 'Estudante Dedicado';
  if (classEl) classEl.innerText = className || 'Ensino Fundamental';
  if (schoolEl) schoolEl.innerText = schoolName || 'Rede de Ensino';
  if (dateEl) {
    const now = new Date();
    dateEl.innerText = 'Emitido em ' + now.toLocaleDateString('pt-BR');
  }

  modal.style.display = 'flex';
}

function closeCertificateModal() {
  const modal = document.getElementById('certificate-modal');
  if (modal) modal.style.display = 'none';
}

function printCertificate() {
  window.print();
}
</script>

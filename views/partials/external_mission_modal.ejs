<!-- ============================================================================
     SISTEMA DE MISSÃO & CHECK-IN PEDAGÓGICO PARA JOGOS NÃO AUTORAIS (EXTERNOS)
     ============================================================================ -->
<div id="external-mission-widget" style="display: none; position: fixed; bottom: 25px; right: 25px; z-index: 99999; max-width: 380px; width: calc(100vw - 50px); background: linear-gradient(135deg, #1e293b, #0f172a); border: 2.5px solid #fbbf24; border-radius: 22px; padding: 18px 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.6); color: #ffffff; font-family: 'Fredoka', system-ui, sans-serif; animation: labMissionSlideUp 0.3s ease-out;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
    <span style="font-size: 0.75rem; background: rgba(251, 191, 36, 0.2); border: 1px solid #fbbf24; color: #fbbf24; padding: 2px 10px; border-radius: 50px; font-weight: 800; text-transform: uppercase;">
      🎮 Missão em Andamento
    </span>
    <span id="mission-timer-display" style="font-size: 0.95rem; font-weight: 800; color: #38bdf8;">00:00</span>
  </div>

  <div style="font-size: 1.05rem; font-weight: 800; color: #f8fafc; margin-bottom: 4px;" id="mission-activity-title">
    <%= activity.title %>
  </div>
  <p style="font-size: 0.85rem; color: #94a3b8; margin: 0 0 12px 0;" id="mission-instruction">
    Pratique o jogo na outra aba por pelo menos 1m30s para liberar seus pontos e seu carimbo na Mochila!
  </p>

  <!-- Progress bar -->
  <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 50px; overflow: hidden; margin-bottom: 14px;">
    <div id="mission-progress-bar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #3b82f6, #10b981); transition: width 1s linear;"></div>
  </div>

  <!-- Action Button -->
  <button id="btn-claim-mission" disabled onclick="claimMissionReward()" style="width: 100%; padding: 12px; border-radius: 14px; font-weight: 900; font-size: 0.95rem; border: none; background: #334155; color: #94a3b8; cursor: not-allowed; transition: all 0.2s; text-transform: uppercase; letter-spacing: 0.5px;">
    ⏳ Jogue mais um pouco...
  </button>
</div>

<style>
@keyframes labMissionSlideUp {
  from { transform: translateY(50px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
</style>

<script>
(function() {
  let missionStartTime = null;
  let missionTimerInterval = null;
  const REQUIRED_SECONDS = 60; // 60 segundos de prática mínima para crianças
  const activityData = {
    id: <%= activity.id %>,
    title: <%- JSON.stringify(activity.title) %>,
    subject: <%- JSON.stringify(activity.subject || 'Geral') %>
  };

  window.startExternalMission = function() {
    missionStartTime = Date.now();
    sessionStorage.setItem('lab_active_mission_' + activityData.id, missionStartTime);
    const widget = document.getElementById('external-mission-widget');
    if (widget) widget.style.display = 'block';

    if (missionTimerInterval) clearInterval(missionTimerInterval);
    missionTimerInterval = setInterval(updateMissionStatus, 1000);
  };

  function updateMissionStatus() {
    if (!missionStartTime) return;
    const elapsed = Math.floor((Date.now() - missionStartTime) / 1000);
    const mins = Math.floor(elapsed / 60);
    const secs = elapsed % 60;
    const timerEl = document.getElementById('mission-timer-display');
    const barEl = document.getElementById('mission-progress-bar');
    const btn = document.getElementById('btn-claim-mission');
    const instr = document.getElementById('mission-instruction');

    if (timerEl) timerEl.innerText = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    
    const pct = Math.min(100, Math.round((elapsed / REQUIRED_SECONDS) * 100));
    if (barEl) barEl.style.width = pct + '%';

    if (elapsed >= REQUIRED_SECONDS && btn && btn.disabled) {
      btn.disabled = false;
      btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
      btn.style.color = '#ffffff';
      btn.style.cursor = 'pointer';
      btn.style.boxShadow = '0 6px 20px rgba(16, 185, 129, 0.4)';
      btn.innerHTML = '🏆 RESGATAR +25 XP & CARIMBO ⭐';
      if (instr) instr.innerHTML = '✨ <strong style="color:#4ade80;">Missão Concluída!</strong> Toque abaixo para receber seus pontos!';
    }
  }

  window.claimMissionReward = function() {
    const btn = document.getElementById('btn-claim-mission');
    if (btn) btn.disabled = true;

    if (window.LabKidsGamification) {
      window.LabKidsGamification.recordCompletion({
        activityId: activityData.id,
        title: activityData.title,
        subject: activityData.subject,
        score: 25
      });
    }

    const widget = document.getElementById('external-mission-widget');
    if (widget) {
      widget.innerHTML = `
        <div style="text-align: center; padding: 10px 0;">
          <div style="font-size: 2.5rem; margin-bottom: 6px;">🎉</div>
          <div style="font-size: 1.15rem; font-weight: 900; color: #fbbf24;">Parabéns!</div>
          <p style="font-size: 0.88rem; color: #cbd5e1; margin: 4px 0 12px 0;">Você ganhou <strong>+25 XP</strong> e seu carimbo de <strong>${activityData.subject}</strong> foi adicionado à sua Mochila!</p>
          <button onclick="this.closest('#external-mission-widget').remove()" style="background: #334155; color: #ffffff; border: none; padding: 8px 18px; border-radius: 50px; font-weight: 800; cursor: pointer;">
            Fechar
          </button>
        </div>
      `;
      setTimeout(() => { if (widget) widget.remove(); }, 6000);
    }
    clearInterval(missionTimerInterval);
    sessionStorage.removeItem('lab_active_mission_' + activityData.id);
  };

  // Se já havia uma missão iniciada ao recarregar
  const saved = sessionStorage.getItem('lab_active_mission_' + activityData.id);
  if (saved) {
    missionStartTime = parseInt(saved, 10);
    const widget = document.getElementById('external-mission-widget');
    if (widget) widget.style.display = 'block';
    missionTimerInterval = setInterval(updateMissionStatus, 1000);
  }
})();
</script>


<%
  const pos = typeof position !== 'undefined' ? position : 'bottom';
  // Mantemos o anúncio no rodapé com rotulagem oficial e lazy loading por IntersectionObserver
  if (pos === 'bottom') {
%>
<div class="adsense-banner-container adsense-pos-<%= pos %>" style="max-width: 960px; width: 100%; margin: 30px auto 20px auto; text-align: center;">
    <div class="adsense-card-wrapper" style="padding: 10px; border-radius: 16px; background: rgba(15, 23, 42, 0.35);">
        <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
            <span>📢 Publicidade Educativa • Apoie o Projeto</span>
        </div>
        <div class="adsense-slot-wrapper" style="overflow: hidden; border-radius: 10px; min-height: 90px;">
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="<%= adsensePubId %>"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
            (function() {
                if ('IntersectionObserver' in window) {
                    var obs = new IntersectionObserver(function(entries) {
                        entries.forEach(function(entry) {
                            if (entry.isIntersecting) {
                                try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e){}
                                obs.unobserve(entry.target);
                            }
                        });
                    }, { rootMargin: '250px 0px' });
                    var el = document.currentScript.previousElementSibling;
                    if (el) obs.observe(el);
                } else {
                    try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e){}
                }
            })();
            </script>
        </div>
    </div>
</div>
<% } %>

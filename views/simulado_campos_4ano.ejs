    const answerKey = { 1:'B', 2:'D', 4:'B', 5:'B', 6:'B', 7:'B', 8:'A', 9:'C', 10:'A' };
    const studentAnswers = {};

    function playPopSound() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
      } catch(e){}
    }

    function scrollToQuestion(qNum) {
      const el = document.getElementById(`q-card-${qNum}`);
      if(el) el.scrollIntoView({ behavior: 'smooth' });
    }

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if(radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt) {
      studentAnswers[qNum] = opt;
      playPopSound();

      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if(dot) dot.classList.remove('selected');
      });

      const selectedDot = document.getElementById(`b-${qNum}-${opt}`);
      if(selectedDot) selectedDot.classList.add('selected');

      updateProgress();
    }

    function updateEssayCartao() {
      const essay = document.getElementById('q3Essay').value.trim();
      const badge = document.getElementById('essayStatusBadge');
      if (essay.length >= 15) {
        studentAnswers[3] = essay;
        badge.innerText = '✓ Texto Concluído';
        badge.style.background = '#10b981';
        badge.style.color = 'white';
      } else {
        delete studentAnswers[3];
        badge.innerText = 'Aguardando Redação';
        badge.style.background = '#f1f5f9';
        badge.style.color = '#94a3b8';
      }
      updateProgress();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const pct = (totalAnswered / 10) * 100;
      document.getElementById('progressFill').style.width = `${pct}%`;
      document.getElementById('progressText').innerText = `${totalAnswered} de 10 respondidas`;
    }

    async function submitSimulado() {
      const nameInput = document.getElementById('studentName').value.trim();
      if (!nameInput) {
        alert('Por favor, informe seu Nome Completo na caixa de identificação antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const totalAnswered = Object.keys(studentAnswers).length;
      if (totalAnswered < 10) {
        if (!confirm(`Você respondeu ${totalAnswered} de 10 questões. Deseja realmente finalizar e enviar o simulado assim mesmo?`)) {
          return;
        }
      }

      let score = 0;
      for (let i = 1; i <= 10; i++) {
        if (i === 3) continue;
        const studentOpt = studentAnswers[i] || '—';
        const correctOpt = answerKey[i];
        if (studentOpt === correctOpt) score++;
      }

      const payload = {
        simulado_id: 'campos-4ano-agosto-2026',
        student_name: nameInput,
        school_name: document.getElementById('schoolName').value.trim() || 'E.M. Profª Eleonora da Silva Pinto',
        class_name: document.getElementById('className').value || '4º Ano A',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 9,
        essay_text: document.getElementById('q3Essay').value.trim()
      };

      try {
        const res = await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        console.log('[Simulado Submit Response]:', data);
      } catch(err) {
        console.warn('Erro ao salvar no servidor:', err);
      }

      const essayText = document.getElementById('q3Essay').value.trim();
      document.getElementById('essayDeliveryStatus').innerText = essayText ? 'Redação (Questão 03) entregue com sucesso' : 'Redação não preenchida';

      document.getElementById('resultModal').classList.add('active');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }
  </script>
</body>
</html>

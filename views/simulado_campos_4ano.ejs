    <!-- Right Column: Cartão Resposta (Sticky Panel) -->
    <aside class="sidebar">
      <div class="cartao-resposta-card">
        <div class="cartao-header">
          <h3>📋 Cartão Resposta</h3>
          <p>Sincronizado em tempo real</p>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" id="progressFill"></div>
          </div>
          <span id="progressText" style="font-size: 0.8rem; font-weight: 800; color: var(--primary);">0 de 10 respondidas</span>
        </div>

        <div class="bubble-grid">
          <!-- Rows 1 to 10 -->
          <% for(let i = 1; i <= 10; i++) { %>
            <div class="bubble-row">
              <span class="bubble-row-q" onclick="scrollToQuestion(<%= i %>)">Q<%= i < 10 ? '0' + i : i %></span>
              <% if (i === 3) { %>
                <span id="essayStatusBadge" style="font-size: 0.75rem; font-weight: 800; color: #94a3b8; background: #f1f5f9; padding: 0.2rem 0.6rem; border-radius: 50px;">Aguardando Redação</span>
              <% } else { %>
                <div class="bubbles-options">
                  <div class="bubble-dot" id="b-<%= i %>-A" onclick="selectFromBubble(<%= i %>, 'A')">A</div>
                  <div class="bubble-dot" id="b-<%= i %>-B" onclick="selectFromBubble(<%= i %>, 'B')">B</div>
                  <div class="bubble-dot" id="b-<%= i %>-C" onclick="selectFromBubble(<%= i %>, 'C')">C</div>
                  <div class="bubble-dot" id="b-<%= i %>-D" onclick="selectFromBubble(<%= i %>, 'D')">D</div>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <button class="submit-btn" onclick="submitSimulado()">
          <span>🚀 FINALIZAR E ENVIAR</span>
        </button>
      </div>
    </aside>

  </main>

  <!-- Result Modal -->
  <div class="result-modal" id="resultModal">
    <div class="result-content">
      <div class="score-circle">
        <span class="score-num" id="scoreValue">0</span>
        <span class="score-total">de 9 Objetivas</span>
      </div>
      <h2 style="font-family: 'Outfit', sans-serif; font-size: 1.6rem; color: #0f172a; margin-bottom: 0.5rem;" id="resultTitle">Simulado Concluído com Sucesso!</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;" id="resultSubtitle">Suas respostas e a redação foram salvas no servidor!</p>

      <div class="gabarito-list" id="gabaritoList">
        <!-- Filled dynamically -->
      </div>

      <button class="modal-btn" onclick="window.location.href='/'">Voltar ao Início</button>
    </div>
  </div>

  <!-- Audio Pop Synth -->
  <script>
    const answerKey = {
      1: 'B',
      2: 'D',
      4: 'B',
      5: 'B',
      6: 'B',
      7: 'B',
      8: 'A',
      9: 'C',
      10: 'A'
    };

    const studentAnswers = {};

    function playPopSound() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.08); // A5
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
      } catch(e){}
    }

    function scrollToQuestion(qNum) {
      const el = document.getElementById(`q-card-${qNum}`);
      if(el) el.scrollIntoView({ behavior: 'smooth' });
    }

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if(radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt) {
      studentAnswers[qNum] = opt;
      playPopSound();

      // Clear previous dots in row
      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if(dot) dot.classList.remove('selected');
      });

      // Highlight selected dot
      const selectedDot = document.getElementById(`b-${qNum}-${opt}`);
      if(selectedDot) selectedDot.classList.add('selected');

      updateProgress();
    }

    function updateEssayCartao() {
      const essay = document.getElementById('q3Essay').value.trim();
      const badge = document.getElementById('essayStatusBadge');
      if (essay.length >= 15) {
        studentAnswers[3] = essay;
        badge.innerText = '✓ Texto Concluído';
        badge.style.background = '#10b981';
        badge.style.color = 'white';
      } else {
        delete studentAnswers[3];
        badge.innerText = 'Aguardando Redação';
        badge.style.background = '#f1f5f9';
        badge.style.color = '#94a3b8';
      }
      updateProgress();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const pct = (totalAnswered / 10) * 100;
      document.getElementById('progressFill').style.width = `${pct}%`;
      document.getElementById('progressText').innerText = `${totalAnswered} de 10 respondidas`;
    }

    async function submitSimulado() {
      const nameInput = document.getElementById('studentName').value.trim();
      if (!nameInput) {
        alert('Por favor, informe seu Nome Completo na caixa de identificação antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const totalAnswered = Object.keys(studentAnswers).length;
      if (totalAnswered < 10) {
        if (!confirm(`Você respondeu ${totalAnswered} de 10 questões. Deseja realmente finalizar e enviar o simulado assim mesmo?`)) {
          return;
        }
      }

      // Calculate score for objective questions
      let score = 0;
      const gabaritoDetails = [];

      for (let i = 1; i <= 10; i++) {
        if (i === 3) continue; // Essay graded separately by teacher
        const studentOpt = studentAnswers[i] || '—';
        const correctOpt = answerKey[i];
        const isCorrect = (studentOpt === correctOpt);
        if (isCorrect) score++;

        gabaritoDetails.push({
          question: i,
          studentOpt,
          correctOpt,
          isCorrect
        });
      }

      const payload = {
        simulado_id: 'campos-4ano-agosto-2026',
        student_name: nameInput,
        school_name: document.getElementById('schoolName').value.trim() || 'E.M. Campos de Todos Nós',
        class_name: document.getElementById('className').value.trim() || '4º Ano A',
        answers_json: studentAnswers,
        score: score,
        max_score: 9,
        essay_text: document.getElementById('q3Essay').value.trim()
      };

      try {
        const res = await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        console.log('[Simulado Submit Response]:', data);
      } catch(err) {
        console.warn('Erro ao salvar no servidor:', err);
      }

      // Display result modal
      document.getElementById('scoreValue').innerText = score;
      const listEl = document.getElementById('gabaritoList');
      listEl.innerHTML = gabaritoDetails.map(item => `
        <div class="gabarito-item">
          <span>Questão ${item.question < 10 ? '0' + item.question : item.question}: Sua resposta <strong>${item.studentOpt}</strong></span>
          <span class="${item.isCorrect ? 'badge-correct' : 'badge-wrong'}">
            ${item.isCorrect ? '✓ Correto (Gabarito ' + item.correctOpt + ')' : '✗ Errado (Gabarito ' + item.correctOpt + ')'}
          </span>
        </div>
      `).join('') + `
        <div class="gabarito-item" style="background: #e0f2fe; margin-top: 0.5rem; padding: 0.5rem; border-radius: 8px;">
          <span>Questão 03 (Redação): <strong>${studentAnswers[3] ? 'Enviada para correção do professor' : 'Não respondida'}</strong></span>
        </div>
      `;

      document.getElementById('resultModal').classList.add('active');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }
  </script>
</body>
</html>

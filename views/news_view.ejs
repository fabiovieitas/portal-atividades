<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %> | Blog Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
    <!-- Google AdSense Auto Ads Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1234567890123456" crossorigin="anonymous"></script>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #fdfdfd;
            line-height: 1.8;
            color: #334155;
        }

        .article-hero-section {
            position: relative;
            height: 60vh;
            min-height: 400px;
            width: 100%;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .article-hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.5);
            z-index: 1;
        }

        .article-hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
            padding: 2rem;
            text-align: center;
            color: white;
        }

        .article-category-badge {
            background: #4f46e5;
            color: white;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            margin-bottom: 1.5rem;
            display: inline-block;
        }

        .article-title-main {
            font-family: 'Fredoka', sans-serif;
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 700;
            margin-bottom: 1rem;
            line-height: 1.1;
        }

        .article-meta-info {
            display: flex;
            justify-content: center;
            gap: 2rem;
            font-size: 1rem;
            opacity: 0.9;
        }

        .main-wrapper {
            max-width: 900px;
            margin: -4rem auto 5rem;
            background: white;
            padding: 4rem 5rem;
            border-radius: 40px;
            position: relative;
            z-index: 10;
            box-shadow: 0 40px 100px rgba(0,0,0,0.08);
        }

        .article-body {
            font-size: 1.25rem;
            color: #334155;
        }

        .article-body p {
            margin-bottom: 2rem;
        }

        .article-body h2, .article-body h3 {
            color: #1e293b;
            margin: 3rem 0 1rem;
            font-weight: 800;
        }

        .back-nav {
            margin-bottom: 3rem;
        }

        .btn-back-blog {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #6366f1;
            text-decoration: none;
            font-weight: 700;
            transition: 0.3s;
        }

        .btn-back-blog:hover {
            transform: translateX(-5px);
        }

        @media (max-width: 768px) {
            .main-wrapper {
                margin-top: -2rem;
                padding: 2.5rem 1.5rem;
                border-radius: 20px;
            }
            .article-meta-info { flex-direction: column; gap: 0.5rem; }
        }
    </style>
</head>
<body>

    <nav class="main-nav" style="background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 10px 0;">
        <div class="nav-container" style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <a href="/" class="logo" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 2rem; animation: rotate 10s infinite linear; display: inline-block;">🤖</span>
                <h1 style="font-family: 'Fredoka', sans-serif; color: white; margin: 0; font-size: 1.8rem;">Lab Kids</h1>
            </a>
            <div class="nav-links" style="display: flex; align-items: center; gap: 20px;">
                <a href="/" style="color: white; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: 0.3s;">
                    <i class="fas fa-home"></i> Início
                </a>
                <a href="/noticias" style="color: white; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: 0.3s;">
                    <i class="fas fa-newspaper"></i> Blog
                </a>
                <a href="/professor/login" style="background: linear-gradient(135deg, #4f46e5, #818cf8); color: white; padding: 10px 20px; border-radius: 50px; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);">
                    <i class="fas fa-chalkboard-teacher"></i> Área do Professor
                </a>
            </div>
        </div>
    </nav>

    <header class="article-hero-section">
        <img src="<%= article.image_url || 'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&q=80&w=1600' %>" class="article-hero-bg" alt="">
        <div class="article-hero-content">
            <span class="article-category-badge"><%= article.category %></span>
            <h1 class="article-title-main"><%= article.title %></h1>
            <div class="article-meta-info">
                <span><i class="far fa-calendar-alt"></i> <%= new Date(article.created_at).toLocaleDateString('pt-BR') %></span>
                <span><i class="far fa-user"></i> <%= article.author %></span>
                <span><i class="far fa-clock"></i> 5 min de leitura</span>
            </div>
        </div>
    </header>

    <main class="main-wrapper">
        <nav class="back-nav">
            <a href="/noticias" class="btn-back-blog">
                <i class="fas fa-arrow-left"></i> Voltar para o Blog
            </a>
        </nav>

        <!-- Top AdSense Banner -->
        <div class="adsense-top-banner" style="margin-bottom: 2rem; padding: 15px; background: #f8fafc; border: 2px dashed #e2e8f0; border-radius: 16px; text-align: center;">
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 700; text-transform: uppercase;">Publicidade AdSense</span>
            <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1234567890123456" data-ad-slot="1122334455" data-ad-format="auto" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

        <div class="article-body">
            <%- article.content %>
        </div>

        <!-- Bottom AdSense Banner -->
        <div class="adsense-bottom-banner" style="margin-top: 3rem; padding: 15px; background: #f8fafc; border: 2px dashed #e2e8f0; border-radius: 16px; text-align: center;">
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 700; text-transform: uppercase;">Publicidade AdSense</span>
            <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1234567890123456" data-ad-slot="6677889900" data-ad-format="auto" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

        <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #eee; text-align: center;">
            <h3>Gostou deste artigo?</h3>
            <p>Compartilhe com outros professores e ajude a transformar a educação!</p>
            <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem;">
                <a href="#" style="background: #1877f2; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;"><i class="fab fa-facebook-f"></i></a>
                <a href="#" style="background: #1da1f2; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;"><i class="fab fa-twitter"></i></a>
                <a href="#" style="background: #25d366; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>
    </main>

    <footer class="footer" style="background: #0f172a; color: white; padding: 4rem 2rem;">
        <div class="container" style="text-align: center;">
            <p>&copy; 2026 Lab Kids - Transformando a educação através da tecnologia.</p>
        </div>
    </footer>

</body>
</html>

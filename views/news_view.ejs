<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %> | Portal de Atividades</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .article-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 4rem 1.5rem;
        }

        .article-header {
            margin-bottom: 3rem;
            text-align: center;
        }

        .article-meta {
            color: #64748b;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            display: flex;
            justify-content: center;
            gap: 1.5rem;
        }

        .article-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }

        .article-hero {
            width: 100%;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            margin-bottom: 3rem;
        }

        .article-content {
            font-size: 1.15rem;
            line-height: 1.8;
            color: #334155;
        }

        .article-content p {
            margin-bottom: 1.5rem;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 2rem;
        }

        @media (max-width: 768px) {
            .article-title { font-size: 2rem; }
            .article-container { padding: 2rem 1rem; }
        }
    </style>
</head>
<body style="background: #fdfdfd;">

    <nav class="main-nav">
        <div class="nav-container">
            <a href="/" class="logo">
                <i class="fas fa-graduation-cap"></i> Portal
            </a>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/noticias">Blog</a>
            </div>
        </div>
    </nav>

    <article class="article-container">
        <a href="/noticias" class="back-link">
            <i class="fas fa-arrow-left"></i> Voltar para o Blog
        </a>

        <header class="article-header">
            <div class="article-meta">
                <span><i class="fas fa-tag"></i> <%= article.category %></span>
                <span><i class="far fa-calendar"></i> <%= new Date(article.created_at).toLocaleDateString('pt-BR') %></span>
                <span><i class="far fa-user"></i> <%= article.author %></span>
            </div>
            <h1 class="article-title"><%= article.title %></h1>
        </header>

        <img src="<%= article.image_url || 'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&q=80&w=1200' %>" alt="<%= article.title %>" class="article-hero">

        <div class="article-content">
            <%- article.content.replace(/\n/g, '<br>') %>
        </div>
    </article>

    <footer class="footer">
        <p>&copy; 2024 Portal de Atividades.</p>
    </footer>

</body>
</html>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= activity.title %> - Redirecionando | Lab Kids</title>
    <link rel="stylesheet" href="/css/style.css?v=3">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <!-- Google AdSense Official Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsensePubId %>" crossorigin="anonymous"></script>
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            color: #ffffff;
            font-family: 'Fredoka', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }

        .redirect-card {
            background: rgba(30, 41, 59, 0.95);
            border: 2px solid #3b82f6;
            border-radius: 28px;
            max-width: 650px;
            width: 100%;
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            backdrop-filter: blur(10px);
        }

        .activity-icon-lg {
            width: 90px;
            height: 90px;
            border-radius: 22px;
            object-fit: cover;
            border: 3px solid #fbbf24;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            margin-bottom: 15px;
        }

        .countdown-circle {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #3b82f6;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            margin: 15px 0;
            box-shadow: 0 6px 0 #1d4ed8;
        }

        /* AdSense Container */
        .adsense-interstitial-box {
            background: rgba(15, 23, 42, 0.8);
            border: 2px dashed #475569;
            border-radius: 18px;
            padding: 20px;
            margin: 20px 0;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .btn-go-now {
            background: #10b981;
            color: white;
            border: none;
            border-bottom: 5px solid #047857;
            padding: 16px 36px;
            font-size: 1.25rem;
            font-weight: 800;
            border-radius: 20px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
        }

        .btn-go-now:hover {
            transform: translateY(-2px);
            background: #34d399;
        }

        .btn-go-now:active {
            transform: translateY(2px);
            border-bottom-width: 0;
        }
    </style>
</head>
<body>

    <!-- Anúncios Laterais AdSense (Esquerda e Direita em Telas Ultra-Wide) -->
    <div class="adsense-sidebar-left" style="position: fixed; left: 15px; top: 100px; width: 160px; height: 600px; z-index: 100; display: none;">
        <div style="background: rgba(15, 23, 42, 0.9); border: 2px dashed #475569; border-radius: 14px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">📢 ADSENSE</div>
            <div style="font-size: 0.65rem; color: #64748b; margin-top: 4px;">Anúncios Seguros</div>
            <ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567891"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>
    </div>

    <div class="adsense-sidebar-right" style="position: fixed; right: 15px; top: 100px; width: 160px; height: 600px; z-index: 100; display: none;">
        <div style="background: rgba(15, 23, 42, 0.9); border: 2px dashed #475569; border-radius: 14px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">📢 ADSENSE</div>
            <div style="font-size: 0.65rem; color: #64748b; margin-top: 4px;">Anúncios Seguros</div>
            <ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567892"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>
    </div>

    <style>
        @media (min-width: 1450px) {
            .adsense-sidebar-left, .adsense-sidebar-right { display: block !important; }
        }
    </style>

    <!-- Layout de 4 Lados de Propagandas para Página de Redirecionamento -->
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; max-width: 900px; gap: 15px;">
        
        <!-- Banner Superior (Topo) -->
        <div class="adsense-banner-top" style="width: 100%; background: rgba(15, 23, 42, 0.9); border: 2px dashed #475569; border-radius: 18px; padding: 12px; text-align: center;">
            <div style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">📢 Espaço Publicitário AdSense (Topo)</div>
            <ins class="adsbygoogle" style="display:block; min-height:90px; width:100%;" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567893" data-ad-format="auto" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

        <!-- Card Central de Redirecionamento -->
        <div class="redirect-card">
            <img src="<%= activity.icon_url || 'https://cdn-icons-png.flaticon.com/512/616/616430.png' %>" class="activity-icon-lg" alt="Ícone">
            <h2 style="font-size: 1.8rem; margin: 0 0 8px 0; color: #fbbf24;"><%= activity.title %></h2>
            <p style="color: #94a3b8; font-size: 1rem; margin: 0 0 15px 0;"><%= activity.description || 'Preparando seu desafio interativo...' %></p>

            <!-- Anúncio AdSense Intercalado Central -->
            <div class="adsense-interstitial-box">
                <div style="font-size: 0.85rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">
                    📢 Espaço Publicitário AdSense (Central)
                </div>
                <div style="font-size: 0.75rem; color: #64748b; margin-bottom: 6px;">Anúncios seguros para crianças aparecerão aqui</div>
                <ins class="adsbygoogle" style="display:block; min-height:100px; width:100%;" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567890" data-ad-format="auto" data-full-width-responsive="true"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            </div>
            <div class="countdown-circle" id="countdown">5</div>
            <br>
            <a href="<%= activity.activity_url %>" id="btn-redirect-link" class="btn-go-now" style="opacity: 0.5; pointer-events: none; cursor: not-allowed;">
                ⏳ AGUARDE A PROPAGANDA (3s)...
            </a>
        </div>

        <!-- Banner Inferior (Rodapé) -->
        <div class="adsense-banner-bottom" style="width: 100%; background: rgba(15, 23, 42, 0.9); border: 2px dashed #475569; border-radius: 18px; padding: 12px; text-align: center;">
            <div style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">📢 Espaço Publicitário AdSense (Base)</div>
            <ins class="adsbygoogle" style="display:block; min-height:90px; width:100%;" data-ad-client="<%= adsensePubId %>" data-ad-slot="1234567894" data-ad-format="auto" data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

    </div>


    <script>
        let seconds = 5;
        const targetUrl = "<%- activity.activity_url %>";
        const countEl = document.getElementById('countdown');
        const btnLink = document.getElementById('btn-redirect-link');

        const timer = setInterval(() => {
            seconds--;
            if (countEl) countEl.innerText = seconds;

            const waitTime = seconds - 2;
            if (waitTime > 0) {
                if (btnLink) btnLink.innerText = `⏳ AGUARDE A PROPAGANDA (${waitTime}s)...`;
            } else if (btnLink && btnLink.style.pointerEvents === 'none') {
                btnLink.style.opacity = '1';
                btnLink.style.pointerEvents = 'auto';
                btnLink.style.cursor = 'pointer';
                btnLink.innerText = '🚀 IR PARA A ATIVIDADE AGORA';
            }

            if (seconds <= 0) {
                clearInterval(timer);
                window.location.href = targetUrl;
            }
        }, 1000);
    </script>
</body>
</html>


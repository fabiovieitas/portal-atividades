      <p style="color: #64748b; margin-bottom: 1.2rem;">Você ainda não respondeu todas as questões do simulado:</p>
      <div id="missingQuestionsList" style="text-align: left; background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 1rem; color: #991b1b; font-weight: 700; margin-bottom: 1.5rem; max-height: 180px; overflow-y: auto;">
      </div>
      <button type="button" onclick="closeMissingModal()" style="padding: 0.8rem 2rem; border-radius: 50px; background: #059669; color: white; border: none; font-weight: 800; cursor: pointer;">
        Voltar e Responder
      </button>
    </div>
  </div>

  <!-- Success / Result Modal -->
  <div class="modal-backdrop" id="resultModal">
    <div class="modal-box">
      <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🎉🐢</div>
      <h3 style="font-family: 'Fredoka', sans-serif; font-size: 2rem; color: #059669; margin-bottom: 0.5rem;">Parabéns pelo Desafio!</h3>
      <p style="color: #64748b; font-size: 1.05rem; margin-bottom: 1.2rem;">Suas respostas foram gravadas com sucesso no sistema do Projeto Campos de Todos Nós.</p>
      <div style="background: #f0fdf4; border: 2px solid #86efac; border-radius: 16px; padding: 1.2rem; margin-bottom: 1.5rem;">
        <div style="font-size: 0.9rem; color: #047857; font-weight: 800; text-transform: uppercase;">Desempenho Objetivo</div>
        <div id="finalScoreDisplay" style="font-family: 'Fredoka', sans-serif; font-size: 2.8rem; color: #059669; margin: 0.3rem 0;">0 / 10</div>
        <div style="font-size: 0.85rem; color: #64748b;">+ Questão de Ditado (Q4) salva para revisão da professora!</div>
      </div>
      <a href="/?level=1-5" style="display: block; padding: 1rem; border-radius: 50px; background: #059669; color: white; font-family: 'Fredoka', sans-serif; font-size: 1.2rem; text-decoration: none; font-weight: 700;">
        Voltar para o Portal Lab Kids 🏠
      </a>
    </div>
  </div>

  <script>
    const answerKey = {
      1: 'C',
      2: 'A',
      3: 'B',
      // 4 is Ditado (Frases escritas)
      5: 'A',
      6: 'A',
      7: 'B',
      8: 'A',
      9: 'C',
      10: 'C',
      11: 'C'
    };

    let studentAnswers = {};
    let isSubmitted = false;
    const SIMULADO_KEY = 'lab_simulado_2ano_setembro_draft';

    // Salvar rascunho
    function saveDraft() {
      if (isSubmitted) return;
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        className: document.getElementById('className')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        ditado1: document.getElementById('ditado1')?.value || '',
        ditado2: document.getElementById('ditado2')?.value || '',
        ditado3: document.getElementById('ditado3')?.value || '',
        answers: studentAnswers
      };
      try { localStorage.setItem(SIMULADO_KEY, JSON.stringify(draft)); } catch(e){}
    }

    // Restaurar rascunho
    function restoreDraft() {
      try {
        const raw = localStorage.getItem(SIMULADO_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft.studentName) document.getElementById('studentName').value = draft.studentName;
        if (draft.schoolName) document.getElementById('schoolName').value = draft.schoolName;
        if (draft.className) document.getElementById('className').value = draft.className;
        if (draft.shiftName) document.getElementById('shiftName').value = draft.shiftName;
        if (draft.ditado1) document.getElementById('ditado1').value = draft.ditado1;
        if (draft.ditado2) document.getElementById('ditado2').value = draft.ditado2;
        if (draft.ditado3) document.getElementById('ditado3').value = draft.ditado3;
        syncDitadoAnswers(false);

        if (draft.answers) {
          for (let q in draft.answers) {
            if (q == '4') continue;
            const opt = draft.answers[q];
            const radio = document.querySelector(`input[name="q${q}"][value="${opt}"]`);
            if (radio) {
              radio.checked = true;
              updateCartao(q, opt, false);
            }
          }
        }
      } catch(e){}
    }

    window.addEventListener('DOMContentLoaded', () => {
      restoreDraft();
      document.getElementById('studentName')?.addEventListener('input', saveDraft);
      document.getElementById('schoolName')?.addEventListener('change', saveDraft);
      document.getElementById('className')?.addEventListener('change', saveDraft);
      document.getElementById('shiftName')?.addEventListener('change', saveDraft);
    });

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if (radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt, shouldSave = true) {
      studentAnswers[qNum] = opt;
      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if (dot) dot.classList.remove('selected');
      });
      const dot = document.getElementById(`b-${qNum}-${opt}`);
      if (dot) dot.classList.add('selected');
      updateProgress();
      if (shouldSave) saveDraft();
    }

    function syncDitadoAnswers(shouldSave = true) {
      const d1 = document.getElementById('ditado1')?.value.trim() || '';
      const d2 = document.getElementById('ditado2')?.value.trim() || '';
      const d3 = document.getElementById('ditado3')?.value.trim() || '';
      const badge = document.getElementById('ditado-status-badge');

      if (d1 || d2 || d3) {
        studentAnswers[4] = `1: ${d1} | 2: ${d2} | 3: ${d3}`;
        if (badge) {
          badge.innerText = '✓ ESCRITO';
          badge.style.background = '#10b981';
          badge.style.color = 'white';
        }
      } else {
        delete studentAnswers[4];
        if (badge) {
          badge.innerText = 'DITADO';
          badge.style.background = '#e2e8f0';
          badge.style.color = '#94a3b8';
        }
      }
      updateProgress();
      if (shouldSave) saveDraft();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      document.getElementById('progressTracker').innerText = `${totalAnswered} de 11 respondidas`;
    }

    function closeMissingModal() {
      document.getElementById('missingModal').classList.remove('active');
    }

    // Leitura em Voz Alta
    function readAloud(qNum) {
      if (!('speechSynthesis' in window)) {
        alert('Seu navegador não suporta leitura em voz alta.');
        return;
      }
      window.speechSynthesis.cancel();

      let text = '';
      if (qNum === 1) text = 'Questão 1. ' + document.getElementById('text-q1').innerText + ' O que a turma aprendeu?';
      else if (qNum === 2) text = 'Questão 2. Observe o segundo quadrinho. O que Lucas está mostrando ao apontar para o chão?';
      else if (qNum === 3) text = 'Questão 3. ' + document.getElementById('text-q3').innerText + ' O que Lucas encontrou no chão?';
      else if (qNum === 4) text = 'Questão 4. Ouça atentamente as frases ditadas pela professora e escreva nos espaços abaixo.';
      else if (qNum === 5) text = 'Questão 5. ' + document.getElementById('text-q5').innerText + ' Observe a frase e os desenhos do cartaz: Rio limpo, vida para todos! Juntos, eles transmitem a ideia de:';
      else if (qNum === 6) text = 'Questão 6. ' + document.getElementById('text-q6').innerText + ' Qual par de palavras rima?';
      else if (qNum === 7) text = 'Questão 7. A professora Sara e Lucas estão em uma área próxima à Lagoa de Cima. Observe a imagem. Quem ou o que está à frente da professora Sara?';
      else if (qNum === 8) text = 'Questão 8. ' + document.getElementById('text-q8').innerText + ' Qual grupo representa a mesma quantia doada por Lucas?';
      else if (qNum === 9) text = 'Questão 9. A professora Sara e Lucas participaram de uma ação de plantio. No Rio Paraíba do Sul, foram 7 mudas. Na Lagoa de Cima, 4 mudas. Na Praia do Farol de São Tomé, 5 mudas. Quantas mudas foram plantadas na Lagoa de Cima e na Praia do Farol de São Tomé juntas?';
      else if (qNum === 10) text = 'Questão 10. A professora Sara e a turma chegaram à Lagoa de Cima para plantar mudas. O relógio digital marcava 09:30. Que horário o relógio está marcando?';
      else if (qNum === 11) text = 'Questão 11. Sustentabilidade é cuidar da natureza hoje para que ela continue preservada no futuro. Lucas aprendeu sobre sustentabilidade e perguntou: O que podemos fazer para cuidar do meio ambiente?';

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'pt-BR';
      utterance.rate = 0.95;

      const btns = document.querySelectorAll('.audio-btn');
      btns.forEach(b => b.classList.remove('speaking'));
      const targetBtn = document.querySelector(`#q-card-${qNum} .audio-btn`);
      if (targetBtn) targetBtn.classList.add('speaking');

      utterance.onend = () => {
        if (targetBtn) targetBtn.classList.remove('speaking');
      };

      window.speechSynthesis.speak(utterance);
    }

    // Enviar Simulado
    async function submitSimulado() {
      const name = document.getElementById('studentName').value.trim();
      if (!name) {
        alert('Por favor, informe seu Nome Completo antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      for (let i = 1; i <= 11; i++) {
        if (!studentAnswers[i]) {
          if (i === 4) missing.push('Questão 04 (Ditado de Frases)');
          else missing.push(`Questão ${i < 10 ? '0' + i : i}`);
        }
      }

      if (missing.length > 0) {
        document.getElementById('missingQuestionsList').innerHTML = missing.map(m => `<div>• ${m}</div>`).join('');
        document.getElementById('missingModal').classList.add('active');
        return;
      }

      let score = 0;
      for (let i = 1; i <= 11; i++) {
        if (i === 4) continue;
        if (studentAnswers[i] === answerKey[i]) score++;
      }

      const payload = {
        simulado_id: 'campos-2ano-setembro-2026',
        student_name: name,
        school_name: document.getElementById('schoolName').value.trim(),
        class_name: document.getElementById('className').value || '2º Ano',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 10,
        essay_text: studentAnswers[4] || ''
      };

      try {
        await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch(err) {
        console.error('Submit error:', err);
      }

      isSubmitted = true;
      try { localStorage.removeItem(SIMULADO_KEY); } catch(e){}

      document.getElementById('finalScoreDisplay').innerText = `${score} / 10`;
      document.getElementById('resultModal').classList.add('active');
      if (typeof confetti === 'function') confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
    }
  </script>


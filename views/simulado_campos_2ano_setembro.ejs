<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulado Oficial 2º Ano — Blocos 1 e 2 (Setembro/2026) | Projeto Campos de Todos Nós</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --primary: #059669;
      --primary-dark: #047857;
      --primary-light: #d1fae5;
      --accent: #f59e0b;
      --bg-gradient: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #cbd5e1;
      --radius-lg: 20px;
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(5, 150, 105, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      overscroll-behavior-y: contain;
      touch-action: pan-y;
      -webkit-overflow-scrolling: touch;
    }
    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Sticky Navigation Header */
    .top-header {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      border-bottom: 3px solid #6ee7b7;
      padding: 0.75rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }
    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
    }
    .brand-title {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.35rem;
      color: var(--primary-dark);
      font-weight: 700;
    }

    .simulado-badge {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: white;
      padding: 0.5rem 1.25rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
    }

    .main-layout {
      max-width: 920px;
      margin: 1.5rem auto 3rem auto;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      flex: 1;
    }

    /* Title Block */
    .simulado-pdf-titlecard {
      background: white;
      border-radius: var(--radius-lg);
      padding: 1.75rem 2rem;
      border: 3px solid #065f46;
      text-align: center;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }
    .simulado-pdf-titlecard::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 8px;
      background: linear-gradient(90deg, #10b981, #f59e0b, #3b82f6);
    }
    .simulado-pdf-titlecard .gov-tag {
      font-family: 'Outfit', sans-serif;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 1.2px;
      color: #065f46;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }
    .simulado-pdf-titlecard h1 {
      font-family: 'Fredoka', sans-serif;
      font-size: 2.2rem;
      color: #064e3b;
      margin-bottom: 0.3rem;
    }
    .simulado-pdf-titlecard h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.4rem;
      color: #1e293b;
      font-weight: 800;
    }
    .simulado-pdf-titlecard .sub-theme {
      color: #059669;
      font-weight: 700;
      font-size: 1.05rem;
      margin-top: 0.4rem;
    }

    /* Student Form Card */
    .student-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 1.5rem 2rem;
      box-shadow: var(--shadow-md);
      border: 2px solid #a7f3d0;
    }
    .student-card h2 {
      font-family: 'Fredoka', sans-serif;
      color: var(--primary-dark);
      margin-bottom: 1rem;
      font-size: 1.25rem;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 2fr 2fr 1fr 1fr;
      gap: 1rem;
    }
    .form-group label {
      display: block;
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }
    .form-control {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 2px solid var(--border-color);
      border-radius: 12px;
      font-family: 'Outfit', sans-serif;
      font-size: 1rem;
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }

    /* Cover Poster Block (Page 1) */
    .cover-section-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-md);
      border: 2px solid #a7f3d0;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 1.75rem;
      align-items: center;
    }
    .cover-content h3 {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.4rem;
      color: var(--primary-dark);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 3px solid #dcfce7;
      padding-bottom: 0.5rem;
    }
    .cover-content p {
      font-size: 1.05rem;
      line-height: 1.7;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 1rem;
    }
    .cover-poster-img {
      width: 100%;
      border-radius: 14px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.12);
      border: 2px solid #cbd5e1;
      display: block;
    }

    /* Question Cards */
    .question-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border-color);
      transition: border-color 0.2s;
    }
    .question-card:hover {
      border-color: var(--primary);
    }
    .question-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px dashed #f1f5f9;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .q-number-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .q-number {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--primary-dark);
    }
    .q-subject-badge {
      font-size: 0.8rem;
      font-weight: 700;
      background: var(--primary-light);
      color: var(--primary-dark);
      padding: 0.3rem 0.8rem;
      border-radius: 50px;
    }
    .audio-btn {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 50px;
      padding: 0.4rem 0.9rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: #475569;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s;
    }
    .audio-btn:hover {
      background: var(--primary-light);
      color: var(--primary-dark);
      border-color: var(--primary);
    }
    .audio-btn.speaking {
      background: var(--primary);
      color: white;
      animation: pulse 1s infinite;
    }

    .q-passage {
      background: #f8fafc;
      border-left: 4px solid var(--primary);
      padding: 1.2rem 1.5rem;
      border-radius: 0 14px 14px 0;
      font-size: 1.15rem;
      line-height: 1.7;
      color: #1e293b;
      margin-bottom: 1.5rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .q-prompt {
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    .q-img-center {
      text-align: center;
      margin: 1.25rem 0;
    }
    .q-img-center img {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      border: 2px solid #e2e8f0;
    }

    /* Multiple Choice Options */
    .options-grid {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .option-label {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: #ffffff;
      border: 2px solid var(--border-color);
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 1.1rem;
      font-weight: 700;
    }
    .option-label:hover {
      border-color: var(--primary);
      background: #f0fdf4;
      transform: translateX(4px);
    }
    .option-label input[type="radio"] {
      width: 1.4rem;
      height: 1.4rem;
      accent-color: var(--primary);
      cursor: pointer;
    }
    .option-label:has(input[type="radio"]:checked) {
      background: #d1fae5;
      border-color: var(--primary);
      color: var(--primary-dark);
      box-shadow: 0 4px 12px rgba(5, 150, 105, 0.15);
    }

    /* Cartão Resposta Flutuante / Bottom Dock */
    .cartao-wrapper {
      background: white;
      border-radius: var(--radius-lg);
      padding: 1.75rem 2rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      border: 2px solid #6ee7b7;
      margin-top: 1rem;
    }
    .cartao-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .cartao-title {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.35rem;
      color: #065f46;
      font-weight: 700;
    }
    .cartao-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(65px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .cartao-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      background: #f8fafc;
      padding: 0.6rem 0.4rem;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    .cartao-q-num {
      font-size: 0.8rem;
      font-weight: 800;
      color: #64748b;
    }
    .bubbles-row {
      display: flex;
      gap: 0.25rem;
    }
    .bubble-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1.5px solid #94a3b8;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.6rem;
      font-weight: 800;
      color: #64748b;
      cursor: pointer;
    }
    .bubble-dot.selected {
      background: var(--primary);
      border-color: var(--primary-dark);
      color: white;
    }

    /* Submit Button */
    .btn-submit-simulado {
      width: 100%;
      padding: 1.2rem;
      font-family: 'Fredoka', sans-serif;
      font-size: 1.35rem;
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: white;
      border: none;
      border-radius: 16px;
      cursor: pointer;
      font-weight: 700;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.3);
      transition: all 0.2s;
      letter-spacing: 0.5px;
    }
    .btn-submit-simulado:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(5, 150, 105, 0.4);
    }

    /* Ditado Inputs (Questão 4) */
    .ditado-box {
      background: #f0fdf4;
      border: 2px solid #86efac;
      border-radius: 16px;
      padding: 1.5rem;
      margin-top: 1rem;
    }
    .ditado-line {
      margin-bottom: 1.25rem;
    }
    .ditado-line:last-child {
      margin-bottom: 0;
    }
    .ditado-line label {
      display: block;
      font-weight: 800;
      color: #065f46;
      margin-bottom: 0.4rem;
      font-size: 0.95rem;
    }
    .ditado-input {
      width: 100%;
      padding: 0.85rem 1rem;
      border: 2px solid #cbd5e1;
      border-radius: 10px;
      font-family: 'Outfit', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      background: white;
      text-transform: uppercase;
    }
    .ditado-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    /* Modais */
    .modal-backdrop {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1rem;
    }
    .modal-backdrop.active {
      display: flex;
    }
    .modal-box {
      background: white;
      border-radius: 24px;
      padding: 2.5rem;
      max-width: 540px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      border: 2px solid #86efac;
      animation: scaleIn 0.25s ease-out;
    }
    @keyframes scaleIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    @media (max-width: 768px) {
      .form-grid { grid-template-columns: 1fr; }
      .cover-section-card { grid-template-columns: 1fr; }
      .main-layout { padding: 0 1rem; }
    }
  </style>
</head>
<body>

  <!-- Top Sticky Header -->
  <header class="top-header">
    <div class="header-container">
      <a href="/?level=1-5" class="brand-logo">
        <span style="font-size: 1.8rem;">🐢</span>
        <div>
          <div class="brand-title">Lab Kids • Projeto Campos de Todos Nós</div>
          <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Secretaria Municipal de Educação de Campos dos Goytacazes</div>
        </div>
      </a>
      <div class="simulado-badge">
        <span>📝 2º ANO — SETEMBRO/2026</span>
      </div>
    </div>
  </header>

  <main class="main-layout">

    <!-- Title Card -->
    <div class="simulado-pdf-titlecard">
      <div class="gov-tag">PREFEITURA MUNICIPAL DE CAMPOS DOS GOYTACAZES • SMEC</div>
      <h1>SIMULADO: 2º ANO</h1>
      <h2>BLOCOS 1 E 2 — SETEMBRO / 2026</h2>
      <div class="sub-theme">🌿 Tema: Preservação das Águas, Meio Ambiente e Sustentabilidade</div>
    </div>

    <!-- Student Identification Card -->
    <div class="student-card">
      <h2>👤 Identificação do Aluno(a)</h2>
      <div class="form-grid">
        <div class="form-group" style="grid-column: span 2;">
          <label>Nome Completo do(a) Estudante *</label>
          <input type="text" id="studentName" class="form-control" placeholder="Digite seu nome completo..." required>
        </div>
        <div class="form-group">
          <label>Escola Municipal *</label>
          <select id="schoolName" class="form-control">
            <% if (schools && schools.length > 0) { %>
              <% schools.forEach(s => { %>
                <option value="<%= s.name %>"><%= s.name %></option>
              <% }); %>
            <% } else { %>
              <option value="E.M. Profª Eleonora da Silva Pinto">E.M. Profª Eleonora da Silva Pinto</option>
              <option value="E.M. José Giró Faísca">E.M. José Giró Faísca</option>
              <option value="Outra Escola Municipal">Outra Escola Municipal</option>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label>Turma *</label>
          <select id="className" class="form-control">
            <option value="2º Ano A">2º Ano A</option>
            <option value="2º Ano B">2º Ano B</option>
            <option value="2º Ano C">2º Ano C</option>
            <option value="2º Ano D">2º Ano D</option>
            <option value="2º Ano">2º Ano (Única)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Turno</label>
          <select id="shiftName" class="form-control">
            <option value="Manhã">Manhã</option>
            <option value="Tarde">Tarde</option>
          </select>
        </div>
        <div class="form-group">
          <label>Data</label>
          <input type="text" id="examDate" class="form-control" value="Setembro/2026" readonly>
        </div>
      </div>
    </div>

    <!-- Cover Poster Block (Page 1) -->
    <div class="cover-section-card">
      <div class="cover-content">
        <h3>🐢 Cuidar do Meio Ambiente é Cuidar do Futuro!</h3>
        <p>Olá, amiguinho(a)! O Goytaré e o Lucas convidaram toda a turma para uma importante missão de sustentabilidade e preservação dos nossos rios e lagoas em Campos dos Goytacazes.</p>
        <p style="color: #047857;">LEIA COM ATENÇÃO CADA QUESTÃO, OBSERVE AS IMAGENS E MARQUE A SUA RESPOSTA NO CARTÃO!</p>
      </div>
      <div>
        <img src="/img/simulado/2ano_setembro/cover_poster.png" alt="Goytaré e a Reciclagem" class="cover-poster-img">
      </div>
    </div>

    <!-- QUESTÃO 1 -->
    <div class="question-card" id="q-card-1">
      <div class="question-header">
        <div class="q-number-box">
          <span class="q-number">QUESTÃO 1</span>
          <button type="button" class="audio-btn" onclick="readAloud(1)"><span class="spk-icon">🔊</span> Ouvir Questão</button>
        </div>
        <span class="q-subject-badge">Língua Portuguesa • EF15LP03</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 260px; gap: 1.5rem; align-items: center; margin-bottom: 1.25rem;">
        <div class="q-passage" id="text-q1" style="margin-bottom: 0;">
          LUCAS E SUA TURMA CUIDAM DO RIO
          <br><br>
          LUCAS E SUA TURMA FORAM PASSEAR.
          <br>
          PERTO DO RIO, PARARAM PARA OLHAR E VIRAM QUE ESTAVA POLUÍDO.
          <br><br>
          A PROFESSORA SARA FALOU:
          <br>
          — LIXO É NA LIXEIRA! NÃO SE JOGA LIXO NO RIO.
          <br><br>
          A TURMA APRENDEU QUE CUIDAR DA NATUREZA É MUITO IMPORTANTE!
        </div>
        <div>
          <img src="/img/simulado/2ano_setembro/q1_goytare.png" alt="Goytaré" style="width: 100%; border-radius: 14px;">
        </div>
      </div>

      <div class="q-prompt">O QUE A TURMA APRENDEU?</div>

      <div class="options-grid">
        <label class="option-label"><input type="radio" name="q1" value="A" onclick="updateCartao(1, 'A')"> <span>A) JOGAR LIXO NO RIO.</span></label>
        <label class="option-label"><input type="radio" name="q1" value="B" onclick="updateCartao(1, 'B')"> <span>B) SUJAR A ÁGUA.</span></label>
        <label class="option-label"><input type="radio" name="q1" value="C" onclick="updateCartao(1, 'C')"> <span>C) CUIDAR DA NATUREZA.</span></label>
        <label class="option-label"><input type="radio" name="q1" value="D" onclick="updateCartao(1, 'D')"> <span>D) DEIXAR LIXO NO CHÃO.</span></label>
      </div>
    </div>

    <!-- QUESTÃO 2 -->
    <div class="question-card" id="q-card-2">
      <div class="question-header">
        <div class="q-number-box">
          <span class="q-number">QUESTÃO 2</span>
          <button type="button" class="audio-btn" onclick="readAloud(2)"><span class="spk-icon">🔊</span> Ouvir Questão</button>
        </div>
        <span class="q-subject-badge">Língua Portuguesa • EF15LP14</span>
      </div>

      <div class="q-img-center">
        <img src="/img/simulado/2ano_setembro/q2_tirinha.png" alt="Tirinha de Lucas" style="max-width: 650px;">
      </div>

      <div class="q-prompt" id="text-q2">OBSERVE O SEGUNDO QUADRINHO. O QUE LUCAS ESTÁ MOSTRANDO AO APONTAR PARA O CHÃO?</div>

      <div class="options-grid">
        <label class="option-label"><input type="radio" name="q2" value="A" onclick="updateCartao(2, 'A')"> <span>A) UMA GARRAFA JOGADA NO CHÃO.</span></label>
        <label class="option-label"><input type="radio" name="q2" value="B" onclick="updateCartao(2, 'B')"> <span>B) UMA ÁRVORE.</span></label>
        <label class="option-label"><input type="radio" name="q2" value="C" onclick="updateCartao(2, 'C')"> <span>C) UM BRINQUEDO.</span></label>
        <label class="option-label"><input type="radio" name="q2" value="D" onclick="updateCartao(2, 'D')"> <span>D) UMA MOCHILA.</span></label>
      </div>
    </div>

    <!-- QUESTÃO 3 -->
    <div class="question-card" id="q-card-3">
      <div class="question-header">
        <div class="q-number-box">
          <span class="q-number">QUESTÃO 3</span>
          <button type="button" class="audio-btn" onclick="readAloud(3)"><span class="spk-icon">🔊</span> Ouvir Questão</button>
        </div>
        <span class="q-subject-badge">Língua Portuguesa • EF15LP03</span>
      </div>

      <div class="q-passage" id="text-q3">
        O LIXO NO CHÃO
        <br><br>

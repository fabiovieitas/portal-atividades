            <div class="bubble-row">
              <span style="font-weight: 800; font-size: 0.85rem; color: #334155;">Q<%= i < 10 ? '0'+i : i %></span>
              <% if (i === 5) { %>
                <span id="essayStatusBadge" style="font-size: 0.75rem; font-weight: 700; background: #f1f5f9; color: #94a3b8; padding: 0.25rem 0.6rem; border-radius: 50px;">Aguardando Convite</span>
              <% } else { %>
                <div class="bubble-dots">
                  <div class="bubble-dot" id="b-<%= i %>-A" onclick="selectFromBubble(<%= i %>, 'A')">A</div>
                  <div class="bubble-dot" id="b-<%= i %>-B" onclick="selectFromBubble(<%= i %>, 'B')">B</div>
                  <div class="bubble-dot" id="b-<%= i %>-C" onclick="selectFromBubble(<%= i %>, 'C')">C</div>
                  <div class="bubble-dot" id="b-<%= i %>-D" onclick="selectFromBubble(<%= i %>, 'D')">D</div>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <button class="submit-btn" onclick="submitSimulado()">
          <span>🚀 FINALIZAR E ENVIAR</span>
        </button>

        <button class="teacher-gabarito-toggle-btn" onclick="toggleGabaritoModal()">
          <span>📊 Ver Gabarito & Habilidades BNCC (Professor)</span>
        </button>
      </div>
    </aside>
  </main>

  <!-- Mascote Ururau Flutuante no Canto Inferior Direito (PDF) -->
  <img src="/img/simulado/2ano/mascot_ururau.png" alt="Mascote Ururau" class="floating-mascot">

  <!-- Result Modal -->
  <div class="result-modal" id="resultModal">
    <div class="result-content">
      <div class="score-circle" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #dcfce7 0%, #86efac 100%); border: 4px solid #10b981; color: #15803d; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
        <span style="font-size: 3rem; font-weight: 900;">✓</span>
      </div>
      <h2 style="font-family: 'Fredoka', sans-serif; font-size: 1.7rem; color: #0f172a; margin-bottom: 0.5rem;">Simulado Entregue com Sucesso! 🎉</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">Parabéns! Suas respostas do 2º Ano foram registradas no sistema.</p>
      <button class="modal-btn" onclick="window.location.href='/'">Voltar ao Portal de Atividades</button>
    </div>
  </div>

  <!-- Missing Questions Modal -->
  <div class="result-modal" id="missingModal">
    <div class="result-content" style="max-width: 500px; text-align: center; border-top: 6px solid #ef4444;">
      <div style="font-size: 3rem; margin-bottom: 0.5rem; color: #ef4444;">⚠️</div>
      <h2 style="font-family: 'Fredoka', sans-serif; color: #dc2626; font-size: 1.6rem; margin-bottom: 0.5rem;">Atenção, Estudante!</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.2rem;">Você ainda tem questões pendentes. Responda a todas para concluir:</p>
      <div id="missingQuestionsList" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 14px; padding: 1rem; text-align: left; max-height: 180px; overflow-y: auto; margin-bottom: 1.5rem; font-family: 'Outfit', sans-serif; font-weight: 700; color: #991b1b; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;"></div>
      <button class="modal-btn" onclick="closeMissingModal()" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">✏️ Voltar e Responder Questões</button>
    </div>
  </div>

  <!-- Teacher Gabarito BNCC Modal (Page 7 of PDF) -->
  <div class="result-modal" id="gabaritoModal">
    <div class="result-content" style="max-width: 750px; text-align: left;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.75rem; margin-bottom: 1rem;">
        <h2 style="font-family: 'Fredoka', sans-serif; color: var(--primary-dark); font-size: 1.4rem;">📊 Gabarito & Matriz de Habilidades BNCC (2º Ano)</h2>
        <button onclick="toggleGabaritoModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">✕</button>
      </div>
      <table class="gabarito-table">
        <thead>
          <tr>
            <th>Questão</th>
            <th>Gabarito</th>
            <th>Habilidade BNCC</th>
            <th>Área do Conhecimento</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>1</td><td><strong>A</strong></td><td>EF02LP12 / EF02HI05</td><td>Língua Portuguesa e Ciências Humanas</td></tr>
          <tr><td>2</td><td><strong>B</strong></td><td>EF02LP10</td><td>Língua Portuguesa</td></tr>
          <tr><td>3</td><td><strong>A</strong></td><td>EF15LP14</td><td>Língua Portuguesa</td></tr>
          <tr><td>4</td><td><strong>C</strong></td><td>EF15LP03</td><td>Língua Portuguesa</td></tr>
          <tr><td>5</td><td><strong>ESCRITA</strong></td><td>EF02LP13</td><td>Língua Portuguesa</td></tr>
          <tr><td>6</td><td><strong>C</strong></td><td>EF15LP03 / EF02HI05</td><td>Língua Portuguesa e Ciências Humanas</td></tr>
          <tr><td>7</td><td><strong>B</strong></td><td>EF02MA03</td><td>Matemática</td></tr>
          <tr><td>8</td><td><strong>D</strong></td><td>EF02MA06</td><td>Matemática</td></tr>
          <tr><td>9</td><td><strong>B</strong></td><td>EF02MA09</td><td>Matemática</td></tr>
          <tr><td>10</td><td><strong>C</strong></td><td>EF02CI03</td><td>Ciências da Natureza</td></tr>
        </tbody>
      </table>
      <div style="text-align: center; margin-top: 1.5rem;">
        <button class="modal-btn" onclick="toggleGabaritoModal()">Fechar Gabarito</button>
      </div>
    </div>
  </div>

  <script>
    const answerKey = { 1:'A', 2:'B', 3:'A', 4:'C', 6:'C', 7:'B', 8:'D', 9:'B', 10:'C' };
    const studentAnswers = {};

    function toggleGabaritoModal() {
      document.getElementById('gabaritoModal').classList.toggle('active');
    }

    function closeMissingModal() {
      document.getElementById('missingModal').classList.remove('active');
    }

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if(radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt) {
      studentAnswers[qNum] = opt;
      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if(dot) dot.classList.remove('selected');
      });
      const selectedDot = document.getElementById(`b-${qNum}-${opt}`);
      if(selectedDot) selectedDot.classList.add('selected');
      updateProgress();
    }

    function syncConviteText() {
      const evento = document.getElementById('conviteEvento').value.trim() || 'PASSAPORTE DA CULTURA CAMPISTA';
      const data = document.getElementById('conviteData').value.trim() || '22/08/2026';
      const local = document.getElementById('conviteLocal').value.trim() || 'ESCOLA';
      const convidados = document.getElementById('conviteConvidados').value.trim() || 'FAMÍLIAS DOS ALUNOS';

      const fullText = `CONVITE:\nVENHA PARTICIPAR DO ${evento}.\nDATA: ${data}.\nO ENCONTRO SERÁ NA ${local}.\nCONVIDAMOS ${convidados}.`;
      document.getElementById('q5Essay').value = fullText;
      updateEssayCartao();
    }

    function updateEssayCartao() {
      const essay = document.getElementById('q5Essay').value.trim();
      const badge = document.getElementById('essayStatusBadge');
      if (essay.length >= 10) {
        studentAnswers[5] = essay;
        badge.innerText = '✓ Convite Escrito';
        badge.style.background = '#10b981';
        badge.style.color = 'white';
      } else {
        delete studentAnswers[5];
        badge.innerText = 'Aguardando Convite';
        badge.style.background = '#f1f5f9';
        badge.style.color = '#94a3b8';
      }
      updateProgress();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const pct = (totalAnswered / 10) * 100;
      document.getElementById('progressFill').style.width = `${pct}%`;
      document.getElementById('progressText').innerText = `${totalAnswered} de 10 respondidas`;
    }

    /* Web Speech API Text-to-Speech (Leitura da Questão em Voz Alta) */
    let currentUtterance = null;
    function readAloud(qNum) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        
        let textToRead = "";
        if (qNum === 1) textToRead = "Questão 1. " + document.getElementById('text-q1').innerText + " Qual é o assunto do texto?";
        else if (qNum === 2) textToRead = "Questão 2. " + document.getElementById('text-q2').innerText + " Na frase, a palavra animado indica que Goytaré estava?";
        else if (qNum === 3) textToRead = "Questão 3. Leia a tirinha abaixo. O que deixa a tirinha engraçada é?";
        else if (qNum === 4) textToRead = "Questão 4. " + document.getElementById('text-q4').innerText + " Quem é o personagem que aparece no início desse trecho?";
        else if (qNum === 5) textToRead = "Questão 5. " + document.getElementById('text-q5').innerText;
        else if (qNum === 6) textToRead = "Questão 6. A lenda do Ururau da Lapa. " + document.getElementById('text-q6').innerText + " De acordo com o texto, a história apresentada refere-se a qual lenda?";
        else if (qNum === 7) textToRead = "Questão 7. " + document.getElementById('text-q7').innerText + " Qual estação recebeu mais visitantes?";
        else if (qNum === 8) textToRead = "Questão 8. " + document.getElementById('text-q8').innerText + " Quantas bandeirinhas eles têm ao todo?";
        else if (qNum === 9) textToRead = "Questão 9. " + document.getElementById('text-q9').innerText + " Qual número completa a sequência: 110, 120, 130, espaço, 150?";
        else if (qNum === 10) textToRead = "Questão 10. " + document.getElementById('text-q10').innerText + " Qual atitude mostra que Lucas está cuidando da saúde?";

        const utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.lang = 'pt-BR';
        utterance.rate = 0.95;

        const btns = document.querySelectorAll('.audio-btn');
        btns.forEach(b => b.classList.remove('speaking'));

        const targetBtn = document.querySelector(`#q-card-${qNum} .audio-btn`);
        if(targetBtn) targetBtn.classList.add('speaking');

        utterance.onend = () => {
          if(targetBtn) targetBtn.classList.remove('speaking');
        };

        window.speechSynthesis.speak(utterance);
      } else {
        alert("O seu navegador não suporta leitura de áudio em voz alta.");
      }
    }

    async function submitSimulado() {
      const nameInput = document.getElementById('studentName').value.trim();
      if (!nameInput) {
        alert('Por favor, informe seu Nome Completo antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      for (let i = 1; i <= 10; i++) {
        if (!studentAnswers[i]) {
          if (i === 5) missing.push('Questão 05 (Produção do Convite)');
          else missing.push(`Questão ${i < 10 ? '0' + i : i}`);
        }
      }

      if (missing.length > 0) {
        document.getElementById('missingQuestionsList').innerHTML = missing.map(q => `<div>• ${q}</div>`).join('');
        document.getElementById('missingModal').classList.add('active');
        return;
      }

      let score = 0;
      for (let i = 1; i <= 10; i++) {
        if (i === 5) continue;
        if (studentAnswers[i] === answerKey[i]) score++;
      }

      const payload = {
        simulado_id: 'campos-2ano-agosto-2026',
        student_name: nameInput,
        school_name: document.getElementById('schoolName').value.trim(),
        class_name: document.getElementById('className').value || '2º Ano',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 9,
        essay_text: document.getElementById('q5Essay').value.trim()
      };

      try {
        await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch(err) {}

      document.getElementById('resultModal').classList.add('active');
      if (typeof confetti === 'function') confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulado 3º Ano — Projeto Campos de Todos Nós (Agosto/2026)</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --primary: #f59e0b;
      --primary-dark: #d97706;
      --primary-light: #fef3c7;
      --accent: #0284c7;
      --bg-gradient: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #cbd5e1;
      --radius-lg: 20px;
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(245, 158, 11, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      overscroll-behavior-y: contain;
      overscroll-behavior: none;
      touch-action: pan-y;
      -webkit-overflow-scrolling: touch;
    }
    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .top-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 2px solid #fde68a;
      padding: 1rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }
    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    .brand-title {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.4rem;
      color: var(--primary-dark);
      font-weight: 700;
    }

    .simulado-badge {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
      padding: 0.5rem 1.25rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
    }

    .main-layout {
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      flex: 1;
    }

    .student-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 1.8rem 2rem;
      box-shadow: var(--shadow-md);
      margin-bottom: 1.5rem;
      border: 2px solid #fde68a;
    }
    .student-card h2 {
      font-family: 'Fredoka', sans-serif;
      color: var(--primary-dark);
      margin-bottom: 1.2rem;
      font-size: 1.3rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .form-group label {
      display: block;
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .form-control {
      width: 100%;
      padding: 0.8rem 1rem;
      border: 2px solid var(--border-color);
      border-radius: 12px;
      font-family: 'Outfit', sans-serif;
      font-size: 1rem;
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .form-row-meta {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 1rem;
    }
    @media (max-width: 680px) {
      .form-row-meta {
        grid-template-columns: 1fr;
      }
    }

    .question-card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow-md);
      border: 1px solid #e2e8f0;
    }
    .question-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #f1f5f9;
    }
    .q-number {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.2rem;
      color: var(--primary-dark);
      background: var(--primary-light);
      padding: 0.4rem 1rem;
      border-radius: 50px;
    }
    .q-text {
      font-size: 1.1rem;
      line-height: 1.6;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 1.25rem;
    }

    .options-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .option-label {
      display: flex;
      align-items: center;
      padding: 1rem 1.25rem;
      border: 2px solid #e2e8f0;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .option-label:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }
    .option-label input[type="radio"] {
      margin-right: 1rem;
      width: 20px;
      height: 20px;
      accent-color: var(--primary);
    }
    .option-text {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .essay-box {
      width: 100%;
      min-height: 120px;
      padding: 1rem;
      border: 2px solid var(--border-color);
      border-radius: 14px;
      font-family: 'Outfit', sans-serif;
      font-size: 1rem;
      resize: vertical;
    }

    /* Cartão de Respostas no Final da Página */
    .cartao-resposta {
      background: white;
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      border: 3px solid #fde68a;
      margin-top: 1rem;
    }
    .cartao-title {
      font-family: 'Fredoka', sans-serif;
      color: var(--primary-dark);
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      text-align: center;
    }
    .bubbles-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.8rem;
      margin: 1.5rem 0;
    }
    .bubble-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f8fafc;
      padding: 0.6rem 1rem;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    .bubble-dots {
      display: flex;
      gap: 0.5rem;
    }
    .bubble-dot {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.85rem;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .bubble-dot:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }
    .bubble-dot.selected {
      background: var(--primary);
      color: white;
      border-color: var(--primary-dark);
      box-shadow: 0 4px 10px rgba(245, 158, 11, 0.35);
    }

    .submit-btn {
      width: 100%;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border: none;
      padding: 1.1rem;
      border-radius: 14px;
      font-family: 'Fredoka', sans-serif;
      font-size: 1.25rem;
      cursor: pointer;
      box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
    }
    .submit-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 25px rgba(16, 185, 129, 0.45);
    }

    .result-modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(8px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .result-modal.active { display: flex; }
    .result-content {
      background: white;
      border-radius: 24px;
      padding: 2.5rem;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }
    .modal-btn {
      background: var(--primary);
      color: white;
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 12px;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      margin-top: 1.5rem;
    }
  </style>
</head>
<body>

  <!-- Top Header -->
  <header class="top-header">
    <div class="header-container">
      <a href="/" class="brand-logo">
        <span style="font-size: 2rem;">🏛️</span>
        <div>
          <div class="brand-title">Projeto Campos de Todos Nós!</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">Prefeitura Municipal de Campos dos Goytacazes</div>
        </div>
      </a>
      <div class="simulado-badge">
        <span>📝 SIMULADO 3º ANO — AGOSTO/2026</span>
      </div>
    </div>
  </header>

  <main class="main-layout">
    
    <!-- Student Identification Box -->
    <section class="student-card">
      <h2>👤 Identificação do Estudante</h2>
      <form id="student-form" onsubmit="event.preventDefault();">
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label for="studentName">Nome Completo do Estudante *</label>
          <input type="text" id="studentName" class="form-control" placeholder="Digite seu nome completo..." required>
        </div>
        <div class="form-row-meta">
          <div class="form-group">
            <label for="schoolName">Escola Municipal *</label>
            <select id="schoolName" class="form-control" style="font-weight: 700; color: var(--primary-dark);">
              <% if (typeof schools !== 'undefined' && schools.length > 0) { %>
                <% schools.forEach(sch => { %>
                  <option value="<%= sch.name %>"><%= sch.name %></option>
                <% }); %>
              <% } else { %>
                <option value="E.M. Profª Eleonora da Silva Pinto">E.M. Profª Eleonora da Silva Pinto</option>
                <option value="E.M. José Giró Faísca">E.M. José Giró Faísca</option>
                <option value="E.M. Luis Carlos de Lacerda">E.M. Luis Carlos de Lacerda</option>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label for="className">Turma / Ano *</label>
            <select id="className" class="form-control" style="font-weight: 700; color: var(--primary-dark);">
              <option value="3º Ano A">3º Ano A</option>
              <option value="3º Ano B">3º Ano B</option>
              <option value="3º Ano C">3º Ano C</option>
              <option value="3º Ano D">3º Ano D</option>
              <option value="3º Ano E">3º Ano E</option>
              <option value="N1">N1 (Nivelamento 1)</option>
              <option value="N2">N2 (Nivelamento 2)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="shiftName">Horário / Turno *</label>
            <select id="shiftName" class="form-control" style="font-weight: 700; color: #d97706;">
              <option value="Manhã">☀️ Manhã</option>
              <option value="Tarde">🌤️ Tarde</option>
            </select>
          </div>
        </div>
      </form>
    </section>

      <!-- Intro Context Text -->
      <div style="background: white; border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem; border-left: 6px solid var(--primary); box-shadow: var(--shadow-sm);">
        <h3 style="font-family: 'Fredoka', sans-serif; color: var(--primary-dark); margin-bottom: 0.5rem;">📖 Dandara e Educaré Conhecem Campos</h3>
        <p style="font-size: 0.95rem; line-height: 1.6; color: #334155;">
          DANDARA E EDUCARÉ PARTICIPARAM DE UM PROJETO SOBRE A CULTURA DE CAMPOS DOS GOYTACAZES. ELES CONHECERAM O BOI PINTADINHO, O JONGO, A FOLIA DE REIS, A MANA CHICA DO CABOIO, O URURAU DA LAPA, O CHUVISCO, O FAROL DE SÃO TOMÉ, A LAGOA DE CIMA, A LAGOA FEA E O RIO PARAÍBA DO SUL.
        </p>
      </div>

      <!-- Question 1 -->
      <div class="question-card" id="q-card-1">
        <div class="question-header">
          <span class="q-number">Questão 01</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #0284c7;">Língua Portuguesa</span>
        </div>
        <div class="q-text">
          DANDARA E EDUCARÉ VISITARAM UMA EXPOSIÇÃO SOBRE A CULTURA DE CAMPOS. EM UMA DAS MESAS, ELES ENCONTRARAM UM DOCE TRADICIONAL DO MUNICÍPIO.<br><br>
          <div style="text-align: center; margin: 1rem 0;">
            <img src="/img/simulado/3ano/q1_chuvisco.png" alt="Doce Tradicional de Campos - Chuvisco" style="max-width: 220px; width: 100%; border-radius: 14px; box-shadow: var(--shadow-sm); border: 1px solid #e2e8f0;">
          </div>
          QUAL É O NOME DO DOCE TRADICIONAL DE CAMPOS?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q1" value="A" onclick="updateCartao(1, 'A')"> <span class="option-text">A) CHUVA.</span></label>
          <label class="option-label"><input type="radio" name="q1" value="B" onclick="updateCartao(1, 'B')"> <span class="option-text">B) CHUVISCO.</span></label>
          <label class="option-label"><input type="radio" name="q1" value="C" onclick="updateCartao(1, 'C')"> <span class="option-text">C) CHUVEIRO.</span></label>
          <label class="option-label"><input type="radio" name="q1" value="D" onclick="updateCartao(1, 'D')"> <span class="option-text">D) CHUVOSO.</span></label>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="question-card" id="q-card-2">
        <div class="question-header">
          <span class="q-number">Questão 02</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #0284c7;">Língua Portuguesa</span>
        </div>
        <div class="q-text">
          DEPOIS DA VISITA, DANDARA ESCREVEU UMA FRASE SOBRE O QUE MAIS GOSTOU DE CONHECER:<br>
          <em>“O __________________ É UMA MANIFESTAÇÃO DA CULTURA POPULAR DE CAMPOS.”</em><br><br>
          QUAL PALAVRA COMPLETA CORRETAMENTE A FRASE?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q2" value="A" onclick="updateCartao(2, 'A')"> <span class="option-text">A) JOMGO.</span></label>
          <label class="option-label"><input type="radio" name="q2" value="B" onclick="updateCartao(2, 'B')"> <span class="option-text">B) JONGO.</span></label>
          <label class="option-label"><input type="radio" name="q2" value="C" onclick="updateCartao(2, 'C')"> <span class="option-text">C) GONGO.</span></label>
          <label class="option-label"><input type="radio" name="q2" value="D" onclick="updateCartao(2, 'D')"> <span class="option-text">D) JONCO.</span></label>
        </div>
      </div>

      <!-- Question 3 (Escrita) -->
      <div class="question-card" id="q-card-3" style="border-left: 6px solid #f59e0b;">
        <div class="question-header">
          <span class="q-number">Questão 03</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #d97706;">✍️ Produção de Texto (Resposta Escrita)</span>
        </div>
        <div class="q-text">
          DANDARA E EDUCARÉ APRENDERAM MUITAS COISAS DURANTE O PROJETO.<br>
          <strong>CRIE E ESCREVA DUAS FRASES SOBRE O QUE VOCÊ APRENDEU DURANTE O PROJETO CAMPOS DE TODOS NÓS:</strong>
        </div>
        <textarea id="q3Essay" class="essay-textarea" placeholder="Escreva suas duas frases aqui (ex: 1- Aprendi sobre o Chuvisco. 2- Conheci o Farol de São Tomé)..." oninput="updateEssayCartao()"></textarea>
      </div>

      <!-- Question 4 -->
      <div class="question-card" id="q-card-4">
        <div class="question-header">
          <span class="q-number">Questão 04</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #059669;">Ciências Humanas</span>
        </div>
        <div class="q-text">
          A LENDA DO URURAU É CONHECIDA HÁ MUITO TEMPO EM CAMPOS E CONTINUA SENDO CONTADA POR DIFERENTES GERAÇÕES.<br><br>
          POR QUE HISTÓRIAS COMO A LENDA DO URURAU DA LAPA SÃO IMPORTANTES?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q4" value="A" onclick="updateCartao(4, 'A')"> <span class="option-text">A) PORQUE ENSINAM A FAZER CÁLCULOS.</span></label>
          <label class="option-label"><input type="radio" name="q4" value="B" onclick="updateCartao(4, 'B')"> <span class="option-text">B) PORQUE SERVEM APENAS PARA DIVERTIR OS TURISTAS.</span></label>
          <label class="option-label"><input type="radio" name="q4" value="C" onclick="updateCartao(4, 'C')"> <span class="option-text">C) PORQUE SÃO HISTÓRIAS DE OUTROS PAÍSES.</span></label>
          <label class="option-label"><input type="radio" name="q4" value="D" onclick="updateCartao(4, 'D')"> <span class="option-text">D) PORQUE AJUDAM A PRESERVAR MEMÓRIAS E TRADIÇÕES.</span></label>
        </div>
      </div>

      <!-- Question 5 -->
      <div class="question-card" id="q-card-5">
        <div class="question-header">
          <span class="q-number">Questão 05</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #7c3aed;">Arte</span>
        </div>
        <div class="q-text">
          DANDARA E EDUCARÉ OBSERVARAM UMA APRESENTAÇÃO DO BOI PINTADINHO. DANDARA PERCEBEU AS CORES, AS FITAS, OS DESENHOS E OS MOVIMENTOS PRESENTES NA APRESENTAÇÃO.<br><br>
          <div style="text-align: center; margin: 1rem 0;">
            <img src="/img/simulado/3ano/q5_boipintadinho.png" alt="Apresentação do Boi Pintadinho" style="max-width: 300px; width: 100%; border-radius: 14px; box-shadow: var(--shadow-sm); border: 1px solid #e2e8f0;">
          </div>
          O QUE ESSES ELEMENTOS MOSTRAM?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q5" value="A" onclick="updateCartao(5, 'A')"> <span class="option-text">A) UMA ATIVIDADE REALIZADA SOMENTE NA SALA DE AULA.</span></label>
          <label class="option-label"><input type="radio" name="q5" value="B" onclick="updateCartao(5, 'B')"> <span class="option-text">B) UMA FORMA DE ORGANIZAR O TRÂNSITO DA CIDADE.</span></label>
          <label class="option-label"><input type="radio" name="q5" value="C" onclick="updateCartao(5, 'C')"> <span class="option-text">C) DIFERENTES FORMAS DE EXPRESSÃO ARTÍSTICA DA CULTURA POPULAR.</span></label>
          <label class="option-label"><input type="radio" name="q5" value="D" onclick="updateCartao(5, 'D')"> <span class="option-text">D) UMA COMPETIÇÃO ESPORTIVA.</span></label>
        </div>
      </div>

      <!-- Question 6 -->
      <div class="question-card" id="q-card-6">
        <div class="question-header">
          <span class="q-number">Questão 06</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #059669;">Ciências Humanas</span>
        </div>
        <div class="q-text">
          DANDARA E EDUCARÉ CONHECERAM O FAROL DE SÃO TOMÉ. ELES APRENDERAM QUE O FAROL É UMA IMPORTANTE REFERÊNCIA TURÍSTICA E CULTURAL DE CAMPOS.<br><br>
          <div style="text-align: center; margin: 1rem 0;">
            <img src="/img/simulado/3ano/q6_farol.png" alt="Farol de São Tomé" style="max-width: 220px; width: 100%; border-radius: 14px; box-shadow: var(--shadow-sm); border: 1px solid #e2e8f0;">
          </div>
          POR QUE É IMPORTANTE CONHECER E CUIDAR DE LUGARES COMO O FAROL DE SÃO TOMÉ?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q6" value="A" onclick="updateCartao(6, 'A')"> <span class="option-text">A) PORQUE FAZEM PARTE DAS REFERÊNCIAS DO MUNICÍPIO E DEVEM SER VALORIZADOS.</span></label>
          <label class="option-label"><input type="radio" name="q6" value="B" onclick="updateCartao(6, 'B')"> <span class="option-text">B) PORQUE SOMENTE OS TURISTAS PODEM CONHECÊ-LOS.</span></label>
          <label class="option-label"><input type="radio" name="q6" value="C" onclick="updateCartao(6, 'C')"> <span class="option-text">C) PORQUE NÃO POSSUEM IMPORTÂNCIA PARA OS MORADORES.</span></label>
          <label class="option-label"><input type="radio" name="q6" value="D" onclick="updateCartao(6, 'D')"> <span class="option-text">D) PORQUE DEVEM SER VISITADOS APENAS DURANTE AS FÉRIAS.</span></label>
        </div>
      </div>

      <!-- Question 7 -->
      <div class="question-card" id="q-card-7">
        <div class="question-header">
          <span class="q-number">Questão 07</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #d97706;">Matemática</span>
        </div>
        <div class="q-text">
          PARA ENFEITAR O ESPAÇO DA APRESENTAÇÃO DO BOI PINTADINHO, DANDARA E EDUCARÉ SEPARARAM <strong>364 FITAS COLORIDAS</strong>.<br><br>
          QUAL É A DECOMPOSIÇÃO CORRETA DO NÚMERO 364?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q7" value="A" onclick="updateCartao(7, 'A')"> <span class="option-text">A) 3 + 6 + 4</span></label>
          <label class="option-label"><input type="radio" name="q7" value="B" onclick="updateCartao(7, 'B')"> <span class="option-text">B) 300 + 6 + 4</span></label>
          <label class="option-label"><input type="radio" name="q7" value="C" onclick="updateCartao(7, 'C')"> <span class="option-text">C) 30 + 60 + 4</span></label>
          <label class="option-label"><input type="radio" name="q7" value="D" onclick="updateCartao(7, 'D')"> <span class="option-text">D) 300 + 60 + 4</span></label>
        </div>
      </div>

      <!-- Question 8 -->
      <div class="question-card" id="q-card-8">
        <div class="question-header">
          <span class="q-number">Questão 08</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #d97706;">Matemática</span>
        </div>
        <div class="q-text">
          DURANTE A EXPOSIÇÃO, DANDARA E EDUCARÉ REGISTRARAM <strong>582 VISITANTES</strong>.<br><br>
          <div style="text-align: center; margin: 1rem 0;">
            <img src="/img/simulado/3ano/q8_numero_582.png" alt="Observe o Número 582" style="max-width: 260px; width: 100%; border-radius: 12px; border: 1px solid #cbd5e1;">
          </div>
          NO NÚMERO 582, O ALGARISMO <strong>5</strong> OCUPA QUAL ORDEM E POSSUI QUAL VALOR?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q8" value="A" onclick="updateCartao(8, 'A')"> <span class="option-text">A) UNIDADE – 5</span></label>
          <label class="option-label"><input type="radio" name="q8" value="B" onclick="updateCartao(8, 'B')"> <span class="option-text">B) DEZENA – 50</span></label>
          <label class="option-label"><input type="radio" name="q8" value="C" onclick="updateCartao(8, 'C')"> <span class="option-text">C) CENTENA – 500</span></label>
          <label class="option-label"><input type="radio" name="q8" value="D" onclick="updateCartao(8, 'D')"> <span class="option-text">D) CENTENA – 50</span></label>
        </div>
      </div>

      <!-- Question 9 -->
      <div class="question-card" id="q-card-9">
        <div class="question-header">
          <span class="q-number">Questão 09</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #d97706;">Matemática</span>
        </div>
        <div class="q-text">
          NA ESTAÇÃO DO JONGO, DANDARA E EDUCARÉ REGISTRARAM <strong>582 VISITANTES</strong>.<br><br>
          COMO SE ESCREVE O NÚMERO 582 POR EXTENSO?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q9" value="A" onclick="updateCartao(9, 'A')"> <span class="option-text">A) QUINHENTOS E OITENTA E DOIS.</span></label>
          <label class="option-label"><input type="radio" name="q9" value="B" onclick="updateCartao(9, 'B')"> <span class="option-text">B) QUINHENTOS E OITO.</span></label>
          <label class="option-label"><input type="radio" name="q9" value="C" onclick="updateCartao(9, 'C')"> <span class="option-text">C) QUINHENTOS E VINTE E OITO.</span></label>
          <label class="option-label"><input type="radio" name="q9" value="D" onclick="updateCartao(9, 'D')"> <span class="option-text">D) QUATROCENTOS E OITENTA E DOIS.</span></label>
        </div>
      </div>

      <!-- Question 10 -->
      <div class="question-card" id="q-card-10">
        <div class="question-header">
          <span class="q-number">Questão 10</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #0284c7;">Ciências da Natureza</span>
        </div>
        <div class="q-text">
          DANDARA E EDUCARÉ PARTICIPARAM DE UMA APRESENTAÇÃO CULTURAL EM UM DIA QUENTE. DEPOIS DE ALGUM TEMPO, DANDARA SENTIU SEDE.<br><br>
          QUAL ATITUDE AJUDA A CUIDAR DA SAÚDE DURANTE A APRESENTAÇÃO?
        </div>
        <div class="options-grid">
          <label class="option-label"><input type="radio" name="q10" value="A" onclick="updateCartao(10, 'A')"> <span class="option-text">A) FICAR MUITO TEMPO NO SOL SEM DESCANSAR.</span></label>
          <label class="option-label"><input type="radio" name="q10" value="B" onclick="updateCartao(10, 'B')"> <span class="option-text">B) BEBER ÁGUA E PROCURAR UM LOCAL COM SOMBRA QUANDO NECESSÁRIO.</span></label>
          <label class="option-label"><input type="radio" name="q10" value="C" onclick="updateCartao(10, 'C')"> <span class="option-text">C) CORRER O TEMPO TODO SEM PARAR.</span></label>
          <label class="option-label"><input type="radio" name="q10" value="D" onclick="updateCartao(10, 'D')"> <span class="option-text">D) PASSAR MUITAS HORAS SEM BEBER ÁGUA.</span></label>
      </div>
    </div>

    <!-- Cartão de Respostas no Final da Página -->
    <section class="cartao-resposta">
      <div class="cartao-title">📋 Cartão Resposta Oficial (3º Ano)</div>
      <p style="text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.8rem;">
        Confira todas as suas respostas marcadas e as frases antes de enviar:
      </p>
      
      <div style="background: #f1f5f9; height: 10px; border-radius: 50px; margin-bottom: 0.5rem; overflow: hidden;">
        <div id="progressFill" style="background: linear-gradient(90deg, var(--primary), var(--success)); height: 100%; width: 0%; transition: width 0.3s;"></div>
      </div>
      <div id="progressText" style="font-size: 0.9rem; font-weight: 800; color: var(--primary); text-align: center; margin-bottom: 1.2rem;">
        0 de 10 respondidas
      </div>

      <div class="bubbles-list">
        <% for(let i=1; i<=10; i++) { %>
          <div class="bubble-row">
            <span style="font-weight: 800; font-size: 0.9rem; color: #334155;">Questão <%= i < 10 ? '0'+i : i %></span>
            <% if (i === 3) { %>
              <span id="essayStatusBadge" style="font-size: 0.8rem; font-weight: 700; background: #f1f5f9; color: #94a3b8; padding: 0.3rem 0.8rem; border-radius: 50px;">Aguardando Frases</span>
            <% } else { %>
              <div class="bubble-dots">
                <div class="bubble-dot" id="b-<%= i %>-A" onclick="selectFromBubble(<%= i %>, 'A')">A</div>
                <div class="bubble-dot" id="b-<%= i %>-B" onclick="selectFromBubble(<%= i %>, 'B')">B</div>
                <div class="bubble-dot" id="b-<%= i %>-C" onclick="selectFromBubble(<%= i %>, 'C')">C</div>
                <div class="bubble-dot" id="b-<%= i %>-D" onclick="selectFromBubble(<%= i %>, 'D')">D</div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <button class="submit-btn" onclick="submitSimulado()">
        <span>🚀 FINALIZAR E ENVIAR SIMULADO</span>
      </button>
    </section>
  </main>

  <!-- Result Modal -->
  <div class="result-modal" id="resultModal">
    <div class="result-content">
      <div class="score-circle" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #dcfce7 0%, #86efac 100%); border: 4px solid #10b981; color: #15803d; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
        <span style="font-size: 3rem; font-weight: 900;">✓</span>
      </div>
      <h2 style="font-family: 'Fredoka', sans-serif; font-size: 1.6rem; color: #0f172a; margin-bottom: 0.5rem;">Simulado Entregue com Sucesso! 🎉</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">Parabéns! Suas respostas do 3º Ano foram salvas com sucesso no sistema.</p>
      <button class="modal-btn" onclick="window.location.href='/'">Voltar ao Portal de Atividades</button>
    </div>
  </div>

  <!-- Missing Questions Modal -->
  <div class="result-modal" id="missingModal">
    <div class="result-content" style="max-width: 500px; text-align: center; border-top: 6px solid #ef4444;">
      <div style="font-size: 3rem; margin-bottom: 0.5rem; color: #ef4444;">⚠️</div>
      <h2 style="font-family: 'Fredoka', sans-serif; color: #dc2626; font-size: 1.6rem; margin-bottom: 0.5rem;">Atenção, Explorador!</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.2rem;">Você ainda tem questões não respondidas. Responda a todas as questões para concluir:</p>
      <div id="missingQuestionsList" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 14px; padding: 1rem; text-align: left; max-height: 180px; overflow-y: auto; margin-bottom: 1.5rem; font-family: 'Outfit', sans-serif; font-weight: 700; color: #991b1b; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;"></div>
      <button class="modal-btn" onclick="closeMissingModal()" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">✏️ Voltar e Responder Questões</button>
    </div>
  </div>

  <script>
    const answerKey = { 1:'B', 2:'B', 4:'D', 5:'C', 6:'A', 7:'D', 8:'C', 9:'A', 10:'B' };
    const studentAnswers = {};
    let isSubmitted = false;
    const SIMULADO_STORAGE_KEY = 'simulado_draft_campos_3ano';

    // === BLINDAGEM CONTRA PULL-TO-REFRESH NO TABLET / CELULAR ===
    let touchStartY = 0;
    document.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches.length > 0) {
        touchStartY = e.touches[0].pageY;
      }
    }, { passive: true });

    document.addEventListener('touchmove', function(e) {
      if (!e.touches || e.touches.length === 0) return;
      const touchY = e.touches[0].pageY;
      const touchDiff = touchY - touchStartY;
      if (window.scrollY <= 2 && touchDiff > 0) {
        e.preventDefault();
      }
    }, { passive: false });

    // === SALVAMENTO AUTOMÁTICO EM TEMPO REAL NO LOCALSTORAGE ===
    function saveDraftToStorage() {
      try {
        const draft = {
          studentName: document.getElementById('studentName')?.value || '',
          schoolName: document.getElementById('schoolName')?.value || '',
          className: document.getElementById('className')?.value || '',
          shiftName: document.getElementById('shiftName')?.value || '',
          essay: document.getElementById('q3Essay')?.value || '',
          answers: studentAnswers,
          timestamp: Date.now()
        };
        localStorage.setItem(SIMULADO_STORAGE_KEY, JSON.stringify(draft));
      } catch(e) {}
    }

    function restoreDraftFromStorage() {
      try {
        const raw = localStorage.getItem(SIMULADO_STORAGE_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (Date.now() - (draft.timestamp || 0) < 24 * 60 * 60 * 1000) {
          if (draft.studentName && document.getElementById('studentName')) {
            document.getElementById('studentName').value = draft.studentName;
          }
          if (draft.schoolName && document.getElementById('schoolName')) {
            document.getElementById('schoolName').value = draft.schoolName;
          }
          if (draft.className && document.getElementById('className')) {
            document.getElementById('className').value = draft.className;
          }
          if (draft.shiftName && document.getElementById('shiftName')) {
            document.getElementById('shiftName').value = draft.shiftName;
          }
          if (draft.essay && document.getElementById('q3Essay')) {
            document.getElementById('q3Essay').value = draft.essay;
            updateEssayCartao(false);
          }
          if (draft.answers && typeof draft.answers === 'object') {
            for (const qNum in draft.answers) {
              if (qNum == '3') continue;
              const val = draft.answers[qNum];
              const radio = document.querySelector(`input[name="q${qNum}"][value="${val}"]`);
              if (radio) {
                radio.checked = true;
                updateCartao(qNum, val, false);
              }
            }
          }
        }
      } catch(e) {}
    }

    window.addEventListener('beforeunload', function(e) {
      if (Object.keys(studentAnswers).length > 0 && !isSubmitted) {
        e.preventDefault();
        e.returnValue = 'Você possui respostas marcadas nesta prova. Deseja realmente sair?';
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      restoreDraftFromStorage();
      document.getElementById('studentName')?.addEventListener('input', saveDraftToStorage);
      document.getElementById('schoolName')?.addEventListener('change', saveDraftToStorage);
      document.getElementById('className')?.addEventListener('change', saveDraftToStorage);
      document.getElementById('shiftName')?.addEventListener('change', saveDraftToStorage);
    });

    function closeMissingModal() {
      document.getElementById('missingModal').classList.remove('active');
    }

    function selectFromBubble(qNum, opt) {
      const radio = document.querySelector(`input[name="q${qNum}"][value="${opt}"]`);
      if(radio) {
        radio.checked = true;
        updateCartao(qNum, opt);
      }
    }

    function updateCartao(qNum, opt, shouldSave = true) {
      studentAnswers[qNum] = opt;
      ['A', 'B', 'C', 'D'].forEach(o => {
        const dot = document.getElementById(`b-${qNum}-${o}`);
        if(dot) dot.classList.remove('selected');
      });
      const selectedDot = document.getElementById(`b-${qNum}-${opt}`);
      if(selectedDot) selectedDot.classList.add('selected');
      updateProgress();
      if (shouldSave) saveDraftToStorage();
    }

    function updateEssayCartao(shouldSave = true) {
      const essay = document.getElementById('q3Essay').value.trim();
      const badge = document.getElementById('essayStatusBadge');
      if (essay.length >= 10) {
        studentAnswers[3] = essay;
        badge.innerText = '✓ Frases Escritas';
        badge.style.background = '#10b981';
        badge.style.color = 'white';
      } else {
        delete studentAnswers[3];
        badge.innerText = 'Aguardando Frases';
        badge.style.background = '#f1f5f9';
        badge.style.color = '#94a3b8';
      }
      updateProgress();
      if (shouldSave) saveDraftToStorage();
    }

    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const pct = (totalAnswered / 10) * 100;
      document.getElementById('progressFill').style.width = `${pct}%`;
      document.getElementById('progressText').innerText = `${totalAnswered} de 10 respondidas`;
    }

    async function submitSimulado() {
      const nameInput = document.getElementById('studentName').value.trim();
      if (!nameInput) {
        alert('Por favor, informe seu Nome Completo antes de enviar!');
        document.getElementById('studentName').focus();
        return;
      }

      const missing = [];
      for (let i = 1; i <= 10; i++) {
        if (!studentAnswers[i]) {
          if (i === 3) missing.push('Questão 03 (Escrita de Frases)');
          else missing.push(`Questão ${i < 10 ? '0' + i : i}`);
        }
      }

      if (missing.length > 0) {
        document.getElementById('missingQuestionsList').innerHTML = missing.map(q => `<div>• ${q}</div>`).join('');
        document.getElementById('missingModal').classList.add('active');
        return;
      }

      let score = 0;
      for (let i = 1; i <= 10; i++) {
        if (i === 3) continue;
        if (studentAnswers[i] === answerKey[i]) score++;
      }

      const payload = {
        simulado_id: 'campos-3ano-agosto-2026',
        student_name: nameInput,
        school_name: document.getElementById('schoolName').value.trim(),
        class_name: document.getElementById('className').value || '3º Ano',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 9,
        essay_text: document.getElementById('q3Essay').value.trim()
      };

      try {
        await fetch('/api/simulado/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch(err) {}

      isSubmitted = true;
      try { localStorage.removeItem(SIMULADO_STORAGE_KEY); } catch(e){}

      document.getElementById('resultModal').classList.add('active');
      if (typeof confetti === 'function') confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
    }
  </script>
</body>
</html>

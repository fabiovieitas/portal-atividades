<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Scanner de Chamada | Lab Kids</title>
  <link rel="icon" type="image/png" href="/img/robot-icon-512.png">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
  <!-- Tesseract.js OCR v5 via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <style>
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      margin: 0;
      padding: 0;
      font-family: 'Outfit', sans-serif;
      background: #f1f5f9;
      color: #0f172a;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .header {
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
      color: white;
      padding: 18px 16px;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .header h1 {
      margin: 0;
      font-family: 'Fredoka', sans-serif;
      font-size: 1.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .class-badge {
      display: inline-block;
      margin-top: 6px;
      background: rgba(255,255,255,0.18);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.3);
    }
    .container {
      flex: 1;
      padding: 16px;
      max-width: 600px;
      margin: 0 auto;
      width: 100%;
    }
    .tab-bar {
      display: flex;
      background: #e2e8f0;
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 16px;
      gap: 4px;
    }
    .tab-btn {
      flex: 1;
      background: none;
      border: none;
      padding: 10px 6px;
      border-radius: 9px;
      font-size: 0.9rem;
      font-weight: 800;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: white;
      color: #4f46e5;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .card {
      background: white;
      border-radius: 20px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      border: 1px solid #e2e8f0;
      margin-bottom: 16px;
    }
    .btn-camera {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      padding: 16px;
      border-radius: 16px;
      font-size: 1.1rem;
      font-weight: 800;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
      transition: transform 0.1s;
    }
    .btn-camera:active { transform: scale(0.98); }
    .btn-gallery {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: #f8fafc;
      color: #475569;
      padding: 12px;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 700;
      border: 1.5px dashed #cbd5e1;
      margin-top: 10px;
      cursor: pointer;
    }
    .tip-box {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 0.82rem;
      color: #1e40af;
      line-height: 1.45;
      margin-top: 14px;
    }
    .progress-box {
      display: none;
      text-align: center;
      padding: 20px;
      background: #eff6ff;
      border: 1.5px solid #bfdbfe;
      border-radius: 16px;
      margin-top: 16px;
    }
    .progress-bar-wrap {
      width: 100%;
      height: 12px;
      background: #e2e8f0;
      border-radius: 6px;
      overflow: hidden;
      margin: 12px 0 8px;
    }
    .progress-bar-fill {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #6366f1, #10b981);
      transition: width 0.3s;
    }
    .preview-wrap {
      display: none;
      margin-top: 14px;
      text-align: center;
    }
    .preview-img {
      max-width: 100%;
      max-height: 240px;
      object-fit: contain;
      border-radius: 12px;
      border: 1.5px solid #cbd5e1;
      background: #000;
    }
    .btn-rotate {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f1f5f9;
      color: #334155;
      border: 1.5px solid #cbd5e1;
      padding: 8px 14px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      margin-top: 8px;
    }
    .student-item {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 8px 12px;
      border-radius: 10px;
      margin-bottom: 6px;
    }
    .student-item input {
      flex: 1;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 8px 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #0f172a;
    }
    .student-item button {
      background: #fee2e2;
      color: #ef4444;
      border: none;
      padding: 8px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }
    .btn-submit-final {
      display: block;
      width: 100%;
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      padding: 16px;
      border-radius: 16px;
      font-size: 1.1rem;
      font-weight: 800;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(16, 185, 129, 0.35);
      margin-top: 16px;
    }
    .btn-submit-final:disabled { opacity: 0.6; cursor: not-allowed; }
    .badge-count {
      background: #dcfce7;
      color: #15803d;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <header class="header">
    <h1>📸 Scanner de Lista de Chamada</h1>
    <div class="class-badge">
      🏫 <%= classInfo.school_name || 'Escola' %> • Turma: <%= classInfo.class_name %>
    </div>
  </header>

  <main class="container">

    <!-- Seletor de Modo: Câmera ou Colar Texto no Celular -->
    <div class="tab-bar">
      <button class="tab-btn active" id="btnTabCamera" onclick="switchMode('camera')">
        📷 Fotografar com Celular
      </button>
      <button class="tab-btn" id="btnTabPaste" onclick="switchMode('paste')">
        ✍️ Colar Texto / WhatsApp
      </button>
    </div>

    <!-- MODO 1: FOTOGRAFAR COM O CELULAR -->
    <div id="mode-camera">
      <div class="card" id="step-capture">
        <h2 style="font-size: 1.15rem; margin: 0 0 6px 0; color: #1e1b4b; font-family: 'Fredoka', sans-serif;">
          1. Tirar Foto da Folha de Chamada
        </h2>
        <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 14px 0; line-height: 1.4;">
          Aponte a câmera para a folha (impressa ou digitada) e fotografe com boa iluminação:
        </p>

        <input type="file" id="cameraInput" accept="image/*" capture="environment" style="display: none;" onchange="handleImageSelected(event)">
        <input type="file" id="galleryInput" accept="image/*" style="display: none;" onchange="handleImageSelected(event)">

        <button class="btn-camera" onclick="document.getElementById('cameraInput').click()">
          📷 Abrir Câmera do Celular
        </button>

        <button class="btn-gallery" onclick="document.getElementById('galleryInput').click()">
          🖼️ Escolher Foto da Galeria do Celular
        </button>

        <!-- Preview da Imagem com Controle de Giro 90° -->
        <div class="preview-wrap" id="previewWrap">
          <img id="imgPreview" class="preview-img" alt="Foto da Chamada">
          <div>
            <button type="button" class="btn-rotate" onclick="rotateAndReOcr()">
              🔄 Girar Foto 90° (Se estiver de lado)
            </button>
          </div>
        </div>

        <div class="tip-box">
          💡 <strong>Dica de ouro:</strong> Se a folha tiver muitas colunas vazias de presença, aproxime a câmera focando <strong>apenas na coluna dos nomes</strong> para uma leitura instantânea!
        </div>

        <div class="progress-box" id="progressBox">
          <div id="progressStatus" style="font-weight: 800; color: #1e40af; font-size: 0.95rem;">
            🔍 Preparando imagem...
          </div>
          <div class="progress-bar-wrap">
            <div class="progress-bar-fill" id="progressBar"></div>
          </div>
          <div id="progressPercent" style="font-size: 0.82rem; color: #64748b; font-weight: 700;">0%</div>
        </div>
      </div>
    </div>

    <!-- MODO 2: COLAR TEXTO NO CELULAR (WHATSAPP/PDF) -->
    <div id="mode-paste" style="display: none;">
      <div class="card">
        <h2 style="font-size: 1.15rem; margin: 0 0 6px 0; color: #1e1b4b; font-family: 'Fredoka', sans-serif;">
          Cole os Nomes Aqui:
        </h2>
        <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 12px 0;">
          Se você tem a lista no WhatsApp, Word ou PDF no celular, copie e cole abaixo:
        </p>
        <textarea id="pastedText" rows="10" placeholder="01 - Ana Clara Souza&#10;02 - Bernardo Silva Santos&#10;03 - Carlos Eduardo Lima..." style="width: 100%; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 12px; font-family: inherit; font-size: 0.95rem;"></textarea>
        <button class="btn-camera" onclick="processPastedText()" style="margin-top: 12px; background: linear-gradient(135deg, #10b981, #059669);">
          ✨ Processar Lista de Nomes
        </button>
      </div>
    </div>

    <!-- CARD DE REVISÃO E CONFIRMAÇÃO DOS NOMES EXTRAÍDOS -->
    <div class="card" id="step-review" style="display: none;">
      
      <!-- Caixa de Texto Lido Direto da Câmera (Transparência Total) -->
      <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 14px; padding: 14px; margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <h3 style="margin: 0; color: #1e40af; font-size: 1rem; font-family: 'Fredoka', sans-serif;">
            📄 Texto Lido da Folha (OCR)
          </h3>
          <span class="badge-count" id="studentCountBadge">0 Alunos</span>
        </div>
        <p style="font-size: 0.78rem; color: #3b82f6; margin: 0 0 8px 0;">
          Confira o texto lido. Você pode editar diretamente qualquer linha se desejar:
        </p>
        <textarea id="rawOcrTextarea" rows="8" style="width: 100%; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 10px; font-family: monospace; font-size: 0.88rem; line-height: 1.4; color: #0f172a;"></textarea>

        <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
          <button type="button" onclick="reparseFromEditedTextarea()" style="background: #4f46e5; color: white; border: none; padding: 8px 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
            ✨ Filtrar Nomes Automaticamente
          </button>
          <button type="button" onclick="useRawLinesDirectly()" style="background: #0284c7; color: white; border: none; padding: 8px 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
            📋 Usar Todas as Linhas como Alunos
          </button>
        </div>
      </div>

      <!-- Lista de Alunos Finais Extraídos -->
      <h3 style="font-size: 1.05rem; margin: 16px 0 8px 0; color: #1e1b4b; font-family: 'Fredoka', sans-serif;">
        Alunos Prontos para Cadastrar:
      </h3>
      <div id="studentsListContainer" style="max-height: 340px; overflow-y: auto; padding-right: 4px;">
        <!-- Lista de inputs injetados via JS -->
      </div>

      <div style="margin-top: 10px;">
        <button type="button" onclick="addNewStudentRow()" style="background: none; border: 1.5px dashed #6366f1; color: #4f46e5; width: 100%; padding: 10px; border-radius: 10px; font-weight: 700; cursor: pointer;">
          + Adicionar Outro Aluno Manualmente
        </button>
      </div>

      <div style="margin-top: 14px; background: #f8fafc; padding: 12px; border-radius: 12px; border: 1px solid #e2e8f0;">
        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 700; color: #334155; cursor: pointer;">
          <input type="checkbox" id="chkGeneratePins" style="width: 18px; height: 18px;" checked>
          Gerar senhas (PIN de 4 dígitos) para cada aluno
        </label>
      </div>

      <button id="btnSubmitRoster" class="btn-submit-final" onclick="submitScannedRoster()">
        🚀 Salvar Todos os Alunos na Turma
      </button>

      <button type="button" onclick="resetScanner()" style="background: none; border: none; color: #64748b; width: 100%; padding: 12px; font-weight: 700; margin-top: 6px; cursor: pointer;">
        🔄 Tirar Outra Foto
      </button>
    </div>

    <!-- CARD DE SUCESSO -->
    <div class="card" id="step-success" style="display: none; text-align: center; padding: 30px 20px;">
      <div style="font-size: 3.5rem; margin-bottom: 12px;">🎉</div>
      <h2 style="font-family: 'Fredoka', sans-serif; color: #059669; margin: 0 0 8px 0; font-size: 1.5rem;">
        Alunos Cadastrados com Sucesso!
      </h2>
      <p id="successSummary" style="color: #475569; font-size: 0.95rem; margin: 0 0 20px 0; line-height: 1.4;">
        Todos os alunos já estão salvos e vinculados à turma!
      </p>

      <button class="btn-camera" onclick="resetScanner()" style="background: linear-gradient(135deg, #10b981, #059669);">
        📸 Escanear Outra Folha
      </button>
      <div style="margin-top: 15px;">
        <a href="/" style="color: #64748b; text-decoration: none; font-size: 0.9rem; font-weight: 700;">
          ← Voltar para o Portal Lab Kids
        </a>
      </div>
    </div>

  </main>

  <script>
    const classId = "<%= classInfo.id %>";
    const classCode = "<%= classInfo.access_code %>";
    const className = "<%= classInfo.class_name %>";
    const schoolName = "<%= (classInfo.school_name || '').replace(/"/g, '\\"') %>";

    let recognizedStudents = [];
    let currentImageElement = null;
    let currentRotation = 0;

    function switchMode(mode) {
      document.getElementById('mode-camera').style.display = mode === 'camera' ? 'block' : 'none';
      document.getElementById('mode-paste').style.display = mode === 'paste' ? 'block' : 'none';
      document.getElementById('btnTabCamera').classList.toggle('active', mode === 'camera');
      document.getElementById('btnTabPaste').classList.toggle('active', mode === 'paste');
    }

    function processPastedText() {
      const text = document.getElementById('pastedText').value;
      if (!text.trim()) {
        alert('Por favor, cole ao menos um nome de aluno!');
        return;
      }
      document.getElementById('rawOcrTextarea').value = text;
      parseExtractedNames(text);
    }

    // Carrega a imagem e prepara o canvas preservando a nitidez natural dos caracteres (Sem binarização destrutiva)
    function renderRotatedCanvas(img, rotation) {
      const canvas = document.createElement('canvas');
      const maxDim = 1800; // Resolução ideal para Tesseract OCR (letras entre 25px e 35px)
      let w = img.width;
      let h = img.height;

      const isSideways = (rotation === 90 || rotation === 270);
      let targetW = isSideways ? h : w;
      let targetH = isSideways ? w : h;

      if (targetW > maxDim || targetH > maxDim) {
        if (targetW > targetH) {
          targetH = Math.round((targetH * maxDim) / targetW);
          targetW = maxDim;
        } else {
          targetW = Math.round((targetW * maxDim) / targetH);
          targetH = maxDim;
        }
      }

      canvas.width = targetW;
      canvas.height = targetH;
      const ctx = canvas.getContext('2d');

      // Fundo branco limpo
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, targetW, targetH);

      ctx.save();
      ctx.translate(targetW / 2, targetH / 2);
      ctx.rotate((rotation * Math.PI) / 180);
      const drawW = isSideways ? targetH : targetW;
      const drawH = isSideways ? targetW : targetH;
      ctx.drawImage(img, -drawW / 2, -drawH / 2, drawW, drawH);
      ctx.restore();

      return canvas;
    }

    async function handleImageSelected(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = async () => {
          currentImageElement = img;
          currentRotation = 0;
          await executeOcrOnImage();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    async function rotateAndReOcr() {
      if (!currentImageElement) return;
      currentRotation = (currentRotation + 90) % 360;
      await executeOcrOnImage();
    }

    async function executeOcrOnImage() {
      if (!currentImageElement) return;

      const progressBox = document.getElementById('progressBox');
      const progressBar = document.getElementById('progressBar');
      const progressStatus = document.getElementById('progressStatus');
      const progressPercent = document.getElementById('progressPercent');
      const imgPreview = document.getElementById('imgPreview');
      const previewWrap = document.getElementById('previewWrap');

      const canvas = renderRotatedCanvas(currentImageElement, currentRotation);
      imgPreview.src = canvas.toDataURL('image/jpeg', 0.85);
      previewWrap.style.display = 'block';

      progressBox.style.display = 'block';
      progressBar.style.width = '15%';
      progressPercent.innerText = '15%';
      progressStatus.innerText = '🔍 Iniciando reconhecimento de texto na folha...';

      try {
        // Tesseract v5 com suporte a Português e Inglês (PSM 4/6 - Coluna de Texto)
        let ret;
        try {
          const worker = await Tesseract.createWorker(['por', 'eng'], 1, {
            logger: m => {
              if (m.status === 'recognizing text') {
                const p = Math.round(15 + m.progress * 80);
                progressBar.style.width = p + '%';
                progressPercent.innerText = p + '%';
                progressStatus.innerText = `🔍 Lendo texto da folha (${p}%)...`;
              }
            }
          });

          // Define modo de segmentação para colunas/blocos de texto (PSM 4 = Coluna única de tamanhos variáveis)
          await worker.setParameters({
            tessedit_pageseg_mode: '4',
            preserve_interword_spaces: '1'
          });

          ret = await worker.recognize(canvas);
          await worker.terminate();
        } catch(errPor) {
          console.warn('Fallback simples do Tesseract:', errPor);
          progressStatus.innerText = '🔍 Utilizando motor rápido...';
          ret = await Tesseract.recognize(canvas, 'eng', {
            logger: m => {
              if (m.status === 'recognizing text') {
                const p = Math.round(20 + m.progress * 75);
                progressBar.style.width = p + '%';
                progressPercent.innerText = p + '%';
              }
            }
          });
        }

        const rawText = (ret && ret.data && ret.data.text) ? ret.data.text.trim() : '';
        document.getElementById('rawOcrTextarea').value = rawText;

        if (!rawText) {
          alert('A câmera não detectou nenhum caractere legível.\n\nVerifique se a foto está bem iluminada ou gire a foto em 90° se ela foi tirada de lado.');
          progressBox.style.display = 'none';
          return;
        }

        parseExtractedNames(rawText);

      } catch (err) {
        console.error('OCR Error:', err);
        alert('Erro ao processar imagem: ' + err.message);
        progressBox.style.display = 'none';
      }
    }

    function reparseFromEditedTextarea() {
      const text = document.getElementById('rawOcrTextarea').value;
      parseExtractedNames(text);
    }

    function useRawLinesDirectly() {
      const text = document.getElementById('rawOcrTextarea').value;
      const lines = text.split(/\r?\n/)
                        .map(l => l.trim())
                        .filter(l => l.length >= 2);
      if (lines.length === 0) {
        alert('A caixa de texto está vazia!');
        return;
      }
      recognizedStudents = Array.from(new Set(lines));
      renderStudentsReviewList();
    }

    // Parser inteligente e tolerante para listas de presença escolares
    function parseExtractedNames(text) {
      if (!text || typeof text !== 'string') return;

      const lines = text.split(/\r?\n/);
      const names = [];

      const ignoreWords = [
        'ESCOLA', 'MUNICIPAL', 'ESTADUAL', 'COLÉGIO', 'COLEGIO', 'PROFESSOR', 'PROFESSORA',
        'CHAMADA', 'LISTA', 'PRESENÇA', 'PRESENCA', 'TURMA', 'ANO', 'TURNO', 'DATA',
        'ASSINATURA', 'ALUNO', 'ALUNOS', 'SECRETARIA', 'MATRÍCULA', 'MATRICULA', 'NOTAS',
        'LAB KIDS', 'CAMPOS', 'GOVERNO', 'EDUCAÇÃO', 'EDUCACAO', 'OBSERVAÇÃO', 'TOTAL',
        'DIÁRIO', 'DIARIO', 'CLASSE', 'BIMESTRE', 'DISCIPLINA', 'MÊS', 'MES', 'HORÁRIO',
        'HORARIO', 'ENSINO', 'FUNDAMENTAL', 'SITUAÇÃO', 'SITUACAO', 'FREQ', 'FREQUENCIA'
      ];

      for (let rawLine of lines) {
        let line = rawLine.trim();
        if (line.length < 2) continue;

        // Se for linha de tabela com colunas '|', extrai a coluna de maior texto (provavelmente o nome)
        if (line.includes('|')) {
          const parts = line.split('|').map(p => p.trim()).filter(p => p.length >= 2);
          const namePart = parts.find(p => p.length >= 3 && /[a-zA-ZáéíóúÁÉÍÓÚãõÃÕâêîôûÂÊÎÔÛçÇ]/.test(p) && !p.match(/^\d+$/) && !p.match(/^\d{1,2}[\/\-\.]\d{1,2}/));
          if (namePart) line = namePart;
        }

        // Limpa numerações no início: "01 - ", "1. ", "1)", "1 - ", "№ 1", "01."
        line = line.replace(/^[\s\.\-_]*(\d{1,3}|[a-zA-Z]\d{1,2})[\s\.\-_:\)\/]+/, '').trim();
        
        // Remove datas (ex: 12/03/2016 ou 05-08-15)
        line = line.replace(/\b\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{2,4}\b/g, '').trim();

        // Remove marcadores de frequência no final da linha (ex: P, F, FJ, C)
        line = line.replace(/\s+[PFpfJjCc]{1,2}$/, '').trim();

        // Remove caracteres especiais de bordas de tabela
        line = line.replace(/[|_~*#$@\[\]{}<>=]/g, ' ').trim();

        // Remove dígitos soltos
        line = line.replace(/\b\d+\b/g, '').trim();

        // Normaliza espaços múltiplos
        line = line.replace(/\s+/g, ' ').trim();

        if (line.length < 2) continue;

        // Ignora se for cabeçalho
        const upper = line.toUpperCase();
        const isHeader = ignoreWords.some(w => upper === w || upper.startsWith(w + ' ') || upper.endsWith(' ' + w));
        if (isHeader) continue;

        if (/[a-zA-ZáéíóúÁÉÍÓÚãõÃÕâêîôûÂÊÎÔÛçÇ]/.test(line)) {
          // Se estiver tudo em maiúsculas, formata em Title Case bonito
          if (line === line.toUpperCase()) {
            line = line.toLowerCase().replace(/(?:^|\s)\S/g, a => a.toUpperCase())
                       .replace(/\b(Da|De|Do|Dos|Das)\b/g, a => a.toLowerCase());
          }
          names.push(line);
        }
      }

      recognizedStudents = Array.from(new Set(names));

      // Se o filtro estrito não encontrou nada, faz fallback para todas as linhas com letras
      if (recognizedStudents.length === 0) {
        const fallbacks = lines.map(l => l.replace(/^[\d\s\.\-_]+/, '').trim()).filter(l => l.length >= 2 && /[a-zA-Z]/.test(l));
        recognizedStudents = Array.from(new Set(fallbacks));
      }

      renderStudentsReviewList();
    }

    function renderStudentsReviewList() {
      const container = document.getElementById('studentsListContainer');
      container.innerHTML = '';

      if (recognizedStudents.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 20px; background: #fffbeb; border: 1px dashed #fde68a; border-radius: 12px; color: #b45309; font-size: 0.9rem;">
            ⚠️ Nenhum nome foi separado automaticamente. <br>
            Você pode copiar do texto acima ou usar o botão <strong>"Usar Todas as Linhas como Alunos"</strong>.
          </div>
        `;
      } else {
        recognizedStudents.forEach((name, idx) => {
          const div = document.createElement('div');
          div.className = 'student-item';
          div.innerHTML = `
            <span style="font-weight: 800; color: #94a3b8; width: 22px; font-size: 0.85rem;">${idx + 1}.</span>
            <input type="text" value="${name}" onchange="updateStudentName(${idx}, this.value)">
            <button type="button" onclick="removeStudentRow(${idx})" title="Remover">❌</button>
          `;
          container.appendChild(div);
        });
      }

      document.getElementById('studentCountBadge').innerText = recognizedStudents.length + ' Alunos';
      document.getElementById('step-capture').style.display = 'none';
      document.getElementById('mode-paste').style.display = 'none';
      document.getElementById('step-review').style.display = 'block';
    }

    function updateStudentName(index, val) {
      recognizedStudents[index] = val.trim();
    }

    function removeStudentRow(index) {
      recognizedStudents.splice(index, 1);
      renderStudentsReviewList();
    }

    function addNewStudentRow() {
      recognizedStudents.push('');
      renderStudentsReviewList();
      const inputs = document.querySelectorAll('#studentsListContainer input');
      if (inputs.length > 0) inputs[inputs.length - 1].focus();
    }

    function resetScanner() {
      recognizedStudents = [];
      document.getElementById('cameraInput').value = '';
      document.getElementById('galleryInput').value = '';
      document.getElementById('previewWrap').style.display = 'none';
      document.getElementById('progressBox').style.display = 'none';
      document.getElementById('step-review').style.display = 'none';
      document.getElementById('step-success').style.display = 'none';
      document.getElementById('step-capture').style.display = 'block';
      switchMode('camera');
    }

    async function submitScannedRoster() {
      const validNames = recognizedStudents.map(n => n.trim()).filter(n => n.length >= 2);
      if (validNames.length === 0) {
        alert('Nenhum aluno válido para cadastrar!');
        return;
      }

      const generatePins = document.getElementById('chkGeneratePins').checked;
      const btn = document.getElementById('btnSubmitRoster');
      btn.disabled = true;
      btn.innerText = `⏳ Cadastrando ${validNames.length} Alunos...`;

      try {
        const res = await fetch(`/api/teacher/classes/${classId}/scanner-import`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            student_names: validNames,
            generate_pins: generatePins,
            access_code: classCode
          })
        });

        const data = await res.json();
        if (data.success) {
          document.getElementById('step-review').style.display = 'none';
          document.getElementById('successSummary').innerHTML = `
            <strong>${data.count} alunos</strong> foram salvos com sucesso na turma <strong>${className}</strong>!<br>
            Você já pode ver todos os alunos no painel do professor no computador.
          `;
          document.getElementById('step-success').style.display = 'block';
        } else {
          alert('Erro ao salvar alunos: ' + (data.error || 'Erro desconhecido'));
          btn.disabled = false;
          btn.innerText = '🚀 Salvar Todos os Alunos na Turma';
        }
      } catch (err) {
        alert('Falha na comunicação: ' + err.message);
        btn.disabled = false;
        btn.innerText = '🚀 Salvar Todos os Alunos na Turma';
      }
    }
  </script>
</body>
</html>

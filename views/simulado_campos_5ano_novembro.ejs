  <!-- MODAL DE SUCESSO -->
  <div class="modal-backdrop" id="resultModal">
    <div class="modal-content">
      <div style="font-size: 3.5rem;">🎉</div>
      <h2 style="font-family: 'Fredoka', sans-serif; font-size: 1.8rem; color: var(--primary-dark); margin: 0.5rem 0;">
        Simulado Enviado com Sucesso!
      </h2>
      <p style="color: #64748b; font-size: 1.05rem;">
        Parabéns por concluir sua avaliação oficial com dedicação e empenho!
      </p>
      <div class="modal-score" id="modalScore">14</div>
      <p style="font-weight: 700; color: #475569; margin-bottom: 1rem;">
        questões registradas com aproveitamento
      </p>
      <div id="modalDetails" style="background: #f8fafc; border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.95rem; color: #334155; text-align: left; line-height: 1.6;">
      </div>
      <button type="button" onclick="window.location.href='/'" style="background: var(--primary); color: white; border: none; border-radius: 12px; padding: 0.85rem 1.75rem; font-family: 'Fredoka', sans-serif; font-size: 1.1rem; font-weight: 600; cursor: pointer; width: 100%;">
        Voltar para a Página Inicial
      </button>
    </div>
  </div>

  <script>
    // Gabarito Oficial SEDUCT (14 Questões: Q4 é Redação)
    const correctAnswers = {
      1: 'C',
      2: 'B',
      3: 'C',
      4: 'DISSERTATIVA', // Redação / Produção Textual
      5: 'C',
      6: 'B',
      7: 'B',
      8: 'C',
      9: 'D',
      10: 'C',
      11: 'C',
      12: 'B',
      13: 'B',
      14: 'A'
    };

    const userAnswers = {};
    let isSubmitting = false;

    // Inicialização da grade do Cartão-Resposta
    function initCRGrid() {
      const grid = document.getElementById('crGrid');
      grid.innerHTML = '';
      for (let i = 1; i <= 14; i++) {
        const cell = document.createElement('div');
        cell.className = 'cr-cell';
        cell.id = `cr-cell-${i}`;
        cell.onclick = () => scrollToCard(i);

        if (i === 4) {
          cell.innerHTML = `
            <span class="cr-cell-q">Q04 (Redação)</span>
            <span class="cr-cell-ans" id="cr-ans-4" style="font-size: 0.9rem;">✍️</span>
          `;
        } else {
          const numStr = i < 10 ? `0${i}` : `${i}`;
          cell.innerHTML = `
            <span class="cr-cell-q">Questão ${numStr}</span>
            <span class="cr-cell-ans" id="cr-ans-${i}">-</span>
          `;
        }
        grid.appendChild(cell);
      }
    }

    function scrollToCard(qNum) {
      const card = document.getElementById(`card-q${qNum}`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // Seleção de alternativa
    function selectOption(qNum, letter) {
      userAnswers[qNum] = letter;

      // Atualiza interface do card
      const card = document.getElementById(`card-q${qNum}`);
      if (card) {
        card.classList.add('answered');
        const items = card.querySelectorAll('.option-item');
        items.forEach(it => it.classList.remove('selected'));
        const optLetter = card.querySelector(`#opt-${qNum}-${letter}`);
        if (optLetter && optLetter.parentElement) {
          optLetter.parentElement.classList.add('selected');
        }
      }

      // Atualiza cartão-resposta
      const crAns = document.getElementById(`cr-ans-${qNum}`);
      const crCell = document.getElementById(`cr-cell-${qNum}`);
      if (crAns) crAns.innerText = letter;
      if (crCell) crCell.classList.add('answered');

      saveDraft();
    }

    // Gerenciamento da Redação (Q4)
    function handleEssayInput(el) {
      const val = el.value || '';
      userAnswers[4] = val;

      const words = val.trim() ? val.trim().split(/\s+/).length : 0;
      const lines = val.split('\n').filter(l => l.trim().length > 0).length;

      document.getElementById('essayWordCount').innerText = `${words} palavras`;
      document.getElementById('essayLineCount').innerText = `${lines} linhas preenchidas`;

      const crCell = document.getElementById('cr-cell-4');
      const crAns = document.getElementById('cr-ans-4');
      const card = document.getElementById('card-q4');

      if (val.trim().length >= 15) {
        if (crCell) crCell.classList.add('answered');
        if (crAns) {
          crAns.style.color = '#16a34a';
          crAns.innerText = '✓';
        }
        if (card) card.classList.add('answered');
      } else {
        if (crCell) crCell.classList.remove('answered');
        if (crAns) {
          crAns.style.color = 'var(--primary)';
          crAns.innerText = '✍️';
        }
        if (card) card.classList.remove('answered');
      }

      saveDraft();
    }

    // Salvar rascunho local
    function saveDraft() {
      try {
        const draft = {
          studentName: document.getElementById('studentName')?.value || '',
          schoolName: document.getElementById('schoolName')?.value || '',
          className: document.getElementById('className')?.value || '',
          shift: document.getElementById('shift')?.value || '',
          answers: userAnswers,
          timestamp: Date.now()
        };
        localStorage.setItem('simulado_5ano_novembro_draft', JSON.stringify(draft));
      } catch(e) {}
    }

    // Recuperar rascunho
    function loadDraft() {
      try {
        const raw = localStorage.getItem('simulado_5ano_novembro_draft');
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft.studentName) document.getElementById('studentName').value = draft.studentName;
        if (draft.schoolName) document.getElementById('schoolName').value = draft.schoolName;
        if (draft.className) document.getElementById('className').value = draft.className;
        if (draft.shift) document.getElementById('shift').value = draft.shift;

        if (draft.answers) {
          Object.keys(draft.answers).forEach(qStr => {
            const q = parseInt(qStr);
            const val = draft.answers[q];
            if (q === 4) {
              const ta = document.getElementById('essayText');
              if (ta && val) {
                ta.value = val;
                handleEssayInput(ta);
              }
            } else if (val) {
              selectOption(q, val);
            }
          });
        }
      } catch(e) {}
    }

    // Submissão do simulado
    async function submitSimulado() {
      if (isSubmitting) return;

      const studentName = document.getElementById('studentName')?.value.trim();
      const schoolName = document.getElementById('schoolName')?.value.trim();
      const className = document.getElementById('className')?.value.trim();
      const shift = document.getElementById('shift')?.value.trim();

      if (!studentName) {
        alert('Por favor, informe seu Nome Completo antes de enviar o simulado.');
        document.getElementById('studentName').focus();
        return;
      }

      // Verificação de preenchimento
      const missing = [];
      for (let i = 1; i <= 14; i++) {
        if (i === 4) {
          const essay = userAnswers[4];
          if (!essay || essay.trim().length < 15) {
            missing.push('Questão 04 (Redação)');
          }
        } else {
          if (!userAnswers[i]) {
            missing.push(`Questão ${i < 10 ? '0' + i : i}`);
          }
        }
      }

      if (missing.length > 0) {
        const confirmSend = confirm(
          `Atenção: As seguintes questões ainda não foram respondidas:\n\n${missing.join(', ')}\n\nDeseja enviar o simulado mesmo assim?`
        );
        if (!confirmSend) return;
      }

      isSubmitting = true;
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>⏳</span> Gravando respostas com segurança...';

      // Cálculo de nota
      let score = 0;
      for (let i = 1; i <= 14; i++) {
        if (i === 4) {
          const red = userAnswers[4];
          if (red && red.trim().length >= 15) score++;
        } else {
          if (userAnswers[i] && userAnswers[i].toUpperCase() === correctAnswers[i]) {
            score++;
          }
        }
      }

      const essayText = typeof userAnswers[4] === 'string' ? userAnswers[4] : '';

      const payload = {
        simulado_id: 'campos-5ano-novembro-2026',
        simuladoId: 'campos-5ano-novembro-2026',
        student_name: studentName,
        studentName: studentName,
        school_name: schoolName,
        schoolName: schoolName,
        shift: shift,
        class_name: className,
        className: className,
        grade: '5º Ano',
        answers_json: userAnswers,
        answers: userAnswers,
        score: score,
        max_score: 14,
        totalQuestions: 14,
        essay_text: essayText,
        submittedAt: new Date().toISOString()
      };

      if (window.SimuladoVault) {
        await window.SimuladoVault.submit(payload);
      } else {
        try {
          await fetch('/api/simulado/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } catch(e) {
          console.warn('Fallback offline save:', e);
        }
      }

      // Limpar rascunho
      localStorage.removeItem('simulado_5ano_novembro_draft');

      // Exibir Modal
      document.getElementById('modalScore').innerText = score;
      document.getElementById('modalDetails').innerHTML = `
        <strong>Aluno(a):</strong> ${studentName}<br>
        <strong>Escola:</strong> ${schoolName}<br>
        <strong>Turno:</strong> ${shift} • <strong>Turma:</strong> ${className}<br>
        <strong>Total de Acertos:</strong> ${score} de 14 questões (${Math.round((score / 14) * 100)}%)
      `;
      document.getElementById('resultModal').classList.add('active');

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 150,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
    }

    // Inicialização
    window.addEventListener('DOMContentLoaded', () => {
      initCRGrid();

      // Checa parâmetro shift na URL
      const urlParams = new URLSearchParams(window.location.search);
      const urlShift = urlParams.get('shift');
      if (urlShift && (urlShift.toLowerCase() === 'manha' || urlShift.toLowerCase() === 'tarde')) {
        const selectShift = document.getElementById('shift');
        if (selectShift) {
          selectShift.value = urlShift.toLowerCase() === 'manha' ? 'Manhã' : 'Tarde';
        }
      }

      loadDraft();
    });
  </script>
</body>
</html>

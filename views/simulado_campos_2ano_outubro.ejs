  <script>
    // ============================================================================
    // CONFIGURAÇÕES GLOBAIS E GABARITO OFICIAL
    // ============================================================================
    const SIMULADO_ID = 'campos-2ano-outubro-2026';
    const DRAFT_KEY = 'lab_simulado_2ano_outubro_draft';

    // 6 questões objetivas (Questão 4 é Ditado de Frases)
    const answerKey = {
      1: 'C',
      2: 'C',
      3: 'A',
      5: 'A',
      6: 'C',
      7: 'C'
    };

    const questionKeys = [1, 2, 3, 4, 5, 6, 7];
    let studentAnswers = {};
    let isSubmitting = false;

    // Inicializar Grade do Cartão Resposta
    function initCRGrid() {
      const grid = document.getElementById('cartaoGrid');
      grid.innerHTML = '';

      questionKeys.forEach(k => {
        const row = document.createElement('div');
        row.className = 'cr-row';
        row.id = `cr-row-${k}`;

        if (k === 4) {
          // Ditado
          row.innerHTML = `
            <span class="cr-q-num">Questão 04 (Ditado):</span>
            <span id="cr-status-q4" style="font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.6rem; border-radius: 50px; background: #f1f5f9; color: #64748b;">
              Aguardando Ditado
            </span>
          `;
        } else {
          // Múltipla escolha
          const qNumFormatted = k < 10 ? '0' + k : k;
          row.innerHTML = `
            <span class="cr-q-num">Questão ${qNumFormatted}:</span>
            <div class="cr-bubbles">
              <div class="cr-bubble" id="cr-bubble-${k}-A" onclick="selectOption(${k}, 'A')">A</div>
              <div class="cr-bubble" id="cr-bubble-${k}-B" onclick="selectOption(${k}, 'B')">B</div>
              <div class="cr-bubble" id="cr-bubble-${k}-C" onclick="selectOption(${k}, 'C')">C</div>
              <div class="cr-bubble" id="cr-bubble-${k}-D" onclick="selectOption(${k}, 'D')">D</div>
            </div>
          `;
        }
        grid.appendChild(row);
      });
    }

    // Seleção de Alternativa (bidirecional entre cards e cartão resposta)
    function selectOption(qNum, letter) {
      if (qNum === 4) return;
      studentAnswers[qNum] = letter;

      // Atualiza visual nos cartões de questão
      ['A', 'B', 'C', 'D'].forEach(l => {
        const optEl = document.getElementById(`opt-${qNum}-${l}`);
        if (optEl && optEl.parentElement) {
          if (l === letter) {
            optEl.parentElement.classList.add('selected');
          } else {
            optEl.parentElement.classList.remove('selected');
          }
        }
      });

      // Atualiza visual no Cartão Resposta
      ['A', 'B', 'C', 'D'].forEach(l => {
        const b = document.getElementById(`cr-bubble-${qNum}-${l}`);
        if (b) {
          if (l === letter) b.classList.add('selected');
          else b.classList.remove('selected');
        }
      });

      updateProgress();
      saveDraft();
    }

    // Sincronizar Frases do Ditado (Questão 4)
    function syncDitadoAnswers(shouldSave = true) {
      const d1 = document.getElementById('ditado1')?.value.trim() || '';
      const d2 = document.getElementById('ditado2')?.value.trim() || '';
      const d3 = document.getElementById('ditado3')?.value.trim() || '';
      const badge = document.getElementById('cr-status-q4');

      if (d1 || d2 || d3) {
        studentAnswers[4] = `1: ${d1} | 2: ${d2} | 3: ${d3}`;
        if (badge) {
          badge.innerText = '✓ Ditado Preenchido';
          badge.style.background = '#dcfce7';
          badge.style.color = '#15803d';
        }
      } else {
        delete studentAnswers[4];
        if (badge) {
          badge.innerText = 'Aguardando Ditado';
          badge.style.background = '#f1f5f9';
          badge.style.color = '#94a3b8';
        }
      }
      updateProgress();
      if (shouldSave) saveDraft();
    }

    // Atualizar Barra de Progresso
    function updateProgress() {
      const totalAnswered = Object.keys(studentAnswers).length;
      const progressPercent = Math.round((totalAnswered / 7) * 100);

      const fill = document.getElementById('progressFill');
      const text = document.getElementById('progressText');
      const crInd = document.getElementById('crProgressIndicator');

      if (fill) fill.style.width = `${progressPercent}%`;
      if (text) text.innerText = `${totalAnswered} de 7 respondidas`;
      if (crInd) crInd.innerText = `${totalAnswered} de 7 preenchidas`;
    }

    // Salvar e Restaurar Rascunho
    function saveDraft() {
      if (isSubmitting) return;
      const draft = {
        studentName: document.getElementById('studentName')?.value || '',
        schoolName: document.getElementById('schoolName')?.value || '',
        className: document.getElementById('className')?.value || '',
        shiftName: document.getElementById('shiftName')?.value || '',
        ditado1: document.getElementById('ditado1')?.value || '',
        ditado2: document.getElementById('ditado2')?.value || '',
        ditado3: document.getElementById('ditado3')?.value || '',
        answers: studentAnswers
      };
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); } catch(e){}
    }

    function restoreDraft() {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);
        if (draft.studentName && !document.getElementById('studentName').value) document.getElementById('studentName').value = draft.studentName;
        if (draft.schoolName && !document.getElementById('schoolName').value) document.getElementById('schoolName').value = draft.schoolName;
        if (draft.className) document.getElementById('className').value = draft.className;
        if (draft.shiftName) document.getElementById('shiftName').value = draft.shiftName;

        if (draft.ditado1) document.getElementById('ditado1').value = draft.ditado1;
        if (draft.ditado2) document.getElementById('ditado2').value = draft.ditado2;
        if (draft.ditado3) document.getElementById('ditado3').value = draft.ditado3;
        syncDitadoAnswers(false);

        if (draft.answers) {
          for (let q in draft.answers) {
            if (q == '4') continue;
            selectOption(parseInt(q), draft.answers[q]);
          }
        }
      } catch(e){}
    }

    // Leitura por Síntese de Voz (TTS)
    function speakText() {}

    function speakSingleSentence(text) {
      if (!('speechSynthesis' in window)) {
        alert('Seu navegador não suporta leitura em áudio.');
        return;
      }
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'pt-BR';
      utterance.rate = 0.9;

      const btn = event?.currentTarget;
      if (btn) btn.classList.add('speaking');
      utterance.onend = () => { if (btn) btn.classList.remove('speaking'); };
      utterance.onerror = () => { if (btn) btn.classList.remove('speaking'); };

      window.speechSynthesis.speak(utterance);
    }

    function speakDitadoCompleto() {}

    // Envio Ultra-Resiliente com SimuladoVault
    async function submitExamWithVault() {
      if (isSubmitting) return;

      const studentName = document.getElementById('studentName').value.trim();
      if (!studentName) {
        alert('⚠️ Por favor, informe seu Nome Completo antes de finalizar!');
        document.getElementById('studentName').focus();
        return;
      }

      // Checagem de pendências
      const missing = [];
      questionKeys.forEach(k => {
        if (!studentAnswers[k]) {
          if (k === 4) missing.push('Questão 04 (Ditado de Frases)');
          else missing.push(`Questão ${k < 10 ? '0' + k : k}`);
        }
      });

      if (missing.length > 0) {
        const confirmSend = confirm(`⚠️ Atenção: você ainda não respondeu:\n\n${missing.join('\n')}\n\nDeseja enviar a avaliação mesmo assim?`);
        if (!confirmSend) return;
      }

      // Calcular Pontuação Objetiva (Máx = 6 pontos)
      let score = 0;
      for (let k in answerKey) {
        if (studentAnswers[k] === answerKey[k]) score++;
      }

      const ditadoText = studentAnswers[4] || '';

      const payload = {
        simulado_id: SIMULADO_ID,
        student_name: studentName,
        school_name: document.getElementById('schoolName').value.trim() || 'E.M. José Giró Faísca',
        class_name: document.getElementById('className').value || '2º Ano B',
        shift: document.getElementById('shiftName').value || 'Manhã',
        answers_json: studentAnswers,
        score: score,
        max_score: 6,
        essay_text: ditadoText
      };

      const btn = document.querySelector('.btn-submit-exam');
      btn.innerHTML = '<span>⏳</span> <span>GRAVANDO NA NUVEM...</span>';
      btn.style.opacity = '0.7';
      isSubmitting = true;

      let result = { success: true };
      if (window.SimuladoVault) {
        result = await window.SimuladoVault.submit(payload, (attempt, max) => {
          btn.innerHTML = `<span>⏳</span> <span>ENVIANDO (TENTATIVA ${attempt}/${max})...</span>`;
        });
      } else {
        try {
          const res = await fetch('/api/simulado/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          result.success = res.ok;
        } catch(e) {
          result.success = false;
        }
      }

      isSubmitting = false;
      btn.innerHTML = '<span>🚀</span> <span>FINALIZAR E ENVIAR</span>';
      btn.style.opacity = '1';

      if (result.success) {
        try { localStorage.removeItem(DRAFT_KEY); } catch(e){}
        if (document.getElementById('modalScore')) document.getElementById('modalScore').innerText = score;
        document.getElementById('resultModal').classList.add('active');
        if (typeof confetti === 'function') {
          confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
        }
      } else {
        alert('⚠️ ATENÇÃO: Falha temporária na internet da escola!\n\nSuas respostas foram SALVAS COM TOTAL SEGURANÇA na memória deste aparelho e NÃO FORAM APAGADAS.\n\nAssim que o sinal de internet voltar, você pode clicar em Enviar novamente ou o sistema sincronizará automaticamente.');
      }
    }

    // ============================================================================
    // CONTROLE DE ACESSO DO PROFESSOR E PREENCHIMENTO AUTOMÁTICO DO CABEÇALHO
    // ============================================================================
    let activePollTimer = null;
    let cachedFoundStudents = [];
    let currentStudentProfile = null;

    async function checkAndEnforceStudentAuth() {
      let profileRaw = localStorage.getItem('lab_student_profile');

      try {
        currentStudentProfile = JSON.parse(profileRaw);
      } catch(e) {
        localStorage.removeItem('lab_student_profile');
        return;
      }

      if (!currentStudentProfile || !currentStudentProfile.name) {
        return;
      }

      const sName = currentStudentProfile.name;
      const sSchool = currentStudentProfile.school_name || currentStudentProfile.school || 'E.M. José Giró Faísca';
      const sClass = currentStudentProfile.class_name || currentStudentProfile.class || '2º Ano B';
      const sShift = currentStudentProfile.shift || 'Manhã';

      const stNameEl = document.getElementById('studentName');
      const scNameEl = document.getElementById('schoolName');
      const clNameEl = document.getElementById('className');
      const shNameEl = document.getElementById('shiftName');

      if (stNameEl) {
        stNameEl.value = sName;
        stNameEl.readOnly = true;
        stNameEl.style.backgroundColor = '#f1f5f9';
      }
      if (scNameEl) {
        scNameEl.value = sSchool;
        scNameEl.readOnly = true;
        scNameEl.style.backgroundColor = '#f1f5f9';
      }
      if (clNameEl) {
        let optFound = Array.from(clNameEl.options).some(o => o.value === sClass);
        if (!optFound) {
          const newOpt = document.createElement('option');
          newOpt.value = sClass;
          newOpt.innerText = sClass;
          clNameEl.appendChild(newOpt);
        }
        clNameEl.value = sClass;
      }
      if (shNameEl) shNameEl.value = sShift;

      const banner = document.getElementById('verifiedStudentBanner');
      if (banner) {
        banner.style.display = 'block';
        document.getElementById('bannerStudentName').innerText = sName;
        document.getElementById('bannerStudentInfo').innerText = sClass + ' • ' + sSchool;
      }

      await verifySimuladoRelease(currentStudentProfile);
    }

    async function verifySimuladoRelease(st) {
      const waitOverlay = document.getElementById('waitingForTeacherOverlay');
      try {
        const query = new URLSearchParams({
          simulado_id: SIMULADO_ID,
          class_id: st.class_id || '',
          class_name: st.class_name || st.class || '',
          school_name: st.school_name || st.school || '',
          student_id: st.id || ''
        });

        const res = await fetch('/api/simulado/check-access?' + query.toString());
        const data = await res.json();

        if (data.allowed) {
          waitOverlay.style.display = 'none';
          if (activePollTimer) {
            clearInterval(activePollTimer);
            activePollTimer = null;
          }
        } else {
          document.getElementById('waitStudentName').innerText = st.name;
          document.getElementById('waitClassName').innerText = st.class_name || '2º Ano';
          waitOverlay.style.display = 'flex';

          if (!activePollTimer) {
            activePollTimer = setInterval(() => {
              if (currentStudentProfile) verifySimuladoRelease(currentStudentProfile);
            }, 4000);
          }
        }
      } catch (err) {
        console.warn('Erro ao verificar liberação:', err);
      }
    }

    async function checkTeacherReleaseNow() {
      if (currentStudentProfile) {
        await verifySimuladoRelease(currentStudentProfile);
      } else {
        await checkAndEnforceStudentAuth();
      }
    }

    async function lookupQuickClassCode() {
      const codeInput = document.getElementById('quickClassCodeInput');
      const statusEl = document.getElementById('quickClassStatus');
      const rawCode = codeInput.value.trim().toUpperCase();
      if (!rawCode || rawCode.length < 3) {
        statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">Digite o código da turma!</span>';
        return;
      }

      statusEl.innerHTML = '<span style="color:#059669; font-weight:700;">⏳ Localizando turma...</span>';

      try {
        const res = await fetch('/api/classes/by-code/' + rawCode);
        const data = await res.json();
        if (!data.success || !data.class) {
          statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">❌ ' + (data.error || 'Código não encontrado!') + '</span>';
          return;
        }

        const cls = data.class;
        statusEl.innerHTML = '<span style="color:#15803d; font-weight:800;">✓ Turma: ' + cls.class_name + ' (' + cls.school_name + ')</span>';

        const stRes = await fetch('/api/classes/' + (cls.teacher_class_id || cls.id) + '/students');
        const stData = await stRes.json();
        const students = Array.isArray(stData) ? stData : (stData.students || []);
        cachedFoundStudents = students;

        const selectEl = document.getElementById('quickStudentSelect');
        selectEl.innerHTML = '<option value="">-- Clique e selecione seu Nome --</option>';

        students.forEach(s => {
          const opt = document.createElement('option');
          opt.value = s.id;
          opt.innerText = s.name;
          selectEl.appendChild(opt);
        });

        document.getElementById('quickStudentSelector').style.display = 'block';
      } catch(e) {
        statusEl.innerHTML = '<span style="color:#ef4444; font-weight:700;">Erro ao buscar turma: ' + e.message + '</span>';
      }
    }

    function confirmQuickStudent(studentId) {
      if (!studentId) return;
      const found = cachedFoundStudents.find(s => String(s.id) === String(studentId));
      if (!found) return;

      localStorage.setItem('lab_student_profile', JSON.stringify(found));
      checkAndEnforceStudentAuth();
    }

    function logoutStudentAndSwitch() {
      if (!confirm('Deseja trocar de aluno neste aparelho?')) return;
      localStorage.removeItem('lab_student_profile');
      location.reload();
    }

    window.addEventListener('DOMContentLoaded', () => {
      initCRGrid();
      restoreDraft();
      updateProgress();
      checkAndEnforceStudentAuth();

      document.getElementById('studentName')?.addEventListener('input', saveDraft);
      document.getElementById('schoolName')?.addEventListener('change', saveDraft);
      document.getElementById('className')?.addEventListener('change', saveDraft);
      document.getElementById('shiftName')?.addEventListener('change', saveDraft);
    });
  </script>
</body>

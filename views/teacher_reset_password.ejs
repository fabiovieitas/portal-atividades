<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Criar Nova Senha — Portal Lab Kids</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" sizes="512x512" href="/img/robot-icon-512.png">
  <link rel="stylesheet" href="/css/style.css?v=3">
  <link rel="stylesheet" href="/css/admin_fixes.css?v=2">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0b1120 0%, #1e1b4b 50%, #0f172a 100%);
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
      color: #1e293b;
    }
    .auth-card {
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(56, 189, 248, 0.2);
      max-width: 480px;
      width: 100%;
      padding: 40px 35px;
      text-align: center;
      overflow: hidden;
      position: relative;
    }
    .card-logo {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      border: 3px solid #38bdf8;
      box-shadow: 0 8px 24px rgba(56, 189, 248, 0.35);
      margin-bottom: 16px;
      display: inline-block;
    }
    .card-title {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.85rem;
      color: #0f172a;
      margin: 0 0 8px 0;
    }
    .card-desc {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.55;
      margin-bottom: 25px;
    }
    .form-group {
      margin-bottom: 20px;
      text-align: left;
    }
    .form-group label {
      display: block;
      font-weight: 700;
      font-size: 0.88rem;
      color: #334155;
      margin-bottom: 6px;
    }
    .form-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      font-size: 1rem;
      font-family: 'Outfit', sans-serif;
      color: #0f172a;
      transition: all 0.2s;
      box-sizing: border-box;
    }
    .form-input:focus {
      border-color: #0284c7;
      outline: none;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }
    .btn-submit {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      font-family: 'Fredoka', 'Outfit', sans-serif;
      transition: all 0.2s;
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.45);
    }
    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border-left: 4px solid #ef4444;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 0.9rem;
      margin-bottom: 20px;
      text-align: left;
    }
    .back-link {
      display: inline-block;
      margin-top: 22px;
      color: #64748b;
      font-weight: 600;
      text-decoration: none;
      font-size: 0.92rem;
      transition: color 0.15s;
    }
    .back-link:hover {
      color: #0284c7;
    }
  </style>
</head>
<body>

  <div class="auth-card">
    <img src="/img/robot-icon-512.png" alt="Robô Lab Kids" class="card-logo">
    <h1 class="card-title">Criar Nova Senha</h1>
    <p class="card-desc">Digite sua nova senha de acesso para a conta <strong><%= email %></strong>.</p>

    <% if (error) { %>
      <div class="alert-error">⚠️ <%= error %></div>
    <% } %>

    <form action="/professor/redefinir-senha" method="POST" onsubmit="return validatePasswords()">
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="form-group">
        <label for="password">Nova Senha (mínimo 6 caracteres)</label>
        <input type="password" id="password" name="password" class="form-input" placeholder="Digite sua nova senha" minlength="6" required autofocus>
      </div>

      <div class="form-group">
        <label for="confirm_password">Confirmar Nova Senha</label>
        <input type="password" id="confirm_password" name="confirm_password" class="form-input" placeholder="Repita a nova senha" minlength="6" required>
      </div>

      <button type="submit" class="btn-submit">Salvar Nova Senha & Entrar 🚀</button>
    </form>

    <div>
      <a href="/professor/login" class="back-link">⬅ Voltar para o Login</a>
    </div>
  </div>

  <script>
    function validatePasswords() {
      const p1 = document.getElementById('password').value;
      const p2 = document.getElementById('confirm_password').value;
      if (p1 !== p2) {
        alert('As duas senhas não coincidem. Por favor, digite senhas iguais.');
        return false;
      }
      return true;
    }
  </script>

</body>
</html>
